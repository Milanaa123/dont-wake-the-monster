    <Item class="ModuleScript" referent="7">
      <Properties>
        <string name="Name">PetAffection</string>
        <string name="Source"><![CDATA[--!strict
-- Pure, deterministic petting rules. The SERVER owns active sessions and noise.
-- For cats, repeated pleasant strokes raise purr intensity until the sound itself
-- may wake Giggles. Grumpy or overstimulated cats may swat, hiss, or run away.
local Affection = {}

Affection.CarryDistance = 22
Affection.PetDistance = 22
Affection.MaxSessionSeconds = 30
Affection.KeepaliveSeconds = 4
Affection.TickSeconds = 0.5

function Affection.isCat(species: any): boolean
    if type(species) ~= "string" then return false end
    local name = string.lower(species)
    return string.find(name, "kitten", 1, true) ~= nil
        or string.find(name, "cat", 1, true) ~= nil
end

local function clamp(value: number): number
    return math.clamp(value, 0, 100)
end

function Affection.newSession(p: any, cat: boolean, roll: number)
    local temperament = p.temperament
    local happiness = p.happiness
    local affection = p.affection == "HeadPats" or p.affection == "Cuddles"
    local patience = 6 + (p.bond / 100) * 7 + (p.traits.kindness / 100) * 5
    if temperament == "Grumpy" then patience -= 4 end
    if temperament == "Shy" then patience -= 1.6 end
    if temperament == "Clingy" then patience += 4 end
    if affection then patience += 3 end
    patience += math.clamp(roll, 0, 1) * 5
    local enjoys = happiness >= 34 and p.hunger < 92 and (p.bond >= 24 or temperament ~= "Grumpy")
    if p.energy <= 10 then enjoys = false end
    return {
        cat = cat,
        elapsed = 0,
        purr = 0,
        patience = math.clamp(patience, 3, 26),
        enjoys = enjoys,
        noiseFraction = 0,
        reacted = false,
        done = false,
    }
end

-- Rolls passed in by the server RNG; no client-supplied chance values.
-- Every return has {noise, purr, event, done, intensity}.
function Affection.step(p: any, session: any, dt: number, roll: number)
    if session.done then return {noise = 0, purr = session.purr, event = "Done", done = true, intensity = 0} end
    dt = math.clamp(dt, 0, Affection.TickSeconds)
    session.elapsed += dt
    local event = ""
    if session.elapsed >= Affection.MaxSessionSeconds then
        session.done = true
        return {noise = 0, purr = session.purr, event = "NeedsRest", done = true, intensity = 0}
    end

    local kindness = (p.traits.kindness or 50) / 100
    local sensitivity = (p.traits.sensitivity or 50) / 100
    local temperament = p.temperament
    local enjoys = session.enjoys and p.happiness > 17
    local rate = (0.045 + kindness * 0.03 + (p.bond / 100) * 0.045) * dt
    if temperament == "Clingy" then rate *= 1.5 end
    if temperament == "Grumpy" then rate *= 0.75 end

    if enjoys then
        p.happiness = clamp(p.happiness + 1.05 * dt)
        p.bond = clamp(p.bond + 0.34 * dt)
        if session.cat then
            session.purr = math.clamp(session.purr + rate, 0, 1)
        end
    else
        session.purr = math.max(0, session.purr - 0.09 * dt)
    end

    -- Affection is not guaranteed: an impatient cat can suddenly change its mind.
    -- The threshold is time-dependent and clamped so very long strokes are risky.
    if session.cat and session.elapsed > session.patience then
        local irritation = math.clamp(
            0.025 + sensitivity * 0.16 + (if temperament == "Grumpy" then 0.15 else 0)
                + (if temperament == "Mischievous" then 0.07 else 0)
                + (if enjoys then -0.055 else 0.15), 0.008, 0.4
        )
        if roll < irritation * dt then
            session.done = true
            session.purr = 0
            p.happiness = clamp(p.happiness - 5)
            local outcome = if temperament == "Mischievous" then "Zoomies"
                elseif temperament == "Shy" then "Hides"
                elseif roll < irritation * dt / 2 then "Swat" else "Hiss"
            return {noise = if outcome == "Hiss" then 4 else 7, purr = 0, event = outcome, done = true, intensity = 0}
        end
    end

    local soundLevel = session.cat and session.purr or 0
    local noiseRate = if session.cat and enjoys then (soundLevel * soundLevel * 11 + soundLevel * 1.2) else 0
    -- Converts continuous volume to integer global noise while preserving sub-tick fractions.
    session.noiseFraction += noiseRate * dt
    local noise = math.floor(session.noiseFraction)
    session.noiseFraction -= noise
    if session.cat and soundLevel >= 0.38 and not session.reacted then
        session.reacted = true
        event = "Purring"
    elseif session.cat and soundLevel >= 0.85 and roll < 0.07 * dt then
        event = "Purrquake"
        noise += 7
    end
    return {noise = noise, purr = soundLevel, event = event, done = false, intensity = soundLevel}
end

return Affection
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="8">
      <Properties>
        <string name="Name">PetPersonality</string>
        <string name="Source"><![CDATA[--!strict
-- Procedural personalities. A species does not determine a pet's personality.
-- Pure Luau for CLI unit tests; every persistent value is server-owned.
local Personality = {}

Personality.Temperaments = {
    "Kind", "Grumpy", "Playful", "Mischievous", "Shy", "Brave",
    "Curious", "Sleepy", "Dramatic", "Clingy", "Proud", "Wild",
}
Personality.Habits = {
    "Cuddles", "Dances", "CollectsShiny", "Naps", "Hides", "Jumps",
    "MakesFaces", "Hums", "ChasesTail", "StealsSnacks", "Daydreams", "Sneezes",
}
Personality.Fears = {
    "Thunder", "Darkness", "Crowds", "SuddenNoise", "BigMonsters", "Water", "None",
}
Personality.Affection = {"HeadPats", "Cuddles", "Dancing", "Games", "Food", "QuietTime", "Praise"}
Personality.Foods = {"Candy", "Pepper", "Bubble", "Star"}
Personality.Moods = {"Happy", "Calm", "Grumpy", "Excited", "Shy", "Scared", "Sleepy", "Hungry", "Curious"}

local LIMIT = 2147483647
local function sane(value: any, default: number): number
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then return default end
    return math.clamp(math.floor(value), 0, 100)
end

-- Exact integer arithmetic: products remain < 2^53, reproducible in Luau.
local function generator(rawSeed: number)
    local seed = math.max(1, math.floor(math.abs(rawSeed)) % (LIMIT - 1))
    return function(max: number): number
        seed = (seed * 48271) % LIMIT
        return seed % max + 1
    end
end

local function has(items: {string}, key: any): boolean
    if type(key) ~= "string" then return false end
    for _, value in ipairs(items) do
        if value == key then return true end
    end
    return false
end

function Personality.seedFor(userId: number, petIndex: number): number
    return math.max(1, (math.floor(math.abs(userId)) * 73 + petIndex * 7919 + 524287) % (LIMIT - 1))
end

function Personality.generate(seed: number, species: string?)
    local normalizedSeed = math.max(1, math.floor(math.abs(seed)) % (LIMIT - 1))
    local roll = generator(normalizedSeed)
    local temperament = Personality.Temperaments[roll(#Personality.Temperaments)]
    local habit = Personality.Habits[roll(#Personality.Habits)]
    local fear = Personality.Fears[roll(#Personality.Fears)]
    local favoriteIndex = roll(#Personality.Foods)
    local dislikedIndex = (favoriteIndex + roll(#Personality.Foods - 1) - 1) % #Personality.Foods + 1
    local traits = {
        kindness = 22 + roll(70),
        curiosity = 12 + roll(80),
        courage = 12 + roll(80),
        mischief = 12 + roll(80),
        sociability = 12 + roll(80),
        sensitivity = 12 + roll(80),
    }
    -- Give temperaments a statistical signature, not fixed compulsory behavior.
    local hints = {
        Kind = {"kindness", 22}, Grumpy = {"sensitivity", 23},
        Playful = {"curiosity", 24}, Mischievous = {"mischief", 25},
        Shy = {"sociability", -23}, Brave = {"courage", 26},
        Curious = {"curiosity", 26}, Sleepy = {"mischief", -18},
        Dramatic = {"sensitivity", 25}, Clingy = {"kindness", 14},
        Proud = {"sociability", -12}, Wild = {"mischief", 20},
    }
    local hint = hints[temperament]
    if hint then traits[hint[1]] = math.clamp(traits[hint[1]] + hint[2], 1, 100) end
    return {
        seed = normalizedSeed,
        temperament = temperament,
        habit = habit,
        fear = fear,
        favoriteFood = Personality.Foods[favoriteIndex],
        dislikedFood = Personality.Foods[dislikedIndex],
        affection = Personality.Affection[roll(#Personality.Affection)],
        traits = traits,
        happiness = 65 + roll(20),
        energy = 55 + roll(33),
        hunger = 27 + roll(25),
        bond = 5 + roll(15),
        interactions = 0,
        rescues = 0,
        ribbons = {},
        species = if type(species) == "string" then string.sub(species, 1, 35) else "",
    }
end

function Personality.restore(raw: any, species: string?): any?
    if type(raw) ~= "table" or type(raw.seed) ~= "number" then return nil end
    local seed = raw.seed
    if seed ~= math.floor(seed) or seed < 1 or seed >= LIMIT then return nil end
    local p = Personality.generate(seed, species)
    -- Immutable identity traits derive from seed: never trust client/save edits.
    p.happiness = sane(raw.happiness, p.happiness)
    p.energy = sane(raw.energy, p.energy)
    p.hunger = sane(raw.hunger, p.hunger)
    p.bond = sane(raw.bond, p.bond)
    if type(raw.ribbons)=="table" then
        for _,id in {"QuietSteps","TrailRunner","GardenKeeper"} do
            if raw.ribbons[id]==true then p.ribbons[id]=true end
        end
    end
    if type(raw.rescues)=="number" and raw.rescues==math.floor(raw.rescues) then
        p.rescues=math.clamp(raw.rescues,0,1000000)
    end
    if type(raw.interactions) == "number" and raw.interactions == math.floor(raw.interactions) then
        p.interactions = math.clamp(raw.interactions, 0, 1000000)
    end
    return p
end

function Personality.pack(p: any)
    return {
        seed = p.seed,
        rescues = p.rescues or 0,
        ribbons = table.clone(p.ribbons or {}),
        happiness = sane(p.happiness, 60),
        energy = sane(p.energy, 60),
        hunger = sane(p.hunger, 40),
        bond = sane(p.bond, 10),
        interactions = math.clamp(math.floor(p.interactions or 0), 0, 1000000),
    }
end

function Personality.bondStage(p: any): string
    if p.bond >= 90 then return "Soulmates" end
    if p.bond >= 65 then return "Best Friends" end
    if p.bond >= 40 then return "Friends" end
    if p.bond >= 20 then return "Getting Close" end
    return "Just Met"
end

function Personality.mood(p: any, monsterAwake: boolean?): string
    if monsterAwake and p.fear == "BigMonsters" and p.traits.courage < 75 then return "Scared" end
    if p.hunger >= 77 then return "Hungry" end
    if p.energy <= 22 then return "Sleepy" end
    if p.happiness < 31 then return "Grumpy" end
    if p.temperament == "Shy" and p.bond < 38 then return "Shy" end
    if p.happiness >= 86 and p.energy >= 56 then return "Excited" end
    if p.temperament == "Curious" and p.energy >= 44 then return "Curious" end
    if p.happiness >= 65 then return "Happy" end
    return "Calm"
end

function Personality.feed(p: any, food: string): (string, number)
    if not has(Personality.Foods, food) then return "Unknown snack", 0 end
    local liked = food == p.favoriteFood
    local hated = food == p.dislikedFood
    local reaction = if liked then "LOVES THIS SNACK!" elseif hated then "YUCK! NOT MY FAVORITE!" else "NOM NOM!"
    local affection = if liked then 5 elseif hated then -3 else 2
    p.hunger = math.max(0, p.hunger - (if liked then 24 else 15))
    p.happiness = math.clamp(p.happiness + (if liked then 12 elseif hated then -13 else 4), 0, 100)
    p.energy = math.clamp(p.energy + (if food == "Pepper" then 7 else 2), 0, 100)
    p.bond = math.clamp(p.bond + math.max(0, affection), 0, 100)
    p.interactions += 1
    return reaction, if liked then -3 elseif hated then 8 else 0
end

function Personality.interact(p: any, action: string): (boolean, string)
    if action ~= "Pet" and action ~= "Play" and action ~= "Comfort" then return false, "Unknown interaction" end
    if action == "Play" and p.energy < 12 then
        return false, "Too sleepy to play! Give your friend a rest."
    end
    local grumpy = p.temperament == "Grumpy" and p.bond < 20
    local shy = p.temperament == "Shy" and p.bond < 30
    if action == "Pet" then
        p.happiness = math.clamp(p.happiness + (if grumpy then 2 else 10), 0, 100)
        p.bond = math.clamp(p.bond + (if grumpy then 1 else 4), 0, 100)
        p.energy = math.clamp(p.energy - 1, 0, 100)
        p.interactions += 1
        return true, if grumpy then "HMPH! One tiny pat. Don't get used to it!" elseif shy then "Eek! A shy little head boop!" else "PURR PURR! Best friends!"
    elseif action == "Play" then
        p.happiness = math.clamp(p.happiness + (if p.temperament == "Playful" then 16 else 9), 0, 100)
        p.bond = math.clamp(p.bond + 5, 0, 100)
        p.energy = math.max(0, p.energy - (if p.temperament == "Wild" then 17 else 12))
        p.hunger = math.min(100, p.hunger + 6)
        p.interactions += 1
        return true, if p.temperament == "Sleepy" then "A sleepy little wiggle!" else "ZOOMIES! Catch me if you can!"
    end
    p.happiness = math.clamp(p.happiness + 8, 0, 100)
    p.bond = math.clamp(p.bond + (if p.temperament == "Shy" then 7 else 4), 0, 100)
    p.energy = math.clamp(p.energy + 9, 0, 100)
    p.interactions += 1
    return true, if p.fear == "BigMonsters" then "Safe in your arms. No scary giants!" else "Soothed with gentle cuddles."
end

function Personality.idle(p: any, monsterAwake: boolean?): string
    if monsterAwake and p.traits.courage <= 40 then return "Hides" end
    if p.hunger >= 78 then return "Begging" end
    if p.energy <= 23 then return "Naps" end
    if p.temperament == "Grumpy" and p.happiness < 65 then return "MakesFaces" end
    if p.temperament == "Clingy" and p.bond >= 45 then return "Cuddles" end
    if p.temperament == "Wild" and p.energy > 65 then return "Jumps" end
    return p.habit
end

function Personality.tick(p: any, monsterAwake: boolean?): string
    local m = Personality.mood(p, monsterAwake)
    p.hunger = math.min(100, p.hunger + 2)
    p.energy = math.clamp(p.energy + (if m == "Sleepy" then 10 elseif monsterAwake then -5 else 2), 0, 100)
    if p.hunger > 80 then p.happiness = math.max(0, p.happiness - 2) end
    if monsterAwake and p.fear == "BigMonsters" then p.happiness = math.max(0, p.happiness - 3) end
    return Personality.idle(p, monsterAwake)
end

local favored = {
    Kind = {"Confetti", "Cloud", "Rainbow"}, Grumpy = {"Sneeze", "Hiccup", "Meteor"},
    Playful = {"Bounce", "Disco", "Spin"}, Mischievous = {"Clone", "Spin", "Giant"},
    Shy = {"Mini", "Cloud", "Rainbow"}, Brave = {"Giant", "Meteor", "Bounce"},
    Curious = {"Clone", "Rainbow", "Confetti"}, Sleepy = {"Mini", "Cloud", "Hiccup"},
    Dramatic = {"Sneeze", "Disco", "Meteor"}, Clingy = {"Cloud", "Confetti", "Clone"},
    Proud = {"Giant", "Disco", "Rainbow"}, Wild = {"Bounce", "Meteor", "Spin"},
}
function Personality.reactionMultiplier(p: any, reactionId: string): number
    local mult = 1
    for _, id in ipairs(favored[p.temperament] or {}) do
        if id == reactionId then mult *= 2.2 end
    end
    if p.traits.mischief > 70 and (reactionId == "Clone" or reactionId == "Spin") then mult *= 1.3 end
    if p.traits.courage < 35 and reactionId == "Mini" then mult *= 1.35 end
    if p.energy < 25 and reactionId == "Cloud" then mult *= 1.4 end
    return mult
end

-- Pet-to-pet social encounters. One small server-selected event per social tick,
-- not a client-triggered reward action. No real-money or random paid rewards.
Personality.EncounterNames = {
    "Besties", "Prank", "DanceOff", "DramaDuel", "HideAndSeek", "NapTogether",
    "SneezeChain", "Singing", "Zoomies", "ShinyTrade", "Rivalry", "Cuddle",
}

function Personality.meet(a: any, b: any)
    local first, second = a.temperament, b.temperament
    local pair = first .. ":" .. second
    -- Mix both genetic seeds multiplicatively. A simple sum modulo 12
    -- correlated same-step seeds and made certain social outcomes unreachable.
    local mixed = (a.seed % 100003) * (b.seed % 100019)
        + (a.interactions + 1) * 71 + (b.interactions + 1) * 97
    local roll = (math.floor(mixed / 31) % 12) + 1
    local kind = Personality.EncounterNames[roll]
    if (first == "Kind" and second == "Kind") or (first == "Clingy" and second == "Kind") then
        kind = "Besties"
    elseif first == "Sleepy" and second == "Sleepy" then
        kind = "NapTogether"
    elseif (first == "Shy" and second == "Wild") or (first == "Wild" and second == "Shy") then
        kind = "HideAndSeek"
    elseif (first == "Mischievous" and second == "Grumpy") or (first == "Grumpy" and second == "Mischievous") then
        kind = "Prank"
    elseif (first == "Dramatic" and second == "Dramatic") then
        kind = "DramaDuel"
    elseif (first == "Playful" and second == "Playful") then
        kind = "Zoomies"
    elseif (first == "Proud" and second == "Brave") or (first == "Brave" and second == "Proud") then
        kind = "Rivalry"
    end
    local definitions = {
        Besties = {noise = 0, delta = 8, title = "became BEST FRIENDS!"},
        Prank = {noise = 12, delta = -5, title = "pulled a ridiculous prank!"},
        DanceOff = {noise = 7, delta = 7, title = "started a DANCE BATTLE!"},
        DramaDuel = {noise = 10, delta = -1, title = "had a DRAMATIC ARGUMENT!"},
        HideAndSeek = {noise = 4, delta = 4, title = "played HIDE AND SEEK!"},
        NapTogether = {noise = 0, delta = 5, title = "fell asleep TOGETHER!"},
        SneezeChain = {noise = 11, delta = 0, title = "started a SNEEZE CHAIN!"},
        Singing = {noise = 8, delta = 5, title = "sang the WORST DUET!"},
        Zoomies = {noise = 9, delta = 7, title = "got the ZOOMIES!"},
        ShinyTrade = {noise = 3, delta = 5, title = "traded shiny pebbles!"},
        Rivalry = {noise = 8, delta = -2, title = "challenged each other!"},
        Cuddle = {noise = 0, delta = 8, title = "made a tiny CUDDLE PILE!"},
    }
    local entry = definitions[kind]
    if not entry then error("Unknown encounter for " .. pair) end
    a.happiness = math.clamp(a.happiness + entry.delta, 0, 100)
    b.happiness = math.clamp(b.happiness + entry.delta, 0, 100)
    a.interactions += 1
    b.interactions += 1
    return {kind = kind, noise = entry.noise, title = entry.title}
end

return Personality
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="9">
      <Properties>
        <string name="Name">RescueRoute</string>
        <string name="Source"><![CDATA[--!strict
local Route = {}
export type Target = {id: number, name: string, position: Vector3, helper: number}

function Route.choose(targets: {Target}, userId: number, origin: Vector3): Target?
    local choice: Target? = nil
    local bestGroup, bestDistance = math.huge, math.huge
    for _, target in ipairs(targets) do
        local group = if target.helper == userId then 0 elseif target.helper == 0 then 1 else 2
        local distance = (target.position - origin).Magnitude
        if group < bestGroup or (group == bestGroup and distance < bestDistance) then
            choice, bestGroup, bestDistance = target, group, distance
        end
    end
    return choice
end

-- A streamed-in model must belong to the same round as its target snapshot.
function Route.modelFor(island: Instance?, round: number, id: number): Model?
    local model = if island then island:FindFirstChild("RescueRunaway_" .. id) else nil
    if model and model:IsA("Model") and model:GetAttribute("RescueRound") == round then return model end
    return nil
end

local arrows = {"↑","↗","→","↘","↓","↙","←","↖"}
function Route.arrow(delta: Vector3, cameraRight: Vector3): string
    -- Horizontal motion stays readable even when the camera points straight down.
    local right = delta.X * cameraRight.X + delta.Z * cameraRight.Z
    local ahead = delta.X * cameraRight.Z - delta.Z * cameraRight.X
    return arrows[math.floor(math.atan2(right, ahead) / (math.pi / 4) + .5) % 8 + 1]
end

return Route
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="10">
      <Properties>
        <string name="Name">SeedMerchant</string>
        <string name="Source"><![CDATA[--!strict
-- A free-coin traveling seed merchant. Deterministic server rotation:
-- same four offers for everyone, no paid random rolls or hidden loot boxes.
local G = require(script.Parent:WaitForChild("GardenConfig"))
local Shop = {}
Shop.IntervalSeconds = 12 * 60
Shop.OfferCount = 4
Shop.PackSize = 2

function Shop.rotation(now: number): number
    return math.max(0, math.floor(now / Shop.IntervalSeconds))
end

function Shop.offers(now: number)
    local rotation = Shop.rotation(now)
    local ordinary = {}
    for _, key in ipairs(G.Order) do
        if G.Crops[key].kind == "ordinary" then table.insert(ordinary, key) end
    end
    local offers = {}
    -- Coprime step traverses all 28 ordinary crops without duplicate slots.
    for slot = 1, Shop.OfferCount do
        local index = ((rotation * 5 + (slot - 1) * 9) % #ordinary) + 1
        local key = ordinary[index]
        local crop = G.Crops[key]
        local price = math.max(5, math.floor(crop.coins * 0.62))
        table.insert(offers, {slot = slot, seed = key, price = price, count = Shop.PackSize, name = crop.name, icon = crop.icon})
    end
    return offers
end

function Shop.snapshot(now: number, bought: any)
    local rotation = Shop.rotation(now)
    local claimed = {}
    if type(bought) == "table" and bought.rotation == rotation and type(bought.slots) == "table" then
        for i = 1, Shop.OfferCount do claimed[i] = bought.slots[i] == true end
    end
    return {rotation = rotation, nextRestock = (rotation + 1) * Shop.IntervalSeconds, offers = Shop.offers(now), claimed = claimed}
end

function Shop.buy(g: any, coins: number, slot: any, now: number): (boolean, string, number)
    if type(slot) ~= "number" or slot ~= math.floor(slot) or slot < 1 or slot > Shop.OfferCount then
        return false, "Invalid merchant offer", 0
    end
    local current = Shop.snapshot(now, g.merchant)
    local offer = current.offers[slot]
    if current.claimed[slot] then return false, "Already bought this offer. Wait for the next restock!", 0 end
    if coins < offer.price then return false, "Not enough coins for the traveling merchant", 0 end
    if (g.seeds[offer.seed] or 0) > G.MAX_STACK - Shop.PackSize then return false, "Seed bag is full", 0 end
    if not g.merchant or g.merchant.rotation ~= current.rotation then
        g.merchant = {rotation = current.rotation, slots = {}}
    end
    g.merchant.slots[slot] = true
    g.seeds[offer.seed] = (g.seeds[offer.seed] or 0) + Shop.PackSize
    return true, "TRAVELING MERCHANT: +" .. Shop.PackSize .. " " .. offer.name .. " seeds!", offer.price
end

return Shop
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="12">
      <Properties>
        <string name="Name">CottageGardenStyle</string>
        <string name="Source"><![CDATA[--!strict
-- Original, asset-free cottage-garden environment inspired by the player's mood reference.
-- No image assets, external meshes, or copied game/world materials are used.
-- Detail pieces are anchored, non-collidable, and created once by the server.
local Lighting = game:GetService("Lighting")

local Art=require(script.Parent.ReferenceMeshLibrary)
local Cottage = {}
local LEAF_DARK = Color3.fromRGB(83, 145, 86)
local LEAF = Color3.fromRGB(127, 183, 94)
local LEAF_LIGHT = Color3.fromRGB(185, 213, 109)
local CREAM = Color3.fromRGB(246, 221, 167)
local WOOD = Color3.fromRGB(192, 141, 104)
local PATH = Color3.fromRGB(207, 169, 122)
local SOIL = Color3.fromRGB(136, 93, 74)
local WHITE = Color3.fromRGB(255, 248, 212)
local ORANGE = Color3.fromRGB(255, 167, 70)
local RED = Color3.fromRGB(236, 85, 87)

local function part(parent: Instance, name: string, position: Vector3, size: Vector3,
    color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Position = position
    p.Size = size
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Material = material or Enum.Material.SmoothPlastic
    p.Color = color
    p.Shape = shape or Enum.PartType.Block
    p.CastShadow = true
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function ball(parent: Instance, name: string, position: Vector3, size: Vector3, color: Color3): Part
    return part(parent, name, position, size, color, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
end

local function beam(parent: Instance, name: string, a: Vector3, b: Vector3, thickness: number, color: Color3)
    local midpoint = (a + b) * 0.5
    local bar = part(parent, name, midpoint, Vector3.new(thickness, thickness, (b - a).Magnitude), color, Enum.Material.Wood)
    bar.CFrame = CFrame.lookAt(midpoint, b)
    return bar
end

local function pebble(parent: Instance, pos: Vector3, size: number)
    local p = ball(parent, "WarmPebble", pos, Vector3.new(size, size * 0.21, size * 0.8), CREAM)
    p.Material = Enum.Material.Sand
end

local function flower(parent: Instance, pos: Vector3, tint: Color3, scale: number)
    local leaf = ball(parent, "FlowerLeaves", pos + Vector3.new(0, 0.25 * scale, 0),
        Vector3.new(1.4, 0.37, 1.1) * scale, LEAF_DARK)
    leaf.CastShadow = false
    local stalk = part(parent, "FlowerStem", pos + Vector3.new(0, 0.68 * scale, 0),
        Vector3.new(0.2, 1.1, 0.2) * scale, LEAF_DARK)
    stalk.CastShadow = false
    for i = 1, 5 do
        local angle = i * 2 * math.pi / 5
        ball(parent, "Petal", pos + Vector3.new(math.cos(angle) * 0.46, 1.35, math.sin(angle) * 0.46) * scale,
            Vector3.new(0.68, 0.27, 0.65) * scale, tint).CastShadow = false
    end
    ball(parent, "FlowerCenter", pos + Vector3.new(0, 1.35 * scale, 0),
        Vector3.new(0.65, 0.29, 0.65) * scale, ORANGE).CastShadow = false
end

local function lowPolyBush(parent: Instance, pos: Vector3, radius: number, rng: Random)
    local primary = ball(parent, "CottageBush", pos + Vector3.new(0, radius * 0.5, 0),
        Vector3.new(radius * 2, radius * 1.2, radius * 1.6), LEAF)
    primary.CFrame *= CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
    local p = ball(parent, "LeafHighlight", pos + Vector3.new(radius * 0.35, radius * 0.97, 0),
        Vector3.new(radius * 1.35, radius * 0.78, radius * 1.25), LEAF_LIGHT)
    p.CanTouch = false
end

local function fruitTree(parent: Instance, pos: Vector3, index: number, rng: Random)
    local tall = rng:NextNumber(13, 19)
    local trunk = part(parent, "OrchardTrunk", pos + Vector3.new(0, tall * 0.51, 0),
        Vector3.new(2.2, tall, 2.2), WOOD, Enum.Material.Wood)
    trunk.Shape = Enum.PartType.Cylinder
    trunk.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    local colors = {LEAF, LEAF_DARK, LEAF_LIGHT}
    local canopy = pos + Vector3.new(0, tall + 2, 0)
    ball(parent, "OrchardCanopy", canopy, Vector3.new(16, 13, 15), colors[index % 3 + 1])
    for i = 1, 4 do
        local a = i * 1.5708 + index * 0.4
        local off = Vector3.new(math.cos(a) * 5.5, rng:NextNumber(-1.4, 2.3), math.sin(a) * 5.5)
        ball(parent, "FoliageCluster", canopy + off, Vector3.new(9.8, 9.4, 10.8), colors[(i + index) % 3 + 1])
    end
    for i = 1, 6 do
        local a = i * 2.399 + index
        local r = rng:NextNumber(3.2, 7)
        local fruit = ball(parent, "GoldenOrange", canopy + Vector3.new(math.cos(a) * r, rng:NextNumber(-5, 1), math.sin(a) * r),
            Vector3.new(2.1, 2.1, 2.1), ORANGE)
        fruit.CastShadow = false
        -- A leaf pair and a small sunlit stem read as real citrus from the camera.
        local tip = fruit.Position + Vector3.new(0, 1.14, 0)
        ball(parent, "OrangeLeaf", tip + Vector3.new(0.53, 0.11, 0),
            Vector3.new(1.19, 0.22, 0.51), LEAF_DARK).CastShadow = false
        ball(parent, "OrangeLeafHighlight", tip + Vector3.new(-0.38, 0.13, 0.04),
            Vector3.new(0.9, 0.19, 0.46), LEAF_LIGHT).CastShadow = false
    end
end

local function wildBerryBush(parent: Instance, pos: Vector3, rng: Random)
    lowPolyBush(parent, pos, rng:NextNumber(2.3, 3.5), rng)
    for i = 1, 5 do
        local a = i * 2.399
        local fruit = ball(parent, "WildStrawberry",
            pos + Vector3.new(math.cos(a) * 2, rng:NextNumber(0.8, 2.3), math.sin(a) * 1.6),
            Vector3.new(1.55, 1.6, 1.4), RED)
        fruit.CastShadow = false
        ball(parent, "StrawberryCalyx", fruit.Position + Vector3.new(0, 0.78, 0),
            Vector3.new(1.25, 0.19, 1.22), LEAF_DARK).CastShadow = false
        for seed = 1, 2 do
            ball(parent, "StrawberrySeed", fruit.Position + Vector3.new((seed - 1.5) * 0.64, -0.03, -0.69),
                Vector3.new(0.13, 0.19, 0.1), CREAM).CastShadow = false
        end
    end
end

local function wheatClump(parent: Instance, pos: Vector3, scale: number)
    for i = 1, 4 do
        local a = i * 2.4
        local x = math.cos(a) * 0.95
        local z = math.sin(a) * 0.95
        local tip = pos + Vector3.new(x, 5.2 * scale, z)
        beam(parent, "WheatStalk", pos + Vector3.new(x, 0, z), tip, 0.18 * scale, Color3.fromRGB(201, 182, 116))
        for k = 1, 3 do
            ball(parent, "GoldenWheat", tip + Vector3.new((k - 2) * 0.18, k * 0.47 * scale, 0),
                Vector3.new(0.75, 1.3, 0.65) * scale, CREAM).CastShadow = false
        end
    end
end

local function melonPatch(parent: Instance, pos: Vector3)
    local melon = ball(parent, "SunlitMelon", pos + Vector3.new(0, 1.2, 0),
        Vector3.new(5.3, 4.1, 5.0), Color3.fromRGB(177, 203, 83))
    melon.Material = Enum.Material.SmoothPlastic
    for i = 1, 3 do
        local a = i * 2.094
        local stripe = ball(parent, "MelonRind", pos + Vector3.new(math.cos(a) * 1.2, 2.35, math.sin(a) * 1.2),
            Vector3.new(2.6, 0.44, 1.3), LEAF_DARK)
        stripe.CFrame *= CFrame.Angles(0, a, math.rad(15))
    end
    for i = 1, 4 do
        local a = i * math.pi / 2
        local leaf = ball(parent, "MelonLeaf", pos + Vector3.new(math.cos(a) * 3.7, 0.26, math.sin(a) * 3.7),
            Vector3.new(3.6, 0.36, 2.1), LEAF)
        leaf.CFrame *= CFrame.Angles(0, a, 0)
    end
end

function Cottage.applyLighting()
    Lighting.ClockTime = 16.1
    Lighting.Brightness = 2.1
    Lighting.ExposureCompensation = -0.07
    Lighting.Ambient = Color3.fromRGB(126, 128, 117)
    Lighting.OutdoorAmbient = Color3.fromRGB(170, 177, 149)
    Lighting.EnvironmentDiffuseScale = 0.4
    Lighting.EnvironmentSpecularScale = 0.32
    Lighting.ShadowSoftness = 0.38
    Lighting.GlobalShadows = true

    local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
    atmosphere.Name = "CottageAtmosphere"
    atmosphere.Color = Color3.fromRGB(251, 225, 176)
    atmosphere.Decay = Color3.fromRGB(187, 204, 165)
    atmosphere.Density = 0.17
    atmosphere.Haze = 0.95
    atmosphere.Glare = 0.22
    atmosphere.Offset = 0.05
    atmosphere.Parent = Lighting

    local function effect(class: string, name: string): Instance
        local existing = Lighting:FindFirstChild(name)
        if existing then return existing end
        local created = Instance.new(class)
        created.Name = name
        created.Parent = Lighting
        return created
    end

    local grade = effect("ColorCorrectionEffect", "CottageColorGrade") :: ColorCorrectionEffect
    grade.Brightness = 0.025
    grade.Contrast = 0.065
    grade.Saturation = -0.065
    grade.TintColor = Color3.fromRGB(255, 248, 224)

    local bloom = effect("BloomEffect", "CottageGentleBloom") :: BloomEffect
    bloom.Intensity = 0.14
    bloom.Size = 18
    bloom.Threshold = 1.8

    local rays = effect("SunRaysEffect", "CottageSunbeams") :: SunRaysEffect
    rays.Intensity = 0.035
    rays.Spread = 0.78
end

-- Small original stage set behind the spawn-side garden, designed to avoid
-- the central monster arena and the three seed-hunt biome centres.
local function storybookCottage(parent: Instance)
    local model = Instance.new("Model")
    model.Name = "CozyOrchardCottage"
    model.Parent = parent
    local x, y, z = 37, 7, 88
    local wall = part(model, "HoneyCottageWalls", Vector3.new(x, y + 4.4, z),
        Vector3.new(14.5, 9.0, 12.5), Color3.fromRGB(226, 185, 138), Enum.Material.WoodPlanks)
    wall.CanCollide = true
    local footing = part(model, "CottageStoneBase", Vector3.new(x, y + 0.2, z),
        Vector3.new(15.3, 0.6, 13.2), Color3.fromRGB(193, 173, 143), Enum.Material.Slate)
    footing.CanCollide = true
    for _, side in ipairs({-1, 1}) do
        local roof = part(model, "BlueSlateRoof", Vector3.new(x + side * 3.9, y + 10.1, z),
            Vector3.new(8.7, 0.82, 15.2), Color3.fromRGB(122, 136, 157), Enum.Material.Slate)
        roof.CFrame *= CFrame.Angles(0, 0, math.rad(side * 25))
        roof.CanCollide = true
        local eave = part(model, "CottageWhiteEave", Vector3.new(x + side * 6.9, y + 8.1, z),
            Vector3.new(1.0, 0.48, 15.7), CREAM, Enum.Material.Wood)
        eave.CanCollide = true
    end
    -- Exterior door is a decorative facade; it is not presented as interactive.
    local door = part(model, "WarmOakDoor", Vector3.new(x, y + 3.1, z - 6.39),
        Vector3.new(3.0, 6.1, 0.3), Color3.fromRGB(137, 97, 75), Enum.Material.WoodPlanks)
    door.CanCollide = true
    ball(model, "DoorKnob", Vector3.new(x + 1.05, y + 3.25, z - 6.64),
        Vector3.new(0.28, 0.28, 0.24), CREAM)
    for _, side in ipairs({-1, 1}) do
        local glass = part(model, "LanternWindow", Vector3.new(x + side * 4.2, y + 5.1, z - 6.39),
            Vector3.new(2.6, 2.8, 0.32), Color3.fromRGB(253, 220, 151), Enum.Material.Glass)
        glass.Transparency = 0.18
        for _, height in ipairs({3.55, 6.68}) do
            part(model, "WindowFrame", Vector3.new(x + side * 4.2, y + height, z - 6.59),
                Vector3.new(3.2, 0.34, 0.40), CREAM, Enum.Material.Wood)
        end
        part(model, "WindowCrossbar", Vector3.new(x + side * 4.2, y + 5.1, z - 6.64),
            Vector3.new(0.28, 3.1, 0.4), CREAM, Enum.Material.Wood)
        local potCenter = Vector3.new(x + side * 5.4, y + 0.7, z - 8)
        local pot = part(model, "CottageFlowerPot", potCenter,
            Vector3.new(1.45, 1.2, 1.4), Color3.fromRGB(183, 107, 83),
            Enum.Material.Brick, Enum.PartType.Cylinder)
        pot.CFrame *= CFrame.Angles(0, 0, math.rad(90))
        flower(model, potCenter + Vector3.new(0, 0.64, 0),
            if side == 1 then WHITE else Color3.fromRGB(248, 181, 197), 0.71)
    end
    part(model, "CottageChimney", Vector3.new(x + 4.5, y + 12, z + 2.6),
        Vector3.new(2.4, 5.4, 2.4), Color3.fromRGB(187, 137, 116), Enum.Material.Brick)
    for i = 1, 4 do
        local p = Vector3.new(x - 2.5 + i * 1.15, 7.26, z - 9.5 - i * 1.2)
        local steppingStone = ball(model, "CottageWalkway", p, Vector3.new(3.4, 0.16, 3.6), PATH)
        steppingStone.Material = Enum.Material.Sand
    end
end

local function orchardPond(parent: Instance)
    local model = Instance.new("Model")
    model.Name = "ShadedOrchardPond"
    model.Parent = parent
    local center = Vector3.new(54, 7.2, 91)
    local shore = ball(model, "PondSandyShore", center,
        Vector3.new(14.4, 0.21, 10.8), Color3.fromRGB(191, 184, 139))
    shore.Material = Enum.Material.Sand
    local water = ball(model, "PondSurface", center + Vector3.new(0, 0.18, 0),
        Vector3.new(11.9, 0.16, 8.3), Color3.fromRGB(131, 186, 185))
    water.Material = Enum.Material.Glass
    water.Transparency = 0.20
    water.CastShadow = false
    workspace:SetAttribute("GardenPondCenter",center)
    for i = 1, 9 do
        local a = i * 2 * math.pi / 9
        local pos = center + Vector3.new(math.cos(a) * 6.9, 0.12, math.sin(a) * 5.0)
        pebble(model, pos, 0.9)
        if i % 3 == 0 then
            flower(model, pos + Vector3.new(0.6, 0.02, 0), WHITE, 0.55)
        end
    end
    for i = 1, 3 do
        local a = i * 2.094
        local pad = ball(model, "WaterLilyPad",
            center + Vector3.new(math.cos(a) * 3, 0.31, math.sin(a) * 2.2),
            Vector3.new(1.9, 0.12, 1.7), LEAF_DARK)
        pad.CastShadow = false
    end
end

function Cottage.decorateWorld(world: Instance)
    local folder = Instance.new("Folder")
    folder.Name = "CottageGardenEnvironment"
    folder.Parent = world
    local rng = Random.new(45721)
    -- Ground level of the existing island = 7; no surprise colliders.
    for z = 34, 67, 6 do
        local stone = ball(folder, "WarmGardenPath", Vector3.new(rng:NextNumber(-0.35, 0.35), 7.15, z),
            Vector3.new(rng:NextNumber(10.5, 12), 0.24, rng:NextNumber(7.1, 8.2)), PATH)
        stone.Material = Enum.Material.Sand
        stone.CFrame *= CFrame.Angles(0, rng:NextNumber(-0.045, 0.045), 0)
    end
    -- Branches to personal gardens keep the center visually clear for the boss.
    for k = 1, 12 do
        local a = (k - 1) / 12 * math.pi * 2
        for radius = 34, 51, 8 do
            local pos = Vector3.new(math.cos(a) * radius, 7.14, math.sin(a) * radius)
            local p = ball(folder, "PathToGardens", pos, Vector3.new(7.5, 0.18, 8.7), Color3.fromRGB(220, 184, 138))
            p.Material = Enum.Material.Sand
            p.CFrame *= CFrame.Angles(0, -a, 0)
        end
    end
    local function patch(key: string, pos: Vector3, width: number): Folder
        local detail=Instance.new("Folder")
        detail.Name="FieldDetails"
        detail.Parent=folder
        Art.ground(folder,key,CFrame.new(pos)*CFrame.Angles(0,pos.X*.13,0),width,detail)
        return detail
    end
    -- Dense-looking but deliberately bounded original orchard.
    for i = 1, 11 do
        local a = (i / 11) * math.pi * 2 + 0.17
        local r = rng:NextNumber(91, 102)
        local treePos = Vector3.new(math.cos(a) * r, 7, math.sin(a) * r)
        if (treePos - Vector3.new(37, 7, 88)).Magnitude > 21
            and (treePos - Vector3.new(54, 7, 91)).Magnitude > 14 then
            fruitTree(patch("Environment_OrangeTree",treePos,13+i%3), treePos, i, rng)
        end
    end
    for i = 1, 21 do
        local a = rng:NextNumber(0, math.pi * 2)
        local r = rng:NextNumber(80, 104)
        local pos=Vector3.new(math.cos(a)*r,7,math.sin(a)*r)
        wildBerryBush(patch("Crop_Berry_S3",pos,4.8),pos,rng)
    end
    for i = 1, 12 do
        local a = (i / 12) * math.pi * 2
        local r = rng:NextNumber(84, 101)
        local pos=Vector3.new(math.cos(a)*r,7,math.sin(a)*r)
        wheatClump(patch("Crop_WhisperWheat_S3",pos,3.4),pos,rng:NextNumber(.8,1.2))
    end
    for _, p in ipairs({
        Vector3.new(-85, 7, 10), Vector3.new(91, 7, -2),
        Vector3.new(-48, 7, -73), Vector3.new(42, 7, 82),
    }) do
        melonPatch(patch("Crop_LavaMelon_S3",p,6.1),p)
    end
    for i = 1, 23 do
        local a = rng:NextNumber(0, math.pi * 2)
        local r = rng:NextNumber(85, 108)
        local pos = Vector3.new(math.cos(a) * r, 7, math.sin(a) * r)
        flower(folder, pos, if i % 3 == 0 then WHITE elseif i % 3 == 1 then
            Color3.fromRGB(251, 204, 202) else Color3.fromRGB(255, 235, 145), rng:NextNumber(0.7, 1.2))
    end
    -- Irregular overlapping shapes give the bare island ground small patches
    -- of painterly grass and clover without introducing textures or colliders.
    for i = 1, 52 do
        local a = rng:NextNumber(0, math.pi * 2)
        local r = if i % 2 == 0 then rng:NextNumber(36, 44) else rng:NextNumber(96, 106)
        local pos = Vector3.new(math.cos(a) * r, 7.2, math.sin(a) * r)
        local shade = if i % 3 == 0 then LEAF_LIGHT elseif i % 3 == 1 then LEAF else LEAF_DARK
        local patch = ball(folder, "MeadowGrassPatch", pos,
            Vector3.new(rng:NextNumber(2.2, 4.8), 0.15, rng:NextNumber(1.7, 3.5)), shade)
        patch.CastShadow = false
        if i % 3 ~= 0 then
            for leafIndex = 1, 3 do
                local theta = leafIndex * 2.094
                local leafCenter = pos + Vector3.new(math.cos(theta) * 0.42, 0.14, math.sin(theta) * 0.38)
                local clover = ball(folder, "CloverLeaf", leafCenter, Vector3.new(0.62, 0.12, 0.48), LEAF_LIGHT)
                clover.CastShadow = false
            end
        end
    end
    storybookCottage(folder)
    orchardPond(folder)
    for i = 1, 19 do
        local a = rng:NextNumber(0, math.pi * 2)
        local r = rng:NextNumber(78, 110)
        pebble(folder, Vector3.new(math.cos(a) * r, 7.14, math.sin(a) * r), rng:NextNumber(0.8, 1.8))
    end
end

function Cottage.styleEntrance(farm: Model, center: CFrame, style: string)
    if farm:GetAttribute("GardenStyle")==style then return end
    farm:SetAttribute("GardenStyle",style)
    local previous=farm:FindFirstChild("EntranceDecor")
    if previous then previous:Destroy() end
    local paint=if style=="Blossom" then Color3.fromRGB(181,138,158)
        elseif style=="Cottage" then Color3.fromRGB(136,157,132) else WOOD
    for _,piece in farm:GetChildren() do
        if piece:IsA("BasePart") and (piece.Name=="WarmWoodFence" or piece.Name=="BackFence" or piece.Name=="FencePost") then
            piece.Color=paint
        end
    end
    if style=="Meadow" then return end
    local decor=Instance.new("Folder")
    decor.Name="EntranceDecor"
    decor.Parent=farm
    if style=="Cottage" then
        Art.ground(decor,"Environment_GardenCottage",center*CFrame.new(-5,.72,13.8),4.0,nil)
        Art.ground(decor,"Environment_StonePath",center*CFrame.new(3.9,.73,13.8)*CFrame.Angles(0,math.pi/2,0),4.5,nil)
    else
        for _,side in {-1,1} do
            Art.ground(decor,"Environment_BloomingHedge",center*CFrame.new(side*5,.72,13.8),4.0,nil)
        end
    end
end

function Cottage.decorateFarm(parent: Instance, center: CFrame)
    -- Natural wood fence on sides/back, open entrance for easy traversal.
    for _, x in ipairs({-13.4, 13.4}) do
        for _, z in ipairs({-14, 0, 14}) do
            local pos = (center * CFrame.new(x, 2.0, z)).Position
            part(parent, "FencePost", pos, Vector3.new(0.85, 4.2, 0.85), WOOD, Enum.Material.Wood)
        end
        for _, height in ipairs({1.5, 2.8}) do
            beam(parent, "WarmWoodFence", (center * CFrame.new(x, height, -14)).Position,
                (center * CFrame.new(x, height, 14)).Position, 0.52, WOOD)
        end
    end
    for _, y in ipairs({1.5, 2.8}) do
        beam(parent, "BackFence", (center * CFrame.new(-13.4, y, -14)).Position,
            (center * CFrame.new(13.4, y, -14)).Position, 0.52, WOOD)
    end
    local rng = Random.new(7326)
    for i = 1, 4 do
        local x = if i % 2 == 0 then -12 else 12
        local z = -11 + i * 4
        local position = (center * CFrame.new(x, 0.75, z)).Position
        flower(parent, position, if i % 2 == 0 then WHITE else Color3.fromRGB(248, 176, 181), 0.62)
    end
    local p = (center * CFrame.new(-11.5, 0.6, 15)).Position
    lowPolyBush(parent, p, 1.6, rng)

    -- Harvest corner: warm wooden basket full of apples and strawberries.
    local basketCenter = (center * CFrame.new(10.1, 1.0, 13.0)).Position
    local basket = part(parent, "HarvestBasket", basketCenter, Vector3.new(3.4, 1.3, 2.6),
        Color3.fromRGB(176, 118, 81), Enum.Material.Wood, Enum.PartType.Cylinder)
    basket.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    for i = 1, 5 do
        local angle = i * 2.399
        local fruitCenter = basketCenter + Vector3.new(math.cos(angle) * 1.06, 0.74, math.sin(angle) * 0.76)
        ball(parent, "PickedStrawberry", fruitCenter, Vector3.new(0.93, 0.98, 0.92),
            if i % 2 == 0 then Color3.fromRGB(248, 105, 108) else Color3.fromRGB(255, 178, 83))
        ball(parent, "FruitLeaf", fruitCenter + Vector3.new(0, 0.48, 0), Vector3.new(0.93, 0.2, 0.76), LEAF_DARK)
    end

    -- Toy-sized enamel watering can, a natural place to orient the player.
    local canFolder=Instance.new("Folder")
    canFolder.Name="WateringCanDetails"
    canFolder.Parent=parent
    local canCenter = (center * CFrame.new(-9.9, 1.35, 12.5)).Position
    ball(canFolder, "WateringCan", canCenter, Vector3.new(2.5, 1.9, 1.8), Color3.fromRGB(159, 198, 215))
    local spoutEnd = canCenter + (center.RightVector * -2.0) + Vector3.new(0, 0.55, 0)
    beam(canFolder, "WateringSpout", canCenter, spoutEnd, 0.38, Color3.fromRGB(121, 166, 196))
    ball(canFolder, "WateringRose", spoutEnd, Vector3.new(0.78, 0.27, 0.78), Color3.fromRGB(222, 230, 211))

    Art.ground(parent,"Environment_WateringCan",center*CFrame.new(-9.9,.73,12.5),2.9,canFolder)

    -- Low detail density: twelve tiny meadow daisies and pebbles around the beds.
    for i = 1, 12 do
        local angle = (i / 12) * 2 * math.pi
        local x = if i % 2 == 0 then rng:NextNumber(-11.6, 11.6) else (if i % 3 == 0 then -12.5 else 12.5)
        local z = if i % 2 == 0 then (if i % 4 == 0 then -13.9 else 14.6) else rng:NextNumber(-13, 13)
        local flowerCenter = (center * CFrame.new(x, 0.75, z)).Position
        if i % 4 == 0 then
            pebble(parent, flowerCenter, rng:NextNumber(0.6, 1.2))
        else
            flower(parent, flowerCenter,
                if i % 3 == 0 then WHITE elseif i % 3 == 1 then Color3.fromRGB(255, 215, 205)
                else Color3.fromRGB(245, 233, 156), 0.48)
        end
    end
end

-- Additional plant language, not separate crops or growth mechanics.
-- Called only when the existing World.updateGarden stage changes.
function Cottage.decorateCrop(parent: Instance, position: Vector3, seedType: string, stage: number)
    if stage < 2 then return end
    if seedType == "Berry" or seedType == "FrostBerry" then
        for i = 1, 4 do
            local a = i * 2.4
            local pos = position + Vector3.new(math.cos(a) * 1.7, 2.0 + stage * 0.7, math.sin(a) * 1.5)
            local berryColor = if seedType == "FrostBerry" then Color3.fromRGB(139, 205, 250) else RED
            ball(parent, "BerryRedCluster", pos, Vector3.new(1.0, 1.2, 1.0), berryColor)
            ball(parent, "LeafCap", pos + Vector3.new(0, 0.65, 0),
                Vector3.new(1.5, 0.25, 1.2), LEAF_DARK)
            for seed = 1, 2 do
                ball(parent, "BerrySeed", pos + Vector3.new((seed - 1.5) * 0.44, 0.03, -0.49),
                    Vector3.new(0.12, 0.16, 0.1), CREAM).CastShadow = false
            end
        end
    elseif seedType == "Tomato" or seedType == "Pepper" then
        for i = 1, 3 do
            local a = i * 2.094
            ball(parent, "RipeTomato", position + Vector3.new(math.cos(a) * 1.5, 2.3 + stage * 0.65, math.sin(a) * 1.5),
                Vector3.new(1.6, 1.6, 1.5), RED)
        end
    elseif seedType == "Carrot" then
        for i = 1, 3 do
            local a = i * 2.094
            local root = position + Vector3.new(math.cos(a) * 1.4, 1.0, math.sin(a) * 1.4)
            ball(parent, "CarrotRoot", root, Vector3.new(1.1, 1.9, 1.1), ORANGE)
            for leaf = 1, 2 do
                local tip = root + Vector3.new((leaf - 1.5) * 0.55, 1.23, 0)
                local greens = ball(parent, "CarrotFeather", tip, Vector3.new(0.42, 1.3, 0.7), LEAF_DARK)
                greens.CFrame *= CFrame.Angles(0, 0, math.rad((leaf - 1.5) * 37))
            end
        end
    elseif seedType == "Watermelon" or seedType == "HoneyMelon" then
        ball(parent, "StripedGardenMelon", position + Vector3.new(0.7, 1.05, 0),
            Vector3.new(3.2, 2.3, 3.0), LEAF)
        ball(parent, "MelonHighlight", position + Vector3.new(0.7, 2.12, 0),
            Vector3.new(1.7, 0.2, 1.1), LEAF_DARK)
        -- Simple contrasting rind marks, intentionally not texture-dependent.
        for stripe = -1, 1 do
            local rind = ball(parent, "MelonRindStripe",
                position + Vector3.new(0.7 + stripe * 0.85, 1.63, -1.05),
                Vector3.new(0.3, 1.34, 0.22), LEAF_DARK)
            rind.CFrame *= CFrame.Angles(0, 0, math.rad(stripe * 18))
        end
    end
end

return Cottage
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="13">
      <Properties>
        <string name="Name">ForestWorld</string>
        <string name="Source"><![CDATA[--!strict
-- Three original 3D expeditions, with real ProximityPrompts and fixed locations.
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local X = require(ReplicatedStorage:WaitForChild("ExpeditionConfig"))
local ForestWorld = {}
local zoneFolder: Folder?
local pollen: {BasePart} = {}

local function shape(parent: Instance, name: string, pos: Vector3, size: Vector3, tint: Color3, material: Enum.Material?, ball: boolean?): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Position = pos
    p.Size = size
    p.Shape = if ball then Enum.PartType.Ball else Enum.PartType.Block
    p.Color = tint
    p.Material = material or Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.Parent = parent
    return p
end

local function sign(parent: Instance, anchor: BasePart, caption: string, width: number)
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = anchor
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.fromOffset(width, 65)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
    billboard.MaxDistance = 135
    billboard.Parent = parent
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.Text = caption
    t.TextWrapped = true
    t.TextScaled = true
    t.TextColor3 = Color3.fromRGB(78, 65, 97)
    t.BackgroundColor3 = Color3.fromRGB(255, 249, 224)
    t.BackgroundTransparency = 0.22
    t.Font = Enum.Font.GothamBlack
    t.Parent = billboard
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 14)
    c.Parent = t
end

local function decorate(parent: Instance, zoneId: string, center: Vector3, color: Color3)
    local rng = Random.new(5539 + #zoneId * 37)
    local gate = shape(parent, "TrailHead", center + Vector3.new(0, 0.15, 0), Vector3.new(12, 0.35, 12), Color3.fromRGB(225, 191, 149), Enum.Material.Sand)
    sign(parent, gate, X.Zones[zoneId].icon .. " " .. X.Zones[zoneId].name, 285)
    for i = 1, 9 do
        local angle = i * 2.399
        local r = rng:NextNumber(12, 26)
        local p = center + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
        if Vector3.new(p.X,0,p.Z).Magnitude < 108 then
            shape(parent, "StorybookTreeTrunk", p + Vector3.new(0, 2.5, 0), Vector3.new(1.5, 5, 1.5), Color3.fromRGB(166, 123, 94), Enum.Material.Wood)
            for leaf = 1, 4 do
                local a = leaf * math.pi * 0.5
                shape(parent, "RoundedTreeCrown", p + Vector3.new(math.cos(a) * 2.5, 6.7 + math.sin(a), math.sin(a) * 2.5), Vector3.new(5.2, 4.6, 5.2), color, Enum.Material.Grass, true)
            end
            if zoneId == "Marsh" then
                shape(parent, "MoonMushroom", p + Vector3.new(2.8, 1.3, 0), Vector3.new(2.2, 1.2, 2.2), Color3.fromRGB(166, 197, 255), Enum.Material.Neon, true)
            elseif zoneId == "Ruins" then
                local stone = shape(parent, "ForgottenStone", p + Vector3.new(-3.6, 1.8, 0), Vector3.new(2.2, 3.6, 2.2), Color3.fromRGB(193, 175, 185), Enum.Material.Slate)
                stone.Orientation = Vector3.new(0, i * 26, i % 3 * 7)
            else
                shape(parent, "HoneyBlossom", p + Vector3.new(2.5, 0.9, 0), Vector3.new(1.9, 1.5, 1.9), Color3.fromRGB(255, 238, 156), Enum.Material.Neon, true)
            end
        end
    end
    -- Storybook floor details: petal trails and little stone footsteps guide
    -- explorers toward the seed caches without adding any invisible barriers.
    for i = 1, 18 do
        local a = i * 2.399963
        local distance = 5 + (i % 6) * 2.5
        local spot = center + Vector3.new(math.cos(a) * distance, 0.28, math.sin(a) * distance)
        if i % 3 == 0 then
            local stone = shape(parent, "MossySteppingStone", spot, Vector3.new(2.4, 0.42, 1.7),
                Color3.fromRGB(211, 202, 180), Enum.Material.Slate, true)
            stone.Orientation = Vector3.new(0, i * 27, 0)
        else
            local flower = shape(parent, "StorybookFlower", spot + Vector3.new(0, 0.32, 0),
                Vector3.new(0.78, 0.72, 0.78),
                if i % 2 == 0 then Color3.fromRGB(255, 229, 188) else Color3.fromRGB(255, 195, 221),
                Enum.Material.SmoothPlastic, true)
            flower.CanQuery = false
            shape(parent, "FlowerCenter", spot + Vector3.new(0, 0.65, 0),
                Vector3.new(0.34, 0.26, 0.34), Color3.fromRGB(255, 235, 141), Enum.Material.SmoothPlastic, true)
        end
    end
    for i = 1, 5 do
        local a = i * 2.4
        local spot = center + Vector3.new(math.cos(a) * 11, 10 + i % 3, math.sin(a) * 11)
        local orb = shape(parent, "FloatingPollen", spot, Vector3.new(1.2, 1.2, 1.2), color, Enum.Material.Neon, true)
        orb.Transparency = 0.36
        table.insert(pollen, orb)
    end
end

function ForestWorld.build(parent: Instance, onGather: (Player, string) -> ())
    if zoneFolder then zoneFolder:Destroy() end
    zoneFolder = Instance.new("Folder")
    zoneFolder.Name = "SeedHuntingForest"
    zoneFolder.Parent = parent
    table.clear(pollen)
    local centers = {
        Meadow = Vector3.new(-86, 7.6, -21),
        Marsh = Vector3.new(88, 7.6, -13),
        Ruins = Vector3.new(0, 7.6, -89),
    }
    for _, zoneId in ipairs(X.ZoneOrder) do
        local zone = X.Zones[zoneId]
        local area = Instance.new("Folder")
        area.Name = zone.name
        area.Parent = zoneFolder
        decorate(area, zoneId, centers[zoneId], zone.color)
        for _, node in ipairs(zone.nodes) do
            local base = Vector3.new(node.x, 8.7, node.z)
            shape(area, "WarmWoodStump", base, Vector3.new(4.3, 1.1, 4.3), Color3.fromRGB(168, 115, 91), Enum.Material.Wood, true)
            local seed = shape(area, "SeedCache_" .. node.id, base + Vector3.new(0, 2.9, 0), Vector3.new(2.3, 2.5, 2.3), zone.color, Enum.Material.Neon, true)
            seed.Transparency = 0.07
            local prompt = Instance.new("ProximityPrompt")
            prompt.Name = "SearchSeeds"
            prompt.ObjectText = node.label
            prompt.ActionText = "FIND SEEDS"
            prompt.HoldDuration = 1.1
            prompt.KeyboardKeyCode = Enum.KeyCode.E
            prompt.MaxActivationDistance = 12
            prompt.RequiresLineOfSight = false
            prompt.Parent = seed
            prompt.Triggered:Connect(function(player: Player) onGather(player, node.id) end)
            sign(area, seed, "🌱 " .. node.label, 170)
            -- Visible petals around the seed pod make the objective recognizable
            -- even when billboard labels are too small on a phone.
            for petal = 1, 5 do
                local angle = petal * math.pi * 2 / 5
                local tip = base + Vector3.new(math.cos(angle) * 1.5, 2.45, math.sin(angle) * 1.5)
                local leaf = shape(area, "SeedPodPetal", tip, Vector3.new(1.1, 0.36, 1.7),
                    Color3.fromRGB(179, 239, 175), Enum.Material.SmoothPlastic, true)
                leaf.Orientation = Vector3.new(0, math.deg(angle), -16)
            end
            for k = 1, 3 do
                local angle = k / 3 * math.pi * 2
                shape(area, "LeafCluster", base + Vector3.new(math.cos(angle) * 2.2, 1.5, math.sin(angle) * 2.2), Vector3.new(1.6, 0.8, 1.6), Color3.fromRGB(113, 203, 137), nil, true)
            end
        end
    end
end

function ForestWorld.weather(weather: string)
    local entry = X.Weather[weather]
    if not entry then return end
    local effect = Lighting:FindFirstChild("ExpeditionWeatherTint")
    if not effect then
        effect = Instance.new("ColorCorrectionEffect")
        effect.Name = "ExpeditionWeatherTint"
        effect.Parent = Lighting
    end
    TweenService:Create(effect :: ColorCorrectionEffect, TweenInfo.new(2.6), {
        TintColor = entry.color,
        Contrast = if weather == "GiggleStorm" then 0.055 else 0.01,
        Saturation = if weather == "MoonFog" then -0.1 else 0.015,
    }):Play()
    for _, spot in ipairs(pollen) do
        if spot.Parent then
            TweenService:Create(spot, TweenInfo.new(1.1), {Color = entry.color, Transparency = if weather == "MoonFog" then 0.08 else 0.4}):Play()
        end
    end
end

function ForestWorld.festival()
    for _, spot in ipairs(pollen) do
        if spot.Parent then
            TweenService:Create(spot, TweenInfo.new(0.8, Enum.EasingStyle.Back), {Size = Vector3.new(3, 3, 3), Color = Color3.fromRGB(255, 226, 137)}):Play()
            task.delay(2.5, function()
                if spot.Parent then TweenService:Create(spot, TweenInfo.new(0.9), {Size = Vector3.new(1.2, 1.2, 1.2)}):Play() end
            end)
        end
    end
end

return ForestWorld
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">Game</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Server-authoritative vertical slice. Clients request actions; the server decides rewards, chaos and knockback.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local AnalyticsService = game:GetService("AnalyticsService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Personality = require(ReplicatedStorage:WaitForChild("PetPersonality"))
local AudioSource = require(ReplicatedStorage.AudioSource)
local Affection = require(ReplicatedStorage:WaitForChild("PetAffection"))
local World = require(script.Parent:WaitForChild("World"))
local ArtLibrary = require(script.Parent:WaitForChild("ReferenceMeshLibrary"))
local NativeAvatar = require(script.Parent:WaitForChild("NativeGardenerAvatar"))
local Progression = require(script.Parent:WaitForChild("Progression"))
local ProfileStore = require(script.Parent:WaitForChild("ProfileStore"))
local Garden = require(script.Parent:WaitForChild("Garden"))
local Cosmetic = require(script.Parent:WaitForChild("GardenCosmetic"))
local MarketplaceService = game:GetService("MarketplaceService")
local GardenActionVFX = require(script.Parent:WaitForChild("GardenActionVFX"))
local RecipeCatalog = require(script.Parent:WaitForChild("RecipeCatalog"))
local RescueObjective = require(script.Parent:WaitForChild("RescueObjective"))
local GardenConfig = require(ReplicatedStorage:WaitForChild("GardenConfig"))
local SeedMerchant = require(ReplicatedStorage:WaitForChild("SeedMerchant"))
local X = require(ReplicatedStorage:WaitForChild("ExpeditionConfig"))
local SeedHunt = require(script.Parent:WaitForChild("SeedHunt"))
local ForestWorld = require(script.Parent:WaitForChild("ForestWorld"))

World.build()
local remote = Instance.new("RemoteEvent")
remote.Name = "MonsterRemote"
remote.Parent = ReplicatedStorage

local persistence = ProfileStore.new(DataStoreService, Config.DATASTORE_NAME,
    Progression.serialize, HttpService:GenerateGUID(false))
local WakeRound = require(script.Parent:WaitForChild("WakeRound"))
local noiseSpot: Vector3? = nil
local wakeMode = "Listen"
local decoy = {readyAt=0,untilTime=0,position=Vector3.zero}
local rng = Random.new()
local noise = 0
local phase = "SLEEP"
local secondsLeft = Config.SLEEP_MAX_SECONDS
local noiseAlarm: number? = nil
local profiles: {[Player]: any} = {}
local loading: {[Player]: boolean} = {}
local arrival: {[Player]: number} = {}
local closingProfiles: {[Player]: any} = {}
local shuttingDown = false
local totalActions = 0
local wakeCount = 0
local farmSlots: {[number]: Player} = {}
local farmOfPlayer: {[Player]: number} = {}
local currentWeather = "Sunny"
local weatherEndsAt = os.time() + 95
local festivalFinds = 0
local festivalPlayers: {[Player]: boolean} = {}

-- Official Roblox custom analytics; only meaningful in a published experience.
-- Do not attach PII and never trust client-supplied event names/values.
local function metric(player: Player, eventName: string, value: number?)
    if RunService:IsStudio() then return end
    task.spawn(function()
        local ok, err = pcall(function()
            AnalyticsService:LogCustomEvent(player, eventName, value or 1)
        end)
        if not ok then warn("Analytics temporarily unavailable: " .. tostring(err)) end
    end)
end

local function onceMetric(player: Player, profile: any, eventName: string)
    if profile.metricFlags[eventName] then return end
    profile.metricFlags[eventName] = true
    if profile.loaded then profile.dirty=true profile.revision+=1 end
    metric(player, eventName)
end

local function notice(message: string, color: Color3?)
    remote:FireAllClients({type = "notice", text = message, color = color or Color3.fromRGB(255, 255, 255)})
end

local function sendStats(player: Player)
    local profile = profiles[player]
    if profile then
        local p = profile.personalities[profile.petIndex]
        remote:FireClient(player, {type = "stats", coins = profile.coins, pet = Config.Pets[profile.petIndex].name, hearts = profile.hearts, knockedOut = profile.knockedOut, petMood = if p then Personality.mood(p, phase == "AWAKE") else "Calm", petTemperament = if p then p.temperament else "Unknown"})
    end
end

local function sendCollection(player: Player)
    local profile = profiles[player]
    if not profile then return end
    local catalog = Progression.catalog(profile)
    catalog.type = "collection"
    remote:FireClient(player, catalog)
end

local function sendGarden(player: Player)
    local profile = profiles[player]
    if not profile then return end
    local snapshot = Garden.snapshot(profile.garden)
    snapshot.type = "garden"
    snapshot.slot = farmOfPlayer[player] or 0
    snapshot.saving = profile.loaded
    snapshot.weather = currentWeather
    snapshot.weatherEndsAt = weatherEndsAt
    snapshot.festivalFinds = festivalFinds
    snapshot.festivalGoal = X.FestivalGoal
    remote:FireClient(player, snapshot)
end

local function sleepWarning(): (string?, number?)
    if phase ~= "SLEEP" then
        noiseAlarm = nil
        return nil, nil
    end
    local reason, seconds
    noiseAlarm, reason, seconds = WakeRound.warning(noise, Config.NOISE_MAX, secondsLeft, os.clock(), noiseAlarm)
    return reason, seconds
end

local function sendState(player: Player?)
    local warning, wakeIn = sleepWarning()
    World.setStirring(warning ~= nil)
    local update = {type = "state", phase = phase, warning = warning, wakeIn = wakeIn, noise = noise, maxNoise = Config.NOISE_MAX, time = secondsLeft, wakes = wakeCount, wakeMode = wakeMode, lureReady = os.clock()>=decoy.readyAt, rescue = RescueObjective.status(), weather = currentWeather, festivalFinds = festivalFinds, festivalGoal = X.FestivalGoal}
    if player then
        remote:FireClient(player, update)
    else
        remote:FireAllClients(update)
    end
end

local function rootFor(player: Player): BasePart?
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then return root end
    return nil
end

local function knock(root: BasePart, center: Vector3, strength: number)
    local delta = root.Position - center
    local flat = Vector3.new(delta.X, 0, delta.Z)
    local away = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, 1)
    root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + away * strength + Vector3.new(0, 22, 0)
end

local function nearbyKnock(center: Vector3, radius: number, strength: number)
    for _, player in ipairs(Players:GetPlayers()) do
        local root = rootFor(player)
        if root and (root.Position - center).Magnitude < radius then
            knock(root, center, strength)
            remote:FireClient(player, {type = "shake", amount = 0.65})
        end
    end
end

local function monsterStrike(center: Vector3, radius: number, strength: number, jumpAvoids: boolean)
    if phase ~= "AWAKE" then return end
    for _, player in ipairs(Players:GetPlayers()) do
        local profile = profiles[player]
        local root = rootFor(player)
        if profile and root and not profile.knockedOut and (root.Position - center).Magnitude <= radius then
            if jumpAvoids and root.Position.Y > 15 then continue end
            if os.clock() - profile.lastHit < 2.5 then continue end
            profile.lastHit = os.clock()
            profile.hearts = math.max(0, profile.hearts - 1)
            knock(root, center, strength)
            remote:FireClient(player, {type = "shake", amount = 1})
            if profile.hearts <= 0 then
                profile.knockedOut=true
                RescueObjective.release(player)
            end
            sendStats(player)
            if profile.hearts <= 0 then
                remote:FireClient(player, {type = "notice", text = "OOPS! YOU GOT BONKED! Watch until next round.", color = Color3.fromRGB(255, 150, 158)})
                task.delay(0.2, function()
                    if root.Parent and profiles[player] == profile then
                        root.CFrame = CFrame.new(0, 17, 74)
                        root.AssemblyLinearVelocity = Vector3.zero
                    end
                end)
            else
                remote:FireClient(player, {type = "notice", text = "BONK! " .. profile.hearts .. " hearts left!", color = Color3.fromRGB(255, 150, 158)})
            end
        end
    end
end

local function addCoins(player: Player, amount: number)
    local profile = profiles[player]
    if not profile then return end
    profile.coins += math.max(0, math.floor(amount))
    if profile.loaded then
        profile.dirty = true
        profile.revision += 1
    end
    sendStats(player)
end

local function save(player: Player)
    local profile = profiles[player]
    if profile and not persistence:save(player.UserId,profile) then
        metric(player,"ProfileSaveFailed")
        if not profile.loaded then
            remote:FireClient(player,{type="notice",text="Saving stopped. Rejoin before making more progress."})
            sendGarden(player)
        end
    end
end

local function movePetNearPlayer(player: Player)
    local profile = profiles[player]
    local root = rootFor(player)
    if not profile or not root or not profile.pet or not profile.pet.Parent then return end
    profile.pet:PivotTo(CFrame.new(root.Position + Vector3.new(4, 4, -3)))
end

local function careUpdate(player: Player)
    local profile = profiles[player]
    if not profile then return end
    local petInfo = Config.Pets[profile.petIndex]
    if player.Character then
        player.Character:SetAttribute("GardenCare",if profile.carrying then "Carry" elseif profile.petting then "Pet" else "")
    end
    remote:FireClient(player, {
        type = "petCare",
        petting = profile.petting,
        carrying = profile.carrying,
        cat = Affection.isCat(petInfo.description or ""),
        purr = profile.purr,
        purrSoundConfigured = AudioSource.resolve(Config.PurrSoundId,"original-cat-purr-loop") ~= nil,
    })
end

local function stopPetting(player: Player, profile: any)
    if not profile.petting and profile.purr <= 0 then return end
    profile.petting = false
    profile.pettingSession = nil
    profile.purr = 0
    profile.purrStage = 0
    if profile.pet then World.setPurr(profile.pet, 0, Config.PurrSoundId) end
    if profiles[player] == profile then careUpdate(player) end
end

local function startPetting(player: Player)
    local profile = profiles[player]
    if not profile or profile.petting or phase ~= "SLEEP" then return end
    local now = os.clock()
    if now - profile.lastStrokingStart < 1.4 then return end
    local root = rootFor(player)
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 or not profile.pet or not profile.pet.PrimaryPart then return end
    if (root.Position - profile.pet.PrimaryPart.Position).Magnitude > Affection.PetDistance then
        remote:FireClient(player, {type = "petFeeling", text = "Come closer to your animal before petting."})
        return
    end
    local personality = profile.personalities[profile.petIndex]
    if not personality then return end
    profile.lastStrokingStart = now
    profile.lastCarePulse = now
    profile.petting = true
    profile.purr = 0
    local petInfo = Config.Pets[profile.petIndex]
    local cat = Affection.isCat(petInfo.description or "")
    profile.pettingSession = Affection.newSession(personality, cat, rng:NextNumber())
    World.emotePet(profile.pet, Personality.mood(personality), if cat then "Gentle strokes" else "Cuddles")
    careUpdate(player)
end

local function keepPetting(player: Player)
    local profile = profiles[player]
    if not profile or not profile.petting then return end
    local now = os.clock()
    if now - profile.lastCarePulse >= 0.65 then
        profile.lastCarePulse = now
    end
end

local function toggleCarry(player: Player)
    local profile = profiles[player]
    if not profile then return end
    local now = os.clock()
    if now - profile.lastCarryChange < 0.65 then return end
    profile.lastCarryChange = now
    if profile.carrying then
        profile.carrying = false
        remote:FireClient(player, {type = "petFeeling", text = "Your little friend is back on its paws."})
        careUpdate(player)
        return
    end
    local root = rootFor(player)
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 or not profile.pet or not profile.pet.PrimaryPart then return end
    if (root.Position - profile.pet.PrimaryPart.Position).Magnitude > Affection.CarryDistance then return end
    local personality = profile.personalities[profile.petIndex]
    if not personality then return end
    local reluctance = if personality.temperament == "Grumpy" then 0.24
        elseif personality.temperament == "Shy" then 0.16
        elseif personality.temperament == "Wild" then 0.18 else 0.03
    reluctance = math.max(0.01, reluctance - personality.bond / 550)
    if rng:NextNumber() < reluctance then
        remote:FireClient(player, {type = "petFeeling", text = "NOT NOW! Your pet wriggled free of the cuddle!"})
        World.emotePet(profile.pet, "Grumpy", "No hugs")
        return
    end
    profile.carrying = true
    World.emotePet(profile.pet, Personality.mood(personality), "In arms")
    remote:FireClient(player, {type = "petFeeling", text = "You picked up " .. Config.Pets[profile.petIndex].name .. "! Hold STROKE to pet."})
    careUpdate(player)
end

local function refreshGarland(player: Player, profile: any)
    if not Cosmetic.Enabled or Cosmetic.PassId<=0 then return end
    task.spawn(function()
        local owned=Cosmetic.owns(MarketplaceService,player.UserId,Cosmetic.Enabled,Cosmetic.PassId)
        if profiles[player]==profile and owned then
            World.showGarland(player.UserId)
        end
    end)
end

if Cosmetic.Enabled and Cosmetic.PassId>0 then
    MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player,passId,purchased)
        local profile=profiles[player]
        if profile and purchased and passId==Cosmetic.PassId then refreshGarland(player,profile) end
    end)
end

local function onPlayerAdded(player: Player)
    if shuttingDown or loading[player] or profiles[player] then return end
    loading[player] = true
    arrival[player]=os.clock()
    metric(player,"VisitStarted")
    local profile = Progression.new()
    profile.lastFeed = -100
    profile.lastSync = -100
    profile.lastShopAction = -100
    profile.lastDailyRequest = -100
    profile.lastGardenAction = -100
    profile.lastPetGardenAssist = -100
    profile.lastLure = -100
    profile.lastGardenVisit = -100
    profile.lastFood = ""
    profile.lastPetInteraction = -100
    profile.lastCarryChange = -100
    profile.lastStrokingStart = -100
    profile.lastCarePulse = -100
    profile.petting = false
    profile.carrying = false
    profile.pettingSession = nil
    profile.purr = 0
    profile.purrStage = 0
    profile.idleAction = "Cuddles"
    profile.loaded = false
    profile.dirty = false
    profile.revision = 0
    profile.effectUntil = 0
    profile.effect = ""
    profile.pet = nil
    profile.hearts = 3
    profile.knockedOut = false
    profile.lastHit = -100
    local ok, result = persistence:load(player.UserId)
    if ok then
        profile.loaded = true
        -- Persist the precise visit's lease token, not just this server's ID.
        -- A rapid reconnect on the same server must not share write access.
        profile.dataSessionId = result._dwtmLease.token
        Progression.load(profile, result)
    else
        warn("DWTM: data load unavailable for " .. player.UserId .. ". Progress is session-only.")
    end
    if shuttingDown or player.Parent ~= Players then
        if ok then persistence:release(player.UserId, profile) end
        loading[player]=nil
        return
    end
    -- Publish only fully loaded state. Remotes/timers cannot mutate a temporary
    -- starter garden while GetAsync yields and then overwrite or lose progress.
    loading[player]=nil
    profiles[player] = profile
    if not ok then
        -- Make it unmistakable that session-only progress is not permanent.
        -- This is especially important if the account is active in another
        -- Roblox server and an atomic lease correctly denied this join.
        remote:FireClient(player, {
            type = "notice",
            text = "SAVE UNAVAILABLE: " .. tostring(persistence.lastLoadError or "Please rejoin later")
                .. ". Progress in this visit will not be saved.",
            color = Color3.fromRGB(255, 164, 148),
        })
    end
    if ok then
        profile.firstObservedVisit=not profile.metricFlags.FirstVisit
        onceMetric(player,profile,if profile.metricFlags.FirstVisit then "FirstReturn" else "FirstVisit")
    else
        metric(player,"ProfileLoadFailed")
    end
    if phase=="AWAKE" then onceMetric(player,profile,"FirstWakeSeen") end
    task.delay(600, function()
        if profiles[player] == profile then metric(player, "StayedTenMinutes") end
    end)
    for petId in pairs(profile.owned) do
        if Progression.ensurePersonality(profile, petId, player.UserId) then
            if profile.loaded then profile.dirty = true end
            profile.revision += 1
        end
    end

    local petDefinition = Config.Pets[profile.petIndex]
    profile.pet = World.makePet(petDefinition.name .. "_" .. player.UserId, petDefinition.color, petDefinition.ear == "pointy")
    World.stylePersonality(profile.pet, profile.personalities[profile.petIndex])
    World.emotePet(profile.pet, Personality.mood(profile.personalities[profile.petIndex]), "Hello")
    movePetNearPlayer(player)
    for slot = 1, GardenConfig.SLOT_COUNT do
        if not farmSlots[slot] then
            farmSlots[slot] = player
            farmOfPlayer[player] = slot
            World.createGarden(player.UserId, player.DisplayName, slot)
            refreshGarland(player,profile)
            World.updateGarden(player.UserId, profile.garden, GardenConfig)
            break
        end
    end

    local function characterReady(character: Model)
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
        if humanoid and humanoid:IsA("Humanoid") then
            humanoid.Died:Connect(function()
                profile.carrying = false
                profile.petting = false
                profile.pettingSession = nil
                profile.purr = 0
                if profile.pet then World.setPurr(profile.pet, 0, Config.PurrSoundId) end
                careUpdate(player)
                if phase == "AWAKE" and profiles[player] == profile and player.Character == character then
                    profile.knockedOut = true
                    RescueObjective.release(player)
                    profile.hearts = 0
                    sendStats(player)
                    remote:FireClient(player, {type = "notice", text = "OH NO! YOU'RE OUT UNTIL THE NEXT ROUND!", color = Color3.fromRGB(255, 161, 170)})
                end
            end)
        end
        task.wait(1.0)
        if player.Character == character then
            -- Display chibi gardener only when all creator-owned imported mesh
            -- components exist; otherwise leave Roblox avatar untouched.
            if not ArtLibrary.applyGardenerAvatar(character) then
                NativeAvatar.apply(character)
            end
            movePetNearPlayer(player)
        end
    end
    player.CharacterAdded:Connect(function(character: Model)
        task.spawn(characterReady, character)
    end)
    -- Roblox can finish avatar appearance after CharacterAdded. Retry only
    -- when the final outfit is ready, without replacing the Humanoid rig.
    player.CharacterAppearanceLoaded:Connect(function(character: Model)
        if player.Character == character then
            if not ArtLibrary.applyGardenerAvatar(character) then
                NativeAvatar.apply(character)
            end
        end
    end)
    if player.Character then
        task.spawn(characterReady, player.Character)
    end
    sendStats(player)
    sendCollection(player)
    sendGarden(player)
    sendState(player)
    careUpdate(player)
    if phase == "SLEEP" and not sleepWarning() then
        remote:FireClient(player, {type = "notice", text = "Meet " .. petDefinition.name .. "! Pick a snack to feed your pet.", color = Color3.fromRGB(252, 205, 255)})
    end
end

local function onPlayerRemoving(player: Player)
    RescueObjective.release(player)
    local started=arrival[player]
    if started then
        arrival[player]=nil
        local seconds=math.floor(os.clock()-started)
        metric(player,"VisitSeconds",seconds)
        if seconds<60 then metric(player,"LeftBefore60") end
        if seconds<180 then metric(player,"LeftBefore180") end
    end
    local profile = profiles[player]
    if not profile then return end
    closingProfiles[player] = profile
    profiles[player] = nil
    if profile then stopPetting(player, profile) end
    if profile and profile.pet then profile.pet:Destroy() end
    World.removeGarden(player.UserId)
    local slot = farmOfPlayer[player]
    if slot then farmSlots[slot] = nil end
    farmOfPlayer[player] = nil
    if not persistence:finish(player.UserId, profile) then
        -- Retain the lease until expiry rather than allowing a second server
        -- to join while an unsaved snapshot may still exist in memory.
        metric(player,"ProfileSaveFailed")
        warn("DWTM: final save failed; lease will expire for " .. player.UserId)
    end
    closingProfiles[player] = nil
end

local function notifyBondMilestone(player: Player, profile: any, previous: string)
    local p = profile.personalities[profile.petIndex]
    if not p then return end
    local current = Personality.bondStage(p)
    if previous ~= current then
        task.delay(1.6, function()
            if profiles[player] == profile then
                remote:FireClient(player, {type = "petFeeling", text = "💖 " .. Config.Pets[profile.petIndex].name .. " friendship level: " .. current .. "!"})
                if profile.pet and profile.pet.PrimaryPart then
                    World.burst(profile.pet.PrimaryPart.Position, Color3.fromRGB(255, 163, 198), 16, 12)
                end
            end
        end)
    end
end

local function weightedReaction(food: string, previousFood: string, petIndex: number, personality: any)
    local total = 0
    local weights = {}
    local quirk = Config.Pets[petIndex].quirk
    local favorites = {
        Trickster = {Clone = true, Spin = true, Hiccup = true},
        Dreamer = {Mini = true, Cloud = true, Rainbow = true},
        Bouncer = {Bounce = true, Giant = true, Sneeze = true},
        Sparkle = {Confetti = true, Disco = true, Rainbow = true},
        Storm = {Meteor = true, Sneeze = true, Hiccup = true},
        Gremlin = {Giant = true, Clone = true, Meteor = true},
    }
    for index, reaction in ipairs(Config.Reactions) do
        local weight = reaction.weight
        if favorites[quirk] and favorites[quirk][reaction.id] then weight *= 1.6 end
        if personality then weight *= Personality.reactionMultiplier(personality, reaction.id) end
        if food == "Candy" and (reaction.id == "Confetti" or reaction.id == "Clone" or reaction.id == "Giant") then weight *= 2 end
        if food == "Pepper" and (reaction.id == "Sneeze" or reaction.id == "Spin" or reaction.id == "Hiccup") then weight *= 2 end
        if food == "Bubble" and (reaction.id == "Cloud" or reaction.id == "Mini" or reaction.id == "Bounce") then weight *= 2 end
        if food == "Star" and (reaction.id == "Rainbow" or reaction.id == "Disco" or reaction.id == "Meteor") then weight *= 2 end
        if food == previousFood and (reaction.id == "Clone" or reaction.id == "Giant") then weight += 4 end
        total += weight
        weights[index] = total
    end
    local roll = rng:NextNumber(0, total)
    for i, upper in ipairs(weights) do
        if roll <= upper then return Config.Reactions[i] end
    end
    return Config.Reactions[#Config.Reactions]
end

local function petEffect(profile: any, reaction: any, food: string)
    local pet = profile.pet
    if not pet or not pet.Parent or not pet.PrimaryPart then return end
    local pos = pet.PrimaryPart.Position
    local foodColor = Config.Foods[food].color
    local id = reaction.id
    profile.effect = id
    profile.effectUntil = os.clock() + 3.2
    pet:ScaleTo(1)
    World.tintPet(pet, Config.Pets[profile.petIndex].color)

    if id == "Giant" then
        pet:ScaleTo(2.4)
        World.burst(pos, foodColor, 17, 14)
    elseif id == "Mini" then
        pet:ScaleTo(0.5)
        World.burst(pos, Color3.fromRGB(255, 255, 255), 10)
    elseif id == "Clone" then
        for i = 1, 2 do
            local clone = pet:Clone()
            clone.Name = "TemporaryClone"
            clone.Parent = workspace:WaitForChild("MonsterIsland")
            clone:PivotTo(pet:GetPivot() * CFrame.new(i * 5 - 7, 0, 4))
            Debris:AddItem(clone, 3)
        end
        World.burst(pos, Color3.fromRGB(255, 226, 121), 15)
    elseif id == "Rainbow" or id == "Disco" then
        local expiry = profile.effectUntil
        task.spawn(function()
            for step = 1, 17 do
                if profile.effectUntil ~= expiry or not pet.Parent then break end
                local hue = (step * (if id == "Disco" then 0.23 else 0.08)) % 1
                local tint = Color3.fromHSV(hue, 0.55, 1)
                World.tintPet(pet, tint)
                if step % 4 == 0 and pet.PrimaryPart then
                    World.burst(pet.PrimaryPart.Position, tint, 6, 8)
                end
                task.wait(if id == "Disco" then 0.14 else 0.19)
            end
        end)
    elseif id == "Cloud" then
        local bubbleParent = workspace:WaitForChild("MonsterIsland")
        for i = 1, 9 do
            local bubble = Instance.new("Part")
            bubble.Name = "FloatingBubble"
            bubble.Shape = Enum.PartType.Ball
            bubble.Size = Vector3.new(2.5, 2.5, 2.5) * rng:NextNumber(0.7, 1.7)
            bubble.Material = Enum.Material.Glass
            bubble.Color = Color3.fromRGB(174, 239, 255)
            bubble.Transparency = 0.35
            bubble.Anchored = true
            bubble.CanCollide = false
            bubble.Position = pos + Vector3.new(rng:NextNumber(-5, 5), rng:NextNumber(0, 3), rng:NextNumber(-5, 5))
            bubble.Parent = bubbleParent
            TweenService:Create(bubble, TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Position = bubble.Position + Vector3.new(0, rng:NextNumber(12, 20), 0),
                Transparency = 1,
                Size = Vector3.new(0.3, 0.3, 0.3),
            }):Play()
            Debris:AddItem(bubble, 3)
        end
    elseif id == "Sneeze" then
        World.wave(pos, 21, Color3.fromRGB(130, 238, 255))
        nearbyKnock(pos, 22, 28)
    elseif id == "Meteor" then
        local blob = Instance.new("Part")
        blob.Name = "JellyMeteor"
        blob.Shape = Enum.PartType.Ball
        blob.Color = foodColor
        blob.Material = Enum.Material.Neon
        blob.Size = Vector3.new(11, 11, 11)
        blob.Anchored = true
        blob.CanCollide = false
        blob.Position = pos + Vector3.new(0, 35, 0)
        blob.Parent = workspace:WaitForChild("MonsterIsland")
        TweenService:Create(blob, TweenInfo.new(0.85, Enum.EasingStyle.Bounce), {Position = pos + Vector3.new(0, 4, 0)}):Play()
        task.delay(0.9, function()
            if blob.Parent then
                World.burst(blob.Position, foodColor, 25, 17)
                blob:Destroy()
            end
        end)
        Debris:AddItem(blob, 2)
    else
        if id == "Confetti" then
            for i = 1, 5 do
                World.burst(pos, Color3.fromHSV(i / 5, 0.5, 1), 7, 12)
            end
        else
            World.burst(pos, foodColor, 15, 11)
        end
        if id == "Hiccup" then
            World.wave(pos, 12, foodColor)
            nearbyKnock(pos, 14, 12)
        end
    end
end

local function warnPetCall(player: Player, profile: any, personality: any)
    local now=os.clock()
    if now<(profile.nextCall or 0) then return end
    local species=Config.Pets[profile.petIndex].name
    local cue,volume=WakeRound.alarm(species,personality.traits,rng:NextNumber())
    if not cue then return end
    local pet,round=profile.pet,wakeCount
    profile.nextCall=now+12
    profile.callPending=true
    World.emotePet(pet,"Curious",if cue=="BirdEcho" then "Echo?" else "Yip?")
    remote:FireClient(player,{type="callWarning",text=species.." is about to "..(if cue=="BirdEcho" then "echo" else "bark")..". Tap SOOTHE!"})
    task.delay(3.5,function()
        if profiles[player]~=profile or not profile.callPending then return end
        profile.callPending=false
        if phase~="SLEEP" or wakeCount~=round or profile.pet~=pet or not pet.Parent or not pet.PrimaryPart then return end
        noiseSpot=pet.PrimaryPart.Position
        noise=math.min(Config.NOISE_MAX,noise+volume)
        World.emotePet(pet,"Excited","+"..volume.." noise!")
        remote:FireClient(player,{type="soundCue",cue=cue})
        sendState()
    end)
end

local function feed(player: Player, food: any, craftedId: string?)
    local profile = profiles[player]
    if not profile or typeof(food) ~= "string" then return end
    local foodInfo = Config.Foods[food]
    if craftedId then
        local recipe = RecipeCatalog.Recipes[craftedId]
        if not recipe or recipe.type ~= "feed" or recipe.baseFood ~= food then return end
    end
    if not foodInfo then return end
    if phase ~= "SLEEP" then
        remote:FireClient(player, {type = "notice", text = "The monster is awake! DODGE!", color = Color3.fromRGB(255, 174, 96)})
        return
    end
    local now = os.clock()
    if now - profile.lastFeed < Config.FEED_COOLDOWN then return end
    local root = rootFor(player)
    if not root or not profile.pet or not profile.pet.PrimaryPart then return end
    if (root.Position - profile.pet.PrimaryPart.Position).Magnitude > Config.FEED_DISTANCE then
        remote:FireClient(player, {type = "notice", text = "Get closer to your pet!", color = Color3.fromRGB(255, 220, 142)})
        return
    end

    if craftedId then
        local ok, message = Garden.consume(profile.garden, craftedId, "feed")
        if not ok then
            remote:FireClient(player, {type = "notice", text = message, color = Color3.fromRGB(255, 190, 130)})
            return
        end
        profile.dirty = profile.loaded
        profile.revision += 1
        sendGarden(player)
    end
    profile.lastFeed = now
    profile.pet:SetAttribute("FedAt", workspace:GetServerTimeNow())
    onceMetric(player, profile, "FirstPetFed")
    local activePersonality = profile.personalities[profile.petIndex]
    local reaction = weightedReaction(food, profile.lastFood, profile.petIndex, activePersonality)
    local earlierStage = Personality.bondStage(activePersonality)
    local emotionText, personalityNoise = Personality.feed(activePersonality, food)
    notifyBondMilestone(player, profile, earlierStage)
    if profile.loaded then profile.dirty = true end
    profile.revision += 1
    local combo = profile.lastFood == food and rng:NextNumber() < 0.24
    profile.lastFood = food
    totalActions += 1

    petEffect(profile, reaction, food)
    World.emotePet(profile.pet, Personality.mood(activePersonality), if personalityNoise > 0 then "Yuck" else "Nom")
    local earnedNoise = math.max(0, foodInfo.noise + reaction.noise + personalityNoise + (if combo then 7 else 0))
    if craftedId then
        earnedNoise += RecipeCatalog.Recipes[craftedId].extraNoise
        if profile.pet and profile.pet.PrimaryPart then
            World.burst(profile.pet.PrimaryPart.Position, GardenConfig.Crops.Berry.color, 12, 11)
        end
    end
    if earnedNoise > 0 then noiseSpot = profile.pet.PrimaryPart.Position end
    noise = math.min(Config.NOISE_MAX, noise + earnedNoise)
    local bonus, discoveries = Progression.recordFeed(profile, reaction.id)
    addCoins(player, Config.FEED_REWARD + (if combo then 3 else 0) + bonus)
    sendCollection(player)
    onceMetric(player,profile,"FirstReaction")
    remote:FireClient(player,{type="feedNoise", amount=earnedNoise, reaction=reaction.title})
    local text = player.DisplayName .. "'s " .. Config.Pets[profile.petIndex].name .. ": " .. reaction.title
    if combo then
        text ..= " + COMBO!"
        remote:FireAllClients({type = "soundCue", cue = "Boing"})
    end
    if craftedId then text ..= " (GARDEN RECIPE!)" end
    notice(text, foodInfo.color)
    remote:FireClient(player, {type = "petFeeling", text = Config.Pets[profile.petIndex].name .. ": " .. emotionText})
    warnPetCall(player,profile,activePersonality)
    sendStats(player)
    sendState()
    if #discoveries > 0 then
        local message = table.concat(discoveries, " | ")
        task.delay(1.15, function()
            if profiles[player] == profile then
                remote:FireClient(player, {type = "questToast", text = message})
            end
        end)
    end
end

local function switchPet(player: Player, rawId: any, isPurchase: boolean)
    local profile = profiles[player]
    if not profile then return end
    if not profile.loaded then
        remote:FireClient(player, {type = "notice", text = "Saving is unavailable. Pet purchases are temporarily disabled.", color = Color3.fromRGB(255, 184, 125)})
        return
    end
    local ok, message
    if isPurchase then
        metric(player,"PetCoinPurchaseAttempt")
        ok, message = Progression.buy(profile, rawId)
        if ok then metric(player,"PetCoinPurchaseSuccess") end
    else
        ok, message = Progression.equip(profile, rawId)
    end
    if ok then
        if isPurchase then
            Progression.ensurePersonality(profile, rawId, player.UserId, rng:NextInteger(1, 2147483645))
        end
        profile.dirty = true
        profile.revision += 1
        -- Buying does not auto-equip: avoids charging again when a user just switches pets.
        if not isPurchase then
            stopPetting(player, profile)
            profile.carrying = false
            if profile.pet then profile.pet:Destroy() end
            local definition = Config.Pets[profile.petIndex]
            profile.pet = World.makePet(definition.name .. "_" .. player.UserId, definition.color, definition.ear == "pointy")
            World.stylePersonality(profile.pet, profile.personalities[profile.petIndex])
            World.emotePet(profile.pet, Personality.mood(profile.personalities[profile.petIndex]), "Hello")
            movePetNearPlayer(player)
            careUpdate(player)
        end
        sendStats(player)
        sendCollection(player)
    end
    remote:FireClient(player, {type = "notice", text = message, color = if ok then Color3.fromRGB(162, 255, 201) else Color3.fromRGB(255, 182, 151)})
end

local function interactWithPet(player: Player, rawAction: any)
    if typeof(rawAction) ~= "string" or (rawAction ~= "Pet" and rawAction ~= "Play" and rawAction ~= "Comfort") then return end
    local profile = profiles[player]
    if not profile or phase == "AWAKE" then return end
    local now = os.clock()
    local answeringCall=rawAction=="Comfort" and profile.callPending==true
    if not answeringCall and now - profile.lastPetInteraction < 3.5 then return end
    local root = rootFor(player)
    if not root or not profile.pet or not profile.pet.PrimaryPart then return end
    if (root.Position - profile.pet.PrimaryPart.Position).Magnitude > Config.FEED_DISTANCE then
        remote:FireClient(player, {type = "petFeeling", text = "Come closer to your pet!"})
        return
    end
    profile.lastPetInteraction = now
    local p = profile.personalities[profile.petIndex]
    if not p then return end
    local earlierStage = Personality.bondStage(p)
    local success, message = Personality.interact(p, rawAction)
    if success then
        notifyBondMilestone(player, profile, earlierStage)
        if profile.loaded then profile.dirty = true end
        profile.revision += 1
        profile.idleAction = if rawAction == "Play" then "Jumps" elseif rawAction == "Pet" then "Cuddles" else "Naps"
        World.emotePet(profile.pet, Personality.mood(p), profile.idleAction)
        if rawAction == "Play" and p.traits.mischief > 60 then
            noise = math.min(Config.NOISE_MAX, noise + 3)
            World.burst(profile.pet.PrimaryPart.Position, Color3.fromRGB(254, 201, 121), 9, 8)
            sendState()
        elseif rawAction == "Comfort" then
            profile.callPending=false
            local before = noise
            noise = WakeRound.comfort(before,p.traits.sensitivity,p.bond)
            if p.ribbons.QuietSteps then noise=math.max(0,noise-1) end
            if before > noise then
                message ..= "  Quieted the garden by " .. (before-noise) .. "."
                sendState()
            end
            World.burst(profile.pet.PrimaryPart.Position, Color3.fromRGB(215, 175, 255), 8, 7)
        end
        sendStats(player)
        sendCollection(player)
    end
    remote:FireClient(player, {type = "petFeeling", text = Config.Pets[profile.petIndex].name .. ": " .. message})
end

local function gardenAction(player: Player, command: string, arg: any)
    local profile = profiles[player]
    if not profile then return false end
    -- The shop/menu cannot be used to hide from Giggles or mutate the
    -- persistent garden after the player has been knocked out.
    if phase == "AWAKE" or profile.knockedOut then
        remote:FireClient(player, {type = "notice",
            text = "Survive the chase first! Your garden will still be here."})
        return false
    end
    local now = os.clock()
    if now - profile.lastGardenAction < 0.23 then return end
    profile.lastGardenAction = now
    local g = profile.garden
    local ok, message, price
    local newlyDiscovered = false
    local harvestedMutation = false
    local harvestedSeed: string? = nil
    if command == "GardenHarvest" and typeof(arg) == "number" and arg == math.floor(arg)
        and arg >= 1 and arg <= GardenConfig.PLOT_COUNT then
        local plot = g.plots[arg]
        harvestedMutation = plot and plot.mutation ~= nil or false
        harvestedSeed = if plot then plot.seed else nil
    end
    if command=="GardenStyle" then
        if now-(profile.lastDecorChange or -100)<2 then return end
        profile.lastDecorChange=now
        ok,message=Garden.setStyle(g,arg)
    elseif command == "GardenMerchantBuy" then
        if not profile.loaded then
            remote:FireClient(player, {type = "notice", text = "Saving is offline. Merchant purchases are paused."})
            return
        end
        ok, message, price = SeedMerchant.buy(g, profile.coins, arg, os.time())
        if ok then profile.coins -= price end
    elseif command == "GardenBuySeed" then
        if not profile.loaded then
            remote:FireClient(player, {type = "notice", text = "Saving is offline. Seed purchases are paused.", color = Color3.fromRGB(255, 193, 130)})
            return
        end
        ok, message, price = Garden.buySeed(g, profile.coins, arg)
        if ok then profile.coins -= price end
    elseif command == "GardenPlant" then
        if typeof(arg) ~= "table" then return end
        ok, message = Garden.plant(g, arg.plot, arg.seed)
        if ok then Garden.weather(g, currentWeather, function() return rng:NextNumber() end) end
    elseif command == "GardenHarvest" then
        ok, message = Garden.harvest(g, arg)
    elseif command == "GardenFertilize" then
        if typeof(arg) ~= "table" then return end
        ok, message = Garden.fertilize(g, arg.plot, arg.fertilizer)
    elseif command == "GardenCraft" then
        ok, message = Garden.craft(g, arg)
    elseif command == "GardenAssist" then
        local root = rootFor(player)
        local home = World.gardenSpawn(player.UserId)
        local personality = profile.personalities[profile.petIndex]
        if not root or not home or not personality then return end
        if (root.Position - home).Magnitude > 31 then
            ok, message = false, "Visit your garden to ask your pet for help!"
        elseif now - profile.lastPetGardenAssist < 9 then
            ok, message = false, "Your pet needs a short break!"
        else
            ok, message = Garden.assist(g, arg, personality.traits.curiosity)
            if ok then
                profile.lastPetGardenAssist = now
                if profile.pet and profile.pet.PrimaryPart then
                    World.burst(profile.pet.PrimaryPart.Position, Color3.fromRGB(183, 246, 170), 12, 12)
                    World.emotePet(profile.pet, Personality.mood(personality), "Helpful gardener")
                end
            end
        end
    elseif command == "GardenExperiment" then
        local resultId
        ok, message, resultId, newlyDiscovered = Garden.experiment(g, arg)
    else
        return
    end
    if ok then
        if player.Character and (command=="GardenPlant" or command=="GardenHarvest" or command=="GardenFertilize") then
            if command=="GardenFertilize" then ArtLibrary.water(player.Character) end
            player.Character:SetAttribute("GardenGesture",command)
            player.Character:SetAttribute("GestureAt",workspace:GetServerTimeNow())
        end
        if command == "GardenPlant" then onceMetric(player, profile, "FirstSeedPlanted") end
        if command=="GardenHarvest" then onceMetric(player,profile,"FirstHarvest") end
        if newlyDiscovered then metric(player, "SecretRecipeFound") end
        if profile.loaded then profile.dirty = true end
        profile.revision += 1
        World.updateGarden(player.UserId, g, GardenConfig)
        sendGarden(player)
        if command == "GardenPlant" or command == "GardenHarvest" then
            local plotIndex = if command == "GardenPlant" then arg.plot else arg
            if typeof(plotIndex) == "number" then
                local spot = World.plotPosition(player.UserId, plotIndex)
                if spot then
                    local seedId = if command == "GardenHarvest" then harvestedSeed else arg.seed
                    local def = if typeof(seedId) == "string" then GardenConfig.Crops[seedId] else nil
                    GardenActionVFX.play(workspace, spot, command == "GardenHarvest",
                        if def then def.color else nil)
                end
            end
        end
        if newlyDiscovered then
            addCoins(player, 15)
            local root = rootFor(player)
            if root then World.burst(root.Position + Vector3.new(0, 3, 0), Color3.fromRGB(255, 222, 145), 22, 14) end
        end
        sendStats(player)
        if command == "GardenHarvest" then
            remote:FireClient(player, {type = "soundCue", cue = if harvestedMutation then "MutationSparkle" else "HarvestPop"})
            if phase == "SLEEP" and harvestedSeed then
                -- Unpredictable but harmless harvest surprises: crops are safe in
                -- inventory even when the monster wakes. No pay-to-win outcomes.
                local pet = profile.personalities[profile.petIndex]
                local mischief = if pet then pet.traits.mischief / 100 else 0
                local chance = 0.12 + mischief * 0.1
                if harvestedSeed == "WhisperWheat" or harvestedSeed == "GlowPumpkin"
                    or harvestedSeed == "ThunderPlum" or harvestedSeed == "Pepper" then
                    chance += 0.2
                end
                if rng:NextNumber() < chance then
                    local reactions = {
                        {text = "THE WHEAT STARTED SINGING OPERA!", cue = "ComedySting", noise = 7},
                        {text = "A PUMPKIN JUST LAUGHED AT YOUR CAT!", cue = "SuspiciousMeow", noise = 6},
                        {text = "YOUR PET SNEEZED INTO THE VEGETABLES!", cue = "RecordScratch", noise = 9},
                        {text = "THE HARVEST MADE A TINY DRAMATIC SCENE!", cue = "TinyViolin", noise = 4},
                    }
                    local incident = reactions[rng:NextInteger(1, #reactions)]
                    noise = math.min(Config.NOISE_MAX, noise + incident.noise)
                    local root = rootFor(player)
                    if root then World.burst(root.Position + Vector3.new(0, 2, 0), GardenConfig.Crops[harvestedSeed].color, 15, 10) end
                    notice(incident.text, Color3.fromRGB(255, 216, 150))
                    remote:FireAllClients({type = "soundCue", cue = incident.cue})
                    sendState()
                end
            end
        elseif newlyDiscovered then
            remote:FireClient(player, {type = "soundCue", cue = "RareDiscovery"})
        elseif command == "GardenMerchantBuy" then
            remote:FireClient(player, {type = "soundCue", cue = "ComedySting"})
        elseif command == "GardenAssist" then
            remote:FireClient(player, {type = "soundCue", cue = "WeatherChime"})
        end
    end
    remote:FireClient(player, {type = if newlyDiscovered then "questToast" else "notice", text = message, color = if ok then Color3.fromRGB(164, 255, 186) else Color3.fromRGB(255, 196, 143)})
    return ok == true
end

-- Playable farming at the actual 3D soil beds. Roblox ProximityPrompt
-- supplies keyboard, gamepad and touch interaction without needing a menu.
-- No client-provided plot coordinates, inventory or owner IDs are trusted.
World.setGardenPromptHandler(function(player: Player, ownerId: number, index: number)
    if player.UserId ~= ownerId then
        remote:FireClient(player, {type = "notice", text = "This is another gardener's plot!"})
        return
    end
    local profile = profiles[player]
    if not profile or typeof(index) ~= "number" or index ~= math.floor(index)
        or index < 1 or index > GardenConfig.PLOT_COUNT then return end
    local root = rootFor(player)
    local spot = World.plotPosition(ownerId, index)
    if not root or not spot or (root.Position - spot).Magnitude > 11 then return end
    local character = player.Character
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    if not humanoid or humanoid.Health <= 0 or profile.knockedOut then return end
    if phase == "AWAKE" then
        remote:FireClient(player, {type = "notice", text = "Run! Giggles is awake. Gardening can wait!"})
        return
    end
    local plot = profile.garden.plots[index]
    if plot then
        if os.time() >= plot.readyAt then
            gardenAction(player, "GardenHarvest", index)
        else
            local remaining = math.max(1, plot.readyAt - os.time())
            remote:FireClient(player, {
                type = "notice",
                text = GardenConfig.Crops[plot.seed].name .. " is growing — " ..
                    tostring(remaining) .. " seconds until harvest!",
            })
        end
        return
    end
    local chosen: string? = nil
    for _, seed in ipairs(GardenConfig.Order) do
        if (profile.garden.seeds[seed] or 0) > 0 then
            chosen = seed
            break
        end
    end
    if chosen then
        gardenAction(player, "GardenPlant", {plot = index, seed = chosen})
    else
        remote:FireClient(player, {
            type = "notice",
            text = "No seeds left. Open Garden to buy or collect more seeds!",
        })
    end
end)

local function useLure(player: Player, id: any)
    local profile = profiles[player]
    if not profile or typeof(id) ~= "string" then return end
    local lure = RecipeCatalog.Recipes[id]
    if not lure or lure.type ~= "lure" then return end
    if phase=="AWAKE" then
        local root=rootFor(player)
        local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if profile.knockedOut or not root or not humanoid or humanoid.Health<=0 then return end
        local forward=root.CFrame.LookVector
        local target=root.Position+Vector3.new(forward.X,0,forward.Z)*12
        if WakeRound.throwLure(decoy,profile.garden,id,os.clock(),target,Garden.consume) then
            if profile.loaded then profile.dirty=true end
            profile.revision+=1
            World.burst(target,Color3.fromRGB(255,217,128),12,9)
            remote:FireAllClients({type="soundCue",cue="Boing"})
            notice("Giggles followed the lure! Rescue a pet while he is distracted.")
            sendGarden(player)
            sendState()
        end
        return
    end
    if phase ~= "SLEEP" then
        remote:FireClient(player, {type = "notice", text = "Wait until the monster sleeps!", color = Color3.fromRGB(255, 202, 156)})
        return
    end
    if os.clock() - profile.lastLure < 10 then return end
    local root = rootFor(player)
    if not root then return end
    local ok, message = Garden.consume(profile.garden, id, "lure")
    if not ok then
        remote:FireClient(player, {type = "notice", text = message, color = Color3.fromRGB(255, 182, 136)})
        return
    end
    profile.lastLure = os.clock()
    if profile.loaded then profile.dirty = true end
    profile.revision += 1
    local effects = {
        SillyLure = {visitors = 1, noise = 11, coins = 8},
        MonsterLure = {visitors = 3, noise = 28, coins = 20},
        GlowLure = {visitors = 2, noise = 14, coins = 12},
        CloudLure = {visitors = 2, noise = 17, coins = 13},
        ThunderLure = {visitors = 4, noise = 32, coins = 25},
        RainbowLure = {visitors = 3, noise = 24, coins = 18},
    }
    local effect = effects[id]
    if not effect then return end
    local center = root.Position + root.CFrame.LookVector * 9
    World.burst(center, Color3.fromHSV(rng:NextNumber(), 0.56, 1), if effect.visitors > 2 then 26 else 17, 14)
    noiseSpot = center
    noise = math.min(Config.NOISE_MAX, noise + effect.noise)
    local visitors = effect.visitors
    for i = 1, visitors do
        local definition = Config.Pets[rng:NextInteger(1, #Config.Pets)]
        local visitor = World.makePet("Wild" .. definition.name .. "_" .. i, definition.color, definition.ear == "pointy")
        visitor.Name = "WildVisitor"
        visitor:PivotTo(CFrame.new(center + Vector3.new(i * 4 - visitors * 2, 4, -2)))
        Debris:AddItem(visitor, 8)
    end
    addCoins(player, effect.coins)
    sendGarden(player)
    sendState()
    notice(player.DisplayName .. " used " .. message .. "! WILD VISITORS!", Color3.fromRGB(192, 255, 150))
end

-- The seed forest does not rely on trust in client coordinates. Players must
-- walk to the physical cache and hold its built-in ProximityPrompt.
local function gatherSeed(player: Player, id: string)
    if phase ~= "SLEEP" then
        remote:FireClient(player, {type = "notice", text = "Explore when Giggles is sleeping!", color = Color3.fromRGB(255, 184, 134)})
        return
    end
    local profile = profiles[player]
    local found = SeedHunt.node(id)
    local root = rootFor(player)
    if not profile or not found or not root then return end
    local c = found.node
    if (root.Position - Vector3.new(c.x, 9.8, c.z)).Magnitude > 16 then return end
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local pet = profile.personalities[profile.petIndex]
    local assist = if pet then math.max(0, (pet.traits.curiosity - 50) / 1000) else 0
    local ok, message, seedKey, rarity, discovered = SeedHunt.collect(profile.garden.hunt, profile.garden.seeds, id, rng:NextNumber(), assist, os.time())
    if not ok then
        remote:FireClient(player, {type = "notice", text = message, color = Color3.fromRGB(255, 207, 142)})
        return
    end
    if profile.loaded then profile.dirty = true end
    profile.revision += 1
    onceMetric(player, profile, "FirstSeedLocated")
    if rarity == "rare" then metric(player, "RareSeedLocated") end
    festivalFinds += 1
    festivalPlayers[player] = true
    World.burst(root.Position + Vector3.new(0, 3, 0), GardenConfig.Crops[seedKey].color, if rarity == "rare" then 25 else 12, 12)
    remote:FireClient(player, {type = "seedFound", text = message, rarity = rarity, discovered = discovered, seed = seedKey})
    remote:FireClient(player, {type = "soundCue", cue = if rarity == "rare" then "RareDiscovery" else "SeedFind"})
    if discovered then addCoins(player, 12) end
    if SeedHunt.claimQuest(profile.garden.hunt, os.time()) then
        addCoins(player, 45)
        remote:FireClient(player, {type = "questToast", text = "EXPLORER QUEST! +45 COINS!"})
    end
    if festivalFinds >= X.FestivalGoal then
        ForestWorld.festival()
        notice("SEED FESTIVAL! THE WHOLE ISLAND FOUND ENOUGH SEEDS!", Color3.fromRGB(255, 230, 134))
        remote:FireAllClients({type = "soundCue", cue = "Festival"})
        for participating in pairs(festivalPlayers) do
            if profiles[participating] then addCoins(participating, X.FestivalRewardCoins) end
        end
        festivalFinds = 0
        table.clear(festivalPlayers)
    end
    sendGarden(player)
    sendState()
end

ForestWorld.build(workspace:WaitForChild("MonsterIsland"), gatherSeed)
ForestWorld.weather(currentWeather)

local function changeWeather()
    local nextId = X.WeatherOrder[rng:NextInteger(1, #X.WeatherOrder)]
    if nextId == currentWeather then
        nextId = X.WeatherOrder[(table.find(X.WeatherOrder, nextId) % #X.WeatherOrder) + 1]
    end
    currentWeather = nextId
    weatherEndsAt = os.time() + 100
    local weather = X.Weather[currentWeather]
    ForestWorld.weather(currentWeather)
    local affected = 0
    for player, profile in pairs(profiles) do
        local changed = Garden.weather(profile.garden, currentWeather, function()
            return rng:NextNumber()
        end)
        if changed > 0 then
            affected += changed
            if profile.loaded then profile.dirty = true end
            profile.revision += 1
            World.updateGarden(player.UserId, profile.garden, GardenConfig)
        end
        sendGarden(player)
    end
    noise = math.min(Config.NOISE_MAX, noise + weather.noise)
    notice(weather.icon .. " " .. weather.name .. "! " .. affected .. " growing plants affected!", weather.color)
    remote:FireAllClients({type = "soundCue", cue = if currentWeather == "GiggleStorm" then "SillyStorm" else "WeatherChime"})
    sendState()
end

remote.OnServerEvent:Connect(function(player: Player, command: any, arg: any)
    local profile = profiles[player]
    if shuttingDown or not profile or typeof(command) ~= "string" then return end
    if command == "Feed" then
        feed(player, arg)
    elseif command == "StartPetting" then
        startPetting(player)
    elseif command == "StopPetting" then
        stopPetting(player, profile)
    elseif command == "PettingPulse" then
        keepPetting(player)
    elseif command == "ToggleCarry" then
        toggleCarry(player)
    elseif command == "PetInteract" then
        interactWithPet(player, arg)
    elseif command == "GardenFeed" then
        if typeof(arg) ~= "string" then return end
        local recipe = RecipeCatalog.Recipes[arg]
        if recipe and recipe.type == "feed" then
            feed(player, recipe.baseFood, arg)
        end
    elseif command == "GardenMerchantBuy" or command == "GardenBuySeed" or command == "GardenPlant" or command == "GardenHarvest"
       or command == "GardenFertilize" or command == "GardenCraft" or command == "GardenExperiment"
       or command == "GardenAssist" or command=="GardenStyle" then
        gardenAction(player, command, arg)
    elseif command == "RescueSignal" then
        if phase == "AWAKE" and not profile.knockedOut and typeof(arg) == "table"
            and RescueObjective.signal(player, arg.round, arg.id) then
            sendState()
        end
    elseif command == "GardenLure" then
        useLure(player, arg)
    elseif command=="GardenWelcome" then
        if typeof(arg)~="boolean" or not farmOfPlayer[player] or phase=="AWAKE" then return end
        if os.clock()-profile.lastGardenAction<.5 then return end
        profile.lastGardenAction=os.clock()
        player:SetAttribute("GardenOpen",arg)
        sendGarden(player)
    elseif command == "GardenVisit" then
        if phase == "AWAKE" then
            remote:FireClient(player, {type = "notice", text = "No teleporting away from Giggles! SURVIVE!", color = Color3.fromRGB(255, 178, 135)})
            return
        end
        if os.clock() - profile.lastGardenVisit < 2 then return end
        profile.lastGardenVisit = os.clock()
        local owner=Garden.visitOwner(player,arg,Players,farmOfPlayer)
        if not owner then return end
        local spot = World.gardenSpawn(owner.UserId)
        local root = rootFor(player)
        if spot and root then
            root.CFrame = CFrame.new(spot)
            root.AssemblyLinearVelocity = Vector3.zero
        end
    elseif command == "BuyPet" or command == "EquipPet" then
        if os.clock() - profile.lastShopAction < 0.35 then return end
        profile.lastShopAction = os.clock()
        switchPet(player, arg, command == "BuyPet")
    elseif command == "TutorialDismiss" then
        if profile.tutorialSeen then return end
        profile.tutorialSeen = true
        if profile.loaded then
            profile.dirty = true
            profile.revision += 1
        end
        sendCollection(player)
    elseif command == "ClaimDaily" then
        if os.clock() - profile.lastDailyRequest < 1 then return end
        profile.lastDailyRequest = os.clock()
        if not profile.loaded then
            remote:FireClient(player, {type = "notice", text = "Daily reward unavailable: saving is offline.", color = Color3.fromRGB(255, 180, 153)})
            return
        end
        local ok, message = Progression.claimDaily(profile)
        if ok then
            addCoins(player, Config.DAILY_REWARD)
            sendCollection(player)
        end
        remote:FireClient(player, {type = "notice", text = message, color = if ok then Color3.fromRGB(154, 255, 207) else Color3.fromRGB(255, 216, 147)})
    elseif command == "Sync" then
        if os.clock() - profile.lastSync < 0.8 then return end
        profile.lastSync = os.clock()
        sendState(player)
        sendStats(player)
        sendCollection(player)
        sendGarden(player)
        careUpdate(player)
    end
end)

local function warnStrike(spot: Vector3, radius: number, strength: number, jump: boolean, delay: number, color: Color3)
    local round=wakeCount
    World.markDanger(spot,radius,color,delay)
    task.delay(delay,function()
        if wakeCount==round then monsterStrike(spot,radius,strength,jump) end
    end)
end

local function monsterAction()
    if os.clock()<decoy.untilTime then return end
    if wakeMode == "Listen" then
        local location = noiseSpot or World.monsterPosition()
        local spot = Vector3.new(location.X,10,location.Z)
        World.monsterGesture()
        notice("Giggles heard something! Step outside the blue ring.")
        warnStrike(spot,16,26,false,1.8,Color3.fromRGB(145,211,255))
        return
    end
    local choice = if wakeMode=="Garden" then 3 else rng:NextInteger(1,3)
    if wakeMode=="Chase" and choice==3 then choice=4 end
    World.monsterGesture()
    if choice == 1 then
        notice("GIGGLES STOMPS! JUMP AWAY!", Color3.fromRGB(255, 113, 146))
        local spot = Vector3.new(rng:NextNumber(-35, 35), 9, rng:NextNumber(-35, 35))
        warnStrike(spot,24,55,true,1.7,Color3.fromRGB(255,116,178))
    elseif choice == 2 then
        notice("GIANT SNEEZE! HOLD ON!", Color3.fromRGB(136, 229, 255))
        local body=World.monsterPosition()
        local epicentre=Vector3.new(body.X,12,body.Z)
        warnStrike(epicentre,22,55,false,2.0,Color3.fromRGB(122,213,255))
    elseif choice == 3 then
        notice("THE SKY IS RAINING JELLY!", Color3.fromRGB(255, 223, 114))
        for _ = 1, 3 do
            local spot = Vector3.new(rng:NextNumber(-70, 70), 11, rng:NextNumber(-70, 70))
            World.burst(spot, Color3.fromRGB(252, rng:NextInteger(130, 240), 192), 12, 12)
            warnStrike(spot,12,24,false,1.45,Color3.fromRGB(255,214,130))
        end
    else
        notice("MONSTER FART TORNADO! RUN!", Color3.fromRGB(183, 244, 154))
        local spot = Vector3.new(rng:NextNumber(-40, 40), 12, rng:NextNumber(-40, 40))
        warnStrike(spot,18,38,false,1.6,Color3.fromRGB(175,255,152))
    end
end

local function surpriseWeather()
    local choice = rng:NextInteger(1, 6)
    if choice == 4 or choice == 5 then remote:FireAllClients({type = "soundCue", cue = "RecordScratch"}) end
    if choice == 1 then
        notice("SUGAR RAIN! IT'S RAINING SPRINKLES!", Color3.fromRGB(255, 164, 205))
        for i = 1, 5 do
            local position = Vector3.new(rng:NextNumber(-60, 60), 15, rng:NextNumber(-60, 60))
            World.burst(position, Config.Foods.Candy.color, 12, 17)
        end
        noise = math.min(Config.NOISE_MAX, noise + 5)
    elseif choice == 2 then
        notice("GIGGLES SNORES LIKE A TRACTOR!", Color3.fromRGB(200, 177, 255))
        World.wave(Vector3.new(0, 11, 0), 65, Color3.fromRGB(200, 177, 255))
        noise = math.min(Config.NOISE_MAX, noise + 11)
    elseif choice == 3 then
        notice("EVERY PET: CONGA LINE!!!", Color3.fromRGB(153, 238, 212))
        for _, profile in pairs(profiles) do
            profile.effect = "Spin"
            profile.effectUntil = os.clock() + 4.5
        end
    elseif choice == 4 then
        notice("THE FLOOR JUST BURPED. WHY?!", Color3.fromRGB(255, 216, 120))
        World.wave(Vector3.new(0, 8, 0), 100, Color3.fromRGB(255, 237, 167))
        nearbyKnock(Vector3.new(0, 4, 0), 115, 14)
        noise = math.min(Config.NOISE_MAX, noise + 7)
    elseif choice == 5 then
        notice("MINI PET PARADE! LOOK AT THEM!", Color3.fromRGB(131, 220, 255))
        for _, profile in pairs(profiles) do
            if profile.pet and profile.pet.Parent then
                profile.pet:ScaleTo(0.52)
                profile.effect = "Mini"
                profile.effectUntil = os.clock() + 5
            end
        end
    else
        notice("A JELLYFISH CLOUD JUST PASSED BY...", Color3.fromRGB(255, 196, 243))
        for i = 1, 4 do
            local theta = (i / 4) * math.pi * 2
            local position = Vector3.new(math.cos(theta) * 35, 20, math.sin(theta) * 35)
            World.burst(position, Color3.fromRGB(175, 226, 255), 15, 20)
        end
    end
end

local function startWake()
    phase = "AWAKE"
    noise = Config.NOISE_MAX
    secondsLeft = Config.WAKE_SECONDS
    wakeCount += 1
    wakeMode = WakeRound.mode(wakeCount)
    for player, profile in pairs(profiles) do
        profile.trackedSeconds=0
        profile.roundPet=profile.petIndex
        if rootFor(player) then profile.enteredWake = wakeCount end
        onceMetric(player,profile,"FirstWakeSeen")
        stopPetting(player, profile)
        -- Chase mode must not leave a mobile player holding an animal
        -- with no visible button to put it down.
        if profile.carrying then
            profile.carrying = false
            careUpdate(player)
        end
        profile.hearts = 3
        profile.knockedOut = false
        profile.lastHit = -100
        local p = profile.personalities[profile.petIndex]
        if p and profile.pet then
            profile.idleAction = Personality.idle(p, true)
            World.emotePet(profile.pet, Personality.mood(p, true), profile.idleAction)
        end
        sendStats(player)
    end
    World.setMonsterAwake(true)
    World.setWakeMode(wakeMode)
    remote:FireAllClients({type = "soundCue", cue = "MonsterWake"})
    remote:FireAllClients({type="soundCue",cue=if wakeMode=="Listen" then "SuspiciousMeow" elseif wakeMode=="Garden" then "SillyStorm" else "RecordScratch"})
    notice("Giggles is awake! Follow the rescue arrow and hold SAVE ME!", Color3.fromRGB(255, 113, 145))
    World.wave(Vector3.new(0, 11, 0), 90, Color3.fromRGB(255, 104, 156))
    RescueObjective.start(function(player: Player, justCompleted: boolean, reward: number)
        local profile=profiles[player]
        local companion=profile.personalities[profile.petIndex]
        if companion then companion.rescues=math.min(1000000,companion.rescues+1) end
        onceMetric(player,profile,"FirstPetRescued")
        if justCompleted then
            local contributors={}
            for other in pairs(profiles) do
                if RescueObjective.participated(other) then table.insert(contributors,other) end
            end
            if #contributors>=2 then
                for _,other in ipairs(contributors) do
                    local teammate=profiles[other]
                    onceMetric(other,teammate,"FirstCoopRescue")
                    if not teammate.coopThisVisit then
                        teammate.coopThisVisit=true
                        metric(other,"VisitWithCoopRescue")
                    end
                end
            end
        end
        addCoins(player, reward)
        sendCollection(player)
        remote:FireClient(player,{type="rescueMoment",round=wakeCount})
        if justCompleted then
            notice("TEAM CHALLENGE COMPLETE! ALL LOST PETS ARE SAFE!", Color3.fromRGB(160, 255, 203))
            World.burst(Vector3.new(0, 52, 0), Color3.fromRGB(255, 232, 122), 30, 32)
        else
            remote:FireClient(player, {type = "questToast", text = "PET RESCUED! +" .. reward .. " COINS!"})
        end
        sendState()
    end, function(player: Player): boolean
        local profile = profiles[player]
        return phase == "AWAKE" and profile ~= nil and not profile.knockedOut
    end)
    sendState()
end

local function endWake()
    phase = "COOLDOWN"
    noise = 0
    secondsLeft = Config.COOLDOWN_SECONDS
    World.setMonsterAwake(false)
    remote:FireAllClients({type = "soundCue", cue = "Victory"})
    local teamCompleted = RescueObjective.completed()
    for _, player in ipairs(Players:GetPlayers()) do
        local profile = profiles[player]
        if profile and WakeRound.takeResult(profile,wakeCount,RescueObjective.participated(player)) then
            onceMetric(player,profile,"FirstRoundFinished")
            if profile.firstObservedVisit and not profile.firstVisitFinished then
                profile.firstVisitFinished=true
                metric(player,"FirstVisitRoundFinished")
            end
            if rootFor(player) and not profile.knockedOut then
                local ribbon=WakeRound.ribbon(wakeMode,profile.hearts,RescueObjective.participated(player),
                    profile.trackedSeconds or 0,teamCompleted)
                local companion=profile.personalities[profile.roundPet or profile.petIndex]
                if ribbon and companion and not companion.ribbons[ribbon] then
                    companion.ribbons[ribbon]=true
                    remote:FireClient(player,{type="questToast",text="New rescue ribbon in your pet diary!"})
                end
                local bonus = Progression.recordSurvival(profile)
                local rescueBonus = if teamCompleted and RescueObjective.participated(player) then RescueObjective.status().bonus else 0
                addCoins(player, Config.SURVIVAL_REWARD + bonus + rescueBonus)
                onceMetric(player, profile, "FirstBossSurvived")
                if profile.feedCount>0 then onceMetric(player,profile,"IntroComplete") end
                if rescueBonus > 0 then
                    remote:FireClient(player, {type = "questToast", text = "CO-OP HERO! +" .. rescueBonus .. " BONUS COINS!"})
                end
                if bonus > 0 then
                    task.delay(1.2, function()
                        if profiles[player] == profile then
                            remote:FireClient(player, {type = "questToast", text = "SURVIVAL QUEST COMPLETE! +" .. bonus .. " coins"})
                        end
                    end)
                end
            else
                addCoins(player, 8) -- consolation so new players can still progress
            end
            sendCollection(player)
        end
        if profile then
            profile.hearts = 3
            profile.knockedOut = false
            sendStats(player)
        end
    end
    noiseSpot = nil
    decoy.readyAt,decoy.untilTime=0,0
    RescueObjective.finish()
    notice(if teamCompleted then "GIGGLES IS ASLEEP! HEROES SAVED THE PETS!" else "GIGGLES IS ASLEEP! NEXT TIME, RESCUE THE RUNAWAYS!", Color3.fromRGB(150, 255, 204))
    sendState()
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, player)
end

local lastHeartbeat = 0
RunService.Heartbeat:Connect(function(dt: number)
    lastHeartbeat += dt
    if lastHeartbeat < 1 / 18 then return end
    local interval=lastHeartbeat
    lastHeartbeat = 0
    local nearest: Vector3? = nil
    local nearestPlayer: Player?=nil
    local nearestDistance=math.huge
    local bossPosition=World.monsterPosition()
    local t = os.clock()
    for player, profile in pairs(profiles) do
        local root = rootFor(player)
        local pet = profile.pet
        if root and root.Position.Y < -18 then
            if phase == "AWAKE" and not profile.knockedOut then
                profile.knockedOut = true
                RescueObjective.release(player)
                profile.hearts = 0
                sendStats(player)
                remote:FireClient(player, {type = "notice", text = "SPLASH! OUT FOR THIS ROUND!", color = Color3.fromRGB(152, 230, 255)})
            end
            root.CFrame = CFrame.new(0, 16, 85)
            root.AssemblyLinearVelocity = Vector3.zero
        end
        if phase=="AWAKE" and root and not profile.knockedOut then
            local distance=(root.Position-bossPosition).Magnitude
            if distance<nearestDistance then nearest,nearestDistance,nearestPlayer=root.Position,distance,player end
        end
        if root and pet and pet.Parent and pet.PrimaryPart then
            local mode=if profile.carrying then "Carry" elseif profile.petting then "Pet"
                elseif profile.idleAction=="Naps" and phase=="SLEEP" then "Nap" else "Follow"
            if pet:GetAttribute("MotionMode")~=mode then pet:SetAttribute("MotionMode",mode) end
            if profile.carrying then
                pet:PivotTo(pet:GetPivot():Lerp(World.carryPose(pet, root, t), 0.32))
                continue
            end
            local wobble = math.sin(t * 3 + player.UserId) * 0.65
            local side = root.CFrame.RightVector * 4.8
            local behind = -root.CFrame.LookVector * 3.5
            local personality = profile.personalities[profile.petIndex]
            local habit = profile.idleAction
            if personality and habit == "Hides" then
                side *= 0.45
                behind *= 1.8
            elseif habit == "Cuddles" then
                side *= 0.5
                behind *= 0.55
            end
            local bob = if habit == "Jumps" then math.abs(math.sin(t * 7)) * 2.2 elseif habit == "Naps" then wobble * 0.15 else wobble
            local target = root.Position + side + behind
            if pet:GetAttribute("Airborne") then
                target += Vector3.new(0,2.5+bob,0)
            else
                local query=profile.petGroundQuery
                if not query then
                    query=RaycastParams.new()
                    query.RespectCanCollide=true
                    profile.petGroundQuery=query
                end
                query.FilterDescendantsInstances={player.Character,pet}
                local floor=workspace:Raycast(target+Vector3.yAxis*5,-Vector3.yAxis*30,query)
                local groundY=if floor then floor.Position.Y else root.Position.Y-3
                local lift=if habit=="Jumps" then math.max(bob,0) else .04*math.abs(bob)
                target=Vector3.new(target.X,groundY+2.05*pet:GetScale()+lift,target.Z)
            end
            if (pet.PrimaryPart.Position - target).Magnitude > 60 then
                pet:PivotTo(CFrame.new(target))
            else
                local toward=Vector3.new(root.Position.X,target.Y,root.Position.Z)
                local facing=if (toward-target).Magnitude>.01 then CFrame.lookAt(target,toward) else CFrame.new(target)
                if profile.effect == "Spin" and profile.effectUntil > t then
                    facing *= CFrame.Angles(0, t * 11, 0)
                elseif personality and (habit == "Dances" or habit == "ChasesTail") and profile.effectUntil < t then
                    facing *= CFrame.Angles(0, math.sin(t * 4) * 0.65, 0)
                elseif profile.effect == "Bounce" and profile.effectUntil > t then
                    facing += Vector3.new(0, math.abs(math.sin(t * 9)) * 3, 0)
                end
                pet:PivotTo(pet:GetPivot():Lerp(facing, 0.15))
            end
            if profile.effectUntil <= t and profile.effect ~= "" then
                profile.effect = ""
                pet:ScaleTo(1)
                World.tintPet(pet, Config.Pets[profile.petIndex].color)
            end
        end
    end
    local destination=nearest
    if phase=="AWAKE" and wakeMode=="Listen" then destination=noiseSpot end
    if wakeMode=="Garden" then destination=nil end
    if phase=="AWAKE" and t<decoy.untilTime then destination=decoy.position end
    if phase=="AWAKE" and wakeMode=="Chase" and nearestPlayer and nearest and t>=decoy.untilTime then
        local delta=nearest-bossPosition
        if delta.X*delta.X+delta.Z*delta.Z<=40*40 then
            local tracked=profiles[nearestPlayer]
            if tracked then tracked.trackedSeconds=(tracked.trackedSeconds or 0)+math.min(interval,.2) end
        end
    end
    World.followMonster(destination,interval)
end)

task.spawn(function()
    while true do
        task.wait(3)
        if os.time() >= weatherEndsAt then changeWeather() end
    end
end)

task.spawn(function()
    local actionCooldown = 0
    local surpriseCooldown = rng:NextInteger(17, 29)
    while true do
        task.wait(1)
        if not next(profiles) and phase=="SLEEP" then
            secondsLeft=Config.SLEEP_MAX_SECONDS
            noiseAlarm=nil
            World.setStirring(false)
            noise=0
            noiseSpot=nil
            continue
        end
        secondsLeft = math.max(0, secondsLeft - 1)
        if phase == "SLEEP" then
            surpriseCooldown -= 1
            if surpriseCooldown <= 0 and noise < Config.NOISE_MAX then
                surpriseWeather()
                surpriseCooldown = rng:NextInteger(19, 33)
            end
            local _, wakeIn = sleepWarning()
            if wakeIn == 0 then
                actionCooldown=4
                startWake()
            end
        elseif phase == "AWAKE" then
            actionCooldown -= 1
            if actionCooldown <= 0 and secondsLeft > 2 then
                monsterAction()
                actionCooldown = rng:NextInteger(4, 6)
            end
            if secondsLeft <= 0 then
                endWake()
            end
        elseif phase == "COOLDOWN" then
            if secondsLeft <= 0 then
                phase = "SLEEP"
                secondsLeft = Config.SLEEP_MAX_SECONDS
                notice("Shhh... Giggles is sleeping. Feed your pets!", Color3.fromRGB(180, 255, 222))
            end
        end
        sendState()
    end
end)

-- Garden incidents tie the peaceful farming loop to the main chaos meter.
-- Cosmetic-only plants: never delete a player's crops during a surprise event.
task.spawn(function()
    while true do
        task.wait(56)
        if phase ~= "SLEEP" then continue end
        local eligible = {}
        for player, profile in pairs(profiles) do
            if rootFor(player) then
                for _, plot in ipairs(profile.garden.plots) do
                    if plot and GardenConfig.Crops[plot.seed] then
                        table.insert(eligible, {player = player, profile = profile, plot = plot})
                        break
                    end
                end
            end
        end
        if #eligible == 0 then continue end
        local chosen = eligible[rng:NextInteger(1, #eligible)]
        local home = World.gardenSpawn(chosen.player.UserId)
        if not home then continue end
        local id = rng:NextInteger(1, 5)
        local emotion = chosen.profile.personalities[chosen.profile.petIndex]
        local name = GardenConfig.Crops[chosen.plot.seed].name
        local announcement
        local incidentNoise
        if id == 1 then
            announcement, incidentNoise = name .. " started SINGING OPERA! Cover your ears!", 9
        elseif id == 2 then
            announcement, incidentNoise = chosen.player.DisplayName .. "'s veggies did a DANCE BATTLE!", 7
        elseif id == 3 then
            announcement, incidentNoise = "A GIANT CARROT JUST SNEEZED IN THE GARDEN!", 11
        elseif id == 4 then
            announcement, incidentNoise = "A watermelon yelled MEOW! Even the cats look confused!", 8
        else
            announcement, incidentNoise = "THE SUNFLOWERS ARE GOSSIPING ABOUT GIGGLES!", 6
        end
        if emotion and emotion.temperament == "Mischievous" then incidentNoise += 3 end
        notice("🌿 " .. announcement, Color3.fromRGB(229, 218, 141))
        World.burst(home + Vector3.new(0, 2, 0), GardenConfig.Crops[chosen.plot.seed].color, 22, 14)
        World.wave(home, 14, Color3.fromRGB(255, 215, 157))
        noise = math.min(Config.NOISE_MAX, noise + incidentNoise)
        remote:FireAllClients({type = "soundCue", cue = if id == 1 or id == 4 then "SillyStorm" else "Boing"})
        sendState()
    end
end)

task.spawn(function()
    while true do
        task.wait(8)
        for player, profile in pairs(profiles) do
            World.updateGarden(player.UserId, profile.garden, GardenConfig)
            sendGarden(player)
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(Affection.TickSeconds)
        for player, profile in pairs(profiles) do
            if not profile.petting then continue end
            local t = os.clock()
            local root = rootFor(player)
            local character = player.Character
            local hum = if character then character:FindFirstChildOfClass("Humanoid") else nil
            local pet = profile.pet
            local session = profile.pettingSession
            if not root or not hum or hum.Health <= 0 or not pet or not pet.PrimaryPart
                or not session or phase ~= "SLEEP"
                or t - profile.lastCarePulse > Affection.KeepaliveSeconds
                or (root.Position - pet.PrimaryPart.Position).Magnitude > Affection.PetDistance then
                stopPetting(player, profile)
                continue
            end
            local personality = profile.personalities[profile.petIndex]
            if not personality then stopPetting(player, profile) continue end
            local oldBond = Personality.bondStage(personality)
            local outcome = Affection.step(personality, session, Affection.TickSeconds, rng:NextNumber())
            if outcome.noise > 0 then noiseSpot = pet.PrimaryPart.Position end
            noise = math.min(Config.NOISE_MAX, noise + outcome.noise)
            profile.purr = outcome.purr
            if profile.loaded then profile.dirty = true end
            profile.revision += 1
            World.setPurr(pet, outcome.purr, Config.PurrSoundId)
            local stage = math.floor(outcome.purr * 5 + 0.01)
            if stage ~= profile.purrStage then
                profile.purrStage = stage
                if session.cat and stage >= 1 then
                    World.emotePet(pet, "Happy", "PURR " .. string.rep("♥", stage))
                    if stage >= 3 then
                        World.burst(pet.PrimaryPart.Position, Color3.fromRGB(255, 200, 223), 6, 7)
                    end
                else
                    World.emotePet(pet, Personality.mood(personality), "Pet me")
                end
            end
            if outcome.event == "Purring" then
                notice(player.DisplayName .. "'s kitty started PURRING... shhh!", Color3.fromRGB(255, 191, 219))
            elseif outcome.event == "Purrquake" then
                notice("PURR-QUAKE! That cat is LOUD!", Color3.fromRGB(255, 143, 187))
                remote:FireAllClients({type = "soundCue", cue = "Boing"})
                World.wave(pet.PrimaryPart.Position, 9, Color3.fromRGB(255, 177, 210))
            elseif outcome.event == "Swat" or outcome.event == "Hiss" or outcome.event == "Zoomies" or outcome.event == "Hides" then
                notice(Config.Pets[profile.petIndex].name .. " says NO MORE PETTING! " .. string.upper(outcome.event) .. "!", Color3.fromRGB(255, 180, 122))
                remote:FireAllClients({type = "soundCue", cue = "SuspiciousMeow"})
                World.burst(pet.PrimaryPart.Position, Color3.fromRGB(251, 171, 142), 12, 9)
                profile.carrying = false
                profile.idleAction = if outcome.event == "Zoomies" then "Jumps" elseif outcome.event == "Hides" then "Hides" else "MakesFaces"
            elseif outcome.event == "NeedsRest" then
                remote:FireClient(player, {type = "petFeeling", text = "Your pet needs a little break from cuddles."})
            end
            notifyBondMilestone(player, profile, oldBond)
            if outcome.done then
                stopPetting(player, profile)
            else
                careUpdate(player)
            end
            if outcome.noise > 0 then sendState() end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(25)
        for player, profile in pairs(profiles) do
            local p = profile.personalities[profile.petIndex]
            if p then
                profile.idleAction = Personality.tick(p, phase == "AWAKE")
                if profile.loaded then profile.dirty = true end
                profile.revision += 1
                if profile.pet and profile.pet.Parent then
                    World.emotePet(profile.pet, Personality.mood(p, phase == "AWAKE"), profile.idleAction)
                end
                sendStats(player)
                sendCollection(player)
            end
        end
        if phase == "SLEEP" then
            -- At most one social incident every 25 seconds, no reward farming.
            local active = Players:GetPlayers()
            local socialDone = false
            for first = 1, #active do
                if socialDone then break end
                local pa = active[first]
                local a = profiles[pa]
                local ra = rootFor(pa)
                if not a or not ra or not a.pet or not a.pet.PrimaryPart then continue end
                for second = first + 1, #active do
                    local pb = active[second]
                    local b = profiles[pb]
                    local rb = rootFor(pb)
                    if not b or not rb or not b.pet or not b.pet.PrimaryPart then continue end
                    if (ra.Position - rb.Position).Magnitude > 28 then continue end
                    local petA = a.personalities[a.petIndex]
                    local petB = b.personalities[b.petIndex]
                    if not petA or not petB then continue end
                    local encounter = Personality.meet(petA, petB)
                    a.revision += 1
                    b.revision += 1
                    if a.loaded then a.dirty = true end
                    if b.loaded then b.dirty = true end
                    World.emotePet(a.pet, Personality.mood(petA), encounter.kind)
                    World.emotePet(b.pet, Personality.mood(petB), encounter.kind)
                    local middle = (ra.Position + rb.Position) / 2 + Vector3.new(0, 3, 0)
                    World.burst(middle, Config.Pets[a.petIndex].color, 12, 12)
                    noise = math.min(Config.NOISE_MAX, noise + encounter.noise)
                    notice(Config.Pets[a.petIndex].name .. " & " .. Config.Pets[b.petIndex].name .. " " .. encounter.title, Color3.fromRGB(255, 210, 145))
                    if encounter.kind == "Prank" or encounter.kind == "DramaDuel" then
                        remote:FireAllClients({type = "soundCue", cue = "RecordScratch"})
                    elseif encounter.kind == "Singing" or encounter.kind == "DanceOff" then
                        remote:FireAllClients({type = "soundCue", cue = "ComedySting"})
                    elseif encounter.kind == "NapTogether" then
                        remote:FireAllClients({type = "soundCue", cue = "TinyViolin"})
                    end
                    sendStats(pa)
                    sendStats(pb)
                    sendCollection(pa)
                    sendCollection(pb)
                    sendState()
                    socialDone = true
                    break
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(90)
        for player in pairs(profiles) do save(player) end
    end
end)

game:BindToClose(function()
    shuttingDown = true
    for player in pairs(profiles) do
        task.spawn(onPlayerRemoving, player)
    end
    -- Save different players concurrently within Roblox's shutdown window.
    local deadline = os.clock() + 25
    while (next(profiles) or next(closingProfiles) or next(loading)) and os.clock() < deadline do
        task.wait(0.05)
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="15">
      <Properties>
        <string name="Name">Garden</string>
        <string name="Source"><![CDATA[--!strict
-- Server-only, deterministic gardening rules.
-- Recipe ingredients are defined in ServerScriptService/RecipeCatalog and
-- only recipes actually discovered by this player are sent to the client.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local G = require(ReplicatedStorage:WaitForChild("GardenConfig"))
local SeedMerchant = require(ReplicatedStorage:WaitForChild("SeedMerchant"))
local Catalog = require(script.Parent:WaitForChild("RecipeCatalog"))
local Hunt = require(script.Parent:WaitForChild("SeedHunt"))
local X = require(ReplicatedStorage:WaitForChild("ExpeditionConfig"))
local Garden = {}

local function clampCount(value: any): number
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then return 0 end
    return math.clamp(math.floor(value), 0, G.MAX_STACK)
end

local function plotNumber(value: any): number?
    if type(value) ~= "number" or value ~= math.floor(value) or value < 1 or value > G.PLOT_COUNT then return nil end
    return value
end

local function validSeed(value: any): boolean
    return type(value) == "string" and G.Crops[value] ~= nil
end

local function recipeOutput(g: any, id: string)
    local recipe = Catalog.Recipes[id]
    if recipe.type == "fertilizer" then return g.fertilizer end
    return g.crafted
end

local function matchesRecipe(ingredients: {[string]: number}, counts: {[string]: number}): boolean
    for key, count in pairs(ingredients) do
        if counts[key] ~= count then return false end
    end
    for key, count in pairs(counts) do
        if ingredients[key] ~= count then return false end
    end
    return true
end

local function availableCrops(g: any, counts: {[string]: number}): boolean
    for key, count in pairs(counts) do
        if not validSeed(key) or count < 1 or (g.crops[key] or 0) < count then return false end
    end
    return true
end

local function subtract(g: any, counts: {[string]: number})
    for key, count in pairs(counts) do g.crops[key] -= count end
end

local function addProduct(g: any, id: string): (boolean, string)
    local recipe = Catalog.Recipes[id]
    local target = recipeOutput(g, id)
    if (target[id] or 0) > G.MAX_STACK - recipe.produces then
        return false, "Your crafted storage is full"
    end
    target[id] = (target[id] or 0) + recipe.produces
    return true, "CRAFTED " .. recipe.produces .. "× " .. recipe.name
end

function Garden.new()
    local plots = {}
    for i = 1, G.PLOT_COUNT do plots[i] = false end
    local seeds = {}
    for key, count in pairs(G.DEFAULT_SEEDS) do seeds[key] = count end
    return {
        style = "Meadow",
        plots = plots,
        seeds = seeds,
        crops = {},
        crafted = {},
        fertilizer = {Compost = 1},
        known = {},
        experiments = 0,
        flops = 0,
        hunt = Hunt.new(),
        merchant = {rotation = -1, slots = {}},
    }
end

function Garden.load(raw: any)
    local g = Garden.new()
    if type(raw) ~= "table" then return g end
    if table.find(G.GardenStyles,raw.style) then g.style=raw.style end
    for _, field in ipairs({"seeds", "crops", "crafted", "fertilizer"}) do
        if type(raw[field]) == "table" then
            if field == "seeds" then g.seeds = {} end
            for key, value in pairs(raw[field]) do
                local allowed = false
                if field == "seeds" or field == "crops" then
                    allowed = validSeed(key)
                elseif field == "fertilizer" then
                    allowed = G.Fertilizers[key] ~= nil
                else
                    allowed = Catalog.Recipes[key] ~= nil and Catalog.Recipes[key].type ~= "fertilizer"
                end
                if allowed then g[field][key] = clampCount(value) end
            end
        end
    end
    -- Per-rotation purchase flags are persisted to prevent rejoin farming.
    if type(raw.merchant) == "table" and type(raw.merchant.rotation) == "number"
        and raw.merchant.rotation == math.floor(raw.merchant.rotation)
        and raw.merchant.rotation >= 0 and raw.merchant.rotation <= SeedMerchant.rotation(os.time()) then
        g.merchant.rotation = raw.merchant.rotation
        if type(raw.merchant.slots) == "table" then
            for i = 1, SeedMerchant.OfferCount do
                g.merchant.slots[i] = raw.merchant.slots[i] == true
            end
        end
    end
    if type(raw.plots) == "table" then
        for i = 1, G.PLOT_COUNT do
            local p = raw.plots[i]
            if type(p) == "table" and validSeed(p.seed) then
                local plantTime = if type(p.plantedAt) == "number" then math.floor(p.plantedAt) else 0
                local readyTime = if type(p.readyAt) == "number" then math.floor(p.readyAt) else 0
                local now = os.time()
                if plantTime >= 0 and plantTime <= now + 60 and readyTime >= plantTime and readyTime <= now + 86400 * 4 then
                    g.plots[i] = {seed = p.seed, plantedAt = plantTime, readyAt = readyTime, fertilized = p.fertilized == true, weatherBoosted = p.weatherBoosted == true, assistUsed = p.assistUsed == true, mutation = if type(p.mutation) == "string" and (p.mutation == "Golden" or p.mutation == "Dewy" or p.mutation == "Moonlit" or p.mutation == "Giggly") then p.mutation else nil}
                end
            end
        end
    end
    -- Existing v0.3 players had a visible recipe list. After upgrading, the
    -- book intentionally starts empty unless discoveries were saved in v0.4.
    if type(raw.knownRecipes) == "table" then
        for _, key in ipairs(raw.knownRecipes) do
            if type(key) == "string" and Catalog.Recipes[key] and key ~= "MysterySlop" then
                g.known[key] = true
            end
        end
    end
    g.experiments = clampCount(raw.experiments)
    g.flops = clampCount(raw.flops)
    g.hunt = Hunt.load(raw.hunt)
    return g
end

function Garden.serialize(g: any)
    local plots = {}
    for i = 1, G.PLOT_COUNT do
        local p = g.plots[i]
        plots[i] = if p then {seed = p.seed, plantedAt = p.plantedAt, readyAt = p.readyAt, fertilized = p.fertilized, mutation = p.mutation, weatherBoosted = p.weatherBoosted, assistUsed = p.assistUsed} else false
    end
    local knownRecipes = {}
    for _, id in ipairs(Catalog.Order) do
        if g.known[id] then table.insert(knownRecipes, id) end
    end
    return {
        style = g.style,
        plots = plots,
        seeds = table.clone(g.seeds),
        crops = table.clone(g.crops),
        crafted = table.clone(g.crafted),
        fertilizer = table.clone(g.fertilizer),
        knownRecipes = knownRecipes,
        experiments = math.min(G.MAX_STACK, g.experiments),
        flops = math.min(G.MAX_STACK, g.flops),
        hunt = Hunt.snapshot(g.hunt),
        merchant = {rotation = g.merchant.rotation, slots = table.clone(g.merchant.slots)},
    }
end

-- Only existing, publicly welcoming hosts in this server can be destinations.
-- Ordinary visits use the caller's own garden. A client never supplies a CFrame.
function Garden.visitOwner(visitor: any, requested: any, players: any, slots: any): any?
    if requested==nil then return if slots[visitor] then visitor else nil end
    if type(requested)~="number" or requested~=math.floor(requested)
        or requested<=0 or requested>9007199254740991 then return nil end
    local host=players:GetPlayerByUserId(requested)
    if not host or not slots[host] or host:GetAttribute("GardenOpen")~=true then return nil end
    return host
end

function Garden.setStyle(g: any, style: any): (boolean,string)
    if type(style)~="string" or not table.find(G.GardenStyles,style) then return false,"Unknown garden style" end
    if g.style==style then return false,"Already using "..style end
    g.style=style
    return true,style.." garden ready"
end

function Garden.snapshot(g: any)
    local result = Garden.serialize(g)
    -- Only transmit recipe ingredients that the player has ACTUALLY discovered.
    -- Other ingredient combinations never leave the server.
    local book = {}
    for _, id in ipairs(Catalog.Order) do
        if g.known[id] then
            local recipe = Catalog.Recipes[id]
            table.insert(book, {
                id = id,
                name = recipe.name,
                icon = recipe.icon,
                produces = recipe.produces,
                ingredients = table.clone(recipe.ingredients),
                type = recipe.type,
            })
        end
    end
    local products = {}
    for id, count in pairs(g.crafted) do
        if count > 0 and Catalog.Recipes[id] then
            local recipe = Catalog.Recipes[id]
            table.insert(products, {id = id, name = recipe.name, icon = recipe.icon, type = recipe.type, amount = count})
        end
    end
    table.sort(products, function(a, b) return a.name < b.name end)
    result.book = book
    result.products = products
    result.knownRecipes = nil -- do not expose internal saved format to the UI
    result.totalRecipes = #Catalog.Order
    result.serverTime = os.time()
    -- Collection album: only discovered seeds and mutations, no secret recipes.
    result.seedAlbum = table.clone(g.hunt.discovered)
    result.mutationAlbum = table.clone(g.hunt.mutations)
    result.forageTotal = g.hunt.totalFinds
    result.forageToday = g.hunt.questFinds
    result.merchantShop = SeedMerchant.snapshot(os.time(), g.merchant)
    result.merchant = nil -- hide internal persistence format
    result.forageClaimed = g.hunt.questClaimed
    return result
end

function Garden.buySeed(g: any, coins: number, key: any): (boolean, string, number)
    if not validSeed(key) then return false, "Unknown seed", 0 end
    local crop = G.Crops[key]
    if crop.kind == "premium" then
        return false, "Premium seed not for sale yet. No payment taken.", 0
    end
    if coins < crop.coins then return false, "Need " .. (crop.coins - coins) .. " more coins!", 0 end
    if (g.seeds[key] or 0) > G.MAX_STACK - G.SEED_PACK_SIZE then return false, "Seed storage is full", 0 end
    g.seeds[key] = (g.seeds[key] or 0) + G.SEED_PACK_SIZE
    return true, "+3 " .. crop.name .. " seeds", crop.coins
end

function Garden.plant(g: any, index: any, key: any): (boolean, string)
    local n = plotNumber(index)
    if not n or not validSeed(key) then return false, "Invalid plot or seed" end
    if g.plots[n] then return false, "Harvest this plot first!" end
    if (g.seeds[key] or 0) < 1 then return false, "No seeds. Buy or craft more!" end
    local now = os.time()
    g.seeds[key] -= 1
    g.plots[n] = {seed = key, plantedAt = now, readyAt = now + G.Crops[key].seconds, fertilized = false, weatherBoosted = false, assistUsed = false}
    return true, G.Crops[key].name .. " is growing!"
end

function Garden.harvest(g: any, index: any): (boolean, string)
    local n = plotNumber(index)
    if not n then return false, "Invalid garden plot" end
    local p = g.plots[n]
    if not p then return false, "This plot is empty" end
    if os.time() < p.readyAt then
        return false, "Not ripe! " .. math.max(1, p.readyAt - os.time()) .. " seconds left"
    end
    local amount = G.Crops[p.seed].yield * (if p.mutation then X.MutationBonus else 1)
    if (g.crops[p.seed] or 0) > G.MAX_STACK - amount then return false, "Crop storage is full" end
    g.crops[p.seed] = (g.crops[p.seed] or 0) + amount
    if p.mutation then g.hunt.mutations[p.mutation] = true end
    g.plots[n] = false
    return true, "+" .. amount .. " " .. (if p.mutation then p.mutation .. " " else "") .. G.Crops[p.seed].name
end

function Garden.fertilize(g: any, index: any, key: any): (boolean, string)
    local n = plotNumber(index)
    if not n or type(key) ~= "string" or not G.Fertilizers[key] then return false, "Invalid fertilizer or plot" end
    local p = g.plots[n]
    if not p then return false, "Plant something first!" end
    if p.fertilized then return false, "Already fertilized!" end
    if (g.fertilizer[key] or 0) < 1 then return false, "Craft this fertilizer first!" end
    local remaining = math.max(0, p.readyAt - os.time())
    if remaining < 1 then return false, "Already ripe; harvest it!" end
    g.fertilizer[key] -= 1
    p.readyAt = os.time() + math.max(1, math.floor(remaining * G.Fertilizers[key].modifier))
    p.fertilized = true
    return true, G.Fertilizers[key].name .. " sped up growth!"
end

-- The client submits 2-3 crop IDs ONLY; the server resolves an exact recipe.
-- Failures cost the ingredients, but ALWAYS create a funny Oops Soup, so
-- experimentation provides something useful instead of an empty punishment.
function Garden.experiment(g: any, slots: any): (boolean, string, string?, boolean)
    if type(slots) ~= "table" then return false, "Select 2 or 3 crops to mix", nil, false end
    local count = #slots
    if count < 2 or count > 3 then return false, "Mix 2 or 3 ingredients", nil, false end
    for key in pairs(slots) do
        if type(key) ~= "number" or key < 1 or key > count or key ~= math.floor(key) then
            return false, "Invalid mixing ingredients", nil, false
        end
    end
    local counts: {[string]: number} = {}
    for i = 1, count do
        local key = slots[i]
        if not validSeed(key) then return false, "Unknown ingredient", nil, false end
        counts[key] = (counts[key] or 0) + 1
    end
    if not availableCrops(g, counts) then return false, "Harvest the selected ingredients first!", nil, false end
    local matched = "MysterySlop"
    for _, id in ipairs(Catalog.Order) do
        if matchesRecipe(Catalog.Recipes[id].ingredients, counts) then
            matched = id
            break
        end
    end
    local recipe = Catalog.Recipes[matched]
    local output = recipeOutput(g, matched)
    if (output[matched] or 0) > G.MAX_STACK - recipe.produces then
        return false, "Crafted inventory is full!", nil, false
    end
    subtract(g, counts)
    g.experiments = math.min(G.MAX_STACK, g.experiments + 1)
    output[matched] = (output[matched] or 0) + recipe.produces
    if matched == "MysterySlop" then
        g.flops = math.min(G.MAX_STACK, g.flops + 1)
        return true, "OH NO! Your mixture turned into OOPS SOUP! Feed it to your pet!", matched, false
    end
    if not g.known[matched] then
        g.known[matched] = true
        return true, "NEW RECIPE DISCOVERED: " .. recipe.name .. "! Added to your book!", matched, true
    end
    return true, "You made " .. recipe.produces .. "× " .. recipe.name .. " again!", matched, false
end

function Garden.craft(g: any, id: any): (boolean, string)
    if type(id) ~= "string" or not Catalog.Recipes[id] or not g.known[id] then
        return false, "Discover the recipe through mixing first!"
    end
    local recipe = Catalog.Recipes[id]
    local output = recipeOutput(g, id)
    if (output[id] or 0) > G.MAX_STACK - recipe.produces then return false, "Crafting storage full" end
    if not availableCrops(g, recipe.ingredients) then return false, "Not enough harvested ingredients!" end
    subtract(g, recipe.ingredients)
    return addProduct(g, id)
end

function Garden.consume(g: any, id: any, wantedType: string): (boolean, string)
    if type(id) ~= "string" or not Catalog.Recipes[id] or Catalog.Recipes[id].type ~= wantedType then
        return false, "Invalid crafted item"
    end
    if (g.crafted[id] or 0) < 1 then return false, "Craft this first!" end
    g.crafted[id] -= 1
    return true, Catalog.Recipes[id].name
end

-- Apply the current weather only to living plants, at most once per plot.
function Garden.weather(g: any, weatherId: string, makeRoll: () -> number): number
    if not X.Weather[weatherId] then return 0 end
    local changed = 0
    local now = os.time()
    for i = 1, G.PLOT_COUNT do
        local plot = g.plots[i]
        if plot and Hunt.mutatePlot(plot, weatherId, makeRoll(), now) then changed += 1 end
    end
    return changed
end

function Garden.assist(g: any, plotNumberValue: any, curiosity: number): (boolean, string)
    local index = plotNumber(plotNumberValue)
    if not index then return false, "Invalid garden plot" end
    local plot = g.plots[index]
    if not plot then return false, "Plant something first!" end
    if plot.assistUsed then return false, "Your pet already helped this plant!" end
    local now = os.time()
    if now >= plot.readyAt then return false, "Already ripe!" end
    local boost = math.clamp(0.12 + math.clamp(curiosity, 0, 100) / 100 * 0.18, 0.12, 0.30)
    plot.readyAt = now + math.max(1, math.floor((plot.readyAt - now) * (1 - boost)))
    plot.assistUsed = true
    return true, "Your pet helped the plant grow " .. math.floor(boost * 100) .. "% faster!"
end

return Garden
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="16">
      <Properties>
        <string name="Name">GardenActionVFX</string>
        <string name="Source"><![CDATA[--!strict
-- Tactile, warm farm feedback for actual server-approved crop interactions.
-- Original geometry: painted leaves, petals and a restrained dust puff.
-- No neon spheres, marketplace assets, or hard collisions.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local GardenFX = {}
local FOLIAGE = Color3.fromRGB(94, 156, 88)
local FOLIAGE_LIT = Color3.fromRGB(183, 205, 118)
local PALE_FLOWER = Color3.fromRGB(255, 244, 212)
local SOIL = Color3.fromRGB(179, 133, 97)
local lifetime = 1.35

local function shard(parent: Instance, at: Vector3, tint: Color3,
    size: Vector3, direction: Vector3, spin: number)
    local p = Instance.new("WedgePart")
    p.Name = "GardenLeafConfetti"
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.SmoothPlastic
    p.Size = size
    p.Color = tint
    p.Transparency = 0.07
    p.CFrame = CFrame.new(at) * CFrame.Angles(0, spin, -0.19)
    p.Parent = parent
    TweenService:Create(p, TweenInfo.new(lifetime, Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out), {
        CFrame = CFrame.new(at + direction) * CFrame.Angles(
            math.rad(95), spin + math.rad(190), math.rad(28)),
        Transparency = 1,
        Size = Vector3.new(size.X * 0.38, size.Y, size.Z * 0.46),
    }):Play()
    Debris:AddItem(p, lifetime + 0.15)
end

function GardenFX.play(parent: Instance, position: Vector3,
    isHarvest: boolean, fruitColor: Color3?)
    local total = if isHarvest then 13 else 8
    local color = fruitColor or FOLIAGE
    for i = 1, total do
        local angle = (i / total) * math.pi * 2 + (i % 3) * 0.12
        local radius = if isHarvest then 2.7 else 1.45
        local lift = if isHarvest then 2.5 else 1.3
        local tint = if i % 5 == 0 then PALE_FLOWER
            elseif i % 3 == 0 then FOLIAGE_LIT
            elseif i % 2 == 0 then FOLIAGE
            elseif isHarvest then color else SOIL
        local start = position + Vector3.new(
            math.cos(angle) * 0.36, 0.34 + (i % 3) * 0.11,
            math.sin(angle) * 0.36)
        local movement = Vector3.new(
            math.cos(angle) * radius, lift + (i % 3) * 0.25,
            math.sin(angle) * radius)
        shard(parent, start, tint,
            Vector3.new(0.31 + (i % 3) * 0.07, 0.045, 0.61),
            movement, angle)
    end
end

return GardenFX
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="17">
      <Properties>
        <string name="Name">GardenCosmetic</string>
        <string name="Source"><![CDATA[--!strict
-- Permanent cosmetic ownership stays with Roblox. The grant is a boolean and
-- repeated delivery never increments inventory, coins or crop yields.
local Cosmetic = {Enabled=false, PassId=0}

function Cosmetic.owns(market: any, userId: number, enabled: boolean, passId: number): boolean?
    if not enabled or passId<=0 then return false end
    local ok,result=pcall(function() return market:UserOwnsGamePassAsync(userId,passId) end)
    if not ok then return nil end
    return result==true
end

return Cosmetic
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="18">
      <Properties>
        <string name="Name">MonsterWakeVFX</string>
        <string name="Source"><![CDATA[--!strict
-- Original Roblox Studio VFX for the monster's wake-up moment.
-- Uses native ParticleEmitters, curved Beams, Lighting, TweenService and Debris.
-- No externally uploaded textures or paid marketplace assets required.
-- This is a genuine runtime effect; quality must still be evaluated in Studio.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")

local VFX = {}
local TAU = math.pi * 2
local BLUSH = Color3.fromRGB(255, 166, 185)
local APRICOT = Color3.fromRGB(255, 215, 161)
local WISTERIA = Color3.fromRGB(171, 144, 230)
local LILAC = Color3.fromRGB(220, 190, 255)

local function hiddenAnchor(parent: Instance, position: Vector3): Part
    local p = Instance.new("Part")
    p.Name = "WakeFX_Anchor"
    p.Size = Vector3.new(0.2, 0.2, 0.2)
    p.CFrame = CFrame.new(position)
    p.Anchored = true
    p.Transparency = 1
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Parent = parent
    return p
end

local function ease(duration: number, target: Instance, properties: {[string]: any})
    TweenService:Create(target, TweenInfo.new(duration, Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out), properties):Play()
end

local function motes(parent: Instance, position: Vector3, count: number,
    tint: Color3, upward: boolean)
    local p = hiddenAnchor(parent, position)
    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "WakeFX_Stardust"
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, APRICOT),
        ColorSequenceKeypoint.new(0.4, tint),
        ColorSequenceKeypoint.new(1, LILAC),
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.25),
        NumberSequenceKeypoint.new(0.25, 0.05),
        NumberSequenceKeypoint.new(0.75, 0.40),
        NumberSequenceKeypoint.new(1, 1),
    })
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.22),
        NumberSequenceKeypoint.new(0.25, 1.2),
        NumberSequenceKeypoint.new(1, 0),
    })
    emitter.Speed = NumberRange.new(12, 30)
    emitter.Drag = 2.8
    emitter.Rate = 0
    emitter.Lifetime = NumberRange.new(0.75, 1.5)
    emitter.Rotation = NumberRange.new(0, 360)
    emitter.RotSpeed = NumberRange.new(-100, 100)
    emitter.SpreadAngle = Vector2.new(180, 180)
    emitter.Acceleration = if upward then Vector3.new(0, 19, 0)
        else Vector3.new(0, 2, 0)
    emitter.LightEmission = 0.45
    emitter.ZOffset = 0
    emitter.Parent = p
    emitter:Emit(count)
    Debris:AddItem(p, 3.3)
end

local function lightBloom(parent: Instance, position: Vector3, color: Color3)
    local source = hiddenAnchor(parent, position)
    local light = Instance.new("PointLight")
    light.Name = "WakeFX_Light"
    light.Color = color
    light.Shadows = false
    light.Range = 48
    light.Brightness = 0
    light.Parent = source
    ease(0.23, light, {Brightness = 2.8, Range = 75})
    task.delay(0.32, function()
        if light.Parent then ease(0.8, light, {Brightness = 0, Range = 20}) end
    end)
    Debris:AddItem(source, 1.8)
end

local function ribbon(parent: Instance, center: Vector3, angle: number,
    radius: number, length: number, height: number, color: Color3, index: number)
    local p = hiddenAnchor(parent, center)
    local a = Instance.new("Attachment")
    a.Name = "WakeFX_RibbonBegin"
    a.Position = Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
    a.Parent = p
    local b = Instance.new("Attachment")
    b.Name = "WakeFX_RibbonEnd"
    b.Position = Vector3.new(math.cos(angle + length) * radius,
        height + 2 + (index % 3) * 1.6, math.sin(angle + length) * radius)
    b.Parent = p
    local beam = Instance.new("Beam")
    beam.Name = "WakeFX_CurvedEnergyRibbon"
    beam.Attachment0 = a
    beam.Attachment1 = b
    beam.FaceCamera = true
    beam.LightEmission = 0.42
    beam.LightInfluence = 0
    beam.Segments = 14
    beam.CurveSize0 = 10 + (index % 3) * 4
    beam.CurveSize1 = -9
    beam.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, APRICOT),
        ColorSequenceKeypoint.new(0.48, color),
        ColorSequenceKeypoint.new(1, WISTERIA),
    })
    beam.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.08, 0.22),
        NumberSequenceKeypoint.new(0.5, 0.08),
        NumberSequenceKeypoint.new(0.92, 0.28),
        NumberSequenceKeypoint.new(1, 1),
    })
    beam.Width0 = 0.15
    beam.Width1 = 0.12
    beam.Parent = p
    ease(0.65, beam, {Width0 = 2.0, Width1 = 1.6})
    task.delay(0.67, function()
        if beam.Parent then
            ease(0.80, beam, {Width0 = 0, Width1 = 0})
        end
    end)
    Debris:AddItem(p, 1.65)
end

function VFX.groundPulse(parent: Instance, center: Vector3, radius: number)
    -- Expanding ring of softly glowing petal wisps. Beam count deliberately
    -- capped, all anchored/no collisions, auto-deleted for mobile.
    local count = 14
    for i = 1, count do
        local a = i * TAU / count
        local part = hiddenAnchor(parent, center + Vector3.new(math.cos(a)*3, 0, math.sin(a)*3))
        part.Name = "WakeFX_RingPetal"
        part.Shape = Enum.PartType.Ball
        part.Size = Vector3.new(3.7, 0.18, 2.6)
        part.Transparency = 0.45
        part.Material = Enum.Material.Neon
        part.Color = if i % 2 == 0 then APRICOT else BLUSH
        part.CFrame *= CFrame.Angles(0, a, 0)
        ease(1.10, part, {
            Position = center + Vector3.new(math.cos(a)*radius, 0, math.sin(a)*radius),
            Size = Vector3.new(6, 0.12, 4),
            Transparency = 1,
        })
        Debris:AddItem(part, 1.25)
    end
end

function VFX.markDanger(parent: Instance, center: Vector3, radius: number, tint: Color3, seconds: number)
    for i=1,12 do
        local angle=i*TAU/12
        local offset=Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
        local petal=hiddenAnchor(parent,Vector3.new(center.X,8.2,center.Z)+offset)
        petal.Name="StrikeBoundary"
        petal.Size=Vector3.new(.65,.20,math.min(5,radius*.36))
        petal.Color=tint
        petal.Material=Enum.Material.Neon
        petal.Transparency=.15
        petal.CFrame *= CFrame.Angles(0,-angle,0)
        Debris:AddItem(petal,seconds+.12)
    end
end

function VFX.wake(parent: Instance, center: Vector3)
    motes(parent, center + Vector3.new(0, 20, 0), 84, BLUSH, true)
    lightBloom(parent, center + Vector3.new(0, 29, 0), LILAC)
    for i = 1, 12 do
        local angle = i * TAU / 12
        ribbon(parent, center + Vector3.new(0, 6, 0), angle,
            19 + i % 4 * 3, 0.65, 4 + i % 3 * 2, BLUSH, i)
    end
    -- Second quieter pulse makes the change of phase legible without
    -- a full-screen flash or aggressive strobing.
    task.delay(0.38, function()
        if parent.Parent then
            motes(parent, center + Vector3.new(0, 8, 0), 38, WISTERIA, false)
        end
    end)
end

return VFX
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="19">
      <Properties>
        <string name="Name">NativeGardenerAvatar</string>
        <string name="Source"><![CDATA[--!strict
-- Native Roblox R15 chibi gardener outfit. Renders without any external asset IDs.
-- Keeps standard R15 Motor6Ds, animation, collision, physics and mobile control.
-- The imported original Avatar_ GLB parts always take priority.
local NativeAvatar = {}

local HAIR = Color3.fromRGB(100, 73, 53)
local HAIR_LIGHT = Color3.fromRGB(121, 86, 62)
local SKIN = Color3.fromRGB(255, 215, 179)
local CHEEK = Color3.fromRGB(245, 164, 162)
local EYE = Color3.fromRGB(67, 56, 49)
local WHITE = Color3.fromRGB(255, 249, 225)
local DENIM = Color3.fromRGB(134, 183, 220)
local DENIM_DARK = Color3.fromRGB(88, 149, 191)
local SUNFLOWER = Color3.fromRGB(251, 206, 100)

local function attach(folder: Folder, limb: BasePart, name: string,
    relative: CFrame, size: Vector3, color: Color3,
    shape: Enum.PartType?): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Shape = shape or Enum.PartType.Ball
    part.Size = size
    part.Material = Enum.Material.SmoothPlastic
    part.Color = color
    part.Anchored = false
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.CastShadow = true
    part.CFrame = limb.CFrame * relative
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = folder
    local weld = Instance.new("WeldConstraint")
    weld.Name = "ChibiR15Weld"
    weld.Part0 = limb
    weld.Part1 = part
    weld.Parent = part
    return part
end

local function bobHair(folder: Folder, head: BasePart)
    local a = function(name: string, x: number, y: number, z: number,
        sx: number, sy: number, sz: number, color: Color3)
        return attach(folder,head,name,CFrame.new(x,y,z),
            Vector3.new(sx,sy,sz),color)
    end
    a("HairBack",0,.04,.24,1.89,1.95,1.53,HAIR)
    a("ChibiFace",0,-.11,-.21,1.63,1.63,1.39,SKIN)
    -- Short bob fringe with directional locks, a distinct silhouette.
    a("HairCrown",0,.73,.12,1.80,.46,1.45,HAIR)
    for i = 1, 6 do
        local x = -.68+(i-1)*.27
        a("SweptHairLock_"..i,x,.58,-.66,.35,
            if i%2==0 then .52 else .41,.32,
            if i%3==0 then HAIR_LIGHT else HAIR)
    end
    for sign = -1,1,2 do
        a("SoftBobSide",sign*.81,-.19,-.02,.35,1.10,.84,HAIR)
        a("BobCurl",sign*.81,-.66,.12,.33,.43,.67,HAIR_LIGHT)
    end
    for sign = -1,1,2 do
        a("ClosedDollEye",sign*.32,-.08,-.92,.15,.23,.075,EYE)
        a("LittleEyeShine",sign*.29,-.02,-.987,.045,.063,.023,WHITE)
        a("RosyCheek",sign*.57,-.33,-.80,.25,.13,.05,CHEEK)
    end
    a("LittleNose",0,-.30,-.927,.095,.065,.038,
        Color3.fromRGB(227,168,145))
    a("GentleSmile",0,-.46,-.91,.27,.065,.045,EYE)
    for flower = 1,2 do
        local cx = if flower==1 then .68 else .91
        local cy = if flower==1 then .69 else .45
        local cz = -.75
        local scale = if flower==1 then 1 else .74
        for petal=1,5 do
            local th=petal*math.pi*2/5
            a("HairDaisyPetal",cx+math.cos(th)*.19*scale,
                cy+math.sin(th)*.19*scale,cz,
                .23*scale,.29*scale,.09,WHITE)
        end
        a("GoldenDaisyCenter",cx,cy,cz-.055,.18*scale,.18*scale,
            .09,SUNFLOWER)
    end
end

local function skinLimb(folder: Folder, limb: BasePart,
    name: string, color: Color3, multiplier: number)
    return attach(folder,limb,name,CFrame.identity,limb.Size * multiplier,color)
end

function NativeAvatar.apply(character: Model): boolean
    if character:GetAttribute("DWTMNativeGardenAvatar") == true then
        return true
    end
    -- Never overwrite a custom imported chibi avatar.
    if character:GetAttribute("DWTMStorybookAvatar") == true then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then return false end
    local names = {
        "Head", "UpperTorso", "LowerTorso",
        "LeftUpperArm", "LeftLowerArm", "LeftHand",
        "RightUpperArm", "RightLowerArm", "RightHand",
        "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
        "RightUpperLeg", "RightLowerLeg", "RightFoot"
    }
    local bones: {[string]: BasePart} = {}
    for _, n in ipairs(names) do
        local obj=character:FindFirstChild(n)
        if not obj or not obj:IsA("BasePart") then return false end
        bones[n]=obj
    end
    local old = character:FindFirstChild("NativeGardenOutfit")
    if old then old:Destroy() end
    local folder = Instance.new("Folder")
    folder.Name = "NativeGardenOutfit"
    folder.Parent = character

    bobHair(folder,bones.Head)
    local upper=bones.UpperTorso
    skinLimb(folder,upper,"WhiteGardenBlouse",WHITE,1.12)
    attach(folder,upper,"BlueOverallsBib",CFrame.new(0,-.13,-.47),
        Vector3.new(.86,.89,.15),DENIM)
    for sign=-1,1,2 do
        attach(folder,upper,"OverallsSuspender",CFrame.new(sign*.38,.41,-.49),
            Vector3.new(.16,.66,.16),DENIM_DARK)
        attach(folder,upper,"OverallButton",CFrame.new(sign*.36,.25,-.61),
            Vector3.new(.12,.12,.05),SUNFLOWER)
    end
    attach(folder,upper,"OverallPocket",CFrame.new(0,-.39,-.57),
        Vector3.new(.38,.24,.055),DENIM_DARK)
    skinLimb(folder,bones.LowerTorso,"BlueOverallShorts",DENIM,1.10)
    for _, side in ipairs({"Left","Right"}) do
        local upArm=bones[side.."UpperArm"]
        local lowArm=bones[side.."LowerArm"]
        local hand=bones[side.."Hand"]
        local upLeg=bones[side.."UpperLeg"]
        local lowLeg=bones[side.."LowerLeg"]
        local foot=bones[side.."Foot"]
        skinLimb(folder,upArm,"PuffedBlouseSleeve",WHITE,1.19)
        attach(folder,upArm,"SleeveTrim",
            CFrame.new(0,-upArm.Size.Y*.36,0),
            Vector3.new(upArm.Size.X*1.05,.15,upArm.Size.Z*1.08),WHITE)
        skinLimb(folder,lowArm,"GardenBareArm",SKIN,.96)
        skinLimb(folder,hand,"LittleGardenHand",SKIN,1.08)
        skinLimb(folder,upLeg,"OverallsShortLeg",DENIM,1.10)
        skinLimb(folder,lowLeg,"SkinLeg",SKIN,.96)
        attach(folder,lowLeg,"WhiteSocks",CFrame.new(0,-lowLeg.Size.Y*.34,0),
            Vector3.new(lowLeg.Size.X*.99,lowLeg.Size.Y*.23,
                lowLeg.Size.Z*.99),WHITE)
        skinLimb(folder,foot,"SunflowerShoes",SUNFLOWER,1.20)
        attach(folder,foot,"ShoeWhiteToe",CFrame.new(0,.075,-foot.Size.Z*.33),
            Vector3.new(foot.Size.X*.82,.09,foot.Size.Z*.42),WHITE)
    end

    -- Verify all graphics are mounted before hiding the default Roblox body.
    if #folder:GetChildren() < 28 then
        folder:Destroy()
        return false
    end
    for _, limb in pairs(bones) do
        limb.Transparency=1
        limb.CastShadow=false
    end
    for _, item in ipairs(character:GetDescendants()) do
        if item:IsA("Decal") and item.Parent==bones.Head then
            item.Transparency=1
        elseif item:IsA("BasePart") and item.Parent and
            item.Parent:IsA("Accessory") then
            item.Transparency=1
        end
    end
    character:SetAttribute("DWTMNativeGardenAvatar",true)
    return true
end

return NativeAvatar
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="20">
      <Properties>
        <string name="Name">NativePetSilhouettes</string>
        <string name="Source"><![CDATA[--!strict
-- Reference-friendly species silhouettes for the *asset-free* playable place.
-- This does not replace imported high-resolution meshes or override pet stats.
local Species = {}
local IVORY = Color3.fromRGB(255,246,227)
local BLUSH = Color3.fromRGB(251,181,188)
local DARK = Color3.fromRGB(69,61,68)
local GOLD = Color3.fromRGB(249,207,114)
local LEAF = Color3.fromRGB(115,170,96)
local PEACH = Color3.fromRGB(231,161,112)
local PINK = Color3.fromRGB(249,168,201)

local family: {[string]: string} = {
    Pip="cat", Zuzu="cat", Mochi="lamb", Pickle="frog",
    Bloop="axolotl", Nugget="chick", Tofu="lamb", Wobble="bear",
    Spark="fox", Gloop="axolotl", Luma="lamb", Snorf="dog",
    Floofle="rabbit", Quibble="crab", Fizzle="dino",
    Puddle="axolotl", Sprig="deer", Twinkle="butterfly",
    Mallow="bear", Pebble="turtle", Noodle="ferret",
    Swoop="owl", Rumble="dino", Doodle="sprite",
    Crumble="bear", Squiggle="octopus", Glimmer="unicorn",
    Splat="frog", Puffin="puffin", Echo="bat",
}

local function sphere(model: Model, name: string, position: Vector3,
    size: Vector3, color: Color3): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Shape = Enum.PartType.Ball
    p.Size = size
    p.Position = position
    p.Color = color
    p.Material = Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Parent = model
    return p
end

local function line(model: Model, name: string,
    start: Vector3, finish: Vector3, width: number, color: Color3)
    local length = (finish-start).Magnitude
    if length < .05 then return end
    local p = Instance.new("Part")
    p.Name = name
    p.Size = Vector3.new(width,width,length)
    p.CFrame = CFrame.lookAt((start+finish)*.5,finish)
    p.Color = color
    p.Material = Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Parent = model
end

function Species.apply(pet: Model, name: string, color: Color3): boolean
    local kind = family[name]
    if not kind or pet:GetAttribute("NativeSpeciesStyled") then return false end
    local root = pet.PrimaryPart
    if not root or not root:IsA("Part") then return false end
    local size: Vector3 = root.Size
    if kind=="frog" or kind=="crab" or kind=="turtle" or kind=="octopus" then
        size = Vector3.new(5.15,3.35,4.85)
    elseif kind=="chick" or kind=="owl" or kind=="puffin" then
        size = Vector3.new(3.45,4.4,3.35)
    elseif kind=="ferret" or kind=="axolotl" then
        size = Vector3.new(3.7,3.25,5.35)
    elseif kind=="deer" or kind=="unicorn" then
        size = Vector3.new(3.15,4.85,4.35)
    elseif kind=="butterfly" or kind=="bat" then
        size = Vector3.new(2.65,4.10,3.0)
    elseif kind=="dog" or kind=="bear" or kind=="lamb" then
        size = Vector3.new(4.65,4.15,4.45)
    elseif kind=="dino" then
        size = Vector3.new(4.25,4.1,5.1)
    elseif kind=="fox" then
        size = Vector3.new(3.6,3.7,5.3)
    end
    root.Size = size
    for _, obj in ipairs(pet:GetChildren()) do
        if obj:IsA("BasePart") then
            if obj.Name=="Ear" and kind~="cat" and kind~="fox" and kind~="unicorn" then
                obj.Transparency=1
            elseif obj.Name=="PuffTail" and kind~="rabbit" and kind~="bear" then
                obj.Transparency=1
            elseif obj.Name=="TinyFoot" and kind=="butterfly" then
                obj.Transparency=1
            end
        end
    end
    local s = function(label: string, p: Vector3, sz: Vector3, tint: Color3)
        return sphere(pet,label,p,sz,tint)
    end
    if kind=="cat" or kind=="fox" then
        for side=-1,1,2 do
            s("CreamMuzzle",Vector3.new(side*.44,-.38,-1.95),
                Vector3.new(.78,.56,.37),IVORY)
            for j=1,3 do
                line(pet,"CurvedWhisker",Vector3.new(side*.44,-.48+j*.14,-2.13),
                    Vector3.new(side*2.0,-.55+(j-2)*.35,-2.02),.045,IVORY)
            end
        end
        for i=1,3 do
            s("FluffyRisingTail",Vector3.new(.92+i*.27,-.35+i*.55,2.15+i*.28),
                Vector3.new(.85,.85,.89),
                if kind=="fox" and i==3 then IVORY else color)
        end
    elseif kind=="rabbit" then
        for side=-1,1,2 do
            s("FloppyMoonEar",Vector3.new(side*1.03,3.45,-.40),
                Vector3.new(.96,3.85,.52),color)
            s("SoftInnerEar",Vector3.new(side*1.03,3.53,-.76),
                Vector3.new(.51,2.89,.20),PINK)
            s("BunnyCheek",Vector3.new(side*.70,-.28,-1.93),
                Vector3.new(.84,.64,.50),IVORY)
        end
        s("CottonTail",Vector3.new(0,-.34,2.38),
            Vector3.new(1.25,1.18,1.2),IVORY)
    elseif kind=="ferret" then
        for side=-1,1,2 do
            s("FerretMask",Vector3.new(side*.56,.47,-2.28),
                Vector3.new(.80,.70,.25),IVORY)
            s("FerretPaw",Vector3.new(side*.79,-1.54,-1.62),
                Vector3.new(.68,.45,.74),IVORY)
        end
        s("LongCurvedTail",Vector3.new(1.1,.35,2.67),
            Vector3.new(.83,.86,1.75),color)
    elseif kind=="dog" then
        for side=-1,1,2 do
            s("SoftSpanielEar",Vector3.new(side*1.84,1.07,-.27),
                Vector3.new(1.09,2.55,.73),color:Lerp(DARK,.18))
            s("RoundPupMuzzle",Vector3.new(side*.40,-.62,-1.98),
                Vector3.new(.91,.70,.53),IVORY)
        end
        s("BigPuppyNose",Vector3.new(0,-.36,-2.43),
            Vector3.new(.48,.32,.32),DARK)
    elseif kind=="frog" then
        for side=-1,1,2 do
            s("Eyebulge",Vector3.new(side*1.35,1.91,-1.16),
                Vector3.new(1.15,1.15,1.12),color)
            s("FrogWhiteEye",Vector3.new(side*1.40,1.96,-1.71),
                Vector3.new(.65,.74,.21),IVORY)
            s("FrogPupil",Vector3.new(side*1.41,2.00,-1.87),
                Vector3.new(.32,.43,.14),DARK)
            s("SpreadFrogFoot",Vector3.new(side*1.85,-1.49,-1.08),
                Vector3.new(1.35,.34,1.02),color)
        end
        s("FrogBelly",Vector3.new(0,-.77,-1.9),
            Vector3.new(2.7,1.14,.37),IVORY)
    elseif kind=="axolotl" then
        for side=-1,1,2 do
            for j=1,3 do
                local y=1.49-j*.60
                s("WaterGills",Vector3.new(side*2.24,y,-.32),
                    Vector3.new(1.49,.43,.48),PINK)
                s("GillsFrill",Vector3.new(side*2.80,y+.18,-.39),
                    Vector3.new(.51,.50,.50),color:Lerp(PINK,.42))
            end
        end
        s("AxolotlTailFin",Vector3.new(0,-.25,2.45),
            Vector3.new(1.15,1.58,2.16),PINK)
    elseif kind=="chick" or kind=="owl" or kind=="puffin" then
        for side=-1,1,2 do
            local feather = s("FeatheredWing",Vector3.new(side*1.54,-.2,.30),
                Vector3.new(1.1,2.1,1.42),kind=="puffin" and DARK or color)
            feather.CFrame *= CFrame.Angles(0,0,math.rad(side*21))
            s("BirdEyePatch",Vector3.new(side*.72,.68,-1.68),
                Vector3.new(1.2,1.26,.18),kind=="owl" and IVORY or color)
        end
        local beak=s("CurvedGoldenBeak",Vector3.new(0,-.22,-1.96),
            Vector3.new(.72,.53,.94),GOLD)
        beak.CFrame *= CFrame.Angles(math.rad(-10),0,0)
        if kind=="chick" then
            for j=-1,1 do
                s("BabyChickTuft",Vector3.new(j*.38,2.35,.15),
                    Vector3.new(.38,.70,.46),color)
            end
        end
    elseif kind=="bear" or kind=="lamb" then
        for side=-1,1,2 do
            s("RoundedEar",Vector3.new(side*1.69,1.93,-.21),
                Vector3.new(.95,1.04,.83),color)
            s("EarInner",Vector3.new(side*1.72,1.93,-.67),
                Vector3.new(.53,.55,.23),BLUSH)
        end
        s("SoftCreamBelly",Vector3.new(0,-.66,-1.73),
            Vector3.new(2.42,1.96,.40),IVORY)
        if kind=="lamb" then
            for i=1,6 do
                local a=i*math.pi/3
                s("LittleWoolTuft",Vector3.new(math.cos(a)*1.20,1.83,
                    math.sin(a)*.7-.26),Vector3.new(.86,.87,.89),IVORY)
            end
        end
    elseif kind=="turtle" then
        s("TurtleShell",Vector3.new(0,.70,.59),
            Vector3.new(4.95,3.3,4.52),LEAF)
        for i=1,6 do
            local a=i*math.pi/3
            s("ShellScute",Vector3.new(math.sin(a)*1.38,1.96,
                .62+math.cos(a)*1.30),Vector3.new(1.02,.30,1.04),GOLD:Lerp(LEAF,.45))
        end
        s("TinyTurtleHead",Vector3.new(0,.35,-2.0),
            Vector3.new(2.56,2.02,2.18),color)
    elseif kind=="crab" then
        for side=-1,1,2 do
            s("CrabCrownEye",Vector3.new(side*1.0,1.89,-1.10),
                Vector3.new(.78,.85,.65),IVORY)
            s("CrabPupil",Vector3.new(side*1.0,1.94,-1.52),
                Vector3.new(.31,.37,.15),DARK)
            line(pet,"CrabClawArm",Vector3.new(side*1.75,-.44,-.12),
                Vector3.new(side*3.30,-.10,-1.18),.42,color)
            s("CrabPinkClaw",Vector3.new(side*3.38,-.06,-1.29),
                Vector3.new(1.34,1.18,1.32),color)
        end
    elseif kind=="octopus" then
        for i=1,8 do
            local a=i*math.pi/4
            local start=Vector3.new(math.sin(a)*.9,-1.16,
                math.cos(a)*1.1)
            local finish=Vector3.new(math.sin(a)*3.02,-2.18,
                math.cos(a)*2.85)
            line(pet,"CurvingOctopusArm",start,finish,.62,color)
            s("OctopusArmTip",finish,Vector3.new(.67,.58,.67),color)
        end
    elseif kind=="butterfly" or kind=="bat" then
        for side=-1,1,2 do
            local tint=if kind=="butterfly" then PINK else DARK:Lerp(color,.6)
            local wing=s("Wing",Vector3.new(side*2.35,.62,.56),
                Vector3.new(3.20,3.15,.31),tint)
            wing.CFrame *= CFrame.Angles(0,math.rad(side*12),
                math.rad(side*-13))
            if kind=="butterfly" then
                s("WingGoldDot",Vector3.new(side*3.20,.89,.36),
                    Vector3.new(.72,.74,.14),GOLD)
            end
        end
    elseif kind=="deer" or kind=="unicorn" then
        if kind=="deer" then
            for side=-1,1,2 do
                line(pet,"LittleAntler",Vector3.new(side*.75,2.1,-.20),
                    Vector3.new(side*1.28,3.53,-.13),.18,PEACH)
                line(pet,"AntlerBranch",Vector3.new(side*1.04,3.0,-.13),
                    Vector3.new(side*1.75,3.2,-.18),.14,PEACH)
            end
        else
            line(pet,"UnicornGoldenHorn",Vector3.new(0,2.0,-1.55),
                Vector3.new(0,3.75,-1.71),.40,GOLD)
        end
        s("LongNeckCreamCollar",Vector3.new(0,-.6,-1.7),
            Vector3.new(1.44,1.97,.38),IVORY)
    elseif kind=="dino" then
        for i=1,5 do
            local z=-1.4+i*.85
            s("DinosaurBackSpine",Vector3.new(0,2.01-i*.11,z),
                Vector3.new(.67,1.05,.91),LEAF)
        end
        s("DinosaurThickTail",Vector3.new(0,-.40,2.67),
            Vector3.new(1.37,1.26,2.0),color)
    elseif kind=="sprite" then
        for side=-1,1,2 do
            s("SpriteFloatingFlare",Vector3.new(side*1.86,.71,.50),
                Vector3.new(1.33,1.89,.47),PINK)
        end
        s("SpriteGoldCrown",Vector3.new(0,2.13,-.46),
            Vector3.new(1.50,.32,1.17),GOLD)
    end

    pet:SetAttribute("NativeSpeciesStyled",true)
    return true
end
return Species
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="21">
      <Properties>
        <string name="Name">OrchardGeometry</string>
        <string name="Source"><![CDATA[--!strict
-- Materialize packed, authored meshes on demand. Opaque DataModel content is
-- replicated to clients; an EditableMesh object reference alone cannot replicate.
local AssetService = game:GetService("AssetService")
local EncodingService = game:GetService("EncodingService")
local HttpService = game:GetService("HttpService")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")
local data = ServerStorage:WaitForChild("OrchardGeometry")
local localFiles = if RunService:IsStudio() then ServerStorage:FindFirstChild("StudioMeshFiles") else nil

local Art = {}
local templates: {[string]: MeshPart} = {}
local pending: {[string]: BindableEvent} = {}
local retryAt: {[string]: number} = {}
local building = 0
local space = Instance.new("BindableEvent")
local texture: Content? = nil
local textureBusy = false
local textureReady = Instance.new("BindableEvent")
local textureRetry = 0

local function unpackBytes(encoded: string): buffer
    return EncodingService:DecompressBuffer(EncodingService:Base64Decode(buffer.fromstring(encoded)),
        Enum.CompressionAlgorithm.Zstd)
end

local function replicate(editable: any): Content
    local result, content = AssetService:CreateDataModelContentAsync(Content.fromObject(editable))
    assert(result == Enum.CreateContentResult.Success, tostring(result))
    return content
end

local function pigments(): Content
    while textureBusy do textureReady.Event:Wait() end
    if texture then return texture end
    assert(os.clock() >= textureRetry, "Mesh/image APIs unavailable")
    textureBusy = true
    local img: EditableImage? = nil
    local ok, result = pcall(function()
        local raw = HttpService:JSONDecode((data:FindFirstChild("Pigments") :: StringValue).Value)
        local size = Vector2.new(raw[1], raw[2])
        local image = assert(AssetService:CreateEditableImage({Size = size}), "Image memory budget")
        img = image
        image:WritePixelsBuffer(Vector2.zero, size, unpackBytes(raw[3]))
        return replicate(image)
    end)
    if img then (img :: EditableImage):Destroy() end
    if ok then texture = result else textureRetry = os.clock() + 60 end
    textureBusy = false
    textureReady:Fire()
    assert(ok, tostring(result))
    return result
end

local function surface(encoded: string, atlas: Content): MeshPart
    local bytes = unpackBytes(encoded)
    local count = buffer.readu32(bytes, 0)
    local triangles = buffer.readu32(bytes, 4)
    assert(8 + count*13 + triangles*6 == buffer.len(bytes), "Invalid mesh record")
    local geometry = assert(AssetService:CreateEditableMesh(), "Mesh memory budget")
    local ok, result = pcall(function()
        local vertices, normals, uvs = table.create(count), table.create(count), table.create(count)
        local pos = 8
        for i = 1, count do
            vertices[i] = geometry:AddVertex(Vector3.new(buffer.readi16(bytes,pos),
                buffer.readi16(bytes,pos+2),buffer.readi16(bytes,pos+4))/2048)
            normals[i] = geometry:AddNormal(Vector3.new(buffer.readi8(bytes,pos+6),
                buffer.readi8(bytes,pos+7),buffer.readi8(bytes,pos+8)).Unit)
            uvs[i] = geometry:AddUV(Vector2.new(buffer.readu16(bytes,pos+9),
                buffer.readu16(bytes,pos+11))/65535)
            pos += 13
        end
        for _ = 1, triangles do
            local a,b,c = buffer.readu16(bytes,pos)+1, buffer.readu16(bytes,pos+2)+1, buffer.readu16(bytes,pos+4)+1
            local f = geometry:AddTriangle(vertices[a],vertices[b],vertices[c])
            geometry:SetFaceNormals(f,{normals[a],normals[b],normals[c]})
            geometry:SetFaceUVs(f,{uvs[a],uvs[b],uvs[c]})
            pos += 6
        end
        local uri = replicate(geometry)
        local mesh = AssetService:CreateMeshPartAsync(uri,{CollisionFidelity=Enum.CollisionFidelity.Box})
        mesh.TextureContent = atlas
        return mesh
    end)
    geometry:Destroy()
    assert(ok,tostring(result))
    return result
end

local function vector(v: {number}): Vector3
    return Vector3.new(v[1],v[2],v[3])
end

local function assemble(key: string, record: StringValue): MeshPart
    local spec = HttpService:JSONDecode(record.Value)
    local root: MeshPart? = nil
    local atlas = if localFiles then nil else pigments()
    local ok, problem = pcall(function()
        for _, part in ipairs(spec.parts) do
            local mesh: MeshPart
            if localFiles then
                local file = localFiles:FindFirstChild(key .. "_" .. part.name)
                assert(file and file:IsA("MeshPart"), key .. "/" .. part.name)
                mesh = file:Clone()
            else
                mesh = surface(part.data, atlas :: Content)
            end
            mesh.Anchored = true
            mesh.CanCollide = false
            mesh.CanTouch = false
            mesh.CanQuery = false
            mesh.Massless = true
            mesh.DoubleSided = true
            mesh.Color = Color3.new(1,1,1)
            mesh.Material = Enum.Material.SmoothPlastic
            mesh.Size = vector(part.size):Max(Vector3.one * .001)
            mesh:SetAttribute("PieceCenter",vector(part.center)-vector(spec.center))
            if part.name == "Body" then
                root = mesh
                mesh.Name = key
                mesh:SetAttribute("ArtSize",vector(spec.size))
            else
                assert(root)
                mesh.Name = part.name
                mesh:SetAttribute("JointParent",part.parent)
                mesh:SetAttribute("JointPivot",vector(part.pivot)-vector(spec.center))
                mesh.Parent = root
            end
        end
    end)
    if not ok then
        if root then (root :: MeshPart):Destroy() end
        error(tostring(problem))
    end
    return assert(root)
end

-- Called from cosmetic tasks. Concurrent requests share one construction.
function Art.load(key: string): MeshPart?
    if templates[key] then return templates[key] end
    local busy = pending[key]
    if busy then
        busy.Event:Wait()
        return templates[key]
    end
    if os.clock() < (retryAt[key] or 0) or (not localFiles and os.clock() < textureRetry) then return nil end
    local record = data:FindFirstChild(key)
    if not record or not record:IsA("StringValue") then return nil end
    local event = Instance.new("BindableEvent")
    pending[key] = event
    while building>=2 do space.Event:Wait() end
    building+=1
    local ok, result = pcall(assemble,key,record)
    building-=1
    space:Fire()
    if ok then templates[key] = result else
        retryAt[key] = os.clock()+60
        warn("DWTM artwork " .. key .. ": " .. tostring(result))
    end
    pending[key] = nil
    event:Fire()
    task.defer(function() event:Destroy() end)
    return templates[key]
end

function Art.cached(key: string): MeshPart?
    if localFiles and not templates[key] then return Art.load(key) end
    return templates[key]
end

-- Align sections about authored pivots, retaining the API- and gameplay-owned root.
function Art.mount(mesh: MeshPart, frame: CFrame, scale: number, bodyAnchor: BasePart?)
    local base = mesh:GetAttribute("PieceCenter") or Vector3.zero
    mesh.CFrame = frame * CFrame.new(base*scale)
    if bodyAnchor and mesh:GetAttribute("ArtSize") then
        local spine=Instance.new("Motor6D")
        spine.Name="Spine"
        spine.C0=bodyAnchor.CFrame:ToObjectSpace(mesh.CFrame)
        spine.C1=CFrame.identity
        spine.Part0,spine.Part1=bodyAnchor,mesh
        spine:SetAttribute("PoseScale",scale)
        spine:SetAttribute("FloorClearance",(mesh:GetAttribute("ArtSize").Y*.5+base.Y)*scale)
        spine.Parent=mesh
        mesh.Anchored=false
    end
    local members: {[string]: MeshPart} = {Body=mesh}
    for _, child in ipairs(mesh:GetChildren()) do
        if child:IsA("MeshPart") and child:GetAttribute("JointParent") then
            members[child.Name] = child
            child.Size *= scale
            if child.Name == "Blink" then child:SetAttribute("OpenEyeSize",child.Size) end
            child.CFrame = frame * CFrame.new(child:GetAttribute("PieceCenter")*scale)
        end
    end
    for id, child in pairs(members) do
        if id == "Body" then continue end
        local parent = members[child:GetAttribute("JointParent")]
        local pivot = frame * CFrame.new(child:GetAttribute("JointPivot")*scale)
        local joint = Instance.new("Motor6D")
        joint.Name = id
        joint.Part0, joint.Part1 = parent, child
        joint.C0 = parent.CFrame:ToObjectSpace(pivot)
        joint.C1 = child.CFrame:ToObjectSpace(pivot)
        joint.Parent = child
        child.Anchored = false
    end
end

return Art
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="22">
      <Properties>
        <string name="Name">OrganicGardenBeds</string>
        <string name="Source"><![CDATA[--!strict
-- Original organic farm geometry designed around the reference composition.
-- All nine plots remain in their original positions and still use the
-- existing Garden data, growth timers and server-owned ProximityPrompts.
-- No imported models, texture IDs or generated images.
local Beds = {}

local BROWN = Color3.fromRGB(142, 105, 78)
local DARK = Color3.fromRGB(103, 76, 59)
local LIGHT = Color3.fromRGB(177, 132, 91)
local SAND = Color3.fromRGB(205, 182, 137)
local GREEN = Color3.fromRGB(105, 156, 84)
local GREEN_LIT = Color3.fromRGB(177, 207, 120)
local IVORY = Color3.fromRGB(255, 243, 201)
local PINK = Color3.fromRGB(249, 198, 197)

local function shape(parent: Instance, name: string, at: CFrame,
    size: Vector3, color: Color3, material: Enum.Material,
    kind: Enum.PartType?): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = at
    p.Color = color
    p.Material = material
    p.Shape = kind or Enum.PartType.Ball
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function leaf(parent: Instance, name: string, origin: CFrame,
    x: number, z: number, angle: number, color: Color3, scale: number)
    local q = origin * CFrame.new(x, 0.03, z)
        * CFrame.Angles(0, angle, math.rad(-9))
    shape(parent, name, q, Vector3.new(.35 * scale, .095, .63 * scale),
        color, Enum.Material.SmoothPlastic)
end

local function blossom(parent: Instance, basis: CFrame,
    x: number, z: number, scale: number, pink: boolean)
    local c = if pink then PINK else IVORY
    for j = 1, 5 do
        local a = j * math.pi * 2 / 5
        shape(parent, "MeadowFlowerPetal",
            basis * CFrame.new(x + math.cos(a) * .19 * scale,
                .11, z + math.sin(a) * .18 * scale),
            Vector3.new(.23 * scale, .075, .29 * scale),
            c, Enum.Material.SmoothPlastic)
    end
    shape(parent, "MeadowFlowerHeart",
        basis * CFrame.new(x, .18, z),
        Vector3.new(.23 * scale, .10, .23 * scale),
        Color3.fromRGB(245, 216, 108), Enum.Material.SmoothPlastic)
end

function Beds.decorateLawn(parent: Model, center: CFrame)
    -- One small shared set of worn-earth footsteps defines the entrance,
    -- instead of a giant wood platform or hard nine-square chessboard.
    local rng = Random.new(495812)
    for n = 1, 13 do
        local z = 15.4 - n * 2.5
        local x = math.sin(n * 1.14) * 0.43
        local tint = if n % 3 == 0 then SAND else Color3.fromRGB(220, 190, 145)
        shape(parent, "PaintedFootpath",
            center * CFrame.new(x, .735, z) * CFrame.Angles(0, math.rad(n * 23), 0),
            Vector3.new(4.3 + (n % 3) * .5, .13, 2.65),
            tint, Enum.Material.Sand)
    end
    for n = 1, 14 do
        local side = if n % 2 == 0 then 1 else -1
        local x = side * rng:NextNumber(11.1, 12.4)
        local z = rng:NextNumber(-11.8, 12.5)
        if n % 4 == 0 then
            blossom(parent, center * CFrame.new(0, .70, 0),
                x, z, rng:NextNumber(.52, .8), n % 3 == 0)
        else
            for j = 1, 3 do
                local a = j * math.pi * 2 / 3
                leaf(parent, "PaintedCloverLeaf",
                    center * CFrame.new(0, .72, 0),
                    x + math.sin(a) * .18, z + math.cos(a) * .18,
                    a, if j % 2 == 0 then GREEN_LIT else GREEN, .88)
            end
        end
    end
end

function Beds.decoratePlot(parent: Model, place: CFrame,
    plotIndex: number): Part
    local rng = Random.new(5713 + plotIndex * 67)

    -- Overlapping, low-profile sculpted brown earth forms a single bed.
    -- Every piece remains cosmetic; the existing grass platform is the
    -- reliable physics surface for avatars, pets and mobile controls.
    local base = shape(parent, "SoftSoil",
        place * CFrame.new(0, .04, 0),
        Vector3.new(7.45, .51, 7.38),
        BROWN, Enum.Material.Ground)
    shape(parent, "PaintedDarkLoam",
        place * CFrame.new(-.23, .05, -.17),
        Vector3.new(6.6, .43, 6.3),
        DARK, Enum.Material.Ground)
    shape(parent, "PaintedWarmTopsoil",
        place * CFrame.new(.22, .085, .08),
        Vector3.new(6.0, .37, 6.15),
        LIGHT, Enum.Material.Ground)
    -- Low shoulders soften the edges as the turf blends into the soil.
    -- Never build raised square wood rails in the walking area.
    for i = 1, 6 do
        local a = i * math.pi * 2 / 6 + plotIndex * .11
        local radial = rng:NextNumber(2.65, 3.18)
        local dx, dz = math.cos(a) * radial, math.sin(a) * radial
        local tint = if i % 3 == 0 then BROWN elseif i % 2 == 0 then DARK else LIGHT
        shape(parent, "LooseSoilPebble",
            place * CFrame.new(dx, .16, dz)
                * CFrame.Angles(0, a * .65, 0),
            Vector3.new(rng:NextNumber(.35, .7), .19,
                rng:NextNumber(.38, .67)),
            tint, Enum.Material.Ground)
    end
    for j = 1, 3 do
        local a = j * math.pi * 2 / 3 + plotIndex * .39
        local x = math.cos(a) * 3.36
        local z = math.sin(a) * 3.38
        leaf(parent, "SeedbedClover", place, x, z, a,
            if j % 2 == 0 then GREEN else GREEN_LIT, 1.04)
    end
    return base
end

return Beds
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="23">
      <Properties>
        <string name="Name">PainterlyOrchardTree</string>
        <string name="Source"><![CDATA[--!strict
-- Real Roblox geometry for the original orange orchard in the reference
-- color language. The mesh pack, if installed in Studio, still takes priority.
-- This replaces the four enormous "lollipop" spheres in the fallback scene.
-- One shared asset-free canopy per tree, bounded to <= 48 pieces.
local Orchard = {}

local BARK = Color3.fromRGB(148, 103, 76)
local BARK_LIT = Color3.fromRGB(190, 142, 103)
local DARK = Color3.fromRGB(83, 134, 76)
local MID = Color3.fromRGB(125, 176, 93)
local LIGHT = Color3.fromRGB(186, 209, 112)
local SUNLIGHT = Color3.fromRGB(215, 223, 136)
local ORANGE = Color3.fromRGB(250, 161, 66)
local ORANGE_LIT = Color3.fromRGB(255, 190, 86)

local function piece(parent: Instance, name: string, pos: Vector3,
    size: Vector3, color: Color3, shape: Enum.PartType?): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Position = pos
    p.Color = color
    p.Shape = shape or Enum.PartType.Ball
    p.Material = Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function branch(parent: Instance, from: Vector3, to: Vector3,
    width: number, color: Color3)
    local p = piece(parent, "OrchardBranch",
        (from + to) / 2, Vector3.new(width, width, (to - from).Magnitude),
        color, Enum.PartType.Block)
    p.Material = Enum.Material.Wood
    p.CFrame = CFrame.lookAt((from + to) / 2, to)
    return p
end

function Orchard.build(parent: Instance, index: number, ground: Vector3): Model
    local rng = Random.new(91735 + index * 331)
    local tree = Instance.new("Model")
    tree.Name = "PaintedOrangeTree_" .. index
    tree.Parent = parent
    local tall = rng:NextNumber(12.2, 16.2)
    local crown = ground + Vector3.new(0, tall + 2.5, 0)
    local trunk = piece(tree, "BarkTrunk", ground + Vector3.new(0, tall * .51, 0),
        Vector3.new(1.65, tall, 1.65), BARK)
    trunk.Material = Enum.Material.Wood
    trunk.CastShadow = true

    local colors = {DARK, MID, LIGHT, SUNLIGHT}
    -- Multiple overlapping irregular leaf masses rather than a smooth sphere.
    for i = 1, 11 do
        local a = i * 2.39996 + index * .17
        local distance = (i % 5) * .69 + 2.3
        local p = crown + Vector3.new(math.cos(a) * distance,
            rng:NextNumber(-2.45, 2.45), math.sin(a) * distance)
        local cluster = piece(tree, "PaintedCanopyMass", p,
            Vector3.new(rng:NextNumber(5.0, 7.6),
                rng:NextNumber(4.5, 6.5), rng:NextNumber(5.3, 7.6)),
            colors[((i + index) % #colors) + 1])
        cluster.CastShadow = i % 3 == 0
        if i % 3 == 0 then
            branch(tree,
                ground + Vector3.new(0, tall * .76, 0),
                p - Vector3.new(0, 1.1, 0),
                rng:NextNumber(.53, .82), BARK_LIT)
        end
    end

    -- 16 angular leaves: irregular directional silhouette is more important
    -- in the three-quarter camera than dozens of tiny expensive leaves.
    for i = 1, 14 do
        local a = i * 2.39996 + index * .31
        local p = crown + Vector3.new(math.cos(a) * rng:NextNumber(3.3, 6.1),
            rng:NextNumber(-3.4, 4.3),
            math.sin(a) * rng:NextNumber(3.2, 6.2))
        local leaf = Instance.new("WedgePart")
        leaf.Name = "PaintedOrchardLeaf"
        leaf.Size = Vector3.new(rng:NextNumber(1.5, 2.5), .18,
            rng:NextNumber(2.6, 4.2))
        leaf.CFrame = CFrame.new(p) * CFrame.Angles(
            math.rad(rng:NextNumber(-34, 34)), a,
            math.rad(rng:NextNumber(-24, 24)))
        leaf.Color = if i % 3 == 0 then SUNLIGHT elseif i % 2 == 0 then LIGHT else MID
        leaf.Material = Enum.Material.SmoothPlastic
        leaf.Anchored = true
        leaf.CanCollide = false
        leaf.CanTouch = false
        leaf.CanQuery = false
        leaf.CastShadow = false
        leaf.Parent = tree
    end

    -- Citrus hangs from the outer canopy instead of floating outside it.
    for i = 1, 8 do
        local a = i * 2.39996 + index * .24
        local radius = rng:NextNumber(3.2, 5.9)
        local fruitPos = crown + Vector3.new(
            math.cos(a) * radius, rng:NextNumber(-3.4, 0.6),
            math.sin(a) * radius)
        local fruit = piece(tree, "RipeOrange", fruitPos,
            Vector3.new(1.55, 1.66, 1.53),
            if i % 3 == 0 then ORANGE_LIT else ORANGE)
        fruit.CastShadow = true
        -- Small paired dark/light sepals keep orange fruits visibly attached.
        for j = 1, 1 do
            local leaf = piece(tree, "OrangeSePal",
                fruitPos + Vector3.new(if j == 1 then -.23 else .25,
                    .78, 0), Vector3.new(.49, .10, .27),
                if j == 1 then DARK else MID)
            leaf.CFrame *= CFrame.Angles(0,
                math.rad(if j == 1 then -28 else 31), math.rad(12))
        end
    end

    tree:SetAttribute("NativeOrchardTree", true)
    tree:SetAttribute("DetailCountCap", 48)
    return tree
end

return Orchard
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="24">
      <Properties>
        <string name="Name">ProfileStore</string>
        <string name="Source"><![CDATA[--!strict
-- Cross-server session-locked profile persistence.
-- The UpdateAsync lease prevents two server instances overwriting the same
-- player's inventory/progress. Legacy profiles are claimed in-place.
-- If the database is unavailable or a different live server owns the key,
-- gameplay degrades to an explicitly non-saving session.
local ProfileStore = {}
ProfileStore.__index = ProfileStore

local LEASE_SECONDS = 240
local LEASE_FIELD = "_dwtmLease"

function ProfileStore.new(service: any, name: string, serialize: (any) -> any,
    serverToken: string?)
    local self: any = setmetatable({
        serialize = serialize,
        saving = {},
        serverToken = serverToken,
        lastLoadError = nil,
        claims = {},
    }, ProfileStore)
    local ok, result = pcall(function() return service:GetDataStore(name) end)
    if ok then
        self.store = result
    else
        warn("DWTM: persistence initialization unavailable. Progress is session-only: " .. tostring(result))
    end
    return self
end

local function ours(self: any, snapshot: any, token: string?): boolean
    return type(snapshot) == "table"
        and type(snapshot[LEASE_FIELD]) == "table"
        and snapshot[LEASE_FIELD].token == (token or self.serverToken)
end

local function withLease(self: any, state: any, token: string): any
    local saved = table.clone(state)
    saved[LEASE_FIELD] = {token = token, expiresAt = os.time() + LEASE_SECONDS}
    return saved
end

function ProfileStore.load(self: any, userId: number): (boolean, any)
    self.lastLoadError = nil
    if not self.store then
        self.lastLoadError = "DataStore unavailable"
        return false, nil
    end
    local key = "player_" .. userId
    if not self.serverToken then
        -- Legacy opt-out is retained only for local/mock tests. Production Game
        -- always passes its unique server GUID and uses atomic lease acquisition.
        local ok, result = pcall(function() return self.store:GetAsync(key) end)
        if not ok then self.lastLoadError = tostring(result) end
        return ok, if ok then result else nil
    end
    -- Distinct visit tokens also protect quick disconnect/rejoin on the same
    -- Roblox server while the first visit's last UpdateAsync is still yielding.
    local claim = (self.claims[userId] or 0) + 1
    self.claims[userId] = claim
    local token = self.serverToken .. ":" .. tostring(userId) .. ":" .. tostring(claim)
    local locked = false
    local ok, record = pcall(function()
        return self.store:UpdateAsync(key, function(previous: any)
            local data = if type(previous) == "table" then previous else {}
            local lease = data[LEASE_FIELD]
            if type(lease) == "table" and lease.token ~= token
                and type(lease.expiresAt) == "number"
                and lease.expiresAt > os.time() then
                locked = true
                return nil
            end
            locked = false
            return withLease(self, data, token)
        end)
    end)
    if not ok then
        self.lastLoadError = "DataStore load/lease failed: " .. tostring(record)
        return false, nil
    end
    if locked or not ours(self, record, token) then
        self.lastLoadError = "This profile is still open on another server"
        return false, nil
    end
    return true, record
end

function ProfileStore.save(self: any, userId: number, profile: any): boolean
    -- A leave/shutdown save waits for autosave and creates its own snapshot.
    -- Otherwise an overlapping leave could skip the final few actions.
    while self.saving[profile] do task.wait() end
    if not self.store or not profile.loaded then return true end
    if not profile.dirty and not self.serverToken then return true end
    self.saving[profile] = true
    local revision = profile.revision
    local wrote = false
    local lostLease = false
    local ok, err = pcall(function()
        -- Important: serialize ONCE outside UpdateAsync; Roblox can call the
        -- transform multiple times. The result must be immutable per attempt.
        local snapshot = if profile.dirty then self.serialize(profile) else nil
        self.store:UpdateAsync("player_" .. userId, function(previous: any)
            if self.serverToken then
                if not ours(self, previous, profile.dataSessionId) then
                    lostLease = true
                    return nil
                end
                lostLease = false
                wrote = true
                return withLease(self, snapshot or previous, profile.dataSessionId)
            end
            wrote = true
            return snapshot
        end)
    end)
    self.saving[profile] = nil
    if ok and wrote and not lostLease then
        if profile.revision == revision then profile.dirty = false end
        return true
    end
    if lostLease then
        -- Never overwrite a newer server's progress. Rejoin is required.
        profile.loaded = false
        warn("DWTM: session ownership lost for " .. userId .. ". Saving disabled for this session.")
    elseif not ok then
        warn("DWTM: data save failed for " .. userId .. ": " .. tostring(err))
    end
    return false
end

function ProfileStore.release(self: any, userId: number, profile: any): boolean
    if not self.store or not profile.loaded or not self.serverToken then return true end
    while self.saving[profile] do task.wait() end
    self.saving[profile] = true
    local released = false
    for attempt = 1, 3 do
        local ok, err = pcall(function()
            self.store:UpdateAsync("player_" .. userId, function(previous: any)
                -- Roblox may call the transform again against a newer record.
                -- A prior attempt may also have committed before its response failed.
                released = type(previous) == "table" and previous[LEASE_FIELD] == nil
                if not ours(self, previous, profile.dataSessionId) then return nil end
                released = true
                local nextState = table.clone(previous)
                nextState[LEASE_FIELD] = nil
                return nextState
            end)
        end)
        if ok then break end
        released = false
        if attempt == 3 then
            warn("DWTM: lease release failed for " .. userId .. ": " .. tostring(err))
        else
            task.wait(attempt)
        end
    end
    self.saving[profile] = nil
    return released
end

-- A transient failure during PlayerRemoving has no later autosave to retry it.
function ProfileStore.finish(self: any, userId: number, profile: any): boolean
    if not profile.loaded then return true end
    for attempt=1,3 do
        if self:save(userId,profile) then return self:release(userId,profile) end
        if not profile.loaded then return false end
        if attempt<3 then task.wait(attempt) end
    end
    return false
end

return ProfileStore
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="25">
      <Properties>
        <string name="Name">Progression</string>
        <string name="Source"><![CDATA[--!strict
-- Pure progression rules. Never trust a client-supplied coin total or ownership flag.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Garden = require(script.Parent:WaitForChild("Garden"))
local Personality = require(ReplicatedStorage:WaitForChild("PetPersonality"))

local Progression = {}
local MAX_COINS = 1000000000

local function saneInt(value: any, maximum: number): number
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then return 0 end
    return math.clamp(math.floor(value), 0, maximum)
end

local reactionIds: {[string]: boolean} = {}
for _, reaction in ipairs(Config.Reactions) do
    reactionIds[reaction.id] = true
end

function Progression.new()
    return {
        coins = 0,
        metricFlags = {},
        petIndex = 1,
        owned = {[1] = true},
        discovered = {},
        feedCount = 0,
        survivalCount = 0,
        questClaimed = {feeds = false, survivals = false, discoveries = false},
        dailyDay = -1,
        tutorialSeen = false,
        garden = Garden.new(),
        personalities = {},
    }
end

function Progression.load(profile: any, data: any)
    if type(data) ~= "table" then return end
    if type(data.metricFlags)=="table" then
        for _,id in ipairs({"FirstVisit","FirstReturn","FirstPetFed","FirstReaction","FirstWakeSeen",
            "FirstPetRescued","FirstRoundFinished","FirstBossSurvived","FirstSeedLocated",
            "FirstSeedPlanted","FirstHarvest","FirstCoopRescue","IntroComplete"}) do
            if data.metricFlags[id]==true then profile.metricFlags[id]=true end
        end
    end
    profile.coins = saneInt(data.coins, MAX_COINS)
    profile.garden = Garden.load(data.garden)
    local id = saneInt(data.petIndex, #Config.Pets)
    profile.petIndex = if id >= 1 then id else 1

    if type(data.owned) == "table" then
        for _, value in ipairs(data.owned) do
            local index = saneInt(value, #Config.Pets)
            if index >= 1 then profile.owned[index] = true end
        end
    end
    -- Old v1 accounts only stored equipped pet; never revoke their old companion.
    profile.owned[1] = true
    profile.owned[profile.petIndex] = true

    -- Migrate old collections without changing ownership or resetting progress.
    if type(data.personalities) == "table" then
        for i = 1, #Config.Pets do
            if profile.owned[i] then
                local raw = data.personalities[tostring(i)] or data.personalities[i]
                local pet = Config.Pets[i]
                local restored = Personality.restore(raw, pet.description or pet.name)
                if restored then profile.personalities[i] = restored end
            end
        end
    end

    if type(data.discovered) == "table" then
        for _, reactionId in ipairs(data.discovered) do
            if type(reactionId) == "string" and reactionIds[reactionId] then
                profile.discovered[reactionId] = true
            end
        end
    end

    profile.feedCount = saneInt(data.feedCount, 1000000)
    profile.survivalCount = saneInt(data.survivalCount, 1000000)
    profile.dailyDay = if data.dailyDay == nil then -1 else saneInt(data.dailyDay, 1000000)
    profile.tutorialSeen = data.tutorialSeen == true
    if type(data.questClaimed) == "table" then
        for quest in pairs(Config.QUEST_GOALS) do
            profile.questClaimed[quest] = data.questClaimed[quest] == true
        end
    end
end

function Progression.serialize(profile: any)
    local owned = {}
    for i = 1, #Config.Pets do
        if profile.owned[i] == true then table.insert(owned, i) end
    end
    local discovered = {}
    for _, reaction in ipairs(Config.Reactions) do
        if profile.discovered[reaction.id] == true then
            table.insert(discovered, reaction.id)
        end
    end
    local personalityData = {}
    for i = 1, #Config.Pets do
        if profile.owned[i] and profile.personalities[i] then
            personalityData[tostring(i)] = Personality.pack(profile.personalities[i])
        end
    end
    return {
        coins = saneInt(profile.coins, MAX_COINS),
        metricFlags = table.clone(profile.metricFlags or {}),
        personalities = personalityData,
        petIndex = profile.petIndex,
        owned = owned,
        discovered = discovered,
        feedCount = profile.feedCount,
        survivalCount = profile.survivalCount,
        questClaimed = {
            feeds = profile.questClaimed.feeds,
            survivals = profile.questClaimed.survivals,
            discoveries = profile.questClaimed.discoveries,
        },
        dailyDay = profile.dailyDay,
        tutorialSeen = profile.tutorialSeen == true,
        garden = Garden.serialize(profile.garden),
    }
end

local function discoveryCount(profile: any): number
    local count = 0
    for id, value in pairs(profile.discovered) do
        if value == true and reactionIds[id] then count += 1 end
    end
    return count
end

local function questReward(profile: any, quest: string, current: number): number
    if profile.questClaimed[quest] or current < Config.QUEST_GOALS[quest] then return 0 end
    profile.questClaimed[quest] = true
    return Config.QUEST_REWARDS[quest]
end

function Progression.recordFeed(profile: any, reactionId: string): (number, {string})
    profile.feedCount += 1
    local bonus = 0
    local messages = {}
    if reactionIds[reactionId] and not profile.discovered[reactionId] then
        profile.discovered[reactionId] = true
        bonus += Config.DISCOVERY_REWARD
        table.insert(messages, "NEW DISCOVERY! +" .. Config.DISCOVERY_REWARD .. " coins")
    end
    local feedReward = questReward(profile, "feeds", profile.feedCount)
    if feedReward > 0 then
        bonus += feedReward
        table.insert(messages, "QUEST COMPLETE: FEED 5! +" .. feedReward)
    end
    local discoveryReward = questReward(profile, "discoveries", discoveryCount(profile))
    if discoveryReward > 0 then
        bonus += discoveryReward
        table.insert(messages, "QUEST COMPLETE: DISCOVER 4! +" .. discoveryReward)
    end
    return bonus, messages
end

function Progression.recordSurvival(profile: any): number
    profile.survivalCount += 1
    return questReward(profile, "survivals", profile.survivalCount)
end

function Progression.ensurePersonality(profile: any, petId: number, userId: number, freshSeed: number?): boolean
    if not Config.Pets[petId] or not profile.owned[petId] then return false end
    if profile.personalities[petId] then return false end
    local species = Config.Pets[petId].description or Config.Pets[petId].name
    local seed = freshSeed or Personality.seedFor(userId, petId)
    profile.personalities[petId] = Personality.generate(seed, species)
    return true
end

function Progression.catalog(profile: any)
    local owned = {}
    for i = 1, #Config.Pets do
        if profile.owned[i] then table.insert(owned, i) end
    end
    local currentDay = math.floor(os.time() / 86400)
    local petProfiles = {}
    for i = 1, #Config.Pets do
        local p = profile.personalities[i]
        if profile.owned[i] and p then
            petProfiles[tostring(i)] = {
                temperament = p.temperament,
                habit = p.habit,
                fear = p.fear,
                affection = p.affection,
                favoriteFood = if p.bond >= 25 then p.favoriteFood else "???",
                dislikedFood = if p.bond >= 25 then p.dislikedFood else "???",
                bondStage = Personality.bondStage(p),
                rescues = p.rescues,
                ribbons = table.clone(p.ribbons),
                traits = table.clone(p.traits),
                happiness = p.happiness,
                energy = p.energy,
                hunger = p.hunger,
                bond = p.bond,
                mood = Personality.mood(p),
            }
        end
    end
    return {
        petProfiles = petProfiles,
        owned = owned,
        equipped = profile.petIndex,
        discovered = discoveryCount(profile),
        totalReactions = #Config.Reactions,
        feedCount = profile.feedCount,
        survivalCount = profile.survivalCount,
        questClaimed = {
            feeds = profile.questClaimed.feeds,
            survivals = profile.questClaimed.survivals,
            discoveries = profile.questClaimed.discoveries,
        },
        dailyReady = profile.dailyDay < currentDay,
        dailyReward = Config.DAILY_REWARD,
        tutorialSeen = profile.tutorialSeen == true,
    }
end

function Progression.buy(profile: any, rawId: any): (boolean, string)
    if type(rawId) ~= "number" or rawId ~= math.floor(rawId) then
        return false, "Invalid pet."
    end
    local pet = Config.Pets[rawId]
    if not pet then return false, "Unknown pet." end
    if profile.owned[rawId] then return false, "You already own " .. pet.name end
    if profile.coins < pet.price then return false, "Need " .. (pet.price - profile.coins) .. " more coins!" end
    profile.coins -= pet.price
    profile.owned[rawId] = true
    return true, "UNLOCKED " .. string.upper(pet.name) .. "!"
end

function Progression.equip(profile: any, rawId: any): (boolean, string)
    if type(rawId) ~= "number" or rawId ~= math.floor(rawId) or not Config.Pets[rawId] then
        return false, "Unknown pet."
    end
    if not profile.owned[rawId] then return false, "Unlock this pet first." end
    if profile.petIndex == rawId then return false, "Already equipped." end
    profile.petIndex = rawId
    return true, "EQUIPPED " .. string.upper(Config.Pets[rawId].name) .. "!"
end

function Progression.claimDaily(profile: any): (boolean, string)
    local today = math.floor(os.time() / 86400)
    if profile.dailyDay >= today then return false, "Daily treat already claimed. Come back tomorrow!" end
    profile.dailyDay = today
    return true, "DAILY TREAT! +" .. Config.DAILY_REWARD .. " COINS!"
end

return Progression
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="26">
      <Properties>
        <string name="Name">RecipeCatalog</string>
        <string name="Source"><![CDATA[--!strict
-- IMPORTANT: ServerScriptService only. Secret recipes must not replicate to clients.
-- Players discover recipes by experimenting; the recipe book starts EMPTY.
local Catalog = {}
Catalog.Recipes = {
    BerryMash = {name = "Bubbleberry Mash", icon = "🍧", produces = 2, ingredients = {Berry = 2, Tomato = 1}, type = "feed", baseFood = "Candy", extraNoise = 6},
    SpicySoup = {name = "Screaming Soup", icon = "🥣", produces = 2, ingredients = {Pepper = 2, Carrot = 1}, type = "feed", baseFood = "Pepper", extraNoise = 12},
    MoonCandy = {name = "Moon Candy", icon = "🌙", produces = 2, ingredients = {Moonshroom = 1, CrystalMint = 2}, type = "feed", baseFood = "Star", extraNoise = 11},
    BubbleTea = {name = "Bouncy Bubble Tea", icon = "🧋", produces = 2, ingredients = {Jellybean = 1, Berry = 2}, type = "feed", baseFood = "Bubble", extraNoise = 8},
    SillyLure = {name = "Silly Creature Bait", icon = "🪤", produces = 1, ingredients = {Corn = 2, Sunflower = 1}, type = "lure"},
    MonsterLure = {name = "Monster Snack Lure", icon = "🍔", produces = 1, ingredients = {Dragonfruit = 1, Moonshroom = 2}, type = "lure"},
    Compost = {name = "Compost", icon = "🌱", produces = 2, ingredients = {Carrot = 1, Tomato = 1}, type = "fertilizer"},
    Starlight = {name = "Starlight Fertilizer", icon = "✨", produces = 1, ingredients = {CrystalMint = 2, Sunflower = 1}, type = "fertilizer"},

    PumpkinPunch = {name = "Pumpkin Punch", icon = "🎃", produces = 2, ingredients = {GlowPumpkin = 2, HoneyPear = 1}, type = "feed", baseFood = "Candy", extraNoise = 9},
    CloudSmoothie = {name = "Cloud Smoothie", icon = "☁️", produces = 2, ingredients = {CloudCotton = 2, FrostBerry = 1}, type = "feed", baseFood = "Bubble", extraNoise = 7},
    FrostPop = {name = "Frost Pop", icon = "❄️", produces = 2, ingredients = {FrostBerry = 2, Peppermint = 1}, type = "feed", baseFood = "Bubble", extraNoise = 12},
    LavaNoodles = {name = "Lava Noodles", icon = "🔥", produces = 2, ingredients = {LavaMelon = 1, WhisperWheat = 2}, type = "feed", baseFood = "Pepper", extraNoise = 18},
    GrapeGiggle = {name = "Grape Giggle Jelly", icon = "🍇", produces = 2, ingredients = {GummyGrape = 2, BubbleCabbage = 1}, type = "feed", baseFood = "Candy", extraNoise = 11},
    NeonNectar = {name = "Neon Nectar", icon = "💡", produces = 2, ingredients = {NeonMushroom = 1, StardustRice = 2}, type = "feed", baseFood = "Star", extraNoise = 13},
    CaramelCrunch = {name = "Caramel Crunch", icon = "🍯", produces = 2, ingredients = {CaramelApple = 2, CandyCane = 1}, type = "feed", baseFood = "Candy", extraNoise = 10},
    MoonMilk = {name = "Moon Milk", icon = "🌙", produces = 2, ingredients = {MoonLotus = 1, MarshmallowRoot = 2}, type = "feed", baseFood = "Star", extraNoise = 9},
    ThunderTonic = {name = "Thunder Tonic", icon = "⚡", produces = 2, ingredients = {ThunderPlum = 2, Peppermint = 1}, type = "feed", baseFood = "Pepper", extraNoise = 16},
    RadishFizz = {name = "Radish Fizz", icon = "🫧", produces = 2, ingredients = {RainbowRadish = 1, HoneyPear = 2}, type = "feed", baseFood = "Bubble", extraNoise = 10},
    StarlightPop = {name = "Starlight Pop", icon = "🌟", produces = 2, ingredients = {StardustRice = 1, CandyCane = 2}, type = "feed", baseFood = "Star", extraNoise = 14},
    JellyToast = {name = "Jelly Toast", icon = "🍞", produces = 2, ingredients = {JellyCactus = 1, WhisperWheat = 2}, type = "feed", baseFood = "Candy", extraNoise = 8},
    GlowLure = {name = "Glow Lure", icon = "🌕", produces = 1, ingredients = {GlowPumpkin = 1, NeonMushroom = 2}, type = "lure"},
    CloudLure = {name = "Cloud Lure", icon = "🌤️", produces = 1, ingredients = {CloudCotton = 2, MarshmallowRoot = 1}, type = "lure"},
    ThunderLure = {name = "Thunder Lure", icon = "🌩️", produces = 1, ingredients = {ThunderPlum = 2, LavaMelon = 1}, type = "lure"},
    RainbowLure = {name = "Rainbow Lure", icon = "🦋", produces = 1, ingredients = {RainbowRadish = 1, GummyGrape = 2}, type = "lure"},
    HoneyCompost = {name = "Honey Compost", icon = "🍯", produces = 2, ingredients = {HoneyPear = 1, BubbleCabbage = 1}, type = "fertilizer"},
    FrostFertilizer = {name = "Frost Fertilizer", icon = "❄️", produces = 1, ingredients = {FrostBerry = 2, MoonLotus = 1}, type = "fertilizer"},
    MysterySlop = {name = "Oops Soup", icon = "🥴", produces = 1, ingredients = {}, type = "feed", baseFood = "Bubble", extraNoise = 5},
}
Catalog.Order = {"BerryMash", "SpicySoup", "MoonCandy", "BubbleTea", "SillyLure", "MonsterLure", "Compost", "Starlight", "PumpkinPunch", "CloudSmoothie", "FrostPop", "LavaNoodles", "GrapeGiggle", "NeonNectar", "CaramelCrunch", "MoonMilk", "ThunderTonic", "RadishFizz", "StarlightPop", "JellyToast", "GlowLure", "CloudLure", "ThunderLure", "RainbowLure", "HoneyCompost", "FrostFertilizer"}
return Catalog
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="27">
      <Properties>
        <string name="Name">ReferenceBackdropFallback</string>
        <string name="Source"><![CDATA[--!strict
-- Asset-free companion set dressing for the coherent farm opening: citrus
-- foliage, wood fences and an original black toucan wearing a pale-blue cap.
-- These are true Roblox geometry objects, not generated pictures.
local Dressing = {}
local ORANGE = Color3.fromRGB(255,177,75)
local LEAF = Color3.fromRGB(90,159,85)
local SUNNY = Color3.fromRGB(174,204,108)
local DARK = Color3.fromRGB(67,124,77)
local BARK = Color3.fromRGB(152,113,79)
local WOOD = Color3.fromRGB(211,170,125)
local BLACK = Color3.fromRGB(49,56,59)
local BLUE = Color3.fromRGB(151,185,230)
local PALE = Color3.fromRGB(208,215,215)
local GOLD = Color3.fromRGB(252,207,100)
local SHINE = Color3.fromRGB(254,246,228)

local function part(parent: Instance, name: string,
    frame: CFrame, size: Vector3, color: Color3,
    material: Enum.Material?, shape: Enum.PartType?): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = frame
    p.Shape = shape or Enum.PartType.Block
    p.Material = material or Enum.Material.SmoothPlastic
    p.Color = color
    p.CanCollide = false
    p.Anchored = true
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = size.Y > .17
    p.Parent = parent
    return p
end

local function ball(parent: Instance, name: string, p: Vector3,
    size: Vector3, color: Color3)
    return part(parent,name,CFrame.new(p),size,color,nil,Enum.PartType.Ball)
end

local function branch(parent: Instance, name: string, a: Vector3, b: Vector3,
    width: number, tint: Color3)
    local len = (b-a).Magnitude
    return part(parent,name,CFrame.lookAt((a+b)/2,b),
        Vector3.new(width,width,len),tint,Enum.Material.Wood)
end

local function orangeTree(parent: Instance, ground: Vector3, seed: number)
    local rng=Random.new(seed)
    local trunk = ground+Vector3.new(0,3.4,0)
    branch(parent,"OrangeTreeTrunk",ground,trunk,.88,BARK)
    for i=1,3 do
        local t=i*2.39996
        local tip = trunk+Vector3.new(math.cos(t)*2.6,1.8,math.sin(t)*2.4)
        branch(parent,"OrangeTreeBranch",ground+Vector3.new(0,2.1,0),
            tip,.29,BARK)
    end
    for i=1,11 do
        local a=i*2.39996
        local p=ground+Vector3.new(math.cos(a)*(2.4+(i%3)*.43),
            6.1+(i%4)*.44,math.sin(a)*(2.1+(i%2)*.34))
        ball(parent,"MossGreenCanopy",p,Vector3.new(3.1,2.9,2.85),
            if i%3==0 then SUNNY else LEAF)
        for j=1,2 do
            local theta=a+j*2.094
            local l = Instance.new("WedgePart")
            l.Name="CanopyJaggedLeaf"
            l.Size=Vector3.new(.70,.09,1.08)
            l.Color=if j==1 then DARK else SUNNY
            l.Material=Enum.Material.SmoothPlastic
            l.CFrame=CFrame.new(p + Vector3.new(math.sin(theta)*1.40,
                rng:NextNumber(-.65,.8),
                math.cos(theta)*1.18))*CFrame.Angles(0,theta,math.rad(-16))
            l.Anchored=true
            l.CanCollide=false
            l.CanTouch=false
            l.CanQuery=false
            l.CastShadow=false
            l.Parent=parent
        end
    end
    for i=1,10 do
        local a=i*2.39996
        local p=ground+Vector3.new(math.sin(a)*3.1,
            5.3+(i%4)*.5,math.cos(a)*2.7 - .46)
        ball(parent,"OrangeFruit",p,Vector3.new(.72,.75,.73),ORANGE)
        local shine=ball(parent,"FruitSunlight",p+Vector3.new(-.13,.16,-.29),
            Vector3.new(.16,.20,.07),SHINE)
        shine.CastShadow=false
        branch(parent,"CitrusPeduncle",p+Vector3.new(0,.32,0),
            p+Vector3.new(.1,.58,.07),.065,DARK)
    end
end

local function woodFence(parent: Instance, from: Vector3, to: Vector3, posts: number)
    for i=0,posts do
        local at=from:Lerp(to,i/posts)
        local upper=at+Vector3.new(0,2.05,0)
        branch(parent,"PicketFencePost",at,upper,.35,WOOD)
        ball(parent,"RoundFenceFinial",upper,Vector3.new(.40,.39,.40),WOOD)
    end
    for y=.72,1.53,.81 do
        branch(parent,"PastelWoodFenceRail",
            from+Vector3.new(0,y,0),to+Vector3.new(0,y,0),.24,WOOD)
    end
end

local function toucan(parent: Instance, ground: Vector3)
    local center=ground+Vector3.new(0,1.28,0)
    ball(parent,"ToucanBlackBody",center,
        Vector3.new(1.68,2.32,1.43),BLACK)
    ball(parent,"ToucanSoftChest",center+Vector3.new(0,-.27,-.65),
        Vector3.new(.98,1.36,.22),PALE)
    ball(parent,"ToucanRoundHead",center+Vector3.new(0,.96,-.38),
        Vector3.new(1.58,1.58,1.46),BLACK)
    for sign=-1,1,2 do
        local eye=center+Vector3.new(sign*.44,1.04,-1.10)
        ball(parent,"ToucanGoldenEyeRing",eye,
            Vector3.new(.30,.34,.13),GOLD)
        ball(parent,"ToucanPupil",eye+Vector3.new(0,0,-.09),
            Vector3.new(.14,.17,.09),BLACK)
        ball(parent,"ToucanWing",center+Vector3.new(sign*.73,-.24,.20),
            Vector3.new(.30,1.18,.85),BLACK)
        branch(parent,"ToucanPerchLeg",
            ground+Vector3.new(sign*.41,.09,.24),
            ground+Vector3.new(sign*.41,.46,.10),.14,GOLD)
    end
    -- Beak is thick, readable in three-quarter view, with a grey upper bill.
    local bill=ball(parent,"ToucanCurvedBeak",
        center+Vector3.new(.18,.86,-1.38),
        Vector3.new(1.13,.85,1.17),PALE)
    bill.CFrame *= CFrame.Angles(0,math.rad(-19),math.rad(10))
    ball(parent,"ToucanBeakTip",center+Vector3.new(.38,.67,-1.79),
        Vector3.new(.67,.44,.66),Color3.fromRGB(171,186,186))
    local cap=ball(parent,"ToucanBlueCap",
        center+Vector3.new(0,1.72,-.32),
        Vector3.new(1.61,.43,1.43),BLUE)
    cap.CFrame *= CFrame.Angles(math.rad(-8),0,0)
    ball(parent,"ToucanCapBrim",center+Vector3.new(0,1.54,-1.01),
        Vector3.new(1.23,.16,.65),BLUE)
    -- Yellow emblem on the cap instead of copying any brand logo.
    ball(parent,"UnbrandedCapEmblem",
        center+Vector3.new(.11,1.79,-1.02),
        Vector3.new(.21,.14,.07),SHINE).CastShadow=false
end

function Dressing.build(world: Instance): Folder
    local old=world:FindFirstChild("ReferenceNativeBackdrop")
    if old then old:Destroy() end
    local folder=Instance.new("Folder")
    folder.Name="ReferenceNativeBackdrop"
    folder.Parent=world
    -- Tall orange branches on the right/rear, open corridor in front.
    orangeTree(folder,Vector3.new(16.5,7.15,65),4122)
    orangeTree(folder,Vector3.new(34,7.15,64),4833)
    orangeTree(folder,Vector3.new(-34,7.15,59),6401)
    woodFence(folder,Vector3.new(-36,7.23,62),
        Vector3.new(-17,7.23,62),5)
    woodFence(folder,Vector3.new(17,7.23,62),
        Vector3.new(39,7.23,62),6)
    -- The toucan stands behind the first strawberry bed (not on the path).
    toucan(folder,Vector3.new(-17.7,7.14,66.0))
    folder:SetAttribute("ArtSource","NativeGeometryNoExternalAssets")
    return folder
end

return Dressing
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="28">
      <Properties>
        <string name="Name">ReferenceCropArt</string>
        <string name="Source"><![CDATA[--!strict
-- A coherent, original hand-shaped crop language for the photographed cottage-garden mood.
-- Cosmetic only: the server's growth, mutations, yield, purchases and hit detection stay untouched.
-- All art is deterministic and uses non-colliding, non-queryable, anchored parts.
local CropArt = {}

local GREEN = Color3.fromRGB(96, 158, 88)
local LEAF = Color3.fromRGB(122, 177, 93)
local LEAF_LIT = Color3.fromRGB(167, 205, 110)
local DARK = Color3.fromRGB(69, 120, 72)
local EARTH = Color3.fromRGB(137, 103, 76)
local STRAW = Color3.fromRGB(239, 206, 127)
local CREAM = Color3.fromRGB(253, 238, 197)
local RED = Color3.fromRGB(233, 81, 79)
local ORANGE = Color3.fromRGB(243, 148, 67)
local PINK = Color3.fromRGB(246, 173, 194)
local MINT = Color3.fromRGB(153, 212, 175)

local function piece(parent: Instance, name: string, pos: Vector3,
    size: Vector3, color: Color3, material: Enum.Material?): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Shape = Enum.PartType.Ball
    p.CFrame = CFrame.new(pos)
    p.Material = material or Enum.Material.SmoothPlastic
    p.Color = color
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = size.Magnitude > 2.5
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function stem(parent: Instance, name: string, from: Vector3,
    to: Vector3, width: number, color: Color3)
    local displacement = to - from
    local p = Instance.new("Part")
    p.Name = name
    p.Size = Vector3.new(width, width, displacement.Magnitude)
    p.CFrame = CFrame.lookAt((from + to) * 0.5, to)
    p.Material = Enum.Material.SmoothPlastic
    p.Color = color
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Parent = parent
    return p
end

local function leaf(parent: Instance, pos: Vector3, length: number,
    width: number, angle: number, tint: Color3)
    -- An angular tapered, slightly lifted leaf rather than another ball:
    -- matches the pointed foliage language in the supplied garden reference.
    local p = Instance.new("WedgePart")
    p.Name = "PaintedLeaf"
    p.Size = Vector3.new(width, 0.15, length)
    p.CFrame = CFrame.new(pos) *
        CFrame.Angles(math.rad(-12), math.rad(angle), math.rad(5))
    p.Color = tint
    p.Material = Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Parent = parent
    return p
end

local function plantBase(parent: Instance, pos: Vector3, scale: number, leaves: number)
    for i = 1, leaves do
        local a = 2.39996 * i
        leaf(parent, pos + Vector3.new(math.cos(a) * 0.57 * scale, 0.14 * scale, math.sin(a) * 0.55 * scale),
            1.25 * scale, 0.73 * scale, math.deg(a), if i % 2 == 0 then LEAF_LIT else GREEN)
    end
end

local function littleSeeds(parent: Instance, center: Vector3, scale: number)
    -- Five small seed dimples follow the berry's front curvature.
    for i = 1, 5 do
        local col = (i - 1) % 3 - 1
        local row = math.floor((i - 1) / 3)
        local x = col * .25 * scale
        local y = (row == 0 and .10 or -.23) * scale
        local z = -.52 * scale + math.abs(col) * .07 * scale
        piece(parent, "StrawberrySeed", center + Vector3.new(x, y, z),
            Vector3.new(.12, .15, .07) * scale, CREAM)
    end
end

local function strawberry(parent: Instance, origin: Vector3, s: number, stage: number, tint: Color3)
    for i = 1, 3 do
        local x = (i - 2) * 1.43 * s
        local z = (i % 2 == 0 and 0.68 or -0.56) * s
        local base = origin + Vector3.new(x, 0, z)
        plantBase(parent, base, s, if stage == 3 then 5 else 3)
        local top = base + Vector3.new(0, 1.23 * s, 0)
        stem(parent, "BerryStem", base, top, 0.17 * s, DARK)
        for j = 1, (if stage == 3 then 5 else 3) do
            local a = j * 2.39996 + i * 0.37
            leaf(parent, top + Vector3.new(math.cos(a) * 0.66 * s,
                (j%2)*0.12*s, math.sin(a) * 0.64 * s),
                (if j%3==0 then 1.62 else 1.38) * s, 0.88 * s,
                math.deg(a), if j % 3 == 0 then LEAF_LIT else LEAF)
        end
        if stage >= 2 then
            local r = if stage == 2 then 0.49 else 0.69
            for berryIndex = 1, (if stage == 3 then 2 else 1) do
                local facing = if berryIndex == 1 then -1 else 1
                local fruit = base + Vector3.new(
                    facing * (0.65 + (i%2)*0.13) * s,
                    (if berryIndex == 1 then 0.70 else 0.54) * s,
                    (-0.34 - (berryIndex-1)*0.24) * s)
                stem(parent, "HangingBerry", top,
                    fruit + Vector3.new(0, r * s * 0.46, 0), 0.076 * s, DARK)
                local bright = if i%2==0 then RED else tint
                local fruitShape = piece(parent, "HeartShapedBerry", fruit,
                    Vector3.new(1.05, 1.24, 1.0) * r * s,
                    if stage == 2 then PINK else bright)
                fruitShape.CFrame *= CFrame.Angles(0,math.rad(i*27),math.rad((berryIndex-1)*8))
                -- Five serrated sepals make the strawberry silhouette legible.
                for sepal = 1, 5 do
                    local a = sepal * math.pi * 2 / 5
                    leaf(parent, fruit + Vector3.new(math.cos(a) * .23 * r * s,
                        .68 * r * s, math.sin(a) * .23 * r * s),
                        .69 * r * s, .28 * r * s, math.deg(a), DARK)
                end
                if stage == 3 then littleSeeds(parent, fruit, r * s) end
            end
        end
    end
end

local function stripedMelon(parent: Instance, center: Vector3, scale: number, tint: Color3)
    -- Curved rind bands are sampled against the surface of an ellipsoid.
    -- A segmented painted ribbon reads as a real watermelon from the
    -- three-quarter camera, unlike five vertical sticks floating out front.
    local body = piece(parent, "GardenWatermelon",
        center, Vector3.new(2.7, 2.14, 2.62) * scale, tint)
    body.CastShadow = true
    for stripe = -2, 2 do
        local x = stripe * .37 * scale
        for segment = 1, 3 do
            local yUnit = (segment - 2) * .48
            local xUnit = x / (1.35 * scale)
            local depth = math.sqrt(math.max(.06, 1 - xUnit*xUnit - yUnit*yUnit))
            local z = -1.31 * scale * depth - .035
            local p = piece(parent, "CurvedMelonStripe",
                center + Vector3.new(x, yUnit * 1.07 * scale, z),
                Vector3.new(.19, .49, .08) * scale, DARK)
            p.CFrame *= CFrame.Angles(math.rad((segment - 2) * 34),
                0, math.rad(stripe * 5))
            p.CastShadow = false
        end
    end
    local crown = center + Vector3.new(.17 * scale, 1.04 * scale, .09 * scale)
    for i = 1, 5 do
        local a = i * math.pi * 2 / 5
        leaf(parent, crown + Vector3.new(math.cos(a)*.17*scale, 0,
            math.sin(a)*.17*scale), .70*scale, .28*scale,
            math.deg(a), if i % 2 == 0 then LEAF_LIT else DARK)
    end
    piece(parent, "MelonTail", crown + Vector3.new(0, .19 * scale, 0),
        Vector3.new(.20, .38, .22) * scale, DARK)
end

local function melon(parent: Instance, origin: Vector3, s: number, stage: number, tint: Color3)
    for i = 1, 4 do
        local a = 2.39996 * i
        local start = origin + Vector3.new(math.cos(a) * 0.25 * s, 0, math.sin(a) * 0.25 * s)
        leaf(parent, start + Vector3.new(math.cos(a) * 0.89 * s, 0.2 * s, math.sin(a) * 0.86 * s),
            1.8 * s, 1.23 * s, math.deg(a), if i % 2 == 0 then LEAF_LIT else GREEN)
    end
    if stage >= 2 then
        stripedMelon(parent, origin + Vector3.new(-0.91 * s, 0.92 * s, -0.52 * s),
            (if stage == 2 then 0.59 else 0.9) * s, tint)
        if stage == 3 then
            stripedMelon(parent, origin + Vector3.new(1.18 * s, 0.85 * s, 0.91 * s), 0.68 * s, tint)
            stripedMelon(parent, origin + Vector3.new(0.15 * s, 0.66 * s, 1.18 * s), 0.52 * s, tint)
        end
    end
end

local function carrot(parent: Instance, origin: Vector3, s: number, stage: number)
    for i = 1, 3 do
        local angle = i * 2.39996
        local loc = origin + Vector3.new(math.cos(angle) * 1.14 * s, 0, math.sin(angle) * 1.15 * s)
        local rootHeight = if stage == 1 then 0.34 else if stage == 2 then 0.7 else 1.18
        piece(parent, "CarrotRoot", loc + Vector3.new(0, rootHeight * 0.34 * s, 0),
            Vector3.new(0.84, rootHeight, 0.84) * s, ORANGE)
        for j = 1, 3 do
            local a = j * 2.094
            stem(parent, "CarrotStem", loc + Vector3.new(0, rootHeight * 0.72 * s, 0),
                loc + Vector3.new(math.cos(a) * 0.48 * s, (rootHeight + 0.86) * s, math.sin(a) * 0.48 * s),
                0.12 * s, DARK)
            leaf(parent, loc + Vector3.new(math.cos(a) * 0.6 * s, (rootHeight + 0.84) * s, math.sin(a) * 0.6 * s),
                0.92 * s, 0.5 * s, math.deg(a), GREEN)
        end
    end
end

local function grain(parent: Instance, origin: Vector3, s: number, stage: number, kind: string, tint: Color3)
    for i = 1, 4 do
        local a = i * 2.39996
        local pos = origin + Vector3.new(math.cos(a) * 1.23 * s, 0, math.sin(a) * 1.23 * s)
        local h = (if stage == 1 then 0.95 elseif stage == 2 then 1.65 else 2.65) * s
        stem(parent, "WheatStalk", pos, pos + Vector3.new(0, h, 0), 0.13 * s, DARK)
        leaf(parent, pos + Vector3.new(0.35 * s, h * 0.35, 0), 1.16 * s, 0.46 * s, 15, GREEN)
        if stage >= 2 then
            if kind == "Corn" then
                piece(parent, "CornCob", pos + Vector3.new(0.12 * s, h * 0.73, -0.12 * s),
                    Vector3.new(0.82, 1.45, 0.79) * s, tint)
                leaf(parent, pos + Vector3.new(0.6 * s, h * 0.48, 0), 1.16 * s, 0.5 * s, 40, GREEN)
            else
                -- A tapered wheat ear: paired small spikelets, directional
                -- long awns and a visible straw-colored spike. This avoids
                -- the old three round yellow beads perched on each stalk.
                local golden = if kind == "WhisperWheat" then STRAW else tint
                local tipY = h * .94
                for j = 1, 4 do
                    local y = tipY + j * .24 * s
                    local width = (.21 - j * .025) * s
                    for side = -1, 1, 2 do
                        local grain = piece(parent, "WheatSpikelet",
                            pos + Vector3.new(side * width * .55, y,
                                side * .06 * s),
                            Vector3.new(.25, .41, .26) * s, golden)
                        grain.CFrame *= CFrame.Angles(0, 0,
                            math.rad(side * (16 + j * 5)))
                    end
                end
                for awn = -1, 1, 2 do
                    leaf(parent, pos + Vector3.new(awn * .24 * s,
                        tipY + 1.04 * s, 0),
                        .65 * s, .13 * s, awn * 19, golden)
                end
            end
        end
    end
end

local function bushFruit(parent: Instance, origin: Vector3, s: number, stage: number,
    kind: string, tint: Color3)
    for i = 1, 3 do
        local a = i * 2.39996
        local p = origin + Vector3.new(math.cos(a) * 0.85 * s, 0, math.sin(a) * 0.79 * s)
        local tip = p + Vector3.new(0, 1.66 * s, 0)
        stem(parent, "BushStem", p, tip, 0.19 * s, DARK)
        plantBase(parent, p + Vector3.new(0, 0.84 * s, 0), s, 4)
        if stage >= 2 then
            for j = 1, 2 do
                local off = if j == 1 then -0.6 else 0.65
                local fruit = tip + Vector3.new(off * s, -0.58 * s, -0.31 * s)
                if kind == "Pepper" then
                    piece(parent, "HangingPepper", fruit, Vector3.new(0.61, 1.35, 0.57) * s, tint)
                elseif kind == "GummyGrape" or kind == "Jellybean" then
                    piece(parent, "FruitBunch", fruit, Vector3.new(0.79, 0.96, 0.75) * s, tint)
                else
                    piece(parent, "RipeTomato", fruit, Vector3.new(0.92, 0.91, 0.90) * s, tint)
                end
                leaf(parent, fruit + Vector3.new(0, 0.48 * s, 0), 0.65 * s, 0.42 * s, j * 68, DARK)
            end
        end
    end
end

local function flowering(parent: Instance, origin: Vector3, s: number,
    stage: number, kind: string, tint: Color3)
    local count = if stage == 3 then 3 else 2
    for i = 1, count do
        local a = i * 2.39996
        local base = origin + Vector3.new(math.cos(a) * 1.18 * s, 0, math.sin(a) * 1.15 * s)
        local h = (if stage == 1 then 0.83 elseif stage == 2 then 1.55 else 2.5) * s
        local top = base + Vector3.new(0, h, 0)
        stem(parent, "FlowerStem", base, top, 0.2 * s, DARK)
        leaf(parent, base + Vector3.new(0.39 * s, h * 0.46, 0), 1.32 * s, 0.66 * s, 25, GREEN)
        if stage >= 2 then
            local petalTint = if kind == "Sunflower" then STRAW else tint
            local r = (if stage == 2 then 0.5 else 0.72) * s
            for j = 1, 6 do
                local petalAngle = j * math.pi / 3
                local p = piece(parent, "FlowerPetal",
                    top + Vector3.new(math.cos(petalAngle) * 0.66 * r, math.sin(petalAngle) * 0.65 * r, -0.18 * r),
                    Vector3.new(0.86, 0.62, 0.25) * r, petalTint)
                p.CFrame *= CFrame.Angles(0, 0, petalAngle)
            end
            piece(parent, "FlowerHeart", top + Vector3.new(0, 0, -0.37 * r),
                Vector3.new(0.82, 0.82, 0.34) * r, if kind == "Sunflower" then EARTH else CREAM)
        end
    end
end

local function mushrooms(parent: Instance, origin: Vector3, s: number, stage: number, tint: Color3)
    for i = 1, 3 do
        local a = i * 2.39996
        local pos = origin + Vector3.new(math.cos(a) * 1.10 * s, 0, math.sin(a) * 1.15 * s)
        local h = (if stage == 1 then 0.35 elseif stage == 2 then 0.75 else 1.20) * s
        stem(parent, "MushroomStalk", pos, pos + Vector3.new(0, h, 0), 0.38 * s, CREAM)
        if stage >= 2 then
            local top = pos + Vector3.new(0, h, 0)
            piece(parent, "VelvetMushroomCap", top, Vector3.new(1.60, 0.70, 1.55) * s, tint)
            for j = 1, 3 do
                local b = j * 2.094
                piece(parent, "MushroomDot", top + Vector3.new(math.cos(b) * 0.39 * s, 0.36 * s, math.sin(b) * 0.3 * s),
                    Vector3.new(0.19, 0.13, 0.19) * s, CREAM)
            end
        end
    end
end

local function fantasy(parent: Instance, origin: Vector3, s: number, stage: number, kind: string, tint: Color3)
    -- Explicitly non-real-world crops retain a playful, legible silhouette.
    local tall = (if stage == 1 then 0.95 elseif stage == 2 then 1.65 else 2.50) * s
    for i = 1, 3 do
        local a = i * 2.39996
        local base = origin + Vector3.new(math.cos(a) * 1.12 * s, 0, math.sin(a) * 1.12 * s)
        local tip = base + Vector3.new(0, tall, 0)
        stem(parent, "FantasyCropStem", base, tip, 0.20 * s, DARK)
        plantBase(parent, base + Vector3.new(0, tall * 0.43, 0), s, 3)
        if stage >= 2 then
            if kind == "JellyCactus" or kind == "CrystalMint" or kind == "BubbleCabbage" then
                piece(parent, "FantasySucculent", tip, Vector3.new(1.12, 1.32, 1.07) * s, tint)
                leaf(parent, tip + Vector3.new(0, 0.58 * s, 0), 0.86 * s, 0.7 * s, i * 31, LEAF_LIT)
            else
                piece(parent, "FantasyFruit", tip, Vector3.new(1.16, 1.11, 1.08) * s, tint)
                piece(parent, "FantasyFruitGlint", tip + Vector3.new(-0.24 * s, 0.3 * s, -0.48 * s),
                    Vector3.new(0.22, 0.34, 0.11) * s, CREAM)
            end
        end
    end
end

function CropArt.draw(parent: Instance, center: Vector3,
    seedType: string, stage: number, color: Color3)
    if stage < 1 then return end
    local s = if stage == 1 then 0.54 elseif stage == 2 then 0.78 else 0.94
    local origin = center + Vector3.new(0, 0.72, 0)

    if seedType == "Berry" or seedType == "FrostBerry" then
        strawberry(parent, origin, s, stage, if seedType == "Berry" then RED else color)
    elseif seedType == "LavaMelon" or seedType == "AuroraMelon" then
        melon(parent, origin, s, stage, if seedType == "LavaMelon" then Color3.fromRGB(150, 189, 91) else color)
    elseif seedType == "Carrot" or seedType == "RainbowRadish" or seedType == "MarshmallowRoot" then
        carrot(parent, origin, s, stage)
    elseif seedType == "Corn" or seedType == "WhisperWheat" or seedType == "StardustRice" or seedType == "CandyCane" then
        grain(parent, origin, s, stage, seedType, color)
    elseif seedType == "Tomato" or seedType == "Pepper" or seedType == "GummyGrape" or seedType == "Jellybean" then
        bushFruit(parent, origin, s, stage, seedType, color)
    elseif seedType == "Sunflower" or seedType == "MoonLotus" or seedType == "Starbloom" or seedType == "CloudCotton" then
        flowering(parent, origin, s, stage, seedType, color)
    elseif seedType == "Moonshroom" or seedType == "NeonMushroom" then
        mushrooms(parent, origin, s, stage, color)
    else
        fantasy(parent, origin, s, stage, seedType, color)
    end
end

return CropArt
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="29">
      <Properties>
        <string name="Name">ReferenceFoliageLayer</string>
        <string name="Source"><![CDATA[--!strict
-- Dense, asymmetrical painted foliage for the reference garden.
-- Engine-native WedgeParts are deliberately used so the actual .rbxlx shows
-- the garden on a fresh account WITHOUT creator-uploaded MeshIds.
-- Scene dressing is static, non-colliding and capped for low-end devices.
local Detail = {}

local DARK = Color3.fromRGB(62, 121, 72)
local GREEN = Color3.fromRGB(91, 156, 83)
local LIGHT = Color3.fromRGB(166, 204, 105)
local LIME = Color3.fromRGB(192, 216, 125)
local SOIL = Color3.fromRGB(122, 91, 66)
local GOLD = Color3.fromRGB(243, 209, 151)
local IVORY = Color3.fromRGB(255, 244, 210)
local ROSE = Color3.fromRGB(254, 188, 183)

local LIMIT = 410
local used = 0

local function part(parent: Instance, name: string, at: CFrame,
    size: Vector3, color: Color3, kind: Enum.PartType?): Part?
    if used >= LIMIT then return nil end
    used += 1
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = at
    p.Color = color
    p.Material = Enum.Material.SmoothPlastic
    p.Shape = kind or Enum.PartType.Block
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Anchored = true
    p.CastShadow = false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function foliageBlade(parent: Instance, origin: Vector3,
    direction: Vector3, width: number, height: number, tint: Color3)
    if used >= LIMIT then return end
    local tip = origin + direction
    local mid = (origin + tip) * 0.5
    local blade = Instance.new("WedgePart")
    blade.Name = "PaintedAngularLeaf"
    blade.Material = Enum.Material.SmoothPlastic
    blade.Color = tint
    blade.Anchored = true
    blade.CanCollide = false
    blade.CanTouch = false
    blade.CanQuery = false
    blade.CastShadow = false
    blade.Size = Vector3.new(width, height, direction.Magnitude)
    blade.CFrame = CFrame.lookAt(mid, tip) * CFrame.Angles(0, 0, math.rad(6))
    blade.Parent = parent
    used += 1
end

local function grass(parent: Instance, ground: Vector3, seed: number)
    local a = seed * 2.39996
    for j = 1, 3 do
        local theta = a + j * 2.0944
        local dir = Vector3.new(math.sin(theta) * .47,
            .65 + .18 * math.sin(seed+j), math.cos(theta) * .45)
        foliageBlade(parent, ground, dir, .13,
            .08, if j==1 then LIGHT else GREEN)
    end
end

local function tinyDaisy(parent: Instance, ground: Vector3, seed: number)
    local stem = ground + Vector3.new(0, .46, 0)
    part(parent, "FlowerStem", CFrame.new(ground + Vector3.new(0, .22, 0)),
        Vector3.new(.075,.45,.075), DARK)
    for j = 1, 4 do
        local a = j * math.pi/2 + seed*.27
        local center = stem + Vector3.new(math.sin(a)*.20, 0, math.cos(a)*.20)
        part(parent,"Petal",CFrame.new(center),Vector3.new(.30,.08,.21),
            if seed%3==0 then ROSE else IVORY,Enum.PartType.Ball)
    end
    part(parent,"FlowerHeart",CFrame.new(stem + Vector3.new(0,.06,0)),
        Vector3.new(.18,.11,.18),GOLD,Enum.PartType.Ball)
end

local function orchardLeaves(parent: Instance, origin: Vector3, seed: number)
    -- Angular, overlapping cards break up the old uniform spherical canopy.
    -- Silhouettes point outwards, with front-facing highlights as in the supplied
    -- painterly reference. Fruit and branches remain real 3D objects below.
    for i = 1, 54 do
        local a = i * 2.399963 + seed*.09
        local r = 2.25 + (i%5)*.23
        local radial = Vector3.new(math.sin(a)*r, 0, math.cos(a)*r)
        local y = 5.80 + (i%9)*.36
        local place = origin + radial + Vector3.new(0,y,0)
        local outward = Vector3.new(math.sin(a)*.42,
            math.cos(i*1.7)*.27, math.cos(a)*.45)
        foliageBlade(parent, place, outward, .34+(i%3)*.14, .085,
            if i%5==0 then LIME elseif i%3==0 then LIGHT
            elseif i%2==0 then GREEN else DARK)
    end
end

local function groundDetails(parent: Instance)
    -- A readable central path must stay free; reserve a 10-stud-wide corridor.
    -- Scatter very small elements at the crop/stone edge, not on interaction
    -- prompts or crop plots. The source image has dappled groundcover.
    local r = Random.new(20261120)
    for i = 1, 33 do
        local side = if i%2==0 then -1 else 1
        local x = side * r:NextNumber(10.8, 16.7)
        local z = r:NextNumber(44, 96)
        local p = Vector3.new(x, 7.26, z)
        if i%6==0 then
            tinyDaisy(parent, p, i)
        else
            grass(parent,p,i)
        end
        if i%3==0 then
            local patch = part(parent,"CloverLightPatch",
                CFrame.new(p+Vector3.new(0,-.06,0)) *
                    CFrame.Angles(0,math.rad(i*17),0),
                Vector3.new(.61,.045,.48),
                if i%2==0 then GREEN else LIGHT,Enum.PartType.Ball)
            if patch then patch.Transparency = .08 end
        end
    end
end

local function berryLeafPass(parent: Instance)
    -- Additional leaf silhouettes make the otherwise spherical strawberries
    -- read as actual low garden bushes from the high three-quarter camera.
    for row = 1, 3 do
        for col = 1, 3 do
            local center = Vector3.new(-30+col*4.15,7.17,67+row*4.65)
            for j = 1, 9 do
                local a = j * 2.39996 + row*.14
                local rad = 1.6 + (j%3)*.33
                local root = center + Vector3.new(math.sin(a)*rad,
                    .49+(j%2)*.20, math.cos(a)*rad)
                foliageBlade(parent,root,
                    Vector3.new(math.sin(a)*.66,.09+(j%3)*.08,
                        math.cos(a)*.56), .36, .10,
                    if j%4==0 then LIGHT elseif j%2==0 then GREEN else DARK)
            end
        end
    end
end

function Detail.build(parent: Instance, withTrees: boolean, withBerries: boolean): Folder
    local existing = parent:FindFirstChild("ReferencePaintedFoliage")
    if existing then existing:Destroy() end
    used = 0
    local folder = Instance.new("Folder")
    folder.Name = "ReferencePaintedFoliage"
    folder.Parent = parent
    if withTrees then
        orchardLeaves(folder,Vector3.new(16.5,7.15,65),31)
        orchardLeaves(folder,Vector3.new(34,7.15,64),43)
        orchardLeaves(folder,Vector3.new(-34,7.15,59),57)
    end
    if withBerries then berryLeafPass(folder) end
    groundDetails(folder)
    folder:SetAttribute("Source","NativeRobloxParts_NoMeshIds")
    folder:SetAttribute("PartBudget",LIMIT)
    folder:SetAttribute("PartCount",used)
    return folder
end

return Detail
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="30">
      <Properties>
        <string name="Name">ReferenceGardenFallback</string>
        <string name="Source"><![CDATA[--!strict
-- Reference-focused native garden for a playable, asset-free .rbxlx.
-- Real Roblox BaseParts/WedgeParts are created by the server. No image mocks,
-- MeshId, imported package, plugin or Roblox authentication required.
-- Imported mesh entrance art takes priority when available.
local NativeGarden = {}

local SOIL = Color3.fromRGB(123, 91, 65)
local DARK_SOIL = Color3.fromRGB(96, 75, 56)
local LEAF = Color3.fromRGB(82, 149, 79)
local LEAF_DEEP = Color3.fromRGB(55, 118, 72)
local LEAF_SUN = Color3.fromRGB(151, 190, 83)
local RED = Color3.fromRGB(234, 75, 75)
local RED_LIGHT = Color3.fromRGB(250, 112, 102)
local CREAM = Color3.fromRGB(255, 239, 203)
local MELON = Color3.fromRGB(171, 215, 85)
local MELON_PALE = Color3.fromRGB(214, 232, 133)
local RIND = Color3.fromRGB(81, 150, 78)
local WHEAT = Color3.fromRGB(250, 228, 157)
local GOLD = Color3.fromRGB(237, 189, 105)
local ORANGE = Color3.fromRGB(244, 146, 70)
local PINK = Color3.fromRGB(249, 192, 198)

local function piece(parent: Instance, name: string, at: CFrame, size: Vector3,
    color: Color3, shape: Enum.PartType?): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Shape = shape or Enum.PartType.Block
    p.Material = Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = size.Y > 0.25
    p.Color = color
    p.Size = size
    p.CFrame = at
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function ball(parent: Instance, name: string, pos: Vector3,
    size: Vector3, tint: Color3): Part
    return piece(parent, name, CFrame.new(pos), size, tint, Enum.PartType.Ball)
end

local function stalk(parent: Instance, name: string, a: Vector3, b: Vector3,
    width: number, color: Color3)
    local v = b - a
    if v.Magnitude <= 0.02 then return end
    local mid = (a + b) * 0.5
    local part = piece(parent, name, CFrame.lookAt(mid, b),
        Vector3.new(width, width, v.Magnitude), color)
    part.CastShadow = false
end

local function leaf(parent: Instance, start: Vector3, tip: Vector3,
    width: number, tint: Color3)
    local line = tip - start
    if line.Magnitude < 0.1 then return end
    local mid = (start + tip) * 0.5 + Vector3.new(0, 0.05, 0)
    local l = Instance.new("WedgePart")
    l.Name = "PaintedTaperedLeaf"
    l.Size = Vector3.new(width, 0.11, line.Magnitude)
    l.Color = tint
    l.Material = Enum.Material.SmoothPlastic
    l.Anchored = true
    l.CanCollide = false
    l.CanTouch = false
    l.CanQuery = false
    l.CastShadow = false
    l.CFrame = CFrame.lookAt(mid, tip)
    l.Parent = parent
end

local function blossom(parent: Instance, point: Vector3, scale: number, pink: boolean)
    local color = if pink then PINK else CREAM
    for i = 1, 5 do
        local theta = i * math.pi * 2 / 5
        local petal = ball(parent, "MeadowPetal",
            point + Vector3.new(math.cos(theta) * 0.22 * scale, 0.02,
                math.sin(theta) * 0.22 * scale),
            Vector3.new(0.27, 0.09, 0.36) * scale, color)
        petal.CastShadow = false
    end
    ball(parent, "GoldenFlowerCenter", point + Vector3.new(0, 0.10, 0),
        Vector3.new(0.24, 0.13, 0.24) * scale, GOLD).CastShadow = false
end

local function strawberry(parent: Instance, center: Vector3, seed: number)
    local rng = Random.new(seed)
    -- The dark organic soil patch gives a readable grounding, as in the reference.
    local soil = ball(parent, "StrawberryEarth", center + Vector3.new(0, 0.12, 0),
        Vector3.new(5.9, 0.28, 5.3), SOIL)
    soil.Material = Enum.Material.Ground
    for i = 1, 6 do
        local theta = i * 2.39996
        local r = if i % 2 == 0 then 1.65 else 1.05
        local pos = center + Vector3.new(math.sin(theta)*r, 0.20,
            math.cos(theta)*r)
        local tip = pos + Vector3.new(math.sin(theta)*0.18,
            rng:NextNumber(0.85, 1.15), math.cos(theta)*0.18)
        stalk(parent, "BerryStem", pos, tip, 0.11, LEAF_DEEP)
        for j = 1, 3 do
            local a = theta + j * math.pi * 2 / 3
            leaf(parent, tip, tip + Vector3.new(math.cos(a)*1.02,
                rng:NextNumber(-0.12, 0.18), math.sin(a)*0.89),
                0.57, if j == 1 then LEAF_SUN else LEAF)
        end
        if i <= 5 then
            local berry = tip + Vector3.new(math.sin(theta)*0.36, -0.46,
                math.cos(theta)*0.39 - 0.05)
            stalk(parent, "BerryPeduncle", tip,
                berry + Vector3.new(0, 0.38, 0), 0.045, LEAF_DEEP)
            local fruit = ball(parent, "RipeRedStrawberry", berry,
                Vector3.new(0.68, 0.92, 0.72),
                if i%2==0 then RED_LIGHT else RED)
            fruit.CFrame *= CFrame.Angles(math.rad(9), theta, math.rad(5))
            for k = 1, 3 do
                local a = k * 2.094
                leaf(parent, berry + Vector3.new(0, 0.38, 0),
                    berry + Vector3.new(math.cos(a)*0.37, 0.38,
                        math.sin(a)*0.34), 0.17, LEAF_DEEP)
            end
            for k = 1, 2 do
                ball(parent, "BerrySeed",
                    berry + Vector3.new((k-1.5)*0.19, -0.03, -0.356),
                    Vector3.new(0.058, 0.105, 0.035), CREAM).CastShadow = false
            end
        end
    end
    if seed % 3 == 0 then
        blossom(parent, center + Vector3.new(0.26, 1.09, -0.21), 0.72, false)
    end
end

local function melon(parent: Instance, center: Vector3, seed: number)
    local rnd = Random.new(seed)
    local dirt = ball(parent, "WatermelonBed", center + Vector3.new(0, 0.13, 0),
        Vector3.new(6.4, 0.24, 5.8), SOIL)
    dirt.Material = Enum.Material.Ground
    for i = 1, 3 do
        local a = i * 2.39996
        local x = math.sin(a) * 1.25
        local z = math.cos(a) * 1.15
        stalk(parent, "MelonRunner", center+Vector3.new(0,.23,0),
            center+Vector3.new(x,.27,z),0.13, LEAF_DEEP)
        local fruitCenter = center + Vector3.new(x, 1.04, z)
        local fruit = ball(parent, "StripedWatermelon", fruitCenter,
            Vector3.new(1.83, 1.80, 1.69),
            if i%2==0 then MELON_PALE else MELON)
        fruit.CFrame *= CFrame.Angles(0, a, 0)
        -- Curved rind bands hug the melon instead of floating straight
        -- vertical rods on the front. Keep the detail to five short ribbons.
        for stripe = -2, 2 do
            local xOffset = stripe * 0.28
            local horizontal = math.sqrt(math.max(0.05, 1 - (xOffset / 0.915)^2))
            for segment = 1, 5 do
                local t = -1.1 + (segment - 0.5) * 0.44
                local y = math.sin(t) * 0.86
                local z = -math.cos(t) * 0.845 * horizontal
                local ribbon = ball(parent, "CurvedMelonRind",
                    fruitCenter + Vector3.new(xOffset, y, z - 0.014),
                    Vector3.new(0.095, 0.39, 0.065), RIND)
                ribbon.CFrame *= CFrame.Angles(t * 0.76, a * 0.07, math.rad(stripe * 3))
                ribbon.CastShadow = false
            end
        end
        -- A small five-lobed green crown ties the fruit to the vine.
        for leafIndex = 1, 5 do
            local theta = leafIndex * math.pi * 2 / 5
            leaf(parent, fruitCenter + Vector3.new(0, 0.83, 0),
                fruitCenter + Vector3.new(math.cos(theta)*0.53, 0.82,
                    math.sin(theta)*0.48), 0.24, LEAF_DEEP)
        end
        for j = 1, 3 do
            local angle = a + j*2.094
            leaf(parent, center + Vector3.new(x, .39, z),
                center + Vector3.new(x + math.sin(angle)*1.02,
                    0.51 + rnd:NextNumber(-.16, .2),
                    z + math.cos(angle)*.84), 0.57,
                if j == 1 then LEAF_SUN else LEAF)
        end
    end
end

local function wheat(parent: Instance, center: Vector3, seed: number)
    local rng = Random.new(seed)
    local soil = ball(parent, "WheatEarth", center + Vector3.new(0,.10,0),
        Vector3.new(4.4,.21,4.5), SOIL)
    soil.Material = Enum.Material.Ground
    for i = 1, 11 do
        local theta = i*2.39996
        local radius = 0.30 + (i%5)*.26
        local base = center + Vector3.new(math.sin(theta)*radius,.15,
            math.cos(theta)*radius)
        local top = base + Vector3.new(rng:NextNumber(-.34,.34),
            rng:NextNumber(3.0, 4.6), rng:NextNumber(-.18,.18))
        stalk(parent, "WheatGrassStem", base, top, 0.10, WHEAT)
        for j = 1, 3 do
            local y = j*.33
            local earCenter = top - Vector3.new(0,y,0)
            local ear = ball(parent, "WheatEar", earCenter,
                Vector3.new(.31,.53,.26), if i%2==0 then GOLD else WHEAT)
            ear.CFrame *= CFrame.Angles(0, theta, .17)
        end
        leaf(parent, base+Vector3.new(0,.38,0),
            base+Vector3.new(math.sin(theta+1)*.52, 1.34,
                math.cos(theta+1)*.46),.22,LEAF_SUN)
    end
end

local function carrots(parent: Instance, center: Vector3, seed: number)
    local ground = ball(parent, "CarrotDarkEarth", center+Vector3.new(0,.09,0),
        Vector3.new(5.6,.19,4.5), DARK_SOIL)
    ground.Material = Enum.Material.Ground
    for i = 1, 7 do
        local a = i*2.39996
        local r = 0.32 + (i%3)*.64
        local p = center+Vector3.new(math.sin(a)*r,.45,math.cos(a)*r)
        local root = ball(parent, "MatureOrangeCarrot",p,
            Vector3.new(.65,.91,.62), ORANGE)
        root.CFrame *= CFrame.Angles(0,a,math.rad(-6))
        for j = 1, 4 do
            local b = a + j * math.pi*.5
            leaf(parent,p+Vector3.new(0,.43,0),
                p+Vector3.new(math.sin(b)*.58,1.32,math.cos(b)*.53),
                .23, if j%2==0 then LEAF_SUN else LEAF)
        end
    end
end

function NativeGarden.build(parent: Instance): Folder
    local old = parent:FindFirstChild("ReferenceNativeGarden")
    if old then old:Destroy() end
    local garden = Instance.new("Folder")
    garden.Name = "ReferenceNativeGarden"
    garden.Parent = parent

    -- All beds are outside x [-9,9] so character movement remains unobstructed.
    for row=1,3 do
        for col=1,3 do
            strawberry(garden,Vector3.new(-30+col*4.15,7.17,67+row*4.65),
                row*1703+col*23)
        end
    end
    -- Exactly one compact vine cluster already carries three ripe melons.
    melon(garden, Vector3.new(-21.7, 7.12, 89.0), 501)
    for i=1,3 do
        wheat(garden,Vector3.new(-26+(i%2)*4.6,7.15,63+math.floor((i-1)/2)*6.2),
            111+i)
    end
    for i=1,3 do
        carrots(garden,Vector3.new(-31+i*4.8,7.15,95.0),i)
    end
    -- Flowers and ground greenery soften edges but never obscure the walkway.
    for i=1,31 do
        local a = i*2.39996
        local x = if i%2==0 then -10.8-math.abs(math.sin(a))*2.1
            else 10.9+math.abs(math.cos(a))*2.4
        local z=42+(i%15)*4.0
        local center=Vector3.new(x,7.24,z)
        if i%4~=0 then
            blossom(garden,center, if i%5==0 then 1.3 else .8,i%3==0)
        else
            for l=1,3 do
                local t=a+l*2.094
                leaf(garden,center,center+Vector3.new(math.cos(t)*.7,
                    .28,math.sin(t)*.58),.31,
                    if l%2==0 then LEAF_SUN else LEAF)
            end
        end
    end
    -- Ground-cover layer: tiny clover groups and warm soil pebbles break up
    -- large empty patches without creating physical obstacles or expensive
    -- terrain textures. Deterministic layout for consistent screenshots.
    local details = Random.new(291104)
    for i = 1, 78 do
        local side = if i % 2 == 0 then -1 else 1
        local x = side * details:NextNumber(12.7, 35.0)
        local z = details:NextNumber(58, 101)
        local at = Vector3.new(x, 7.23, z)
        if i % 3 == 0 then
            local pebble = ball(garden, "GardenSoilPebble",
                at, Vector3.new(details:NextNumber(.24,.49),.12,
                    details:NextNumber(.24,.49)),
                if i % 2 == 0 then SOIL else DARK_SOIL)
            pebble.CastShadow = false
        else
            for j = 1, 3 do
                local a = j * math.pi * 2 / 3 + i * .73
                local clover = ball(garden, "TinyCloverLeaf",
                    at + Vector3.new(math.cos(a)*.18,.03,math.sin(a)*.18),
                    Vector3.new(.29,.07,.23),
                    if j == 1 then LEAF_SUN else LEAF)
                clover.CastShadow = false
            end
        end
    end
    garden:SetAttribute("ArtSource", "NativeGeometryNoExternalAssets")
    return garden
end

return NativeGarden
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="31">
      <Properties>
        <string name="Name">ReferenceGroundLight</string>
        <string name="Source"><![CDATA[--!strict
-- Original reference-style ground composition for the *actual playable* map.
-- Material/lighting details use native Roblox geometry, not screenshots or
-- uploaded images. Fixed seed and strict cap keep repeated joins identical.
local Ground = {}

local SOIL_DARK = Color3.fromRGB(89, 75, 52)
local EARTH = Color3.fromRGB(138, 105, 70)
local CLOVER = Color3.fromRGB(84, 145, 80)
local MOSS = Color3.fromRGB(106, 163, 80)
local SUNLIT = Color3.fromRGB(174, 198, 98)
local PETAL = Color3.fromRGB(255, 243, 220)
local GOLD = Color3.fromRGB(252, 216, 133)
local MAX_PARTS = 190

local function oval(parent: Instance, name: string, position: Vector3,
    size: Vector3, color: Color3, transparency: number, orientation: number): Part
    local item=Instance.new("Part")
    item.Name=name
    item.Anchored=true
    item.CanCollide=false
    item.CanTouch=false
    item.CanQuery=false
    item.CastShadow=false
    item.Shape=Enum.PartType.Ball
    item.Material=Enum.Material.SmoothPlastic
    item.Size=size
    item.Color=color
    item.Transparency=transparency
    item.CFrame=CFrame.new(position)*CFrame.Angles(0,orientation,0)
    item.TopSurface=Enum.SurfaceType.Smooth
    item.BottomSurface=Enum.SurfaceType.Smooth
    item.Parent=parent
    return item
end

function Ground.build(world: Instance): Folder
    local previous=world:FindFirstChild("SunlitGardenGround")
    if previous then previous:Destroy() end
    local folder=Instance.new("Folder")
    folder.Name="SunlitGardenGround"
    folder.Parent=world
    local random=Random.new(20261121)
    local created=0
    local function place(name: string, position: Vector3, size: Vector3,
        color: Color3, transparency: number, orientation: number)
        if created>=MAX_PARTS then return end
        oval(folder,name,position,size,color,transparency,orientation)
        created+=1
    end

    -- Deep olive contact shadows underneath the reference orchard.
    -- These are soft silhouettes, not physical colliders/decals.
    for _, center in ipairs({
        Vector3.new(16.5,7.16,65), Vector3.new(34,7.16,64),
        Vector3.new(-34,7.16,59),
    }) do
        place("OrchardContactShade",center+Vector3.new(0,.15,0),
            Vector3.new(11.2,.075,7.1),SOIL_DARK,.74,.43)
        for i=1,6 do
            local a=i*2.399963
            local x=math.cos(a)*random:NextNumber(1.8,5.6)
            local z=math.sin(a)*random:NextNumber(1.5,3.8)
            place("BrokenLeafShadow",center+Vector3.new(x,.18,z),
                Vector3.new(random:NextNumber(.65,1.9),.048,
                    random:NextNumber(.7,1.5)),
                CLOVER,.80,a)
        end
    end

    -- Between planted strawberry crowns, show the warm, dark soil that
    -- gives the reference its rich layering.
    for row=1,3 do
        for col=1,3 do
            local center=Vector3.new(-30+col*4.15,7.17,67+row*4.65)
            for j=1,3 do
                local a=j*2.094+row*.35
                local p=center+Vector3.new(math.sin(a)*1.05,.315,
                    math.cos(a)*.85)
                place("StrawberryRootSoil",p,
                    Vector3.new(random:NextNumber(1.2,1.9),.055,
                        random:NextNumber(.75,1.35)),
                    SOIL_DARK,.58,a)
            end
        end
    end

    -- Loose overlapping foliage and mottled grass around the garden, but
    -- leave the central walking lane, doors and interaction prompts open.
    for i=1,54 do
        local a=i*2.399963
        local side=if i%2==0 then -1 else 1
        local x=side*random:NextNumber(11.5,36)
        local z=random:NextNumber(43,105)
        local p=Vector3.new(x,7.26,z)
        local color=if i%5==0 then SUNLIT
            elseif i%3==0 then CLOVER else MOSS
        place("MeadowPaintedGround",p,
            Vector3.new(random:NextNumber(.90,2.9),.045,
                random:NextNumber(.55,1.55)),color,.56,a)
        if i%4==0 then
            for j=1,3 do
                local d=a+j*2.0944
                place("TinyCloverLeaf",p+Vector3.new(
                    math.cos(d)*.25,.055,math.sin(d)*.22),
                    Vector3.new(.29,.048,.22),SUNLIT,.19,d)
            end
        end
    end

    -- Near-ground scattered stones and pale blossom flecks prevent a
    -- perfectly even computer-generated path texture.
    for i=1,34 do
        local a=i*2.399963
        local side=if i%2==0 then -1 else 1
        local p=Vector3.new(side*random:NextNumber(11.2,20),
            7.32,random:NextNumber(52,101))
        if i%3==0 then
            place("BlossomOnThePath",p,
                Vector3.new(.23,.027,.17),PETAL,.18,a)
            place("BloomPollen",p+Vector3.new(.11,.012,.02),
                Vector3.new(.065,.015,.06),GOLD,.08,a)
        else
            place("WarmSoilPebble",p,
                Vector3.new(random:NextNumber(.22,.56),.11,
                    random:NextNumber(.26,.60)),EARTH,.22,a)
        end
    end

    folder:SetAttribute("VisualStyle","SunlitPaintedGarden")
    folder:SetAttribute("MaxNativeParts",MAX_PARTS)
    folder:SetAttribute("ActualNativeParts",created)
    return folder
end

return Ground
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="32">
      <Properties>
        <string name="Name">ReferenceMeshLibrary</string>
        <string name="Source"><![CDATA[--!strict
-- Resolve private imported artwork first, then the geometry shipped in the place.
local ServerStorage = game:GetService("ServerStorage")

local Geometry = require(script.Parent.OrchardGeometry)
local Bridge = {}
local ROOT_NAME = "DWTM_ArtLibrary"

local staged = false
local function stageImportedPacks()
    if staged then return end
    staged = true
    -- Studio Importer (File > Import) can insert the three original GLB packs
    -- into Workspace. On Play, move those verified mesh assets to ServerStorage.
    -- Does not need a plugin, API key, or any new permissions.
    local known = {
        {pack = "DWTM_Pets_30", folder = "Pets", prefix = "Pet_"},
        {pack = "DWTM_Crops_30x3", folder = "Crops", prefix = "Crop_"},
        {pack = "DWTM_World_8", folder = "World", prefix = "Environment_"},
        {pack = "DWTM_Gardener_Avatar_15", folder = "Avatar", prefix = "Avatar_"},
    }
    local root = ServerStorage:FindFirstChild(ROOT_NAME)
    for _, item in ipairs(known) do
        for _, container in ipairs(workspace:GetChildren()) do
            if string.sub(container.Name, 1, #item.pack) == item.pack then
                local found = {}
                if container:IsA("MeshPart") then
                    table.insert(found, container)
                end
                for _, descendant in ipairs(container:GetDescendants()) do
                    if descendant:IsA("MeshPart") and
                        string.sub(descendant.Name, 1, #item.prefix) == item.prefix then
                        table.insert(found, descendant)
                    end
                end
                if #found > 0 then
                    if not root then
                        root = Instance.new("Folder")
                        root.Name = ROOT_NAME
                        root.Parent = ServerStorage
                    end
                    local folder = root:FindFirstChild(item.folder)
                    if not folder then
                        folder = Instance.new("Folder")
                        folder.Name = item.folder
                        folder.Parent = root
                    end
                    for _, mesh in ipairs(found) do
                        if string.sub(mesh.Name, 1, #item.prefix) == item.prefix then
                            mesh.Anchored = true
                            mesh.CanCollide = false
                            mesh.CanTouch = false
                            mesh.CanQuery = false
                            mesh.Parent = folder
                        end
                    end
                    if container.Parent == workspace then container:Destroy() end
                end
            end
        end
    end
end

local function findMesh(groupName: string, assetName: string): MeshPart?
    stageImportedPacks()
    local root = ServerStorage:FindFirstChild(ROOT_NAME)
    local group = if root then root:FindFirstChild(groupName) else nil
    local obj = if group then group:FindFirstChild(assetName,true) else nil
    if obj and obj:IsA("MeshPart") then return obj end
    if obj and obj:IsA("Model") then
        local mesh = obj:FindFirstChildWhichIsA("MeshPart",true)
        if mesh then return mesh end
    end
    return Geometry.cached(assetName)
end

function Bridge.prepare(owner: Instance, group: string, keys: {string}, ready: () -> (), failed: (() -> ())?)
    task.defer(function()
        for _, key in ipairs(keys) do
            if not owner.Parent then return end
            if not findMesh(group,key) and not Geometry.load(key) then
                if failed and owner.Parent then failed() end
                return
            end
        end
        if owner.Parent then ready() end
    end)
end

local function makeVisual(source: MeshPart, parent: Instance, name: string,
    pivot: CFrame, height: number, bodyAnchor: BasePart?): MeshPart?
    if not source.Archivable then return nil end
    local mesh = source:Clone()
    mesh.Name = name
    mesh.Anchored = true
    mesh.CanCollide = false
    mesh.CanTouch = false
    mesh.CanQuery = false
    mesh.CastShadow = true

    -- Sanity bounds: avoid importer meter/stud scale mistakes taking over
    -- the island or producing a near-invisible animal.
    if mesh.Size.X < 0.001 or mesh.Size.Y < 0.001 or mesh.Size.Z < 0.001 then
        mesh:Destroy()
        return nil
    end
    local full = source:GetAttribute("ArtSize") or mesh.Size
    local sourceSpan = if name == "ImportedWaterPond" then math.max(full.X, full.Z)
        else full.Y
    local ratio = height / math.max(sourceSpan, 0.001)
    mesh.Size = mesh.Size * ratio
    Geometry.mount(mesh,pivot,ratio,bodyAnchor)
    mesh:SetAttribute("VisualOffset",(mesh:GetAttribute("PieceCenter") or Vector3.zero)*ratio)
    if mesh:FindFirstChildWhichIsA("Motor6D",true) then mesh:AddTag("OrchardRig") end
    mesh.Parent = parent
    return mesh
end

-- Place a ground-hugging asset by its horizontal span, keeping the authored aspect.
function Bridge.ground(owner: Instance, key: string, frame: CFrame, span: number, replaced: Instance?)
    local group=if key:sub(1,5)=="Crop_" then "Crops" else "World"
    Bridge.prepare(owner,group,{key},function()
        local source=findMesh(group,key)
        if not source then return end
        local height=span*source.Size.Y/math.max(source.Size.X,source.Size.Z)
        local mesh=makeVisual(source,owner,key,frame*CFrame.new(0,height/2,0),height)
        if mesh and replaced and replaced.Parent then replaced:Destroy() end
    end)
end

-- Keep the planting on the dais when the giant leaves to chase players.
function Bridge.decorateDen(dais: BasePart)
    if dais:FindFirstChild("DenFlowers") then return end
    local flowers=Instance.new("Folder")
    flowers.Name="DenFlowers"
    flowers.Parent=dais
    local surface=dais.Position+Vector3.yAxis*(dais.Size.X*.5)
    local function plant(asset: string,x: number,z: number,yaw: number,span: number)
        Bridge.ground(flowers,"Environment_"..asset,CFrame.new(surface+Vector3.new(x,0,z))*CFrame.Angles(0,yaw,0),span,nil)
    end
    plant("BloomingHedge",1,20.5,.09,22)
    plant("MeadowVerge",-21,12.5,-.82,13)
    plant("MeadowVerge",21,11,1.08,13)
    plant("BloomingHedge",-11,-18,-.38,10)
end

-- Two stretches of paving lead around the berry border to the cottage steps.
-- Keep the open spawn and the centre lane free of raised decorations.
function Bridge.decorateWalkway(scenery: Instance)
    if scenery:FindFirstChild("OrchardWalkway") then return end
    local beds=Instance.new("Folder")
    beds.Name="OrchardWalkway"
    beds.Parent=scenery
    for i=1,16 do
        local side=if i%2==0 then 1 else -1
        local ground=Vector3.new(side*(15+(i%4)*4.6),7.18,54+math.floor(i/2)*4.8)
        Bridge.ground(beds,"Environment_MeadowVerge",
            CFrame.new(ground)*CFrame.Angles(0,i*.82,0),6.2+(i%3)*.7,nil)
    end
    for i,point in ipairs({Vector3.new(9,7.16,90),Vector3.new(15,7.16,94.5),
            Vector3.new(26.4,7.16,89),Vector3.new(33.7,7.16,83.2)}) do
        Bridge.ground(beds,"Environment_MeadowVerge",CFrame.new(point)*CFrame.Angles(0,i*1.7,0),5.2,nil)
    end
    local function pave(a: Vector3, b: Vector3)
        local delta=b-a
        local yaw=math.atan2(delta.X,delta.Z)
        Bridge.ground(beds,"Environment_StonePath",
            CFrame.new((a+b)*.5)*CFrame.Angles(0,yaw,0),delta.Magnitude,nil)
    end
    local bend=Vector3.new(22,7.14,92)
    pave(Vector3.new(5.4,7.14,86.5),bend)
    pave(bend,Vector3.new(35.4,7.14,78.4))
end

function Bridge.water(character: Model)
    local hand=character:FindFirstChild("RightHand")
    local source=findMesh("World","Environment_WateringCan")
    if not hand or not hand:IsA("BasePart") or not source then return end
    local old=character:FindFirstChild("HeldWateringCan")
    if old then old:Destroy() end
    local can=source:Clone()
    can.Name="HeldWateringCan"
    can.Size=source.Size*1.4
    can.Anchored=false
    can.CanCollide=false
    can.CanQuery=false
    can.CanTouch=false
    can.Massless=true
    can.CFrame=hand.CFrame*CFrame.new(0,-.36,-.19)*CFrame.Angles(-.48,0,0)
    local weld=Instance.new("WeldConstraint")
    weld.Part0,weld.Part1=hand,can
    weld.Parent=can
    local nozzle=Instance.new("Attachment")
    nozzle.Position=Vector3.new(0,can.Size.Y*.09,-can.Size.Z*.49)
    nozzle.Parent=can
    local drops=Instance.new("ParticleEmitter")
    drops.Rate=0
    drops.Color=ColorSequence.new(Color3.fromRGB(164,216,217))
    drops.Transparency=NumberSequence.new(.22,.91)
    drops.Size=NumberSequence.new(.065,.032)
    drops.Lifetime=NumberRange.new(.19,.36)
    drops.EmissionDirection=Enum.NormalId.Front
    drops.Acceleration=Vector3.new(0,-25,0)
    drops.Speed=NumberRange.new(2.4,3.3)
    drops.SpreadAngle=Vector2.new(9,9)
    drops.Parent=nozzle
    can.Parent=character
    task.delay(.29,function() if can.Parent then drops:Emit(12) end end)
    game:GetService("Debris"):AddItem(can,1.03)
end

-- The 15 original mesh parts are attached to R15's existing moving bones.
-- Roblox's native Humanoid/Animate script keeps all walk/run/jump animations.
-- We never replace player control, physics or the standard character rig.
function Bridge.applyGardenerAvatar(character: Model): boolean
    if character:GetAttribute("DWTMStorybookAvatar") == true then
        for _,child in ipairs(character:GetDescendants()) do
            if child:IsA("BasePart") and child.Parent and child.Parent:IsA("Accessory") then child.Transparency=1 end
            if child:IsA("Decal") and child.Parent==character:FindFirstChild("Head") then child.Transparency=1 end
        end
        return true
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then return false end
    local names = {
        "Head", "UpperTorso", "LowerTorso",
        "LeftUpperArm", "LeftLowerArm", "LeftHand",
        "RightUpperArm", "RightLowerArm", "RightHand",
        "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
        "RightUpperLeg", "RightLowerLeg", "RightFoot",
    }
    local keys = {}
    for _, name in ipairs(names) do table.insert(keys,"Avatar_"..name) end
    for _, key in ipairs(keys) do
        if not findMesh("Avatar",key) then
            if not character:GetAttribute("GardenerLoading") then
                character:SetAttribute("GardenerLoading",true)
                Bridge.prepare(character,"Avatar",keys,function()
                    character:SetAttribute("GardenerLoading",nil)
                    Bridge.applyGardenerAvatar(character)
                end,function() character:SetAttribute("GardenerLoading",nil) end)
            end
            return false
        end
    end
    local planned = {}
    -- The appearance must be complete; avoid half-colored / half-imported avatars.
    for _, name in ipairs(names) do
        local limb = character:FindFirstChild(name)
        local source = findMesh("Avatar", "Avatar_" .. name)
        if not limb or not limb:IsA("BasePart") or not source
            or source.Size.Y < 0.001 then
            return false
        end
        table.insert(planned, {name = name, limb = limb, source = source})
    end
    local costume = Instance.new("Folder")
    costume.Name = "StorybookGardener"
    costume.Parent = character
    for _, record in ipairs(planned) do
        local limb = record.limb :: BasePart
        local original = record.source :: MeshPart
        local mesh = original:Clone()
        mesh.Name = "Garden" .. record.name
        mesh.Massless = true
        mesh.Anchored = false
        mesh.CanCollide = false
        mesh.CanTouch = false
        mesh.CanQuery = false
        mesh.CastShadow = true
        local scale = limb.Size.Y / math.max(original.Size.Y, 0.001)
        local lift=0
        if record.name == "Head" then
            local chest=character:FindFirstChild("UpperTorso") :: BasePart
            scale=math.max(scale*1.20,chest.Size.X*1.07/original.Size.X)
            lift=(original.Size.Y*scale-limb.Size.Y)*.43
        end
        mesh.Size = original.Size * scale
        mesh.CFrame = limb.CFrame*CFrame.new(0,lift,0)
        mesh.Parent = costume
        local weld = Instance.new("WeldConstraint")
        weld.Name = "AnimatedR15Attachment"
        weld.Part0 = limb
        weld.Part1 = mesh
        weld.Parent = mesh
    end
    -- Only after all 15 moving parts are attached do we hide default geometry.
    for _, record in ipairs(planned) do
        (record.limb :: BasePart).Transparency = 1
    end
    for _, item in ipairs(character:GetDescendants()) do
        if item:IsA("Decal") and item.Parent and item.Parent.Name == "Head" then
            item.Transparency = 1
        elseif item:IsA("BasePart") and item.Parent and item.Parent:IsA("Accessory") then
            item.Transparency = 1
        end
    end
    local oldOutfit = character:FindFirstChild("NativeGardenOutfit")
    if oldOutfit then oldOutfit:Destroy() end
    character:SetAttribute("DWTMStorybookAvatar", true)
    return true
end

-- A static GLB import can stand in while the articulated model loads.
function Bridge.prepareGiant(boss: Model, ready: (MeshPart) -> ())
    task.defer(function()
        if not boss.Parent then return end
        Geometry.load("Environment_SleepingMonster")
        if boss.Parent then
            local mesh=Bridge.applySleepingMonster(boss)
            if mesh then ready(mesh) end
        end
    end)
end

function Bridge.applySleepingMonster(boss: Model): MeshPart?
    local existing=boss:FindFirstChild("ImportedSleepingMonster")
    local packed=Geometry.cached("Environment_SleepingMonster")
    if existing and existing:IsA("MeshPart") and (existing:HasTag("OrchardRig") or not packed) then
        return existing
    end
    local source = packed or findMesh("World", "Environment_SleepingMonster")
    if not source then return nil end
    local height = 52
    local mesh = makeVisual(source, boss, "ImportedSleepingMonster",
        boss:GetPivot() * CFrame.new(0,10+height/2-29,0), height, boss.PrimaryPart)
    if not mesh then return nil end
    mesh:SetAttribute("BossRest",boss:GetPivot():ToObjectSpace(mesh.CFrame))
    for _, obj in ipairs(boss:GetDescendants()) do
        if obj:IsA("BasePart") and obj ~= mesh and not obj:IsDescendantOf(mesh) then
            if mesh:HasTag("OrchardRig") and obj~=boss.PrimaryPart then
                obj:Destroy()
            else
                obj.Transparency = 1
            end
        end
    end
    return mesh
end

function Bridge.applyOrchardTree(parent: Instance, index: number, ground: Vector3): boolean
    local source = findMesh("World", "Environment_OrangeTree")
    if not source then return false end
    local tall = 17 + (index % 3) * 1.1
    local visual = makeVisual(source, parent, "ImportedOrangeTree_" .. tostring(index),
        CFrame.new(ground + Vector3.new(0, tall / 2, 0))
            * CFrame.Angles(0, math.rad(index * 41), 0), tall)
    if visual then
        visual:SetAttribute("CottageArt", true)
        return true
    end
    return false
end

function Bridge.applyPet(pet: Model, species: string): boolean
    if pet:FindFirstChild("ImportedCharacterMesh") then return true end
    local source = findMesh("Pets", "Pet_" .. species)
    if not pet.PrimaryPart then return false end
    if not source then
        Bridge.prepare(pet,"Pets",{"Pet_"..species},function() Bridge.applyPet(pet,species) end)
        return false
    end
    local root = pet.PrimaryPart
    local visual = makeVisual(source, pet, "ImportedCharacterMesh", root.CFrame, 4.1)
    if not visual then return false end
    -- The legacy blob art is removed once the real mesh has been cloned.
    -- Retain the movement root, name tag and sound; avoid replicating dozens
    -- of hidden old parts to phones.
    for _, obj in ipairs(pet:GetDescendants()) do
        if obj:IsA("BasePart") and obj ~= visual and obj ~= root and not obj:IsDescendantOf(visual)
            and not obj:FindFirstAncestor("PersonalityAccessory") then
            obj:Destroy()
        end
    end
    pet:SetAttribute("NativeSpeciesStyled",false)
    root.Transparency = 1
    root.CastShadow = false
    return true
end

function Bridge.applyCrop(visual: Model, center: Vector3,
    seedType: string, stage: number): boolean
    if stage < 1 then return false end
    local name = "Crop_" .. seedType .. "_S" .. tostring(stage)
    local source = findMesh("Crops", name)
    if not source then
        Bridge.prepare(visual,"Crops",{name},function()
            if visual:FindFirstChild("ImportedCropMesh") then return end
            if Bridge.applyCrop(visual,center,seedType,stage) then
                for _, item in ipairs(visual:GetChildren()) do
                    if item:IsA("BasePart") and item.Name ~= "ImportedCropMesh"
                        and not string.match(item.Name,"^MutatedSparkle_") then item:Destroy() end
                end
            end
        end)
        return false
    end
    local targetHeight = if stage == 1 then 1.25 elseif stage == 2 then 2.35 else 3.65
    -- Fit the entire rosette or vine inside its own 8.2-stud plot.
    local width = math.max(source.Size.X,source.Size.Z)
    local fitHeight = math.min(targetHeight,7.3*source.Size.Y/width)
    local mesh = makeVisual(source, visual, "ImportedCropMesh",
        CFrame.new(center + Vector3.new(0,fitHeight/2+.25,0)),fitHeight)
    return mesh ~= nil
end

-- Rich opening composition: layered strawberry beds, melon vines and wheat
-- on one side of the central footpath. All meshes are cosmetic, static and
-- nonqueryable. This does not modify any player-owned garden or economy data.
function Bridge.decorateEntrance(world: Instance): number
    local berry = findMesh("Crops", "Crop_Berry_S3")
    local melon = findMesh("Crops", "Crop_LavaMelon_S3")
    local wheat = findMesh("Crops", "Crop_WhisperWheat_S3")
    if not berry or not melon or not wheat then return 0 end
    local garden = Instance.new("Folder")
    garden.Name = "ImportedReferenceStyleEntranceGarden"
    garden.Parent = world
    local count = 0
    local function place(source: MeshPart, name: string, p: Vector3,
        scaleHeight: number, yaw: number)
        scaleHeight = math.min(scaleHeight,4.7*source.Size.Y/math.max(source.Size.X,source.Size.Z))
        local mesh = makeVisual(source, garden, name,
            CFrame.new(p + Vector3.new(0, scaleHeight * 0.5, 0))
                * CFrame.Angles(0, yaw, 0), scaleHeight)
        if mesh then
            mesh:SetAttribute("DecorativeOnly", true)
            count += 1
        end
    end
    -- Central x in [-8,8] stays completely open for the spawn walkway.
    for row = 1, 3 do
        for col = 1, 3 do
            local x = -30 + col * 4.0
            local z = 67 + row * 4.65
            place(berry, "StrawberryPatch_" .. row .. "_" .. col,
                Vector3.new(x, 7.18, z), 3.4, (row+col)*0.67)
        end
    end
    for i = 1, 2 do
        local x = -27 + i * 6.8
        place(melon, "VineWatermelon_" .. i, Vector3.new(x, 7.06, 89.0),
            3.10, i * 1.23)
    end
    for i = 1, 7 do
        local x = -27 + (i % 3) * 3.1
        local z = 63 + math.floor((i-1)/3) * 4.1
        place(wheat, "WheatBorder_" .. i, Vector3.new(x, 7.06, z),
            3.4 + (i%2)*0.25, i * 0.27)
    end
    for i, key in ipairs({"Carrot","Tomato","Corn"}) do
        local crop = findMesh("Crops","Crop_"..key.."_S3")
        if crop then
            for j=0,2 do
                place(crop,key.."Border"..j,Vector3.new(-10.7-j*4.8,7.22,87+i*3.5),
                    if key=="Corn" then 4.4 else 2.9,.48*(i+j))
            end
        end
    end
    -- A second, lighter planting on the cottage side balances the camera.
    for i = 1, 4 do
        local z = 68 + i * 4.7
        place(berry, "OrchardBerries_" .. i,
            Vector3.new(18.5, 7.16, z), 2.65, i * 0.6)
    end
    return count
end

function Bridge.applySetDress(parent: Instance): number
    stageImportedPacks()
    local applied = 0
    local environment = parent:FindFirstChild("CottageGardenEnvironment", true)
    if not environment then return 0 end

    local placement = {
        {"GardenCottage", "CozyOrchardCottage", Vector3.new(37, 13.5, 88), 13},
        {"WaterPond", "ShadedOrchardPond", Vector3.new(54, 6.98, 91), 14},
        {"GardenerToucan", "OriginalGardenHelper", Vector3.new(-16.5, 9.6, 71), 5.2},
        {"BloomingHedge", "OriginalFlowerHedge", Vector3.new(49, 9.0, 80), 4.0},
    }
    for _, record in ipairs(placement) do
        local source = findMesh("World", "Environment_" .. record[1])
        if source then
            local done = environment:FindFirstChild("Imported" .. record[1])
            if done then applied += 1 continue end
            local previous = environment:FindFirstChild(record[2])
            local frame = CFrame.new(record[3])
            if record[1] == "WaterPond" then
                local size = source:GetAttribute("ArtSize") or source.Size
                frame *= CFrame.new(0, size.Y * .5 * record[4] / math.max(size.X,size.Z), 0)
            end
            local mesh = makeVisual(source, environment, "Imported" .. record[1], frame, record[4])
            if mesh then
                if previous then previous:Destroy() end
                if record[1] == "WaterPond" then workspace:SetAttribute("GardenPondCenter",mesh.CFrame.Position) end
                applied += 1
                if record[1] == "GardenCottage" then
                    -- Decorative cottage is closed: players should not walk
                    -- through a house just because its 3D mesh is cosmetic.
                    local collision = Instance.new("Part")
                    collision.Name = "CottageInvisibleWalls"
                    collision.Size = Vector3.new(14, 8.5, 12)
                    collision.CFrame = CFrame.new(37, 11.25, 88)
                    collision.Transparency = 1
                    collision.Anchored = true
                    collision.CanCollide = true
                    collision.CanQuery = false
                    collision.CanTouch = false
                    collision.Parent = environment
                end
            end
        end
    end
    -- Full imported world packs need the foreground citrus and wooden fences
    -- too. The older bridge only placed the cottage, pond, toucan and hedge,
    -- so the trees and fence vanished whenever the native fallback switched off.
    if applied == 4 then
        local citrus = findMesh("World", "Environment_OrangeTree")
        local fence = findMesh("World", "Environment_WoodFence")
        if citrus and fence then
            local orchard = {
                Vector3.new(14, 7.15, 68),
                Vector3.new(44, 7.15, 70),
                Vector3.new(-36, 7.15, 67.5),
            }
            for index, ground in ipairs(orchard) do
                local height = 17.2 + index * 0.8
                local name = "ImportedHeroCitrus_" .. index
                if environment:FindFirstChild(name) then continue end
                local tree = makeVisual(citrus, environment, name,
                    CFrame.new(ground + Vector3.new(0, height / 2, 0))
                        * CFrame.Angles(0, math.rad(index * 59), 0), height)
                if not tree then applied = 3 end
            end
            for _, x in ipairs({-33, -26, -19, 21, 28, 35}) do
                local name = "ImportedGardenFence_" .. tostring(x)
                if environment:FindFirstChild(name) then continue end
                local rail = makeVisual(fence, environment, name,
                    CFrame.new(x, 8.55, 62), 2.6)
                if not rail then applied = 3 end
            end
        else
            -- Keep the native citrus/fence backdrop if the owner's
            -- import has not included those two named meshes yet.
            applied = 3
        end
    end
    return applied
end

return Bridge
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="33">
      <Properties>
        <string name="Name">RescueObjective</string>
        <string name="Source"><![CDATA[--!strict
-- Shared, server-owned co-op objective during the monster's awake phase.
-- Rescue the runaway creatures while dodging the boss for an extra reward.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local World = require(script.Parent:WaitForChild("World"))

local Rescue = {}
local random = Random.new()
local models: {Model} = {}
local active = false
local goal = 0
local rescued = 0
local completed = false
local participants: {[Player]: number} = {}

local RESCUE_COINS = 8
local TEAM_BONUS = 30
local generation = 0
local targets: {[number]: {name: string, position: Vector3, helper: number, expires: number}} = {}
local SIGNAL_SECONDS = 8

function Rescue.release(player: Player)
    for _, target in pairs(targets) do
        if target.helper == player.UserId then
            target.helper = 0
            target.expires = 0
        end
    end
end

function Rescue.signal(player: Player, round: any, id: any): boolean
    if not active or completed or round ~= generation or typeof(id) ~= "number"
        or not (id >= 1 and id <= goal and id % 1 == 0) then return false end
    local target = targets[id]
    local now = os.clock()
    if not target or target.expires > now then return false end
    local character = player.Character
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    if not humanoid or humanoid.Health <= 0 then return false end
    for _, other in pairs(targets) do
        if other.helper == player.UserId and other.expires > now then return false end
    end
    target.helper = player.UserId
    target.expires = now + SIGNAL_SECONDS
    return true
end

function Rescue.status()
    local remaining = {}
    local now = os.clock()
    for id = 1, goal do
        local target = targets[id]
        if target then
            table.insert(remaining, {id = id, name = target.name, position = target.position,
                helper = if target.expires > now then target.helper else 0})
        end
    end
    return {
        round = generation,
        targets = remaining,
        active = active,
        rescued = rescued,
        goal = goal,
        completed = completed,
        bonus = TEAM_BONUS,
    }
end

function Rescue.participated(player: Player): boolean
    return (participants[player] or 0) > 0
end

function Rescue.completed(): boolean
    return completed
end

function Rescue.start(onRescue: (Player, boolean, number) -> (), allowed: (Player) -> boolean)
    for _, model in ipairs(models) do
        if model.Parent then model:Destroy() end
    end
    table.clear(models)
    table.clear(targets)
    table.clear(participants)
    generation += 1
    local round = generation
    rescued = 0
    active = true
    completed = false

    local currentPlayers = #Players:GetPlayers()
    goal = math.clamp(2 + math.floor(currentPlayers / 3), 2, 5)
    local phaseOffset = random:NextNumber(0, math.pi * 2)

    for i = 1, goal do
        local variant = Config.Pets[random:NextInteger(1, #Config.Pets)]
        local angle = phaseOffset + (i - 1) * math.pi * 2 / goal
        local radius = random:NextNumber(31, 62)
        -- Top of main island is approximately 7 studs; keep prompts reachable.
        local position = Vector3.new(math.cos(angle) * radius, 12.5, math.sin(angle) * radius)
        local pet = World.makePet(variant.name .. "_runaway_" .. i, variant.color, variant.ear == "pointy")
        pet:SetAttribute("RescueRound", round)
        pet.Name = "RescueRunaway_" .. i
        pet:PivotTo(CFrame.new(position) * CFrame.Angles(0, angle, 0))
        table.insert(models, pet)

        local primary = pet.PrimaryPart
        if primary then
            targets[i] = {name = variant.name, position = primary.Position, helper = 0, expires = 0}
            local prompt = Instance.new("ProximityPrompt")
            prompt.Name = "Rescue"
            prompt.ActionText = "SAVE ME!"
            prompt.ObjectText = "Lost " .. variant.name
            prompt.KeyboardKeyCode = Enum.KeyCode.E
            prompt.HoldDuration = 0.15
            prompt.MaxActivationDistance = 13
            prompt.RequiresLineOfSight = false
            prompt.Parent = primary

            local used = false
            prompt.Triggered:Connect(function(player: Player)
                if not active or round ~= generation or completed or used or not allowed(player) then return end
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                if not root or not root:IsA("BasePart") then return end
                if (root.Position - primary.Position).Magnitude > 16 then return end
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if not humanoid or humanoid.Health <= 0 then return end

                used = true
                targets[i] = nil
                prompt.Enabled = false
                participants[player] = (participants[player] or 0) + 1
                rescued += 1
                local justCompleted = rescued >= goal and not completed
                if justCompleted then completed = true end
                World.burst(primary.Position, variant.color, 14, 11)
                if pet.Parent then pet:Destroy() end
                onRescue(player, justCompleted, RESCUE_COINS)
            end)
        end
    end
end

function Rescue.finish()
    active = false
    for _, model in ipairs(models) do
        if model.Parent then model:Destroy() end
    end
    table.clear(models)
    table.clear(targets)
    -- Keep participants until the next Rescue.start so reward resolution can run first.
end

return Rescue
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="34">
      <Properties>
        <string name="Name">SeedHunt</string>
        <string name="Source"><![CDATA[--!strict
-- Pure progression rules for actual, spatially verified seed pickups.
-- The World script provides physical cache positions and the server verifies distance.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local X = require(ReplicatedStorage:WaitForChild("ExpeditionConfig"))
local G = require(ReplicatedStorage:WaitForChild("GardenConfig"))
local Hunt = {}
local byId = {}
for _, zoneId in ipairs(X.ZoneOrder) do
    local zone = X.Zones[zoneId]
    for _, node in ipairs(zone.nodes) do
        assert(not byId[node.id], "Duplicate seed cache id")
        byId[node.id] = {node = node, zone = zoneId}
    end
end

function Hunt.node(id: any): any?
    return if type(id) == "string" then byId[id] else nil
end

function Hunt.new()
    return {visited = {}, discovered = {}, mutations = {}, totalFinds = 0, questDay = -1, questFinds = 0, questClaimed = false}
end

function Hunt.load(raw: any)
    local s = Hunt.new()
    if type(raw) ~= "table" then return s end
    if type(raw.visited) == "table" then
        for id, time in pairs(raw.visited) do
            if Hunt.node(id) and type(time) == "number" and time == math.floor(time)
                and time >= 0 and time <= os.time() + 60 then
                s.visited[id] = time
            end
        end
    end
    if type(raw.discovered) == "table" then
        for key, flag in pairs(raw.discovered) do
            if G.Crops[key] and G.Crops[key].kind == "ordinary" and flag == true then s.discovered[key] = true end
        end
    end
    if type(raw.mutations) == "table" then
        for _, name in ipairs({"Golden", "Dewy", "Moonlit", "Giggly"}) do
            if raw.mutations[name] == true then s.mutations[name] = true end
        end
    end
    if type(raw.totalFinds) == "number" and raw.totalFinds == math.floor(raw.totalFinds) then
        s.totalFinds = math.clamp(raw.totalFinds, 0, 1000000)
    end
    if type(raw.questDay) == "number" and raw.questDay == math.floor(raw.questDay) then
        s.questDay = math.clamp(raw.questDay, -1, 1000000)
    end
    if type(raw.questFinds) == "number" and raw.questFinds == math.floor(raw.questFinds) then
        s.questFinds = math.clamp(raw.questFinds, 0, X.PersonalDailyQuest)
    end
    s.questClaimed = raw.questClaimed == true
    return s
end

function Hunt.snapshot(h: any)
    return {
        visited = table.clone(h.visited),
        discovered = table.clone(h.discovered),
        mutations = table.clone(h.mutations),
        totalFinds = h.totalFinds,
        questDay = h.questDay,
        questFinds = h.questFinds,
        questClaimed = h.questClaimed,
    }
end

function Hunt.collect(h: any, seeds: any, nodeId: any, roll: number, assist: number, now: number): (boolean, string, string?, string?, boolean)
    local found = Hunt.node(nodeId)
    if not found then return false, "Unknown seed cache", nil, nil, false end
    if type(roll) ~= "number" or roll ~= roll or roll < 0 or roll > 1 then return false, "Invalid seed roll", nil, nil, false end
    if type(assist) ~= "number" or assist ~= assist then return false, "Invalid pet boost", nil, nil, false end
    local last = h.visited[nodeId] or -1000000
    if now < last + X.NodeCooldown then return false, "Cache regrowing! Come back soon.", nil, nil, false end
    -- Curious companions can improve odds, but can never mint paid seeds.
    local adjusted = math.clamp(roll + math.clamp(assist, 0, 0.08), 0, 0.9999999)
    local rarity = if adjusted < 0.65 then "common" elseif adjusted < 0.93 then "uncommon" else "rare"
    local index = if rarity == "common" then 1 elseif rarity == "uncommon" then 2 else 3
    local seed = if index == 3 and found.node.loot[4] and adjusted >= 0.965 then found.node.loot[4] else found.node.loot[index]
    if not G.Crops[seed] or G.Crops[seed].kind ~= "ordinary" then return false, "Invalid loot table", nil, nil, false end
    local number = if rarity == "common" then 2 else 1
    if (seeds[seed] or 0) > X.SeedCap - number then return false, "Seed bag full for this plant", nil, nil, false end
    seeds[seed] = (seeds[seed] or 0) + number
    h.visited[nodeId] = now
    h.totalFinds += 1
    local discovered = h.discovered[seed] ~= true
    h.discovered[seed] = true
    local day = math.floor(now / 86400)
    if h.questDay ~= day then
        h.questDay = day
        h.questFinds = 0
        h.questClaimed = false
    end
    h.questFinds = math.min(X.PersonalDailyQuest, h.questFinds + 1)
    return true, "+" .. number .. " " .. G.Crops[seed].name .. " seeds! (" .. rarity .. ")", seed, rarity, discovered
end

function Hunt.claimQuest(h: any, now: number): boolean
    if h.questDay ~= math.floor(now / 86400) then return false end
    if h.questFinds < X.PersonalDailyQuest or h.questClaimed then return false end
    h.questClaimed = true
    return true
end

function Hunt.mutatePlot(p: any, weather: string, roll: number, now: number): boolean
    local w = X.Weather[weather]
    if not w or not p or type(p) ~= "table" then return false end
    if now >= p.readyAt then return false end
    local changed = false
    if not p.weatherBoosted then
        p.readyAt = now + math.max(1, math.floor((p.readyAt - now) * w.speed))
        p.weatherBoosted = true
        changed = true
    end
    if not p.mutation and roll < w.chance then
        p.mutation = w.mutation
        changed = true
    end
    return changed
end

return Hunt
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="35">
      <Properties>
        <string name="Name">StorybookPetArt</string>
        <string name="Source"><![CDATA[--!strict
-- Original, lightweight cosmetic geometry for recognizable storybook animals.
-- The existing pet's PrimaryPart, behavior, ownership, collision and economy stay unchanged.
-- Every detail uses a small anchored, non-colliding Roblox Part, not copied assets.
local Art = {}

local IVORY = Color3.fromRGB(255, 248, 230)
local WHITE = Color3.fromRGB(255, 252, 245)
local PINK = Color3.fromRGB(246, 167, 174)
local CHESTNUT = Color3.fromRGB(141, 103, 75)
local INK = Color3.fromRGB(72, 57, 68)
local GOLD = Color3.fromRGB(246, 211, 117)

local function oval(parent: Instance, name: string, position: Vector3, size: Vector3, tint: Color3): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Shape = Enum.PartType.Ball
    p.Size = size
    p.CFrame = CFrame.new(position)
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.SmoothPlastic
    p.Color = tint
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function ribbon(parent: Instance, name: string, pos: Vector3, size: Vector3, tint: Color3, rotation: number)
    local p = oval(parent, name, pos, size, tint)
    p.CFrame *= CFrame.Angles(0, 0, math.rad(rotation))
    return p
end

local function kitten(parent: Instance, color: Color3)
    local cream = color:Lerp(IVORY, 0.83)
    local stripe = color:Lerp(CHESTNUT, 0.55)
    oval(parent, "CatBib", Vector3.new(0, -1.25, -1.47), Vector3.new(1.85, 1.65, 0.32), cream)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "CatMuzzle", Vector3.new(side * 0.42, -0.74, -2.18), Vector3.new(0.94, 0.72, 0.53), cream)
        ribbon(parent, "TabbyCheekStripe", Vector3.new(side * 1.52, 0.1, -1.57),
            Vector3.new(0.26, 0.72, 0.12), stripe, side * -28)
        oval(parent, "VelvetInnerEar", Vector3.new(side * 1.46, 2.36, -0.57),
            Vector3.new(0.61, 1.26, 0.2), PINK)
        for i = 1, 2 do
            oval(parent, "TinyToe", Vector3.new(side * (0.74 + i * 0.22), -2.02, -1.63),
                Vector3.new(0.15, 0.12, 0.24), cream)
        end
    end
    ribbon(parent, "ForeheadStripe", Vector3.new(0, 1.29, -1.9), Vector3.new(0.32, 0.72, 0.2), stripe, 0)
    oval(parent, "TinyCatNose", Vector3.new(0, -0.62, -2.48), Vector3.new(0.45, 0.32, 0.22), PINK)
    -- Small back stripes are visible from the elevated garden camera.
    for i = 1, 3 do
        oval(parent, "BackTabbySpot", Vector3.new(0, 1.81, -1 + i * 0.78),
            Vector3.new(0.46, 0.12, 0.48), stripe)
    end
end

local function bunny(parent: Instance, color: Color3)
    local blush = Color3.fromRGB(255, 193, 202)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "BunnyEarLining", Vector3.new(side * 1.3, 3.56, -0.61),
            Vector3.new(0.69, 3.1, 0.19), blush)
        oval(parent, "BunnyMuzzle", Vector3.new(side * 0.47, -0.65, -2.18),
            Vector3.new(0.98, 0.7, 0.52), WHITE)
        oval(parent, "BunnyFrontFoot", Vector3.new(side * 1.18, -2.04, -1.65),
            Vector3.new(1.25, 0.46, 1.16), color:Lerp(WHITE, 0.32))
    end
    oval(parent, "CottonTail", Vector3.new(0, -0.6, 2.43), Vector3.new(1.75, 1.75, 1.7), WHITE)
    oval(parent, "BunnyNose", Vector3.new(0, -0.58, -2.48), Vector3.new(0.4, 0.28, 0.22), PINK)
end

local function puppy(parent: Instance, color: Color3)
    local muzzle = Color3.fromRGB(247, 221, 193)
    oval(parent, "PuppyChest", Vector3.new(0, -1.21, -1.5), Vector3.new(2.6, 1.7, 0.35), muzzle)
    for _, side in ipairs({-1, 1}) do
        local ear = ribbon(parent, "PuppyVelvetEar", Vector3.new(side * 2.05, 1.75, -0.56),
            Vector3.new(1.17, 2.2, 0.52), color:Lerp(CHESTNUT, 0.35), side * 25)
        ear.CastShadow = false
        oval(parent, "PuppyJowl", Vector3.new(side * 0.55, -0.9, -2.65),
            Vector3.new(1.1, 0.8, 0.46), muzzle)
        oval(parent, "PuppyEyebrow", Vector3.new(side * 1.12, 1.5, -2.11),
            Vector3.new(0.82, 0.22, 0.2), color:Lerp(CHESTNUT, 0.52))
    end
    oval(parent, "PuppyNose", Vector3.new(0, -0.53, -2.88), Vector3.new(0.7, 0.48, 0.32), INK)
    oval(parent, "PuppyCollar", Vector3.new(0, -0.99, -1.59), Vector3.new(2.7, 0.29, 0.48), GOLD)
end

local function deer(parent: Instance, color: Color3)
    oval(parent, "DeerChest", Vector3.new(0, -1.05, -1.62),
        Vector3.new(1.8, 1.65, 0.45), IVORY)
    oval(parent, "DeerMuzzle", Vector3.new(0, -0.54, -2.25),
        Vector3.new(1.65, 1.06, 0.69), IVORY)
    oval(parent, "DeerNose", Vector3.new(0, -0.53, -2.67),
        Vector3.new(0.48, 0.33, 0.24), INK)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "FawnInnerEar", Vector3.new(side * 2.01, 1.95, -0.61),
            Vector3.new(0.94, 0.62, 0.22), PINK)
        for j = 1, 3 do
            oval(parent, "DeerFreckle", Vector3.new(side * (0.75 + j * 0.36), 1.35, -0.96 + j * 0.51),
                Vector3.new(0.35, 0.16, 0.38), IVORY)
        end
        oval(parent, "DeerHoof", Vector3.new(side * 1.17, -2.08, -1.1),
            Vector3.new(0.83, 0.4, 0.98), CHESTNUT)
        ribbon(parent, "BranchingAntler", Vector3.new(side * 2.03, 4.3, -0.2),
            Vector3.new(0.33, 1.5, 0.34), CHESTNUT, side * 40)
    end
    oval(parent, "DeerTail", Vector3.new(0, -0.65, 2.36), Vector3.new(1.07, 1.18, 1.2), IVORY)
end

local function axolotl(parent: Instance, color: Color3)
    local rose = Color3.fromRGB(248, 152, 185)
    oval(parent, "AxolotlBelly", Vector3.new(0, -1.15, -1.48),
        Vector3.new(2.4, 1.5, 0.34), color:Lerp(WHITE, 0.47))
    for _, side in ipairs({-1, 1}) do
        for i = 1, 3 do
            local gill = ribbon(parent, "FeatheryGill", Vector3.new(side * (2.34 + 0.22 * i), 1.75 - 0.76 * i, -0.65),
                Vector3.new(1.2, 0.35, 0.58), rose, side * (i - 2) * 17)
            gill.CastShadow = false
        end
        oval(parent, "AxolotlGillSpot", Vector3.new(side * 1.55, 0.9, -1.56),
            Vector3.new(0.35, 0.42, 0.24), rose)
    end
    oval(parent, "AxolotlTailFin", Vector3.new(0, -0.15, 2.37),
        Vector3.new(1.1, 1.86, 2.6), color:Lerp(rose, 0.55))
end

local function owl(parent: Instance, color: Color3)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "OwlHeartFace", Vector3.new(side * 1.03, 0.47, -2.14),
            Vector3.new(2.09, 2.22, 0.24), IVORY)
        oval(parent, "OwlEyebrow", Vector3.new(side * 1.04, 1.5, -2.32),
            Vector3.new(1.3, 0.2, 0.2), color:Lerp(CHESTNUT, 0.4))
        oval(parent, "SoftFeatherWing", Vector3.new(side * 2.27, -0.31, 0.3),
            Vector3.new(1.16, 2.53, 1.48), color:Lerp(IVORY, 0.32))
    end
end

-- A handful of recognizable secondary silhouettes, built once per pet.
local function chick(parent: Instance, color: Color3)
    oval(parent, "ChickBib", Vector3.new(0, -0.98, -1.79),
        Vector3.new(2.05, 1.52, 0.42), color:Lerp(WHITE, 0.75))
    oval(parent, "ChickBeak", Vector3.new(0, -0.42, -2.49),
        Vector3.new(0.73, 0.44, 0.68), GOLD)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "ChickFeatherWing", Vector3.new(side * 2.25, -0.25, 0.36),
            Vector3.new(1.12, 1.76, 1.25), color:Lerp(WHITE, 0.46))
        oval(parent, "ChickOrangeFoot", Vector3.new(side * 1.14, -2.05, -1.19),
            Vector3.new(1.12, 0.35, 1.38), GOLD)
    end
    oval(parent, "ChickTopTuft", Vector3.new(0, 2.17, -0.37),
        Vector3.new(0.79, 1.24, 0.86), color)
end

local function turtle(parent: Instance, color: Color3)
    local shell = Color3.fromRGB(94, 155, 113)
    oval(parent, "TurtleChest", Vector3.new(0, -0.82, -1.79),
        Vector3.new(2.1, 1.24, 0.48), IVORY)
    oval(parent, "TurtleShellBack", Vector3.new(0, 0.87, 2.12),
        Vector3.new(4.56, 3.18, 2.44), shell)
    for _, side in ipairs({-1, 1}) do
        for i = 1, 2 do
            oval(parent, "ShellScute", Vector3.new(side * (0.68 + i * 0.47), 1.62, 3.02 - i * 0.1),
                Vector3.new(0.83, 0.76, 0.17), color:Lerp(GOLD, 0.28))
        end
        oval(parent, "TurtleFlatFlipper", Vector3.new(side * 1.78, -1.82, -0.73),
            Vector3.new(1.36, 0.46, 1.77), color)
    end
end

local function frog(parent: Instance, color: Color3)
    oval(parent, "FrogCreamBelly", Vector3.new(0, -1.10, -1.71),
        Vector3.new(2.24, 1.63, 0.39), color:Lerp(IVORY, 0.8))
    for _, side in ipairs({-1, 1}) do
        oval(parent, "FrogEyelid", Vector3.new(side * 1.26, 2.52, -1.7),
            Vector3.new(1.78, 0.36, 0.52), color)
        for toe = 1, 3 do
            oval(parent, "FrogToe", Vector3.new(side * (1.48 + toe * 0.24), -2.1, -1.30 - toe * 0.12),
                Vector3.new(0.45, 0.23, 0.43), color)
        end
    end
end

local function butterfly(parent: Instance, color: Color3)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "ButterflyWingEye", Vector3.new(side * 3.22, 1.28, 2.08),
            Vector3.new(1.1, 1.38, 0.28), PINK)
        oval(parent, "LowerWingHeart", Vector3.new(side * 2.90, -0.89, 2.13),
            Vector3.new(0.77, 0.98, 0.28), IVORY)
        ribbon(parent, "ButterflyFeelers", Vector3.new(side * 0.64, 3.23, -1.11),
            Vector3.new(0.18, 1.65, 0.17), INK, side * 25)
    end
    oval(parent, "ButterflyChest", Vector3.new(0, -0.37, -1.93),
        Vector3.new(0.86, 2.53, 0.65), color:Lerp(IVORY, 0.64))
end

local function crab(parent: Instance, color: Color3)
    oval(parent, "CrabMuzzle", Vector3.new(0, -0.83, -1.92),
        Vector3.new(1.92, 0.92, 0.48), IVORY)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "CrabClawTip", Vector3.new(side * 3.48, 0.5, -1.08),
            Vector3.new(1.29, 1.37, 1.11), color:Lerp(PINK, 0.3))
        for i = 1, 2 do
            ribbon(parent, "CrabSideLeg", Vector3.new(side * (2.1 + 0.6 * i), -1.42, 0.57 * i),
                Vector3.new(1.42, 0.32, 0.4), color, side * 21)
        end
    end
end

local function dinosaur(parent: Instance, color: Color3)
    oval(parent, "DinosaurBelly", Vector3.new(0, -0.98, -1.73),
        Vector3.new(2.19, 1.76, 0.42), IVORY)
    oval(parent, "DinosaurMuzzle", Vector3.new(0, -0.75, -2.29),
        Vector3.new(1.48, 0.81, 0.93), color:Lerp(IVORY, 0.36))
    for i = 1, 4 do
        oval(parent, "DinosaurBackPlate", Vector3.new(0, 2.22 - i * 0.14, -0.5 + i * 0.84),
            Vector3.new(1.2, 1.44, 0.61), color:Lerp(GOLD, 0.28))
    end
end

local function bird(parent: Instance, color: Color3)
    oval(parent, "BirdChest", Vector3.new(0, -0.86, -1.78),
        Vector3.new(2.1, 1.58, 0.42), IVORY)
    oval(parent, "BirdBeak", Vector3.new(0, -0.51, -2.59),
        Vector3.new(1.04, 0.62, 0.99), GOLD)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "FeatherLayer", Vector3.new(side * 2.25, -0.38, 0.56),
            Vector3.new(0.95, 1.73, 1.57), color:Lerp(IVORY, 0.55))
        oval(parent, "BirdFoot", Vector3.new(side * 1.11, -2.01, -1.36),
            Vector3.new(0.9, 0.33, 0.93), GOLD)
    end
end

local function bat(parent: Instance, color: Color3)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "BatEarPink", Vector3.new(side * 1.44, 2.34, -0.72),
            Vector3.new(0.61, 1.17, 0.26), PINK)
        oval(parent, "BatMembraneHighlight", Vector3.new(side * 3.18, 0.4, 1.53),
            Vector3.new(2.03, 1.47, 0.19), color:Lerp(PINK, 0.48))
    end
    oval(parent, "BatChest", Vector3.new(0, -1.12, -1.71),
        Vector3.new(1.88, 1.51, 0.45), IVORY)
end

local function unicorn(parent: Instance, color: Color3)
    oval(parent, "UnicornFace", Vector3.new(0, -0.67, -1.93),
        Vector3.new(1.96, 1.21, 0.52), IVORY)
    oval(parent, "UnicornMuzzle", Vector3.new(0, -1.03, -2.47),
        Vector3.new(1.27, 0.67, 0.81), color:Lerp(IVORY, 0.65))
    for _, side in ipairs({-1, 1}) do
        oval(parent, "UnicornMane", Vector3.new(side * 1.48, 1.55, 0.96),
            Vector3.new(1.22, 1.96, 1.22), if side < 0 then PINK else GOLD)
    end
end

local function bear(parent: Instance, color: Color3)
    oval(parent, "BearMuzzle", Vector3.new(0, -0.65, -2.21),
        Vector3.new(1.63, 1.04, 0.69), IVORY)
    oval(parent, "BearNose", Vector3.new(0, -0.44, -2.62),
        Vector3.new(0.56, 0.36, 0.23), INK)
    for _, side in ipairs({-1, 1}) do
        oval(parent, "BearEarInner", Vector3.new(side * 1.56, 2.22, -0.58),
            Vector3.new(0.84, 0.81, 0.25), color:Lerp(PINK, 0.51))
    end
end

function Art.decorate(pet: Model, species: string, color: Color3)
    if not pet.PrimaryPart or pet:FindFirstChild("StorybookDetails") then return end
    local details = Instance.new("Folder")
    details.Name = "StorybookDetails"
    details.Parent = pet

    -- Micro-highlights make the existing eyes read as glossy, lively eyes
    -- without a camera-facing billboard, a per-frame update, or texture assets.
    for _, side in ipairs({-1, 1}) do
        oval(details, "EyeSpark", Vector3.new(side * 1.03, 0.82, -2.39),
            Vector3.new(0.24, 0.29, 0.13), WHITE)
    end

    if species == "Pip" or species == "Zuzu" then
        kitten(details, color)
    elseif species == "Floofle" then
        bunny(details, color)
    elseif species == "Snorf" then
        puppy(details, color)
    elseif species == "Sprig" then
        deer(details, color)
    elseif species == "Puddle" then
        axolotl(details, color)
    elseif species == "Swoop" then
        owl(details, color)
    elseif species == "Nugget" then
        chick(details, color)
    elseif species == "Pebble" then
        turtle(details, color)
    elseif species == "Splat" then
        frog(details, color)
    elseif species == "Twinkle" then
        butterfly(details, color)
    elseif species == "Quibble" then
        crab(details, color)
    elseif species == "Rumble" then
        dinosaur(details, color)
    elseif species == "Puffin" then
        bird(details, color)
    elseif species == "Echo" then
        bat(details, color)
    elseif species == "Glimmer" then
        unicorn(details, color)
    elseif species == "Mallow" then
        bear(details, color)
    end
end

return Art
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="36">
      <Properties>
        <string name="Name">WakeRound</string>
        <string name="Source"><![CDATA[--!strict
-- Round membership belongs to a visit. A reconnect cannot inherit a departed
-- player's survival credit. A new arrival can still join by making a rescue.
local Round = {}
local modes = {"Listen", "Chase", "Garden"}

function Round.mode(number: number): string
    return modes[(number-1)%#modes+1]
end

function Round.takeResult(profile: any, round: number, helped: boolean): boolean
    if profile.settledWake == round then return false end
    if profile.enteredWake ~= round and not helped then return false end
    profile.settledWake = round
    return true
end

function Round.ribbon(mode: string, hearts: number, helped: boolean, tracked: number, teamSafe: boolean): string?
    if hearts<=0 then return nil end
    if mode=="Listen" and helped and hearts==3 then return "QuietSteps" end
    if mode=="Chase" and tracked>=3 then return "TrailRunner" end
    if mode=="Garden" and helped and teamSafe then return "GardenKeeper" end
    return nil
end

-- A full meter can be soothed until the alarm expires. The normal end of
-- sleep is independent, even if a player quiets the garden at the last tick.
function Round.warning(noise: number, limit: number, secondsLeft: number, now: number, alarm: number?): (number?, string?, number?)
    local deadline = if noise >= limit then alarm or (now + 5) else nil
    local loudSeconds = if deadline then math.max(0, math.ceil(deadline - now)) else math.huge
    if secondsLeft <= 5 and secondsLeft <= loudSeconds then
        return deadline, "Timer", secondsLeft
    end
    if deadline then return deadline, "Noise", loudSeconds end
    return nil, nil, nil
end

function Round.comfort(noise: number, sensitivity: number, bond: number): number
    local relief = 2 + math.floor((100-sensitivity)/35) + math.floor(bond/40)
    return math.max(0, noise-relief)
end

function Round.alarm(species: string, traits: any, roll: number): (string?,number)
    if species=="Snorf" and roll < (110-traits.courage)/180 then return "PuppyYip",6 end
    if (species=="Swoop" or species=="Nugget" or species=="Puffin") and roll<traits.sociability/160 then
        return "BirdEcho",4
    end
    return nil,0
end

-- Check the shared distraction timer and stock together. Every check runs on
-- the server without yielding, so simultaneous throws cannot debit two bags.
function Round.throwLure(decoy: any, garden: any, id: any, now: number, position: any, consume: any): boolean
    if id~="SillyLure" and id~="GlowLure" then return false end
    if now<decoy.readyAt then return false end
    if not consume(garden,id,"lure") then return false end
    decoy.position=position
    decoy.untilTime=now+5
    decoy.readyAt=now+12
    return true
end

return Round
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="37">
      <Properties>
        <string name="Name">World</string>
        <string name="Source"><![CDATA[--!strict
-- Procedural prototype art: no externally licensed assets or mesh dependencies.
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local CottageStyle = require(script.Parent:WaitForChild("CottageGardenStyle"))
local OrganicGardenBeds = require(script.Parent:WaitForChild("OrganicGardenBeds"))
local PainterlyOrchardTree = require(script.Parent:WaitForChild("PainterlyOrchardTree"))
local StorybookPetArt = require(script.Parent:WaitForChild("StorybookPetArt"))
local ReferenceCropArt = require(script.Parent:WaitForChild("ReferenceCropArt"))
local ReferenceMeshLibrary = require(script.Parent:WaitForChild("ReferenceMeshLibrary"))
local MonsterWakeVFX = require(script.Parent:WaitForChild("MonsterWakeVFX"))
local NativeReferenceGarden = require(script.Parent:WaitForChild("ReferenceGardenFallback"))
local NativeReferenceBackdrop = require(script.Parent:WaitForChild("ReferenceBackdropFallback"))
local ReferenceFoliageLayer = require(script.Parent:WaitForChild("ReferenceFoliageLayer"))
local ReferenceGroundLight = require(script.Parent:WaitForChild("ReferenceGroundLight"))
local NativePetSilhouettes = require(script.Parent:WaitForChild("NativePetSilhouettes"))

local AudioSource = require(game:GetService("ReplicatedStorage").AudioSource)
local World = {}
local scenery: Folder
local monster: Model
local den = CFrame.identity
local monsterEyes: {BasePart} = {}
local monsterLids: {BasePart} = {}
local monsterSleepLines: {BasePart} = {}
local importedSleepingMonster: MeshPart? = nil
local lastAwakeState: boolean? = nil
local monsterMouth: BasePart

local PINK = Color3.fromRGB(255, 153, 204)
local BLUE = Color3.fromRGB(121, 220, 255)
local MINT = Color3.fromRGB(142, 239, 196)
local YELLOW = Color3.fromRGB(255, 227, 133)
local PURPLE = Color3.fromRGB(192, 165, 255)

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = cframe
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.Shape = shape or Enum.PartType.Block
    p.Anchored = true
    p.CanCollide = false
    p.CastShadow = true
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function orb(parent: Instance, name: string, position: Vector3, size: Vector3, color: Color3, material: Enum.Material?): Part
    return part(parent, name, size, CFrame.new(position), color, material, Enum.PartType.Ball)
end

local function platform(parent: Instance, name: string, position: Vector3, radius: number, thickness: number, color: Color3): Part
    local p = part(parent, name, Vector3.new(thickness, radius * 2, radius * 2), CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)), color, Enum.Material.Grass, Enum.PartType.Cylinder)
    p.CanCollide = true
    return p
end

local function billboard(parent: Instance, label: string, position: Vector3, width: number)
    local anchor = part(parent, "SignAnchor", Vector3.new(1, 1, 1), CFrame.new(position), Color3.new(1, 1, 1))
    anchor.Transparency = 1
    local gui = Instance.new("BillboardGui")
    gui.Size = UDim2.fromOffset(width, 95)
    gui.StudsOffset = Vector3.new(0, 4, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 44
    gui.Parent = anchor
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundTransparency = 1
    t.Text = label
    t.TextScaled = true
    t.Font = Enum.Font.GothamBlack
    t.TextStrokeTransparency = 0.35
    t.TextStrokeColor3 = Color3.fromRGB(58, 39, 86)
    t.TextColor3 = Color3.fromRGB(255, 255, 255)
    t.Parent = gui
end

local function lollipopTree(index: number, position: Vector3)
    -- An authorized, imported MeshPart always wins. With no mesh permissions
    -- the playable game still gets layered original orange-tree geometry,
    -- rather than large generic spheres.
    if ReferenceMeshLibrary.applyOrchardTree(scenery, index, position) then return end
    local tree = PainterlyOrchardTree.build(scenery, index, position)
    ReferenceMeshLibrary.prepare(tree,"World",{"Environment_OrangeTree"},function()
        if ReferenceMeshLibrary.applyOrchardTree(tree.Parent,index,position) then tree:Destroy() end
    end)
end

local function mushroom(position: Vector3, color: Color3, scale: number)
    part(scenery, "MushroomStem", Vector3.new(scale * 1.1, scale * 3.2, scale * 1.1), CFrame.new(position + Vector3.new(0, scale * 1.6, 0)), Color3.fromRGB(255, 245, 221))
    orb(scenery, "MushroomCap", position + Vector3.new(0, scale * 3.4, 0), Vector3.new(scale * 5, scale * 2, scale * 5), color)
    for i = 1, 5 do
        local theta = i * math.pi * 2 / 5
        orb(scenery, "Spot", position + Vector3.new(math.cos(theta) * scale * 1.5, scale * 4.3, math.sin(theta) * scale * 1.5), Vector3.new(scale * 0.6, scale * 0.32, scale * 0.6), Color3.fromRGB(255, 253, 245))
    end
end

function World.build()
    local existing = workspace:FindFirstChild("MonsterIsland")
    if existing then existing:Destroy() end
    scenery = Instance.new("Folder")
    scenery.Name = "MonsterIsland"
    scenery.Parent = workspace

    Lighting.ClockTime = 15.4
    Lighting.Brightness = 2.5
    Lighting.Ambient = Color3.fromRGB(171, 172, 220)
    Lighting.OutdoorAmbient = Color3.fromRGB(182, 191, 233)
    Lighting.FogColor = Color3.fromRGB(188, 222, 255)
    Lighting.FogEnd = 650
    Lighting.GlobalShadows = true

    local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
    atmosphere.Density = 0.23
    atmosphere.Color = Color3.fromRGB(208, 229, 255)
    atmosphere.Decay = Color3.fromRGB(255, 199, 217)
    atmosphere.Parent = Lighting
    CottageStyle.applyLighting()

    local water = part(scenery, "CottonCandySea", Vector3.new(1700, 4, 1700), CFrame.new(0, -26, 0), Color3.fromRGB(136, 195, 198), Enum.Material.Glass)
    water.Transparency = 0.36

    platform(scenery, "MainIsland", Vector3.new(0, 0, 0), 118, 14, Color3.fromRGB(151, 197, 124))
    platform(scenery, "MainEdge", Vector3.new(0, -8, 0), 113, 8, Color3.fromRGB(194, 156, 119))
    platform(scenery, "UpperEarth", Vector3.new(0, -16, 0), 88, 9, Color3.fromRGB(154, 130, 114))
    local dais=platform(scenery, "MonsterPlatform", Vector3.new(0, 8, 0), 30, 4, Color3.fromRGB(157, 181, 114))
    ReferenceMeshLibrary.decorateDen(dais)

    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "SafeSpawn"
    spawn.Size = Vector3.new(15, .25, 15)
    spawn.CFrame = CFrame.new(0, 7.08, 85)
    spawn.Material = Enum.Material.Grass
    spawn.Color = Color3.fromRGB(184, 207, 141)
    spawn.Transparency = 1
    spawn.Anchored = true
    spawn.Neutral = true
    spawn.CanCollide = true
    spawn.Duration = 0
    spawn.Parent = scenery

    local rng = Random.new(82041) -- stable decorative layout
    local colors = {PINK, BLUE, MINT, YELLOW, PURPLE}
    for i = 1, 14 do
        local a = (i / 14) * math.pi * 2
        local r = rng:NextNumber(72, 104)
        lollipopTree(i, Vector3.new(math.cos(a) * r, 7, math.sin(a) * r))
    end
    for i = 1, 12 do
        local a = rng:NextNumber(0, math.pi * 2)
        local r = rng:NextNumber(44, 101)
        local pos = Vector3.new(math.cos(a) * r, 7, math.sin(a) * r)
        mushroom(pos, colors[i % #colors + 1], rng:NextNumber(0.8, 1.8))
    end
    -- Garden reference uses sunlit foliage and tiny flowers rather than
    -- oversized neon crystals in the central playable meadow.
    for i = 1, 7 do
        local a = rng:NextNumber(0, math.pi * 2)
        local r = rng:NextNumber(43, 106)
        local base = Vector3.new(math.cos(a) * r, 7.4, math.sin(a) * r)
        for petal = 1, 5 do
            local theta = petal * math.pi * 2 / 5
            local bloom = orb(scenery, "LittleGardenPetal",
                base + Vector3.new(math.cos(theta) * 0.72, 0.1, math.sin(theta) * 0.72),
                Vector3.new(0.92, 0.28, 0.65),
                if i % 2 == 0 then Color3.fromRGB(255, 239, 211)
                else Color3.fromRGB(251, 201, 220))
            bloom.CanQuery = false
            bloom.CastShadow = false
        end
        local center = orb(scenery, "GardenBloomHeart", base + Vector3.new(0, 0.35, 0),
            Vector3.new(0.62, 0.20, 0.62), Color3.fromRGB(251, 224, 129))
        center.CanQuery = false
        center.CastShadow = false
    end
    -- Keep the horizon visually quiet; cloud spheres previously dominated
    -- the 3/4 farm camera and conflicted with the foliage-first reference.

    CottageStyle.decorateWorld(scenery)
    local importedSceneryCount = ReferenceMeshLibrary.applySetDress(scenery)
    -- Art packs are imported separately. Missing world GLBs must not leave
    -- imported crops surrounded by bare terrain; missing crop GLBs must not
    -- remove the personal garden. Keep each fallback independently.
    local importedBeds = ReferenceMeshLibrary.decorateEntrance(scenery)
    local nativeBeds = importedBeds == 0
    local nativeBackdrop = importedSceneryCount < 4
    if nativeBeds then NativeReferenceGarden.build(scenery) end
    if nativeBackdrop then NativeReferenceBackdrop.build(scenery) end
    if nativeBeds or nativeBackdrop then
        ReferenceFoliageLayer.build(scenery, nativeBackdrop, nativeBeds)
    end
    local function refreshFoliage()
        if nativeBeds or nativeBackdrop then
            ReferenceFoliageLayer.build(scenery,nativeBackdrop,nativeBeds)
        else
            local old = scenery:FindFirstChild("ReferencePaintedFoliage")
            if old then old:Destroy() end
        end
    end
    if nativeBeds then
        ReferenceMeshLibrary.prepare(scenery,"Crops",{"Crop_Berry_S3","Crop_LavaMelon_S3",
            "Crop_WhisperWheat_S3","Crop_Carrot_S3","Crop_Tomato_S3","Crop_Corn_S3"},function()
            if ReferenceMeshLibrary.decorateEntrance(scenery)>0 then
                local old = scenery:FindFirstChild("ReferenceNativeGarden")
                if old then old:Destroy() end
                nativeBeds=false
                refreshFoliage()
            end
        end)
    end
    if nativeBackdrop then
        ReferenceMeshLibrary.prepare(scenery,"World",{"Environment_OrangeTree","Environment_WoodFence",
            "Environment_GardenCottage","Environment_WaterPond","Environment_GardenerToucan",
            "Environment_BloomingHedge"},function()
            if ReferenceMeshLibrary.applySetDress(scenery)==4 then
                local old = scenery:FindFirstChild("ReferenceNativeBackdrop")
                if old then old:Destroy() end
                nativeBackdrop=false
                refreshFoliage()
            end
        end)
    end
    ReferenceGroundLight.build(scenery)
    ReferenceMeshLibrary.decorateWalkway(scenery)

    lastAwakeState = nil
    monster = Instance.new("Model")
    monster.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    monster.Name = "GigglesTheGiant"
    monster.Parent = scenery
    table.clear(monsterEyes)
    table.clear(monsterLids)
    table.clear(monsterSleepLines)
    local body = orb(monster, "Tummy", Vector3.new(0, 29, 0), Vector3.new(33, 30, 28), PURPLE)
    monster.PrimaryPart = body
    orb(monster, "Head", Vector3.new(0, 47, -4), Vector3.new(29, 25, 25), PURPLE)
    orb(monster, "LeftEar", Vector3.new(-12, 59, -4), Vector3.new(10, 17, 9), PINK)
    orb(monster, "RightEar", Vector3.new(12, 59, -4), Vector3.new(10, 17, 9), PINK)
    orb(monster, "BellyPatch", Vector3.new(0, 29, -13), Vector3.new(20, 19, 3), PINK)
    orb(monster, "LeftFoot", Vector3.new(-12, 16, -8), Vector3.new(12, 8, 14), PURPLE)
    orb(monster, "RightFoot", Vector3.new(12, 16, -8), Vector3.new(12, 8, 14), PURPLE)
    orb(monster, "LeftArm", Vector3.new(-20, 34, 0), Vector3.new(12, 17, 12), PURPLE)
    orb(monster, "RightArm", Vector3.new(20, 34, 0), Vector3.new(12, 17, 12), PURPLE)
    -- Soft original fur puffs break up the geometric sphere silhouette.
    for i = 1, 10 do
        local a = (i / 10) * 2 * math.pi
        local tuft = orb(monster, "ForeheadFurTuft",
            Vector3.new(math.cos(a) * 11.9, 55.3 + math.sin(a) * 2.4, -8.2),
            Vector3.new(4.2, 5.9, 4.6), if i % 2 == 0 then PURPLE:Lerp(PINK, 0.16) else PURPLE)
        tuft.CFrame *= CFrame.Angles(0, 0, a + 0.4)
    end
    for _, side in ipairs({-1, 1}) do
        orb(monster, "VelvetInnerEar",
            Vector3.new(side * 12, 61.6, -9), Vector3.new(5.4, 9.3, 0.8), PINK:Lerp(Color3.fromRGB(253, 238, 197), 0.27))
        orb(monster, "SleepingCheek",
            Vector3.new(side * 11.3, 43.1, -14.5), Vector3.new(5.7, 3.1, 1.2), PINK)
    end
    for _, x in ipairs({-7, 7}) do
        orb(monster, "EyeWhite", Vector3.new(x, 49, -15.3), Vector3.new(6, 6.3, 2.2), Color3.fromRGB(250, 250, 255))
        local iris = orb(monster, "SleepyEye", Vector3.new(x, 48.5, -16.8), Vector3.new(3, 3.2, 1.4), Color3.fromRGB(57, 47, 91))
        table.insert(monsterEyes, iris)
        -- Purple closed-eye covers are removed only while the monster is awake.
        local lid = orb(monster, "ClosedEyelid", Vector3.new(x, 49, -17.8),
            Vector3.new(6.2, 6.3, 1.05), PURPLE)
        table.insert(monsterLids, lid)
        local sleepLine = orb(monster, "SleepySmileLine",
            Vector3.new(x, 47.7, -18.48), Vector3.new(4.0, 0.43, 0.27),
            Color3.fromRGB(92, 69, 116))
        table.insert(monsterSleepLines, sleepLine)
    end
    monsterMouth = orb(monster, "Mouth", Vector3.new(0, 41, -16), Vector3.new(8, 2, 1.4), Color3.fromRGB(75, 42, 90))
    local halo = orb(monster, "GlowingNose", Vector3.new(0, 45, -17), Vector3.new(3, 2, 1.7), PINK, Enum.Material.Neon)
    halo.CanCollide = false

    importedSleepingMonster = ReferenceMeshLibrary.applySleepingMonster(monster)
    if not importedSleepingMonster or not importedSleepingMonster:HasTag("OrchardRig") then
        ReferenceMeshLibrary.prepareGiant(monster,function(mesh)
            importedSleepingMonster = mesh
        end)
    end
    -- The spawn is on the southern side (+Z); face the garden entrance.
    monster:PivotTo(monster:GetPivot() * CFrame.Angles(0, math.pi, 0))
    den = monster:GetPivot()

    return scenery
end

function World.monsterPosition(): Vector3
    return monster:GetPivot().Position
end

function World.followMonster(target: Vector3?, dt: number)
    local current=monster:GetPivot()
    local foot=Vector3.new(current.X,0,current.Z)
    local destination=if target then Vector3.new(target.X,0,target.Z) else Vector3.zero
    -- Keep the giant in the inner arena and keep the personal beds accessible.
    if destination.Magnitude>36 then destination=destination.Unit*36 end
    local delta=destination-foot
    local step=(if target then 6.8 else 10)*math.min(dt,.20)
    local nextFoot=if delta.Magnitude<=step then destination else foot+delta.Unit*step
    local height=den.Y-3*math.clamp((nextFoot.Magnitude-25)/8,0,1)
    local pos=Vector3.new(nextFoot.X,height,nextFoot.Z)
    local facing=if target then Vector3.new(target.X-pos.X,0,target.Z-pos.Z) else den.LookVector
    local heading=if facing.Magnitude>.01 then CFrame.lookAt(Vector3.zero,facing.Unit).Rotation else current.Rotation
    local desired=CFrame.new(pos)*current.Rotation:Lerp(heading,1-math.exp(-dt*3.2))
    if not target and nextFoot.Magnitude<.04 and desired.LookVector:Dot(den.LookVector)>.9998 then desired=den end
    if current~=desired then monster:PivotTo(desired) end
    local walking=(nextFoot-foot).Magnitude>.03
    if monster:GetAttribute("Walking")~=walking then monster:SetAttribute("Walking",walking) end
end

function World.setStirring(stirring: boolean)
    if monster:GetAttribute("Stirring") ~= stirring then monster:SetAttribute("Stirring",stirring) end
end

function World.setWakeMode(mode: string)
    monster:SetAttribute("WakeMode",mode)
end

function World.monsterGesture()
    monster:SetAttribute("AttackAt",workspace:GetServerTimeNow())
end

function World.setMonsterAwake(awake: boolean)
    -- A phase transition must emit VFX once, not on every server update.
    if lastAwakeState == awake then return end
    lastAwakeState = awake
    if awake then
        MonsterWakeVFX.wake(scenery, Vector3.new(0, 8, 0))
    end
    monster:SetAttribute("Awake",awake)
    local rigged = importedSleepingMonster and importedSleepingMonster:GetAttribute("ArtSize") ~= nil
    if importedSleepingMonster and importedSleepingMonster.Parent and not rigged then
        importedSleepingMonster.Transparency = if awake then 1 else 0
        for _, obj in ipairs(monster:GetDescendants()) do
            if obj:IsA("BasePart") and obj ~= importedSleepingMonster then
                obj.Transparency = if awake then 0 else 1
            end
        end
    end
    for _, lid in ipairs(monsterLids) do
        if lid.Parent then lid.Transparency = if awake or importedSleepingMonster then 1 else 0 end
    end
    for _, line in ipairs(monsterSleepLines) do
        if line.Parent then line.Transparency = if awake or importedSleepingMonster then 1 else 0 end
    end
    -- Sleep is golden-hour cozy; wakeup temporarily cools the same landscape.
    TweenService:Create(Lighting, TweenInfo.new(1.8), {
        ClockTime = if awake then 19.0 else 16.1,
        Brightness = if awake then 1.42 else 2.1,
        OutdoorAmbient = if awake then Color3.fromRGB(151, 155, 189)
            else Color3.fromRGB(170, 177, 149),
    }):Play()
    local grade = Lighting:FindFirstChild("CottageColorGrade")
    if grade and grade:IsA("ColorCorrectionEffect") then
        TweenService:Create(grade, TweenInfo.new(1.7), {
            TintColor = if awake then Color3.fromRGB(210, 204, 247)
                else Color3.fromRGB(255, 248, 224),
            Saturation = if awake then -0.19 else -0.065,
        }):Play()
    end
    for _, eye in ipairs(monsterEyes) do
        if eye.Parent then
            TweenService:Create(eye, TweenInfo.new(0.35), {Size = awake and Vector3.new(4.2, 5.5, 1.7) or Vector3.new(3, 3.2, 1.4), Color = awake and Color3.fromRGB(255, 65, 124) or Color3.fromRGB(57, 47, 91)}):Play()
        end
    end
    if monsterMouth and monsterMouth.Parent then
        TweenService:Create(monsterMouth, TweenInfo.new(0.4), {Size = awake and Vector3.new(11, 10, 2) or Vector3.new(8, 2, 1.4)}):Play()
    end
end

local function drawLegacyPet(pet: Model,species: string,color: Color3,pointy: boolean)
    for _, x in ipairs({-1.15, 1.15}) do
        orb(pet, "EyeWhite", Vector3.new(x, 0.5, -1.85), Vector3.new(1.35, 1.65, 0.6), Color3.fromRGB(255, 255, 255))
        orb(pet, "Pupil", Vector3.new(x, 0.35, -2.23), Vector3.new(0.64, 0.9, 0.25), Color3.fromRGB(48, 35, 74))
        orb(pet, "Ear", Vector3.new(x * 1.25, 2.15, 0), pointy and Vector3.new(1.15, 2.4, 1.1) or Vector3.new(1.8, 1.6, 1.3), color)
    end
    orb(pet, "Nose", Vector3.new(0, -0.55, -2.04), Vector3.new(0.55, 0.4, 0.4), PINK)
    orb(pet, "Smile", Vector3.new(0, -1.13, -1.85), Vector3.new(1.18, 0.25, 0.28), Color3.fromRGB(92, 53, 92))
    for _, x in ipairs({-1.75, 1.75}) do
        orb(pet, "RosyCheek", Vector3.new(x, -0.67, -1.57), Vector3.new(0.7, 0.5, 0.27), Color3.fromRGB(255, 156, 177))
        orb(pet, "TinyFoot", Vector3.new(x * 0.7, -1.86, -0.9), Vector3.new(1.25, 0.7, 1.45), color)
    end
    orb(pet, "PuffTail", Vector3.new(0, -0.2, 2.05), Vector3.new(1.8, 1.8, 1.8), color)
    if species == "Pip" or species == "Zuzu" then
        -- Two explicitly feline companions. The SAME cat species can have
        -- entirely different personalities per player.
        for _, side in ipairs({-1, 1}) do
            for n = 1, 3 do
                local whisker = part(pet, "KittenWhisker", Vector3.new(1.15, 0.10, 0.10),
                    CFrame.new(side * 1.94, -0.55 + (n - 2) * 0.24, -1.51) * CFrame.Angles(0, 0, math.rad(side * (n - 2) * 9)),
                    Color3.fromRGB(251, 245, 239))
                whisker.CanCollide = false
            end
        end
        orb(pet, "CatTail", Vector3.new(1.9, 0.35, 2.35), Vector3.new(1, 3.0, 1), color)
        orb(pet, "TailTip", Vector3.new(1.9, 1.75, 2.35), Vector3.new(1.3, 1.3, 1.3), PINK)
    elseif species == "Nugget" then
        for _, x in ipairs({-1, 1}) do
            local wing = orb(pet, "FluffyWing", Vector3.new(x * 2.6, 0.2, 0.3), Vector3.new(1.5, 2.4, 1.2), Color3.fromRGB(255, 245, 196))
            wing.CFrame = wing.CFrame * CFrame.Angles(0, 0, math.rad(x * 24))
        end
    elseif species == "Spark" then
        local crystal = orb(pet, "SparkCrown", Vector3.new(0, 3.1, 0), Vector3.new(1.55, 2.3, 1.5), YELLOW, Enum.Material.Neon)
        crystal.CFrame = crystal.CFrame * CFrame.Angles(0, 0, math.rad(22))
    elseif species == "Pickle" then
        orb(pet, "LeafSprout", Vector3.new(-0.6, 3.1, 0), Vector3.new(1.75, 0.62, 1.05), MINT)
        orb(pet, "LeafSprout", Vector3.new(0.6, 3.4, 0), Vector3.new(1.75, 0.62, 1.05), MINT)
    elseif species == "Mochi" or species == "Tofu" then
        for _, x in ipairs({-1.1, 0, 1.1}) do
            orb(pet, "CloudTuft", Vector3.new(x, 2.25, -0.2), Vector3.new(1.8, 1.5, 1.8), Color3.fromRGB(255, 253, 244))
        end
    elseif species == "Bloop" or species == "Gloop" then
        for _, x in ipairs({-1.7, 1.7}) do
            orb(pet, "JellySpot", Vector3.new(x, 0.85, -1.38), Vector3.new(0.6, 0.65, 0.28), BLUE, Enum.Material.Neon)
        end
    elseif species == "Wobble" then
        local halo = part(pet, "WobbleHalo", Vector3.new(0.4, 5.2, 5.2), CFrame.new(0, 3.1, 0) * CFrame.Angles(0, 0, math.rad(90)), PURPLE, Enum.Material.Neon, Enum.PartType.Cylinder)
        halo.Transparency = 0.32
    elseif species == "Luma" then
        orb(pet, "FluffyCloud", Vector3.new(0, 2.5, 0), Vector3.new(4, 1.5, 3), Color3.fromRGB(255, 248, 251))
        orb(pet, "StarCharm", Vector3.new(0, 3.45, -0.8), Vector3.new(1.4, 1.7, 1), YELLOW, Enum.Material.Neon)
    elseif species == "Snorf" then
        orb(pet, "BigSnout", Vector3.new(0, -0.5, -2.35), Vector3.new(2.2, 1.3, 1.3), Color3.fromRGB(241, 203, 159))
        for _, x in ipairs({-1, 1}) do orb(pet, "FloppyEar", Vector3.new(x * 2.1, 2, 0), Vector3.new(1.4, 2.8, 1.6), color) end
    elseif species == "Floofle" then
        for _, x in ipairs({-1, 1}) do
            orb(pet, "BunnyEar", Vector3.new(x * 1.3, 3.4, 0), Vector3.new(1.4, 4.2, 1.1), color)
            orb(pet, "BuckTooth", Vector3.new(x * 0.4, -1, -2.1), Vector3.new(0.65, 0.8, 0.5), Color3.fromRGB(255, 254, 248))
        end
    elseif species == "Quibble" then
        for _, x in ipairs({-1, 1}) do
            orb(pet, "CrabClaw", Vector3.new(x * 3.2, -0.2, -0.5), Vector3.new(2.1, 2.4, 2.1), color)
            orb(pet, "EyeStalk", Vector3.new(x * 1.15, 2.8, -0.7), Vector3.new(0.8, 2.8, 0.8), color)
        end
    elseif species == "Fizzle" then
        for i = 1, 4 do
            local spike = orb(pet, "FireSpike", Vector3.new(0, 2.5 + i * 0.35, -1.6 + i * 0.8), Vector3.new(1.1, 1.8, 1), Color3.fromRGB(255, 224 - i * 24, 87), Enum.Material.Neon)
            spike.CFrame *= CFrame.Angles(0, 0, math.rad(i * 12))
        end
    elseif species == "Puddle" then
        for _, x in ipairs({-1, 1}) do
            for i = 1, 3 do
                orb(pet, "AxolotlGill", Vector3.new(x * (2.4 + i * 0.2), 1.8 - i * 0.85, -0.4), Vector3.new(1.5, 0.7, 0.9), Color3.fromRGB(255, 174, 195))
            end
        end
    elseif species == "Sprig" then
        for _, x in ipairs({-1, 1}) do
            local horn = orb(pet, "LittleAntler", Vector3.new(x * 1.5, 3.7, 0), Vector3.new(0.6, 3.2, 0.6), Color3.fromRGB(169, 123, 92))
            horn.CFrame *= CFrame.Angles(0, 0, math.rad(x * 20))
            orb(pet, "LeafCrown", Vector3.new(x * 1.7, 4.5, 0), Vector3.new(1.4, 0.7, 1), MINT)
        end
    elseif species == "Twinkle" then
        for _, x in ipairs({-1, 1}) do
            orb(pet, "ButterflyWingTop", Vector3.new(x * 3.2, 1.2, 1.7), Vector3.new(3, 3.9, 0.7), Color3.fromRGB(247, 185, 253))
            orb(pet, "ButterflyWingBottom", Vector3.new(x * 2.9, -0.8, 1.8), Vector3.new(2, 2.4, 0.7), Color3.fromRGB(167, 220, 254))
        end
    elseif species == "Mallow" then
        orb(pet, "MarshmallowHat", Vector3.new(0, 2.75, 0), Vector3.new(3.5, 1.5, 3.5), Color3.fromRGB(255, 251, 238))
        orb(pet, "HeartNose", Vector3.new(0, -0.4, -2.5), Vector3.new(0.9, 0.65, 0.6), PINK)
    elseif species == "Pebble" then
        orb(pet, "TurtleShell", Vector3.new(0, 0.7, 2.0), Vector3.new(4.7, 3.8, 2.5), Color3.fromRGB(92, 174, 120))
        for _, x in ipairs({-1, 1}) do orb(pet, "ShellSpot", Vector3.new(x * 1.3, 1.7, 3.0), Vector3.new(1.3, 1.3, 0.6), MINT) end
    elseif species == "Noodle" then
        for _, x in ipairs({-1, 1}) do
            orb(pet, "LongFloppyEar", Vector3.new(x * 2.5, 2.1, -0.6), Vector3.new(1.1, 4.8, 1.2), color)
            orb(pet, "Whisker", Vector3.new(x * 1.6, -0.5, -2.2), Vector3.new(1.4, 0.15, 0.2), Color3.fromRGB(255, 249, 230))
        end
    elseif species == "Swoop" then
        for _, x in ipairs({-1, 1}) do
            orb(pet, "OwlFaceDisc", Vector3.new(x * 1.1, 0.6, -1.95), Vector3.new(2.3, 2.5, 0.55), Color3.fromRGB(251, 231, 255))
            orb(pet, "OwlFeather", Vector3.new(x * 1.8, 2.9, 0), Vector3.new(0.85, 2.2, 1), color)
        end
        orb(pet, "Beak", Vector3.new(0, -0.25, -2.4), Vector3.new(1, 1.4, 0.85), YELLOW)
    elseif species == "Rumble" then
        for i = 1, 5 do
            orb(pet, "DinoSpike", Vector3.new(0, 2.3, -2.1 + i), Vector3.new(1.4, 1.3, 1.5), Color3.fromRGB(121, 201, 133))
        end
    elseif species == "Doodle" then
        for i = 1, 5 do
            local theta = i * math.pi * 2 / 5
            orb(pet, "InkDot", Vector3.new(math.cos(theta) * 3, 1 + math.sin(theta) * 2.8, 0), Vector3.new(0.65, 0.65, 0.65), Color3.fromRGB(82, 77, 138))
        end
    elseif species == "Crumble" then
        for i = 1, 6 do
            local theta = i * math.pi * 2 / 6
            orb(pet, "ChocolateChip", Vector3.new(math.cos(theta) * 1.45, math.sin(theta) * 1.4, -1.88), Vector3.new(0.65, 0.7, 0.35), Color3.fromRGB(128, 81, 65))
        end
    elseif species == "Squiggle" then
        for i = 1, 6 do
            local theta = i * math.pi * 2 / 6
            orb(pet, "SquidArm", Vector3.new(math.cos(theta) * 2, -2, math.sin(theta) * 2), Vector3.new(0.8, 2.2, 0.8), color)
        end
    elseif species == "Glimmer" then
        local horn = orb(pet, "UnicornHorn", Vector3.new(0, 3.6, -0.6), Vector3.new(1, 3.3, 1), Color3.fromRGB(255, 238, 138), Enum.Material.Neon)
        horn.CFrame *= CFrame.Angles(math.rad(-22), 0, 0)
        for _, x in ipairs({-1, 1}) do orb(pet, "RainbowMane", Vector3.new(x * 1.2, 2.1, 0.8), Vector3.new(2, 1.3, 1.5), Color3.fromRGB(235, 178, 254)) end
    elseif species == "Splat" then
        for _, x in ipairs({-1, 1}) do
            orb(pet, "FrogEyebulge", Vector3.new(x * 1.3, 2.2, -1.1), Vector3.new(2, 2, 1.8), color)
            orb(pet, "FrogFoot", Vector3.new(x * 2, -1.95, -1), Vector3.new(2, 0.7, 2), color)
        end
    elseif species == "Puffin" then
        for _, x in ipairs({-1, 1}) do orb(pet, "PuffinWing", Vector3.new(x * 2.5, 0.1, 0), Vector3.new(1.5, 3, 1.9), Color3.fromRGB(255, 245, 218)) end
        orb(pet, "OrangeBeak", Vector3.new(0, -0.5, -2.65), Vector3.new(1.5, 1.1, 1.4), Color3.fromRGB(255, 165, 94))
    elseif species == "Echo" then
        for _, x in ipairs({-1, 1}) do
            local wing = orb(pet, "BatWing", Vector3.new(x * 3.1, 0.7, 1), Vector3.new(3, 2.6, 0.75), Color3.fromRGB(94, 79, 174))
            wing.CFrame *= CFrame.Angles(0, 0, math.rad(x * 24))
            orb(pet, "Fang", Vector3.new(x * 0.6, -1.1, -2.17), Vector3.new(0.45, 0.95, 0.45), Color3.fromRGB(254, 254, 248))
        end
    end
    StorybookPetArt.decorate(pet, species, color)
end

function World.makePet(name: string, color: Color3, pointy: boolean): Model
    local pet = Instance.new("Model")
    pet.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    pet:SetAttribute("CoatColor",color)
    pet.Name = name
    pet.Parent = scenery
    local body = orb(pet, "SquishyBody", Vector3.new(0, 0, 0), Vector3.new(4.4, 4, 4), color)
    body.CanCollide = false
    pet.PrimaryPart = body
    local species = (string.match(name, "^[^_]+") or name):gsub("^Wild", "")
    pet:SetAttribute("PetSpecies",species)
    pet:SetAttribute("Airborne",species=="Echo" or species=="Twinkle" or species=="Doodle" or species=="Swoop")
    local tag = Instance.new("BillboardGui")
    tag.Name = "PetNameTag"
    tag.Size = UDim2.fromOffset(140, 36)
    tag.StudsOffset = Vector3.new(0, 3.7, 0)
    tag.MaxDistance = 85
    tag.AlwaysOnTop = true
    tag.Parent = body
    local tagText = Instance.new("TextLabel")
    tagText.Size = UDim2.fromScale(1, 1)
    tagText.BackgroundTransparency = 1
    tagText.Text = species
    tagText.TextScaled = true
    tagText.TextColor3 = Color3.fromRGB(255, 255, 255)
    tagText.TextStrokeColor3 = Color3.fromRGB(76, 49, 99)
    tagText.TextStrokeTransparency = 0.15
    tagText.Font = Enum.Font.GothamBlack
    tagText.Parent = tag
    local light = Instance.new("PointLight")
    light.Range = 11
    light.Brightness = 0.12
    light.Color = color
    light.Parent = body
    -- Imported sculpt takes priority. With no asset permissions, pets still
    -- have family-specific native silhouettes instead of identical blobs.
    if not ReferenceMeshLibrary.applyPet(pet, species) then
        drawLegacyPet(pet,species,color,pointy)
        NativePetSilhouettes.apply(pet, species, color)
    end
    return pet
end

function World.tintPet(pet: Model, tint: Color3)
    local mesh = pet:FindFirstChild("ImportedCharacterMesh")
    if mesh and mesh:IsA("MeshPart") then
        local mix=if tint==pet:GetAttribute("CoatColor") then Color3.new(1,1,1) else Color3.new(1,1,1):Lerp(tint,.70)
        mesh.Color=mix
        for _,child in ipairs(mesh:GetChildren()) do
            if child:IsA("MeshPart") then child.Color=mix end
        end
    end
    for _, item in ipairs(pet:GetDescendants()) do
        if item:IsA("BasePart") and (item.Name == "SquishyBody" or item.Name == "Ear") then
            item.Color = tint
        end
    end
end

function World.burst(position: Vector3, color: Color3, count: number, reach: number?)
    -- A short scattering of hand-painted leaves/flower confetti instead of
    -- bright neon spheres. Cap replicated pieces even during chaotic rounds.
    local rng = Random.new()
    local total = math.clamp(math.floor(count), 0, 18)
    local radius = math.clamp(reach or 9, 1, 11)
    for i = 1, total do
        local angle = (i / math.max(total, 1)) * math.pi * 2
            + rng:NextNumber(-0.24, 0.24)
        local distance = rng:NextNumber(radius * 0.22, radius * 0.66)
        local start = position + Vector3.new(
            math.cos(angle) * 0.22, rng:NextNumber(1.15, 2.0),
            math.sin(angle) * 0.22)
        local leaf = Instance.new("WedgePart")
        leaf.Name = "PaintedCelebrationPetal"
        leaf.Size = Vector3.new(rng:NextNumber(0.21, 0.44), 0.075,
            rng:NextNumber(0.42, 0.78))
        leaf.CFrame = CFrame.new(start)
            * CFrame.Angles(rng:NextNumber(-.35, .35), angle, .20)
        leaf.Material = Enum.Material.SmoothPlastic
        leaf.Color = if i % 5 == 0 then Color3.fromRGB(255, 244, 204)
            elseif i % 3 == 0 then color:Lerp(Color3.fromRGB(163, 207, 132), .26)
            else color
        leaf.Anchored = true
        leaf.CanCollide = false
        leaf.CanTouch = false
        leaf.CanQuery = false
        leaf.CastShadow = false
        leaf.Transparency = 0.08
        leaf.Parent = scenery
        local goal = start + Vector3.new(math.cos(angle) * distance,
            rng:NextNumber(.25, 1.5), math.sin(angle) * distance)
        TweenService:Create(leaf, TweenInfo.new(rng:NextNumber(.75, 1.18),
            Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = CFrame.new(goal) * CFrame.Angles(
                rng:NextNumber(.45, 1.6), angle + math.pi * 1.4, .46),
            Transparency = 1,
            Size = leaf.Size * .40,
        }):Play()
        Debris:AddItem(leaf, 1.3)
    end
end

function World.markDanger(center: Vector3, radius: number, tint: Color3, seconds: number)
    MonsterWakeVFX.markDanger(scenery,center,radius,tint,seconds)
end

function World.wave(position: Vector3, radius: number, _color: Color3)
    MonsterWakeVFX.groundPulse(scenery, position, radius)

end

-- Server-created personal farm zones. A player sees their six physical plots on the island.
local farmModels: {[number]: Model} = {}
local farmCenters: {[number]: CFrame} = {}
-- The interaction handler lives in the authoritative game server.
-- World only creates physical prompts and never edits the player's inventory.
local gardenPromptHandler: ((Player, number, number) -> ())? = nil

function World.setGardenPromptHandler(handler: (Player, number, number) -> ())
    gardenPromptHandler = handler
end

function World.plotPosition(userId: number, plotIndex: number): Vector3?
    if plotIndex < 1 or plotIndex > 9 or plotIndex ~= math.floor(plotIndex) then return nil end
    local farm = farmModels[userId]
    if not farm then return nil end
    local plot = farm:FindFirstChild("Plot_" .. tostring(plotIndex))
    if not plot then return nil end
    local x, y, z = plot:GetAttribute("PosX"), plot:GetAttribute("PosY"), plot:GetAttribute("PosZ")
    if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then return nil end
    return Vector3.new(x, y, z)
end

function World.createGarden(userId: number, ownerName: string, slot: number): boolean
    if slot < 1 or slot > 12 then return false end
    if farmModels[userId] then farmModels[userId]:Destroy() end
    -- Place the first player garden directly ahead of the southern spawn.
    -- Remaining plots retain their distinct 12-player radial slots.
    local angle = (slot - 1) / 12 * math.pi * 2 + math.pi / 2
    local origin = Vector3.new(math.cos(angle) * 61, 7.26, math.sin(angle) * 61)
    local center = CFrame.lookAt(origin, Vector3.new(0, origin.Y, 0))
    local model = Instance.new("Model")
    model.Name = "Farm_" .. tostring(userId)
    model.Parent = scenery
    farmModels[userId] = model
    farmCenters[userId] = center
    local base = part(model, "GardenPlatform", Vector3.new(28, 0.8, 32),
        center, Color3.fromRGB(133, 177, 103), Enum.Material.Grass)
    base.CanCollide = true
    local lawn = part(model, "GreenGrass", Vector3.new(26, 0.4, 30),
        center * CFrame.new(0, 0.5, 0), Color3.fromRGB(168, 194, 119), Enum.Material.Grass)
    lawn.CanCollide = true
    OrganicGardenBeds.decorateLawn(model, center)
    local labelPosition = (center * CFrame.new(0, 2.2, 12)).Position
    billboard(model, "🌼 " .. string.sub(ownerName, 1, 16) .. "'S GARDEN", labelPosition, 260)

    for index = 1, 9 do
        local col = (index - 1) % 3
        local row = math.floor((index - 1) / 3)
        local plot = Instance.new("Model")
        plot.Name = "Plot_" .. index
        plot.Parent = model
        plot:SetAttribute("StageKey", "EMPTY")
        plot:SetAttribute("PlotIndex", index)
        local place = center * CFrame.new((col - 1) * 8.2, 0.9, (row - 1) * 8.4)
        plot:SetAttribute("PosX", place.Position.X)
        plot:SetAttribute("PosY", place.Position.Y)
        plot:SetAttribute("PosZ", place.Position.Z)
        -- Edgeless organic earth replaces nine raised wooden boxes.
        -- Positions and attributes still match the existing garden persistence.
        local soil = Instance.new("Model")
        soil.Name="SoilDetails"
        soil.Parent=plot
        OrganicGardenBeds.decoratePlot(soil, place, index)
        ReferenceMeshLibrary.ground(plot,"Environment_LoamBed",place*CFrame.Angles(0,index*math.pi/2,0),7.35,soil)
        local mini = part(plot, "NumberAnchor", Vector3.new(0.2, 0.2, 0.2), place * CFrame.new(0, 1.6, -2.9), Color3.new(1, 1, 1))
        mini.Transparency = 1
        mini.CanCollide = false
        mini.CanQuery = false
        local prompt = Instance.new("ProximityPrompt")
        prompt.Name = "GardenPlotInteract"
        prompt.ActionText = "Plant seed"
        prompt.ObjectText = "Your garden • Plot " .. index
        prompt.KeyboardKeyCode = Enum.KeyCode.E
        prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
        prompt.MaxActivationDistance = 8
        prompt.HoldDuration = 0.22
        prompt.RequiresLineOfSight = false
        prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
        prompt.Parent = mini
        prompt.Triggered:Connect(function(player: Player)
            local handler = gardenPromptHandler
            if handler then handler(player, userId, index) end
        end)
        local tag = Instance.new("BillboardGui")
        tag.Size = UDim2.fromOffset(84, 24)
        tag.MaxDistance = 12
        tag.AlwaysOnTop = false
        tag.Parent = mini
        local t = Instance.new("TextLabel")
        t.Size = UDim2.fromScale(1, 1)
        t.BackgroundColor3 = Color3.fromRGB(255, 252, 224)
        t.BackgroundTransparency = 0.28
        t.TextColor3 = Color3.fromRGB(69, 43, 64)
        t.Text = "PLOT " .. index
        t.TextScaled = true
        t.Font = Enum.Font.GothamBlack
        t.Parent = tag
        local rounded = Instance.new("UICorner")
        rounded.CornerRadius = UDim.new(0, 7)
        rounded.Parent = t
    end
    CottageStyle.decorateFarm(model, center)
    return true
end

function World.showGarland(userId: number)
    local farm=farmModels[userId]
    if not farm or farm:FindFirstChild("MoonflowerGarland") then return end
    local garland=Instance.new("Folder")
    garland.Name="MoonflowerGarland"
    garland.Parent=farm
    local frame=farmCenters[userId]
    for _,side in {-1,1} do
        ReferenceMeshLibrary.ground(garland,"Crop_MoonLotus_S3",frame*CFrame.new(side*8,.77,-13.6),2.5,nil)
    end
end

function World.removeGarden(userId: number)
    if farmModels[userId] then farmModels[userId]:Destroy() end
    farmModels[userId] = nil
    farmCenters[userId] = nil
end

function World.gardenSpawn(userId: number): Vector3?
    local center = farmCenters[userId]
    if not center then return nil end
    return (center * CFrame.new(0, 4, 13)).Position
end

function World.updateGarden(userId: number, garden: any, cropConfig: any)
    local model = farmModels[userId]
    if not model then return end
    CottageStyle.styleEntrance(model,farmCenters[userId],garden.style)
    local now = os.time()
    for index = 1, cropConfig.PLOT_COUNT do
        local plot = model:FindFirstChild("Plot_" .. index)
        if not plot or not plot:IsA("Model") then continue end
        local p = garden.plots[index]
        local stage = 0
        if p then
            local total = math.max(1, p.readyAt - p.plantedAt)
            local ratio = math.clamp((now - p.plantedAt) / total, 0, 1)
            stage = if now >= p.readyAt then 3 elseif ratio > 0.48 then 2 else 1
        end
        local stageKey = if p then p.seed .. "_" .. stage .. "_" .. (p.mutation or "normal") else "EMPTY"
        -- Refresh interaction text even when the stage geometry did not change.
        -- The server calls this every 8 seconds, so ripeness appears in-world.
        local anchorPart = plot:FindFirstChild("NumberAnchor")
        local prompt = if anchorPart then anchorPart:FindFirstChild("GardenPlotInteract") else nil
        if prompt and prompt:IsA("ProximityPrompt") then
            prompt.ActionText = if not p then "Plant seed"
                elseif now >= p.readyAt then "Harvest ripe crop" else "Check growth"
            prompt.ObjectText = if p and cropConfig.Crops[p.seed] then
                cropConfig.Crops[p.seed].name else "Your garden • Plot " .. index
            prompt.HoldDuration = if p and now >= p.readyAt then 0.14 else 0.22
        end
        if plot:GetAttribute("StageKey") == stageKey then continue end
        plot:SetAttribute("StageKey", stageKey)
        local previous = plot:FindFirstChild("PlantVisual")
        if previous then previous:Destroy() end
        if p and cropConfig.Crops[p.seed] then
            local visual = Instance.new("Model")
            visual.Name = "PlantVisual"
            visual.Parent = plot
            local center = Vector3.new(plot:GetAttribute("PosX"), plot:GetAttribute("PosY"), plot:GetAttribute("PosZ"))
            local crop = cropConfig.Crops[p.seed]
            -- All 30 crop IDs keep their gameplay identity and stage timing.
            -- Unlike the old giant glowing spheres, these are original leafy silhouettes.
            local height = 1.2 + stage * 1.0
            local size = 0.75 + stage * 0.65
            local head = center + Vector3.new(0, height + 0.8, 0)
            if not ReferenceMeshLibrary.applyCrop(visual, center, p.seed, stage) then
                ReferenceCropArt.draw(visual, center, p.seed, stage, crop.color)
            end
            if p.mutation then
                local variations = {
                    Golden = Color3.fromRGB(255, 224, 107),
                    Dewy = Color3.fromRGB(133, 225, 255),
                    Moonlit = Color3.fromRGB(202, 165, 255),
                    Giggly = Color3.fromRGB(255, 152, 209),
                }
                local tint = variations[p.mutation] or crop.color
                for n = 1, 5 do
                    local a = n * math.pi * 2 / 5
                    local bubble = orb(visual, "MutatedSparkle_" .. p.mutation,
                        head + Vector3.new(math.cos(a) * (size + 1.1), math.sin(a) * (size + 1.2), 0),
                        Vector3.new(0.64, 0.64, 0.64), tint, Enum.Material.Neon)
                    bubble.CanCollide = false
                end
            end
            -- Ripeness is visible on the fruit itself; no floating neon marker.
        end
    end
end

local MOOD_LABELS = {
    Happy = "😊 HAPPY", Calm = "😌 CALM", Grumpy = "😾 GRUMPY",
    Excited = "🤩 EXCITED", Shy = "🥺 SHY", Scared = "😱 SCARED",
    Sleepy = "😴 SLEEPY", Hungry = "🍎 HUNGRY", Curious = "🧐 CURIOUS",
}

function World.stylePersonality(pet: Model, personality: any)
    local root = pet.PrimaryPart
    if not root then return end
    if pet:FindFirstChild("PersonalityAccessory") then return end
    local folder = Instance.new("Folder")
    folder.Name = "PersonalityAccessory"
    folder.Parent = pet
    local t = personality.temperament
    if t == "Grumpy" or t == "Mischievous" or t == "Wild" then
        for _, side in ipairs({-1, 1}) do
            local horn = orb(folder, "TinyAttitudeHorn", Vector3.new(side * 1.15, 2.8, -0.4),
                Vector3.new(0.8, 1.7, 0.8), if t == "Grumpy" then Color3.fromRGB(255, 105, 131) else Color3.fromRGB(183, 137, 249))
            horn.CFrame *= CFrame.Angles(0, 0, math.rad(side * 23))
        end
    elseif t == "Kind" or t == "Clingy" or t == "Shy" then
        orb(folder, "HeartCharm", Vector3.new(0.65, 2.65, -1.1), Vector3.new(1.5, 1.4, 0.5), PINK, Enum.Material.Neon)
    elseif t == "Brave" or t == "Proud" then
        orb(folder, "TinyCrown", Vector3.new(0, 3, -0.3), Vector3.new(2.4, 0.6, 1.2), YELLOW, Enum.Material.Neon)
        orb(folder, "CrownGem", Vector3.new(0, 3.45, -0.72), Vector3.new(0.8, 0.8, 0.5), BLUE, Enum.Material.Neon)
    elseif t == "Curious" or t == "Playful" then
        orb(folder, "CuriosityOrb", Vector3.new(-1.35, 2.7, -0.65), Vector3.new(1.15, 1.15, 1.15), MINT, Enum.Material.Neon)
    elseif t == "Sleepy" or t == "Dreamer" then
        orb(folder, "DreamBubble", Vector3.new(1.65, 2.9, 0), Vector3.new(1.3, 1.3, 1.3), BLUE, Enum.Material.Glass)
    else
        orb(folder, "DramaStar", Vector3.new(0, 3.2, -0.3), Vector3.new(1.4, 1.4, 1.4), YELLOW, Enum.Material.Neon)
    end
    local moodGui = Instance.new("BillboardGui")
    moodGui.Name = "MoodBubble"
    moodGui.Size = UDim2.fromOffset(176, 44)
    moodGui.StudsOffset = Vector3.new(0, 5.1, 0)
    moodGui.MaxDistance = 82
    moodGui.AlwaysOnTop = true
    moodGui.Parent = root
    local label = Instance.new("TextLabel")
    label.Name = "MoodText"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundColor3 = Color3.fromRGB(255, 249, 238)
    label.BackgroundTransparency = 0.15
    label.TextColor3 = Color3.fromRGB(79, 55, 104)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBlack
    label.Parent = moodGui
    local round = Instance.new("UICorner")
    round.CornerRadius = UDim.new(0, 14)
    round.Parent = label
    World.emotePet(pet, "Happy", personality.habit)
end

-- Configurable sound. Upload the project's original purr WAV in Creator Dashboard
-- and set Config.PurrSoundId. No third-party or unlicensed audio asset is used.
function World.setPurr(pet: Model, level: number, soundId: number?)
    local root = pet.PrimaryPart
    if not root then return end
    local existing = root:FindFirstChild("SoftPurrLoop")
    local uri=AudioSource.resolve(soundId,"original-cat-purr-loop")
    if not uri then
        if existing and existing:IsA("Sound") then existing:Stop() end
        return
    end
    local sound: Sound
    if existing and existing:IsA("Sound") then
        sound = existing
    else
        sound = Instance.new("Sound")
        sound.Name = "SoftPurrLoop"
        sound.Looped = true
        sound.RollOffMaxDistance = 64
        sound.RollOffMinDistance = 3
        sound.RollOffMode = Enum.RollOffMode.InverseTapered
        sound.SoundId = uri
        sound.Volume = 0
        sound.Parent = root
    end
    level = math.clamp(level, 0, 1)
    sound.Volume = 0.05 + level * 0.77
    sound.PlaybackSpeed = 0.82 + level * 0.29
    if level <= 0.001 then
        sound:Stop()
    elseif not sound.IsPlaying then
        sound:Play()
    end
end

function World.carryPose(pet: Model, root: BasePart, t: number): CFrame
    -- Visual cuddling pose, not an equipped Tool. Server continuously positions
    -- the anchored, non-colliding companion in the avatar's arms.
    local cuddle = root.CFrame * CFrame.new(0, 1.0 + math.sin(t * 2.5) * 0.09, -3)
    return cuddle * CFrame.Angles(math.rad(-13), math.rad(math.sin(t * 1.2) * 7), math.rad(-8))
end

function World.emotePet(pet: Model, mood: string, action: string?)
    local root = pet.PrimaryPart
    if not root then return end
    pet:SetAttribute("PetMood",mood)
    local gui = root:FindFirstChild("MoodBubble")
    if not gui then return end
    local label = gui:FindFirstChild("MoodText")
    if label and label:IsA("TextLabel") then
        local m = MOOD_LABELS[mood] or mood
        label.Text = m .. (if action then " • " .. string.upper(action) else "")
        label.TextColor3 = if mood == "Grumpy" then Color3.fromRGB(195, 68, 94)
            elseif mood == "Scared" then Color3.fromRGB(113, 91, 210)
            elseif mood == "Happy" or mood == "Excited" then Color3.fromRGB(79, 159, 97)
            else Color3.fromRGB(79, 55, 104)
    end
end

return World
]]></string>
      </Properties>
    </Item>
  </Item>
