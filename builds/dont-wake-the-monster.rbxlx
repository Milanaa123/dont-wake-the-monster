  <Item class="StarterPlayer" referent="187">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="188">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="189">
        <Properties>
          <string name="Name">Collection</string>
          <string name="Source"><![CDATA[--!strict
-- Free-to-play creature collection and quests; no Robux purchases in this prototype.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent

local INK = Color3.fromRGB(62, 52, 91)
local PURPLE = Color3.fromRGB(127, 91, 194)
local CREAM = Color3.fromRGB(255, 250, 242)
local LIGHT = Color3.fromRGB(245, 236, 255)
local MUTED = Color3.fromRGB(104, 94, 126)

local catalog = {owned = {1}, equipped = 1, discovered = 0, totalReactions = #Config.Reactions, feedCount = 0, survivalCount = 0, questClaimed = {feeds = false, survivals = false, discoveries = false}, dailyReady = false}
local currentCoins = 0

local function rounded(target: Instance, radius: number)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = target
end

local function outline(target: Instance, color: Color3)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = 2
    s.Transparency = 0.28
    s.Parent = target
end

local function textLabel(parent: Instance, value: string, size: number, color: Color3, font: Enum.Font?): TextLabel
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Text = value
    t.Font = font or Enum.Font.GothamBold
    t.TextSize = size
    t.TextColor3 = color
    t.TextWrapped = true
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = parent
    return t
end

local gui = Instance.new("ScreenGui")
gui.Name = "CollectionGui"
gui.ResetOnSpawn = false
gui.DisplayOrder = 7
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local open = Instance.new("TextButton")
open.Name = "OpenCollection"
open.Position = UDim2.fromOffset(12, 191)
open.Size = UDim2.fromOffset(152, 42)
open.BackgroundColor3 = CREAM
open.TextColor3 = INK
open.Text = "🐾 MY PETS (P)"
open.Font = Enum.Font.GothamBlack
open.TextSize = 13
open.Parent = gui
rounded(open, 14)
outline(open, Color3.fromRGB(198, 170, 251))

local daily = Instance.new("TextButton")
daily.Name = "DailyTreat"
daily.Position = UDim2.fromOffset(12, 241)
daily.Size = UDim2.fromOffset(152, 39)
daily.BackgroundColor3 = Color3.fromRGB(255, 224, 147)
daily.TextColor3 = INK
daily.Font = Enum.Font.GothamBlack
daily.TextSize = 12
daily.Text = "🎁 DAILY TREAT"
daily.Parent = gui
rounded(daily, 14)
outline(daily, Color3.fromRGB(255, 186, 114))

local overlay = Instance.new("Frame")
overlay.Name = "CollectionOverlay"
overlay.Size = UDim2.fromScale(1, 1)
overlay.Position = UDim2.fromScale(0, 0)
overlay.BackgroundColor3 = Color3.fromRGB(35, 26, 62)
overlay.BackgroundTransparency = 0.3
overlay.BorderSizePixel = 0
overlay.Active = true
overlay.Visible = false
overlay.Parent = gui

local panel = Instance.new("Frame")
panel.Name = "CollectionPanel"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.new(0.94, 0, 0.86, 0)
panel.BackgroundColor3 = CREAM
panel.BorderSizePixel = 0
panel.Parent = overlay
rounded(panel, 24)
outline(panel, Color3.fromRGB(208, 187, 255))
local panelLimit = Instance.new("UISizeConstraint")
panelLimit.MaxSize = Vector2.new(580, 650)
panelLimit.MinSize = Vector2.new(260, 300)
panelLimit.Parent = panel

local title = textLabel(panel, "🐾 MY CHAOTIC CREATURES", 20, INK, Enum.Font.GothamBlack)
title.Position = UDim2.new(0, 18, 0, 13)
title.Size = UDim2.new(1, -83, 0, 30)
title.TextScaled = true
local titleLimit = Instance.new("UITextSizeConstraint")
titleLimit.MaxTextSize = 20
titleLimit.MinTextSize = 13
titleLimit.Parent = title

local close = Instance.new("TextButton")
close.Name = "Close"
close.AnchorPoint = Vector2.new(1, 0)
close.Position = UDim2.new(1, -15, 0, 10)
close.Size = UDim2.fromOffset(43, 38)
close.BackgroundColor3 = Color3.fromRGB(255, 184, 193)
close.Text = "✕"
close.TextSize = 24
close.TextColor3 = INK
close.Font = Enum.Font.GothamBlack
close.Parent = panel
rounded(close, 14)

local subtitle = textLabel(panel, "Collect new friends using COINS from chaos!", 12, MUTED)
subtitle.Position = UDim2.new(0, 18, 0, 48)
subtitle.Text = "Each pet has a unique temperament. Tap DIARY to bond!"
subtitle.Size = UDim2.new(1, -36, 0, 24)
subtitle.TextScaled = true
local subtitleLimit = Instance.new("UITextSizeConstraint")
subtitleLimit.MinTextSize = 10
subtitleLimit.MaxTextSize = 13
subtitleLimit.Parent = subtitle

local quests = Instance.new("Frame")
quests.Name = "Quests"
quests.Position = UDim2.new(0, 13, 0, 79)
quests.Size = UDim2.new(1, -26, 0, 100)
quests.BackgroundColor3 = LIGHT
quests.BorderSizePixel = 0
quests.Parent = panel
rounded(quests, 15)

local questTitle = textLabel(quests, "✨ STARTER QUESTS", 14, PURPLE, Enum.Font.GothamBlack)
questTitle.Position = UDim2.new(0, 12, 0, 3)
questTitle.Size = UDim2.new(1, -24, 0, 22)
local questFeed = textLabel(quests, "🍬 Feed pets: 0/5  →  +45 coins", 12, INK)
questFeed.Position = UDim2.new(0, 12, 0, 25)
questFeed.Size = UDim2.new(1, -24, 0, 22)
local questSurvive = textLabel(quests, "❤️ Survive rounds: 0/2  →  +80 coins", 12, INK)
questSurvive.Position = UDim2.new(0, 12, 0, 48)
questSurvive.Size = UDim2.new(1, -24, 0, 22)
local questDiscover = textLabel(quests, "🌈 Discover chaos: 0/4  →  +70 coins", 12, INK)
questDiscover.Position = UDim2.new(0, 12, 0, 71)
questDiscover.Size = UDim2.new(1, -24, 0, 22)

local collectionTitle = textLabel(panel, "YOUR PETS", 15, INK, Enum.Font.GothamBlack)
collectionTitle.Position = UDim2.new(0, 17, 0, 183)
collectionTitle.Size = UDim2.new(1, -34, 0, 27)

local list = Instance.new("ScrollingFrame")
list.Name = "PetList"
list.Position = UDim2.new(0, 12, 0, 212)
list.Size = UDim2.new(1, -24, 1, -223)
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.ScrollBarThickness = 5
list.ScrollBarImageColor3 = PURPLE
list.CanvasSize = UDim2.new(0, 0, 0, 0)
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.ScrollingDirection = Enum.ScrollingDirection.Y
list.Parent = panel
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list
local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 4)
padding.PaddingBottom = UDim.new(0, 10)
padding.PaddingLeft = UDim.new(0, 4)
padding.PaddingRight = UDim.new(0, 7)
padding.Parent = list

local rowButtons: {[number]: TextButton} = {}
local rowDetails: {[number]: TextLabel} = {}
local function owned(id: number): boolean
    for _, value in ipairs(catalog.owned) do
        if value == id then return true end
    end
    return false
end

for id, pet in ipairs(Config.Pets) do
    local row = Instance.new("Frame")
    row.Name = pet.name
    row.LayoutOrder = id
    row.Size = UDim2.new(1, -4, 0, 62)
    row.BackgroundColor3 = LIGHT
    row.BorderSizePixel = 0
    row.Parent = list
    rounded(row, 14)

    local iconBack = Instance.new("Frame")
    iconBack.Position = UDim2.fromOffset(8, 8)
    iconBack.Size = UDim2.fromOffset(46, 46)
    iconBack.BackgroundColor3 = pet.color
    iconBack.BorderSizePixel = 0
    iconBack.Parent = row
    rounded(iconBack, 14)
    local icon = textLabel(iconBack, "◕ᴥ◕", 19, INK, Enum.Font.GothamBlack)
    icon.TextXAlignment = Enum.TextXAlignment.Center
    icon.Size = UDim2.fromScale(1, 1)

    local petName = textLabel(row, pet.name, 16, INK, Enum.Font.GothamBlack)
    petName.Position = UDim2.new(0, 62, 0, 7)
    petName.Size = UDim2.new(0.35, 0, 0, 23)
    petName.TextTruncate = Enum.TextTruncate.AtEnd

    local petPrice = textLabel(row, if id == 1 then "Starter buddy" else tostring(pet.price) .. " coins", 11, MUTED)
    petPrice.Position = UDim2.new(0, 62, 0, 32)
    petPrice.Size = UDim2.new(0.38, 0, 0, 20)
    rowDetails[id] = petPrice

    local button = Instance.new("TextButton")
    button.Name = "Action"
    button.AnchorPoint = Vector2.new(1, 0.5)
    button.Position = UDim2.new(1, -9, 0.5, 0)
    button.Size = UDim2.new(0.35, 0, 0, 41)
    button.BackgroundColor3 = Color3.fromRGB(255, 217, 147)
    button.BorderSizePixel = 0
    button.Text = "BUY"
    button.TextColor3 = INK
    button.Font = Enum.Font.GothamBlack
    button.TextScaled = true
    button.Parent = row
    rounded(button, 12)
    local limit = Instance.new("UITextSizeConstraint")
    limit.MinTextSize = 10
    limit.MaxTextSize = 14
    limit.Parent = button
    rowButtons[id] = button
    button.MouseButton1Click:Connect(function()
        if owned(id) then
            if catalog.equipped ~= id then remote:FireServer("EquipPet", id) end
        else
            remote:FireServer("BuyPet", id)
        end
    end)
end

local function render()
    collectionTitle.Text = string.format("YOUR PETS  %d/%d     •     CHAOS FOUND %d/%d", #catalog.owned, #Config.Pets, catalog.discovered, catalog.totalReactions)
    local done = catalog.questClaimed
    questFeed.Text = if done.feeds then "✅ FEED 5: COMPLETE!" else string.format("🍬 Feed pets: %d/5  →  +45 coins", math.min(catalog.feedCount, 5))
    questSurvive.Text = if done.survivals then "✅ SURVIVE 2: COMPLETE!" else string.format("❤️ Survive rounds: %d/2  →  +80 coins", math.min(catalog.survivalCount, 2))
    questDiscover.Text = if done.discoveries then "✅ DISCOVER 4: COMPLETE!" else string.format("🌈 Discover chaos: %d/4  →  +70 coins", math.min(catalog.discovered, 4))
    daily.Text = if catalog.dailyReady then "🎁 CLAIM +60 COINS" else "🎁 COME BACK TOMORROW"
    daily.BackgroundColor3 = if catalog.dailyReady then Color3.fromRGB(255, 224, 147) else Color3.fromRGB(227, 225, 225)
    for id, pet in ipairs(Config.Pets) do
        local b = rowButtons[id]
        local profileInfo = if type(catalog.petProfiles) == "table" then catalog.petProfiles[tostring(id)] else nil
        if profileInfo then
            rowDetails[id].Text = profileInfo.temperament .. " • " .. profileInfo.mood .. " • Bond " .. profileInfo.bond .. "%"
        else
            rowDetails[id].Text = if id == 1 then "Starter buddy" else tostring(pet.price) .. " coins"
        end
        if catalog.equipped == id then
            b.Text = "EQUIPPED ✓"
            b.BackgroundColor3 = Color3.fromRGB(170, 236, 187)
            b.Active = false
            b.AutoButtonColor = false
        elseif owned(id) then
            b.Text = "EQUIP"
            b.BackgroundColor3 = Color3.fromRGB(172, 226, 255)
            b.Active = true
            b.AutoButtonColor = true
        else
            b.Text = if currentCoins >= pet.price then "BUY " .. pet.price else "🔒 " .. pet.price
            b.BackgroundColor3 = if currentCoins >= pet.price then Color3.fromRGB(255, 222, 146) else Color3.fromRGB(219, 215, 229)
            b.Active = true -- server handles insufficient balance with feedback
            b.AutoButtonColor = true
        end
    end
end

local function setOpen(isOpen: boolean)
    overlay.Visible = isOpen
    open.Visible = not isOpen
    daily.Visible = not isOpen
    if isOpen then render() end
end
open.MouseButton1Click:Connect(function() setOpen(true) end)
close.MouseButton1Click:Connect(function() setOpen(false) end)
daily.MouseButton1Click:Connect(function()
    if catalog.dailyReady then remote:FireServer("ClaimDaily") end
end)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.P then
        setOpen(not overlay.Visible)
    elseif input.KeyCode == Enum.KeyCode.Escape and overlay.Visible then
        setOpen(false)
    end
end)

remote.OnClientEvent:Connect(function(event: any)
    if typeof(event) ~= "table" then return end
    if event.type == "collection" then
        catalog = event
        render()
    elseif event.type == "stats" then
        currentCoins = event.coins or 0
        render()
    end
end)

render()
task.delay(1.1, function()
    remote:FireServer("Sync")
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="190">
        <Properties>
          <string name="Name">CottageCamera</string>
          <string name="Source"><![CDATA[--!strict
-- Cozy three-quarter camera for gardening, normal follow view for dangerous chases.
-- Gameplay mode changes are driven by the server's existing phase messages.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent
local preferredGarden = true
local lastPhase = "SLEEP"
local appliedGarden = false
local Frame = require(ReplicatedStorage:WaitForChild("GardenCameraFrame"))
local normalFov = 70
local pondPosition: Vector3? = nil
local function updatePond()
    local center = workspace:GetAttribute("GardenPondCenter")
    pondPosition = if typeof(center)=="Vector3" then center else nil
end
workspace:GetAttributeChangedSignal("GardenPondCenter"):Connect(updatePond)
updatePond()
local currentFocus: Vector3? = nil

local gui = Instance.new("ScreenGui")
gui.Name = "CottageCameraGui"
gui.ResetOnSpawn = false
gui.DisplayOrder = 4
gui.Parent = player:WaitForChild("PlayerGui")

local toggle = Instance.new("TextButton")
toggle.Name = "CameraMode"
toggle.Position = UDim2.fromOffset(12, 342)
toggle.Size = UDim2.fromOffset(152, 42)
toggle.BackgroundColor3 = Color3.fromRGB(245, 237, 206)
toggle.BorderSizePixel = 0
toggle.TextColor3 = Color3.fromRGB(67, 67, 63)
toggle.Font = Enum.Font.GothamBlack
toggle.TextScaled = true
toggle.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 13)
corner.Parent = toggle
local limit = Instance.new("UITextSizeConstraint")
limit.MinTextSize = 11
limit.MaxTextSize = 15
limit.Parent = toggle

local function applyMode()
    local camera = workspace.CurrentCamera
    local shouldGarden = preferredGarden and lastPhase ~= "AWAKE"
    toggle.Active = lastPhase ~= "AWAKE"
    toggle.AutoButtonColor = lastPhase ~= "AWAKE"
    toggle.Text = if lastPhase == "AWAKE" then "🏃 CHASE VIEW"
        elseif shouldGarden then "🍃 GARDEN VIEW (V)" else "🎮 FOLLOW VIEW (V)"
    if not camera then
        appliedGarden = shouldGarden
        return
    end
    if appliedGarden == shouldGarden and camera.CameraType == (if shouldGarden then Enum.CameraType.Scriptable else Enum.CameraType.Custom) then
        return
    end
    if shouldGarden then
        if camera.CameraType ~= Enum.CameraType.Scriptable then
            normalFov = camera.FieldOfView
        end
        currentFocus = nil
        camera.CameraType = Enum.CameraType.Scriptable
    else
        currentFocus = nil
        camera.CameraType = Enum.CameraType.Custom
        camera.FieldOfView = normalFov
        local character = player.Character
        local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
        if humanoid then camera.CameraSubject = humanoid end
    end
    appliedGarden = shouldGarden
end

local function togglePreferred()
    if lastPhase == "AWAKE" then return end
    preferredGarden = not preferredGarden
    applyMode()
end

toggle.MouseButton1Click:Connect(togglePreferred)
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
    if not processed and input.KeyCode == Enum.KeyCode.V then
        togglePreferred()
    end
end)

remote.OnClientEvent:Connect(function(event: any)
    if type(event) ~= "table" or event.type ~= "state" then return end
    if type(event.phase) ~= "string" or event.phase == lastPhase then return end
    lastPhase = event.phase
    -- Close camera angle is unsuitable for survival rounds: return standard
    -- Roblox mobile/gamepad/keyboard camera control until the chase is over.
    applyMode()
end)

local function render(delta: number)
    if not appliedGarden then return end
    local camera = workspace.CurrentCamera
    local character = player.Character
    local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
    if not camera or not root or not root:IsA("BasePart") then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local move = if humanoid then humanoid.MoveDirection else Vector3.zero
    local aspect = camera.ViewportSize.X / math.max(camera.ViewportSize.Y, 1)
    local target, offset, fov = Frame.at(root.Position,move,aspect,pondPosition)
    local smoothing = math.clamp(1 - math.exp(-delta * 7.2), 0, 1)
    local snap = not currentFocus or ((currentFocus :: Vector3)-target).Magnitude>28
    currentFocus = if snap then target else (currentFocus :: Vector3):Lerp(target,smoothing)
    local focus = currentFocus :: Vector3
    local desired = CFrame.lookAt(focus + offset, focus)
    camera.CameraType = Enum.CameraType.Scriptable
    camera.FieldOfView = fov
    camera.CFrame = if snap then desired else camera.CFrame:Lerp(desired,smoothing)
    camera.Focus = CFrame.new(focus)
end

player.CharacterAdded:Connect(function()
    task.defer(applyMode)
end)
RunService:BindToRenderStep("CottageGardenCamera", Enum.RenderPriority.Camera.Value + 1, render)
applyMode()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="191">
        <Properties>
          <string name="Name">CottageQuickMenu</string>
          <string name="Source"><![CDATA[--!strict
-- Keeps the first mobile garden view clear: secondary menus collapse behind
-- one genuine working button. Original buttons and click handlers are reused.
-- Desktop retains native layout. No decorative / inert controls.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent

local targets = {
    {"CollectionGui", "OpenCollection"},
    {"CollectionGui", "DailyTreat"},
    {"GardenGui", "GardenOpen"},
    {"SeedExplorer", "OpenSeedExplorer"},
    {"PetDiary", "OpenDiary"},
    {"CottageCameraGui", "CameraMode"},
    {"AudioSettings", "MusicToggle"},
    {"AudioSettings", "EffectsToggle"},
    {"HowToPlayGui", "ReopenTutorial"},
}

type ControlState = {
    control: GuiButton,
    pos: UDim2,
    anchor: Vector2,
    size: UDim2,
}
local originals: {[GuiButton]: ControlState} = {}
local watched: {[GuiButton]: boolean} = {}
local expanded = false
local chasing = false
local compact = false
local introductory = true

local root = Instance.new("ScreenGui")
root.Name = "CottageQuickMenu"
root.ResetOnSpawn = false
root.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
root.DisplayOrder = 21
root.Parent = playerGui

local button = Instance.new("TextButton")
button.Name = "QuickMenuToggle"
button.Position = UDim2.fromOffset(12, 191)
button.Size = UDim2.fromOffset(136, 43)
button.BackgroundColor3 = Color3.fromRGB(255, 246, 221)
button.TextColor3 = Color3.fromRGB(75, 70, 64)
button.Font = Enum.Font.GothamBlack
button.TextScaled = true
button.Text = "🌼 MENU"
button.AutoButtonColor = true
button.BorderSizePixel = 0
button.Parent = root
local round = Instance.new("UICorner")
round.CornerRadius = UDim.new(0, 13)
round.Parent = button
local outline = Instance.new("UIStroke")
outline.Color = Color3.fromRGB(180, 155, 128)
outline.Transparency = .36
outline.Thickness = 1.3
outline.Parent = button
local textSize = Instance.new("UITextSizeConstraint")
textSize.MinTextSize = 11
textSize.MaxTextSize = 16
textSize.Parent = button

local function viewport(): Vector2
    local camera = Workspace.CurrentCamera
    return if camera then camera.ViewportSize else Vector2.new(800, 600)
end

local function refresh()
    local frame = viewport()
    compact = introductory or UserInputService.TouchEnabled or frame.X < 760
    local top=math.clamp(math.floor(frame.Y*.24),75,191)
    local firstRow=top+48
    local rows=math.max(1,math.floor((frame.Y-firstRow-54)/40))
    local columns=math.ceil(#targets/rows)
    local width=math.clamp(math.floor((frame.X-30)/columns)-5,80,155)
    button.Position=UDim2.fromOffset(12,top)
    button.Visible = compact and not chasing
    button.Text = if expanded then "✕ CLOSE MENU" else "🌼 MENU"

    for index, match in ipairs(targets) do
        local gui = playerGui:FindFirstChild(match[1])
        local control = if gui then gui:FindFirstChild(match[2],true) else nil
        if control and control:IsA("GuiButton") then
            if not originals[control] then
                originals[control] = {
                    control = control,
                    pos = control.Position,
                    anchor = control.AnchorPoint,
                    size = control.Size,
                }
            end
            local original = originals[control]
            if compact then
                control.AnchorPoint = Vector2.new(0, 0)
                control.Position = UDim2.fromOffset(12+math.floor((index-1)/rows)*(width+5),firstRow+(index-1)%rows*40)
                control.Size = UDim2.fromOffset(width,36)
                control.Visible = expanded and not chasing
                if not watched[control] then
                    watched[control] = true
                    control.Activated:Connect(function()
                        expanded = false
                        refresh()
                    end)
                end
            else
                control.AnchorPoint = original.anchor
                control.Position = original.pos
                control.Size = original.size
                control.Visible = not chasing
            end
        end
    end
end

button.Activated:Connect(function()
    if chasing then return end
    expanded = not expanded
    refresh()
end)

remote.OnClientEvent:Connect(function(payload: any)
    if type(payload) ~= "table" then return end
    if payload.type=="collection" then
        local first=(payload.survivalCount or 0)==0
        if first~=introductory then introductory=first refresh() end
    end
    if payload.type ~= "state" then return end
    local newChasing = payload.phase == "AWAKE"
    if newChasing ~= chasing then
        chasing = newChasing
        if chasing then expanded = false end
        refresh()
    end
end)

playerGui.DescendantAdded:Connect(function(added: Instance)
    if not added:IsA("GuiButton") then return end
    task.defer(refresh)
end)

local camera = Workspace.CurrentCamera
if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh) end
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    local newCamera = Workspace.CurrentCamera
    if newCamera then
        newCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
    end
    refresh()
end)

task.defer(refresh)
task.delay(1.0, refresh)
task.delay(3.0, refresh)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="192">
        <Properties>
          <string name="Name">CozyMotion</string>
          <string name="Source"><![CDATA[--!strict
-- Gentle camera-proximity cosmetic movement for original imported GLB art.
-- Runs only on the viewer. Server physics, mesh imports and gameplay stay untouched.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

type AnimatedEntry = {
    mesh: MeshPart,
    base: CFrame,
    size: Vector3,
    kind: string,
    seed: number,
    born: number,
}
local animated: {[MeshPart]: AnimatedEntry} = {}
local viewDistance = 140
local elapsed = 0

local function kindFor(mesh: MeshPart): string?
    if mesh.Name == "ImportedCharacterMesh" then return "pet" end
    if mesh.Name == "ImportedSleepingMonster" then
        return if mesh:HasTag("OrchardRig") then nil else "boss"
    end
    if mesh.Name == "ImportedGardenerToucan" then return "bird" end
    if string.find(mesh.Name, "ImportedOrangeTree_", 1, true) == 1 then return "tree" end
    if mesh:GetAttribute("DecorativeOnly") == true then return "plant" end
    if mesh.Name == "ImportedCropMesh" then return "plant" end
    return nil
end

local function track(descendant: Instance)
    if not descendant:IsA("MeshPart") then return end
    local kind = kindFor(descendant)
    if not kind then return end
    local seed = 0
    local identity = descendant:GetFullName()
    for i = 1, #identity do
        seed += string.byte(identity, i) * (i % 17 + 1)
    end
    seed += math.floor(descendant.Position.X * 7 + descendant.Position.Z * 13)
    animated[descendant] = {
        mesh = descendant,
        born = os.clock(),
        base = descendant.CFrame,
        size = descendant.Size,
        kind = kind,
        seed = seed % 137,
    }
end

local function untrack(descendant: Instance)
    if descendant:IsA("MeshPart") then
        animated[descendant] = nil
    end
end

local island = Workspace:WaitForChild("MonsterIsland", 30)
if island then
    for _, descendant in ipairs(island:GetDescendants()) do track(descendant) end
    island.DescendantAdded:Connect(track)
    island.DescendantRemoving:Connect(untrack)
end

-- Limit update to 30 FPS; far decorations don't spend work.
RunService.RenderStepped:Connect(function(dt: number)
    elapsed += dt
    if elapsed < 1 / 30 then return end
    elapsed = 0
    local now = Workspace.DistributedGameTime
    local camera = Workspace.CurrentCamera
    if not camera then return end

    for mesh, entry in pairs(animated) do
        if not mesh.Parent or (entry.kind=="boss" and mesh:HasTag("OrchardRig")) then
            animated[mesh] = nil
            continue
        end
        if (mesh.Position - camera.CFrame.Position).Magnitude > viewDistance then
            continue
        end
        local offsetTime = now + entry.seed * 0.31
        if entry.kind == "pet" then
            -- Each family has its own motion rhythm while remaining attached
            -- to the server-authoritative movement root.
            local parent = mesh.Parent
            local root = if parent and parent:IsA("Model") then parent.PrimaryPart else nil
            if root and root:IsA("BasePart") then
                local species = parent.Name:match("^[^_]+") or ""
                local isBird = species == "Swoop" or species == "Puffin"
                    or species == "Nugget" or species == "Twinkle"
                    or species == "Echo"
                local isCalm = species == "Pebble" or species == "Mallow"
                    or species == "Floofle"
                local rate = if isBird then 5.9 elseif isCalm then 1.85 else 3.35
                local amount = if isBird then 0.18 elseif isCalm then 0.05 else 0.09
                local bob = math.sin(offsetTime * rate) * amount
                local tilt = math.sin(offsetTime * rate * .74) *
                    (if isBird then .058 else if isCalm then .018 else .043)
                local scale=parent:GetScale()
                local offset=(mesh:GetAttribute("VisualOffset") or Vector3.zero)*scale
                mesh.CFrame = root.CFrame * CFrame.new(offset + Vector3.new(0,bob,0))
                    * CFrame.Angles(0, 0, tilt)
                local inhale = 1 + .012 * math.sin(offsetTime * 2.8)
                -- Model:ScaleTo controls giant/mini food reactions.
                if not mesh:HasTag("OrchardRig") then mesh.Size = entry.size * scale * Vector3.new(inhale, 1 / inhale, inhale) end
            end
        elseif entry.kind == "plant" then
            local tilt = math.sin(offsetTime * 1.27) * 0.018
            local growth=math.clamp((os.clock()-entry.born)/.42,0,1)
            local scale=if mesh.Name=="ImportedCropMesh" then 1-.23*(1-growth)^3 else 1
            if growth<1 or mesh.Size~=entry.size then mesh.Size=entry.size*scale end
            local half=entry.size.Y*.5
            mesh.CFrame=entry.base*CFrame.new(0,-half,0)*CFrame.Angles(tilt,0,tilt*.44)*CFrame.new(0,half*scale,0)
        elseif entry.kind == "tree" then
            local tilt = math.sin(offsetTime * 0.78) * 0.007
            mesh.CFrame = entry.base * CFrame.Angles(tilt * 0.62, 0, tilt)
        elseif entry.kind == "bird" then
            local bob = math.sin(offsetTime * 1.8) * 0.10
            local nod = math.sin(offsetTime * 1.5) * 0.06
            mesh.CFrame = entry.base * CFrame.new(0, bob, 0)
                * CFrame.Angles(nod, 0, 0)
        elseif entry.kind == "boss" and mesh.Transparency < 0.9 then
            local inhale = 1 + math.sin(offsetTime * 1.24) * 0.008
            if not mesh:HasTag("OrchardRig") then mesh.Size = entry.size * inhale end
            local model=mesh.Parent
            local rest=mesh:GetAttribute("BossRest")
            local base=if rest and model and model:IsA("Model") then model:GetPivot()*rest else entry.base
            mesh.CFrame = base * CFrame.new(0, math.sin(offsetTime * 1.24) * 0.10, 0)
        end
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="193">
        <Properties>
          <string name="Name">FirstMinuteGuide</string>
          <string name="Source"><![CDATA[--!strict
-- Playable, non-modal first-minute guidance. This listens only to server
-- snapshots, never guesses that an action succeeded from button taps.
-- It disappears for returning players and during the monster chase.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent

local gui = Instance.new("ScreenGui")
gui.Name = "FirstMinuteGuide"
gui.ResetOnSpawn = false
gui.DisplayOrder = 3
gui.IgnoreGuiInset = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Name = "NextObjective"
panel.AnchorPoint = Vector2.new(.5, 1)
panel.Position = UDim2.new(.5, 0, 1, -206)
panel.Size = UDim2.new(.90, 0, 0, 64)
panel.BackgroundColor3 = Color3.fromRGB(255, 250, 229)
panel.BackgroundTransparency = .05
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = gui
local maxSize = Instance.new("UISizeConstraint")
maxSize.MaxSize = Vector2.new(480, 64)
maxSize.Parent = panel
local rounded = Instance.new("UICorner")
rounded.CornerRadius = UDim.new(0, 16)
rounded.Parent = panel
local outline = Instance.new("UIStroke")
outline.Color = Color3.fromRGB(163, 194, 125)
outline.Thickness = 2
outline.Transparency = .16
outline.Parent = panel

local heading = Instance.new("TextLabel")
heading.Name = "Objective"
heading.BackgroundTransparency = 1
heading.Position = UDim2.new(0, 12, 0, 6)
heading.Size = UDim2.new(1, -24, 0, 26)
heading.TextXAlignment = Enum.TextXAlignment.Left
heading.TextSize = 16
heading.TextColor3 = Color3.fromRGB(66, 84, 59)
heading.Font = Enum.Font.GothamBold
heading.Text = ""
heading.Parent = panel
local minMax = Instance.new("UITextSizeConstraint")
minMax.MaxTextSize = 16
minMax.MinTextSize = 11
minMax.Parent = heading

local hint = Instance.new("TextLabel")
hint.Name = "HelpfulTip"
hint.BackgroundTransparency = 1
hint.Position = UDim2.new(0, 12, 0, 34)
hint.Size = UDim2.new(1, -24, 0, 23)
hint.TextXAlignment = Enum.TextXAlignment.Left
hint.TextWrapped = true
hint.TextSize = 12
hint.Font = Enum.Font.GothamMedium
hint.TextColor3 = Color3.fromRGB(111, 101, 76)
hint.Text = ""
hint.Parent = panel

local collectionKnown = false
local gardenKnown = false
local lastReaction = ""
local lastNoise = 0
local visitSurvivals: number? = nil
local feedCount = 0
local survivalCount = 0
local experimentCount = 0
local planted = false
local harvested = false
local phase = "SLEEP"
local warning = false
local stage = ""
local finished = false

local function refresh()
    if not collectionKnown or not gardenKnown or phase == "AWAKE" or warning then
        panel.Visible = false
        return
    end
    -- Established players should not see a repetitive tutorial after every
    -- respawn or join; this is an introductory experience, not a daily quest.
    if (visitSurvivals or 0)>0 or experimentCount > 0 or finished then
        panel.Visible = false
        return
    end
    local nextStage, titleText, message
    if phase=="COOLDOWN" and survivalCount==0 then
        nextStage,titleText="recover","Giggles is heading back to bed"
        message="In the next round, stay outside the marked rings and hold SAVE ME beside a lost pet."
    elseif feedCount == 0 then
        nextStage, titleText = "feed", "Meet your pet. Giggles is sleeping nearby."
        message = "Tap a snack below and watch your companion."
    elseif survivalCount==0 then
        nextStage = "noise"..lastReaction..tostring(lastNoise)
        titleText = if lastReaction~="" then lastReaction.."   +"..lastNoise.." noise" else "Every snack can stir Giggles"
        message = "Try SOOTHE to quiet your pet, or feed again. When Giggles wakes, look for SAVE ME."
    elseif not planted and not harvested then
        nextStage, titleText = "plant", "🌱  You survived! Plant your first seed"
        message = "Walk to your garden and tap PLANT on an empty bed."
    elseif not harvested then
        nextStage, titleText = "harvest", "🍓  Watch your crop grow"
        message = "Return to a ripe plant and tap HARVEST for ingredients."
    else
        finished = true
        panel.Visible = false
        return
    end
    if stage ~= nextStage then
        stage = nextStage
        heading.Text = titleText
        hint.Text = message
        panel.BackgroundTransparency = 1
        panel.Visible = true
        TweenService:Create(panel, TweenInfo.new(.35, Enum.EasingStyle.Quad),
            {BackgroundTransparency = .05}):Play()
    else
        panel.Visible = true
    end
end

remote.OnClientEvent:Connect(function(event: any)
    if type(event) ~= "table" or type(event.type) ~= "string" then return end
    if event.type == "collection" then
        collectionKnown = true
        feedCount = math.max(0, tonumber(event.feedCount) or 0)
        survivalCount = math.max(0, tonumber(event.survivalCount) or 0)
        if visitSurvivals==nil then visitSurvivals=survivalCount end
    elseif event.type=="feedNoise" then
        lastNoise=event.amount
        lastReaction=event.reaction
    elseif event.type == "garden" then
        gardenKnown = true
        experimentCount = math.max(0, tonumber(event.experiments) or 0)
        if type(event.plots) == "table" then
            for _, plot in ipairs(event.plots) do
                if type(plot) == "table" and type(plot.seed) == "string" then
                    planted = true
                    break
                end
            end
        end
        if type(event.crops) == "table" then
            for _, amount in pairs(event.crops) do
                if type(amount) == "number" and amount > 0 then
                    harvested = true
                    break
                end
            end
        end
    elseif event.type == "state" then
        warning = event.warning ~= nil
        phase = if type(event.phase) == "string" then event.phase else phase
    else
        return
    end
    refresh()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="194">
        <Properties>
          <string name="Name">Garden</string>
          <string name="Source"><![CDATA[--!strict
-- 30 crops and a SECRET recipe book: players experiment and discover recipes themselves.
-- Robux-only products are visibly disabled until product IDs and server receipts exist.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local G = require(ReplicatedStorage:WaitForChild("GardenConfig"))
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent
local INK = Color3.fromRGB(55, 57, 74)
local GREEN = Color3.fromRGB(93, 177, 119)
local LILAC = Color3.fromRGB(161, 129, 211)
local CREAM = Color3.fromRGB(254, 252, 241)
local MINT = Color3.fromRGB(228, 250, 222)
local MUTED = Color3.fromRGB(109, 110, 126)
local state: any = nil
local latestAt = 0
local coins = 0
local tab = "Plots"
local seedIndex = 1
local fertilizerKey = "Compost"
local mixSlots = {"", "", ""}
local pickerSlot = 0
local selectedCropCount = 0
local plotTimers: {[number]: TextLabel} = {}
local lastMerchantRefresh = -1

local function round(obj: Instance, radius: number)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = obj
end
local function outline(obj: Instance, color: Color3)
    local border = Instance.new("UIStroke")
    border.Color = color
    border.Thickness = 1.5
    border.Transparency = 0.25
    border.Parent = obj
end
local function text(parent: Instance, caption: string, size: number, color: Color3, bold: boolean?): TextLabel
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Text = caption
    label.TextColor3 = color
    label.TextSize = size
    label.Font = if bold then Enum.Font.GothamBlack else Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    label.Parent = parent
    return label
end
local function button(parent: Instance, caption: string, color: Color3): TextButton
    local b = Instance.new("TextButton")
    b.Text = caption
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.TextColor3 = INK
    b.BackgroundColor3 = color
    b.BorderSizePixel = 0
    b.Parent = parent
    round(b, 11)
    local lim = Instance.new("UITextSizeConstraint")
    lim.MinTextSize = 9
    lim.MaxTextSize = 15
    lim.Parent = b
    return b
end
local function copyMap(t: any, key: string): number
    if typeof(t) ~= "table" then return 0 end
    local value = t[key]
    return if type(value) == "number" then value else 0
end
local function ownsSeed(key: string): number
    if not state then return 0 end
    return copyMap(state.seeds, key)
end
local function cropInventory(key: string): number
    if not state then return 0 end
    return copyMap(state.crops, key)
end
local function productInventory(key: string, fertilizer: boolean): number
    if not state then return 0 end
    return copyMap(if fertilizer then state.fertilizer else state.crafted, key)
end
local function secondsLeft(plot: any): number
    if typeof(plot) ~= "table" or not state then return 0 end
    local now = (state.serverTime or os.time()) + (os.clock() - latestAt)
    return math.max(0, math.ceil(plot.readyAt - now))
end

local gui = Instance.new("ScreenGui")
gui.Name = "GardenGui"
gui.DisplayOrder = 9
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")
local open = button(gui, "🌿 MY GARDEN (G)", MINT)
open.Name = "GardenOpen"
open.Position = UDim2.new(1, -164, 0, 191)
open.Size = UDim2.fromOffset(152, 42)
outline(open, GREEN)

local overlay = Instance.new("Frame")
overlay.Name = "GardenOverlay"
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundColor3 = Color3.fromRGB(29, 36, 42)
overlay.BackgroundTransparency = 0.3
overlay.Active = true
overlay.Visible = false
overlay.Parent = gui

local panel = Instance.new("Frame")
panel.Name = "GardenPanel"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.new(0.95, 0, 0.88, 0)
panel.BackgroundColor3 = CREAM
panel.BorderSizePixel = 0
panel.Parent = overlay
round(panel, 22)
outline(panel, GREEN)
local constrain = Instance.new("UISizeConstraint")
constrain.MaxSize = Vector2.new(650, 750)
constrain.MinSize = Vector2.new(260, 310)
constrain.Parent = panel

local title = text(panel, "🌼 MY CHAOS GARDEN", 21, GREEN, true)
title.Position = UDim2.new(0, 17, 0, 11)
title.Size = UDim2.new(1, -80, 0, 34)
title.TextScaled = true
local titleLimit = Instance.new("UITextSizeConstraint")
titleLimit.MaxTextSize = 21
titleLimit.MinTextSize = 12
titleLimit.Parent = title
local close = button(panel, "✕", Color3.fromRGB(255, 188, 189))
close.Position = UDim2.new(1, -52, 0, 11)
close.Size = UDim2.fromOffset(39, 38)

local status = text(panel, "Loading the greenhouse...", 12, MUTED, false)
status.Position = UDim2.new(0, 17, 0, 49)
status.Size = UDim2.new(1, -30, 0, 22)

local tabRow = Instance.new("Frame")
tabRow.BackgroundTransparency = 1
tabRow.Position = UDim2.new(0, 12, 0, 78)
tabRow.Size = UDim2.new(1, -24, 0, 41)
tabRow.Parent = panel
local tabs = {}
for i, info in ipairs({
    {key = "Plots", label = "🌱 PLOTS"},
    {key = "Seeds", label = "🛒 SEEDS"},
    {key = "Craft", label = "📖 ALCHEMY"},
}) do
    local b = button(tabRow, info.label, MINT)
    b.Position = UDim2.new((i - 1) / 3, 3, 0, 0)
    b.Size = UDim2.new(1 / 3, -7, 1, 0)
    tabs[info.key] = b
    b.MouseButton1Click:Connect(function()
        tab = info.key
        -- render() declared below, called through local callback set below
        if tabs._render then tabs._render() end
    end)
end

local content = Instance.new("ScrollingFrame")
content.Name = "GardenContent"
content.Position = UDim2.new(0, 12, 0, 130)
content.Size = UDim2.new(1, -24, 1, -145)
content.BackgroundTransparency = 1
content.BorderSizePixel = 0
content.ScrollBarThickness = 5
content.ScrollBarImageColor3 = GREEN
content.CanvasSize = UDim2.fromScale(0, 0)
content.AutomaticCanvasSize = Enum.AutomaticSize.Y
content.Parent = panel
local lay = Instance.new("UIListLayout")
lay.SortOrder = Enum.SortOrder.LayoutOrder
lay.Padding = UDim.new(0, 8)
lay.Parent = content
local pad = Instance.new("UIPadding")
pad.PaddingTop = UDim.new(0, 3)
pad.PaddingBottom = UDim.new(0, 10)
pad.PaddingLeft = UDim.new(0, 3)
pad.PaddingRight = UDim.new(0, 6)
pad.Parent = content

local function row(height: number, color: Color3?): Frame
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -6, 0, height)
    frame.BackgroundColor3 = color or MINT
    frame.BorderSizePixel = 0
    frame.Parent = content
    round(frame, 13)
    return frame
end

local function clearRows()
    table.clear(plotTimers)
    for _, item in ipairs(content:GetChildren()) do
        if item:IsA("Frame") then item:Destroy() end
    end
end

local function topHint(message: string)
    local box = row(62, Color3.fromRGB(239, 235, 253))
    local label = text(box, message, 13, INK, true)
    label.Position = UDim2.new(0, 12, 0, 6)
    label.Size = UDim2.new(1, -24, 1, -12)
    return box
end

local function drawPlots()
    local seed = G.Order[seedIndex]
    local header = row(104, Color3.fromRGB(230, 246, 221))
    local hint = text(header, "SELECT SEED FOR EMPTY PLOTS", 12, MUTED, true)
    hint.Position = UDim2.new(0, 11, 0, 3)
    hint.Size = UDim2.new(1, -24, 0, 23)
    local chosen = G.Crops[seed]
    local selector = button(header, "◀  " .. chosen.icon .. " " .. chosen.name .. "  ×" .. ownsSeed(seed) .. "  ▶", Color3.fromRGB(255, 235, 155))
    selector.Position = UDim2.new(0, 9, 0, 27)
    selector.Size = UDim2.new(1, -18, 0, 32)
    selector.MouseButton1Click:Connect(function()
        repeat
            seedIndex = (seedIndex % #G.Order) + 1
        until G.Crops[G.Order[seedIndex]].kind ~= "premium" or ownsSeed(G.Order[seedIndex]) > 0
        tabs._render()
    end)
    local visit = button(header, "📍 VISIT MY PHYSICAL GARDEN", Color3.fromRGB(184, 226, 247))
    visit.Position = UDim2.new(0, 9, 0, 65)
    visit.Size = UDim2.new(1, -18, 0, 32)
    visit.MouseButton1Click:Connect(function()
        remote:FireServer("GardenVisit")
        overlay.Visible = false
        open.Visible = true
    end)

    local decor=row(92,CREAM)
    local nextStyle=((table.find(G.GardenStyles,state.style) or 1)%#G.GardenStyles)+1
    local style=button(decor,(state.style or "Meadow").." → "..G.GardenStyles[nextStyle],MINT)
    style.Size=UDim2.new(.5,-12,0,48)
    style.Position=UDim2.fromOffset(8,30)
    style.Activated:Connect(function() remote:FireServer("GardenStyle",G.GardenStyles[nextStyle]) end)
    local welcome=player:GetAttribute("GardenOpen")==true
    local invite=button(decor,if welcome then "Close guest list" else "Welcome visitors",LILAC)
    invite.Size=UDim2.new(.5,-12,0,48)
    invite.Position=UDim2.new(.5,4,0,30)
    invite.Activated:Connect(function() remote:FireServer("GardenWelcome",not welcome) end)
    local decorTitle=text(decor,"ENTRANCE STYLE & VISITORS",12,MUTED,true)
    decorTitle.Position=UDim2.fromOffset(8,2)
    decorTitle.Size=UDim2.new(1,-16,0,24)
    for _,host in Players:GetPlayers() do
        if host~=player and host:GetAttribute("GardenOpen")==true then
            local entry=row(46,CREAM)
            local guest=button(entry,"Visit "..host.DisplayName.."'s garden",MINT)
            guest.Position=UDim2.fromOffset(6,4)
            guest.Size=UDim2.new(1,-12,0,38)
            guest.Activated:Connect(function() remote:FireServer("GardenVisit",host.UserId) end)
        end
    end

    local fertilizer = row(69, Color3.fromRGB(241, 235, 251))
    local available = productInventory(fertilizerKey, true)
    local selectorFert = button(fertilizer, "FERTILIZER: " .. fertilizerKey .. "  ×" .. available .. "  ↻", Color3.fromRGB(213, 191, 249))
    selectorFert.Position = UDim2.new(0, 8, 0, 9)
    selectorFert.Size = UDim2.new(1, -16, 0, 48)
    selectorFert.MouseButton1Click:Connect(function()
        local keys = {"Compost", "Starlight", "HoneyCompost", "FrostFertilizer", "AuroraDust"}
        for i, key in ipairs(keys) do
            if key == fertilizerKey then
                fertilizerKey = keys[i % #keys + 1]
                break
            end
        end
        tabs._render()
    end)

    for i = 1, G.PLOT_COUNT do
        local p = if state then state.plots[i] else false
        local card = row(if p then 114 else 80, if p then Color3.fromRGB(237, 250, 230) else Color3.fromRGB(242, 238, 230))
        local crop = if typeof(p) == "table" then G.Crops[p.seed] else nil
        local plotText = text(card, "PLOT " .. i .. "   " .. (if crop then crop.icon .. " " .. (if p.mutation then "✨ " .. p.mutation .. " " else "") .. crop.name else "Empty"), 14, INK, true)
        plotText.Position = UDim2.new(0, 11, 0, 5)
        plotText.Size = UDim2.new(0.56, 0, 0, 27)
        local countdown = text(card, if crop then "Growing..." else "Ready for planting", 12, MUTED, false)
        countdown.Position = UDim2.new(0, 11, 0, 34)
        countdown.Size = UDim2.new(0.56, 0, 0, 36)
        plotTimers[i] = countdown
        local action = button(card, if crop then "HARVEST" else "PLANT", if crop then Color3.fromRGB(255, 218, 145) else Color3.fromRGB(171, 236, 181))
        action.Position = UDim2.new(0.58, 0, 0, 7)
        action.Size = UDim2.new(0.4, -9, 0, 32)
        action.MouseButton1Click:Connect(function()
            if crop then
                remote:FireServer("GardenHarvest", i)
            else
                remote:FireServer("GardenPlant", {plot = i, seed = G.Order[seedIndex]})
            end
        end)
        if crop then
            local fert = button(card, if p.fertilized then "FERTILIZED ✓" else "USE FERTILIZER", Color3.fromRGB(200, 235, 245))
            fert.Position = UDim2.new(0.58, 0, 0, 43)
            fert.Size = UDim2.new(0.4, -9, 0, 29)
            fert.Active = not p.fertilized
            fert.AutoButtonColor = not p.fertilized
            fert.MouseButton1Click:Connect(function()
                if not p.fertilized then
                    remote:FireServer("GardenFertilize", {plot = i, fertilizer = fertilizerKey})
                end
            end)
            local assist = button(card, if p.assistUsed then "🐾 PET ALREADY HELPED" else "🐾 ASK PET TO HELP GROW", Color3.fromRGB(205, 241, 205))
            assist.Position = UDim2.new(0.03, 0, 0, 83)
            assist.Size = UDim2.new(0.94, 0, 0, 25)
            assist.Active = not p.assistUsed
            assist.AutoButtonColor = not p.assistUsed
            assist.MouseButton1Click:Connect(function()
                if not p.assistUsed then remote:FireServer("GardenAssist", i) end
            end)
        end
    end
end

local function drawSeeds()
    topHint("🌱 FIND rare seeds in 3 forests • merchant restocks every 12 min • all for free coins.")
    if state and typeof(state.merchantShop) == "table" then
        local shop = state.merchantShop
        local now = (state.serverTime or os.time()) + (os.clock() - latestAt)
        local mins = math.max(0, math.ceil(((shop.nextRestock or 0) - now) / 60))
        local header = row(56, Color3.fromRGB(255, 234, 188))
        local title = text(header, "🛒 TRAVELING SEED MERCHANT", 16, INK, true)
        title.Position = UDim2.fromOffset(10, 4)
        title.Size = UDim2.new(1, -20, 0, 25)
        local subtitle = text(header, "4 rotating discounts • restock in ~" .. mins .. " min • 1 pack each", 11, MUTED)
        subtitle.Position = UDim2.fromOffset(10, 29)
        subtitle.Size = UDim2.new(1, -20, 0, 23)
        for _, offer in ipairs(shop.offers or {}) do
            local claimed = shop.claimed and shop.claimed[offer.slot] == true
            local entry = row(66, Color3.fromRGB(255, 247, 217))
            local name = text(entry, offer.icon .. " " .. offer.name, 14, INK, true)
            name.Position = UDim2.fromOffset(9, 6)
            name.Size = UDim2.new(0.56, 0, 0, 26)
            local info = text(entry, "+" .. offer.count .. " seeds • " .. offer.price .. " coins", 11, MUTED)
            info.Position = UDim2.fromOffset(9, 32)
            info.Size = UDim2.new(0.55, 0, 0, 24)
            local buy = button(entry, if claimed then "SOLD OUT" else "BUY 🪙", if claimed then Color3.fromRGB(225, 218, 211) else Color3.fromRGB(255, 209, 144))
            buy.Position = UDim2.new(0.6, 0, 0.5, -18)
            buy.Size = UDim2.new(0.38, -8, 0, 36)
            buy.Active = not claimed
            buy.AutoButtonColor = not claimed
            buy.MouseButton1Click:Connect(function()
                if not claimed then remote:FireServer("GardenMerchantBuy", offer.slot) end
            end)
        end
    end
    for _, seed in ipairs(G.Order) do
        local crop = G.Crops[seed]
        local premium = crop.kind == "premium"
        local frame = row(74, if premium then Color3.fromRGB(243, 230, 252) else MINT)
        local titleRow = text(frame, crop.icon .. " " .. crop.name, 15, INK, true)
        titleRow.Position = UDim2.new(0, 10, 0, 6)
        titleRow.Size = UDim2.new(0.58, 0, 0, 26)
        local detail = text(frame, (if premium then "✨ Premium design • no payment" else "+" .. G.SEED_PACK_SIZE .. " seeds / " .. crop.coins .. " coins") .. " • bag: " .. ownsSeed(seed), 11, MUTED, false)
        detail.Position = UDim2.new(0, 10, 0, 34)
        detail.Size = UDim2.new(0.57, 0, 0, 32)
        local buy = button(frame, if premium then "COMING SOON" else "BUY " .. crop.coins .. " 🪙", if premium then Color3.fromRGB(219, 209, 228) else Color3.fromRGB(255, 219, 139))
        buy.Position = UDim2.new(0.6, 0, 0.5, -18)
        buy.Size = UDim2.new(0.38, -8, 0, 36)
        buy.Active = not premium
        buy.AutoButtonColor = not premium
        buy.MouseButton1Click:Connect(function()
            if not premium then remote:FireServer("GardenBuySeed", seed) end
        end)
    end
    local premiumFert = row(74, Color3.fromRGB(243, 230, 252))
    local fertTitle = text(premiumFert, "✨ Aurora Dust Fertilizer", 15, INK, true)
    fertTitle.Position = UDim2.new(0, 10, 0, 5)
    fertTitle.Size = UDim2.new(0.58, 0, 0, 28)
    local fertDetail = text(premiumFert, "80% faster remaining growth • stock: " .. productInventory("AuroraDust", true), 11, MUTED, false)
    fertDetail.Position = UDim2.new(0, 10, 0, 32)
    fertDetail.Size = UDim2.new(0.58, 0, 0, 33)
    local comingSoon = button(premiumFert, "COMING SOON", Color3.fromRGB(219, 209, 228))
    comingSoon.Position = UDim2.new(0.6, 0, 0.5, -18)
    comingSoon.Size = UDim2.new(0.38, -8, 0, 36)
    comingSoon.Active = false
    comingSoon.AutoButtonColor = false
end

local function drawIngredientPicker()
    local slot = pickerSlot
    topHint("🧺 SELECT INGREDIENT FOR SLOT " .. slot .. ". Only crops YOU harvested appear here.")
    local clear = row(54, Color3.fromRGB(242, 233, 253))
    local remove = button(clear, "✕ REMOVE INGREDIENT / BACK", Color3.fromRGB(238, 210, 237))
    remove.Position = UDim2.new(0, 8, 0, 7)
    remove.Size = UDim2.new(1, -16, 0, 40)
    remove.MouseButton1Click:Connect(function()
        mixSlots[slot] = ""
        pickerSlot = 0
        tabs._render()
    end)
    local choices = 0
    for _, key in ipairs(G.Order) do
        local available = cropInventory(key)
        if available > 0 then
            choices += 1
            local crop = G.Crops[key]
            local card = row(56, MINT)
            local choose = button(card, crop.icon .. " " .. crop.name .. "   ×" .. available, Color3.fromRGB(200, 240, 201))
            choose.Position = UDim2.new(0, 8, 0, 7)
            choose.Size = UDim2.new(1, -16, 0, 42)
            choose.MouseButton1Click:Connect(function()
                mixSlots[slot] = key
                pickerSlot = 0
                tabs._render()
            end)
        end
    end
    if choices == 0 then topHint("Your basket is empty. Plant seeds and harvest crops first!") end
end

local function ingredientCard(index: number)
    local key = mixSlots[index]
    local crop = G.Crops[key]
    local card = row(52, Color3.fromRGB(238, 244, 226))
    local cap = if crop then crop.icon .. " " .. crop.name else "＋ Choose ingredient"
    local selectIngredient = button(card, "SLOT " .. index .. ": " .. cap, Color3.fromRGB(220, 241, 210))
    selectIngredient.Position = UDim2.new(0, 8, 0, 6)
    selectIngredient.Size = UDim2.new(1, -16, 0, 39)
    selectIngredient.MouseButton1Click:Connect(function()
        pickerSlot = index
        tabs._render()
    end)
end

local function drawCraft()
    if pickerSlot > 0 then
        drawIngredientPicker()
        return
    end
    topHint("🧪 EXPERIMENT! Mix TWO or THREE harvested ingredients. No recipes are given at the start. Every discovery is written in YOUR book.")
    local counter = row(63, Color3.fromRGB(246, 236, 218))
    local ownedCrops = 0
    local varieties = 0
    for _, key in ipairs(G.Order) do
        local amount = cropInventory(key)
        if amount > 0 then
            varieties += 1
            ownedCrops += amount
        end
    end
    local inventoryLabel = text(counter, "🌿 HARVESTED: " .. ownedCrops .. " pieces • " .. varieties .. " crop types. Each mix uses the ingredients you choose.", 13, INK, true)
    inventoryLabel.Position = UDim2.new(0, 10, 0, 5)
    inventoryLabel.Size = UDim2.new(1, -20, 1, -10)

    for i = 1, 3 do
        ingredientCard(i)
    end
    local mixture = row(61, Color3.fromRGB(253, 232, 194))
    local mixButton = button(mixture, "⚗️ MIX INGREDIENTS — DISCOVER!", Color3.fromRGB(255, 203, 124))
    mixButton.Position = UDim2.new(0, 9, 0, 8)
    mixButton.Size = UDim2.new(1, -18, 0, 44)
    mixButton.MouseButton1Click:Connect(function()
        local ingredients = {}
        for _, ingredient in ipairs(mixSlots) do
            if ingredient ~= "" then table.insert(ingredients, ingredient) end
        end
        if #ingredients >= 2 and #ingredients <= 3 then
            remote:FireServer("GardenExperiment", ingredients)
        else
            -- No event is sent for incomplete experiments.
            mixButton.Text = "CHOOSE 2 OR 3 INGREDIENTS!"
        end
    end)

    local book = if state and typeof(state.book) == "table" then state.book else {}
    local chapter = row(61, Color3.fromRGB(235, 227, 253))
    local chapterTitle = text(chapter, "📖 YOUR RECIPE BOOK: " .. #book .. " / " .. (if state then state.totalRecipes or "?" else "?") .. " DISCOVERED", 15, INK, true)
    chapterTitle.Position = UDim2.new(0, 11, 0, 5)
    chapterTitle.Size = UDim2.new(1, -20, 0, 25)
    local chapterTip = text(chapter, "Successful experiments become permanent pages.", 11, MUTED)
    chapterTip.Position = UDim2.new(0, 11, 0, 29)
    chapterTip.Size = UDim2.new(1, -20, 0, 27)
    if #book == 0 then
        topHint("📕 All pages are blank. Try mixing berries, vegetables, flowers or magic herbs!")
    end

    for _, recipe in ipairs(book) do
        local card = row(112, MINT)
        local heading = text(card, recipe.icon .. " " .. recipe.name .. "  ×" .. recipe.produces, 15, INK, true)
        heading.Position = UDim2.new(0, 10, 0, 4)
        heading.Size = UDim2.new(1, -18, 0, 27)
        local ingredients = {}
        local canCraft = true
        for _, key in ipairs(G.Order) do
            local need = recipe.ingredients[key]
            if need then
                local have = cropInventory(key)
                table.insert(ingredients, need .. "× " .. G.Crops[key].icon .. " " .. G.Crops[key].name)
                if have < need then canCraft = false end
            end
        end
        local detail = text(card, table.concat(ingredients, " + "), 11, MUTED)
        detail.Position = UDim2.new(0, 10, 0, 35)
        detail.Size = UDim2.new(1, -20, 0, 27)
        local make = button(card, "MAKE AGAIN", if canCraft then Color3.fromRGB(255, 225, 153) else Color3.fromRGB(228, 226, 227))
        make.Position = UDim2.new(0, 9, 0, 67)
        make.Size = UDim2.new(0.48, -10, 0, 36)
        make.MouseButton1Click:Connect(function()
            remote:FireServer("GardenCraft", recipe.id)
        end)
        local amount = productInventory(recipe.id, recipe.type == "fertilizer")
        local consume = button(card, (if recipe.type == "fertilizer" then "STOCK" else "USE") .. " ×" .. amount, Color3.fromRGB(185, 237, 211))
        consume.Position = UDim2.new(0.5, 0, 0, 67)
        consume.Size = UDim2.new(0.49, -10, 0, 36)
        consume.Active = amount > 0 and recipe.type ~= "fertilizer"
        consume.AutoButtonColor = consume.Active
        consume.MouseButton1Click:Connect(function()
            if amount < 1 then return end
            if recipe.type == "feed" then
                remote:FireServer("GardenFeed", recipe.id)
            elseif recipe.type == "lure" then
                remote:FireServer("GardenLure", recipe.id)
            end
        end)
    end

    -- Existing products and chaotic mistakes remain usable even if the
    -- corresponding recipe has not yet been discovered in the new book.
    local products = if state and typeof(state.products) == "table" then state.products else {}
    local knownMap = {}
    for _, recipe in ipairs(book) do knownMap[recipe.id] = true end
    for _, recipe in ipairs(products) do
        if not knownMap[recipe.id] then
            local card = row(57, Color3.fromRGB(251, 224, 220))
            local use = button(card, recipe.icon .. " " .. recipe.name .. " ×" .. recipe.amount .. " — USE", Color3.fromRGB(253, 215, 190))
            use.Position = UDim2.new(0, 8, 0, 8)
            use.Size = UDim2.new(1, -16, 0, 40)
            use.MouseButton1Click:Connect(function()
                if recipe.type == "feed" then remote:FireServer("GardenFeed", recipe.id)
                elseif recipe.type == "lure" then remote:FireServer("GardenLure", recipe.id) end
            end)
        end
    end
end

local function render()
    if not state then
        status.Text = "Garden loading...   🪙 " .. coins
    else
        status.Text = "🪙 " .. coins .. " • " .. (if state.saving then "SAVED" else "OFFLINE") .. " • " .. (state.weather or "SUNNY") .. " • " .. (state.forageTotal or 0) .. " SEED FINDS"
    end
    for key, b in pairs(tabs) do
        if typeof(b) == "Instance" and b:IsA("TextButton") then
            b.BackgroundColor3 = if key == tab then Color3.fromRGB(152, 228, 169) else Color3.fromRGB(229, 228, 223)
        end
    end
    if not overlay.Visible then return end
    clearRows()
    if tab == "Plots" then drawPlots()
    elseif tab == "Seeds" then drawSeeds()
    else drawCraft() end
end
tabs._render = render

local function setOpen(isOpen: boolean)
    overlay.Visible = isOpen
    open.Visible = not isOpen
    render()
end
open.MouseButton1Click:Connect(function() setOpen(true) end)
close.MouseButton1Click:Connect(function() setOpen(false) end)
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.G then
        setOpen(not overlay.Visible)
    elseif input.KeyCode == Enum.KeyCode.Escape and overlay.Visible then
        setOpen(false)
    end
end)
remote.OnClientEvent:Connect(function(event: any)
    if typeof(event) ~= "table" then return end
    if event.type == "garden" then
        state = event
        latestAt = os.clock()
        render()
    elseif event.type == "stats" then
        coins = event.coins or coins
        render()
    end
end)

task.spawn(function()
    while true do
        task.wait(1)
        if overlay.Visible and tab == "Seeds" and state and state.merchantShop then
            local now = (state.serverTime or os.time()) + (os.clock() - latestAt)
            local rotation = state.merchantShop.rotation
            if now >= (state.merchantShop.nextRestock or math.huge) and lastMerchantRefresh ~= rotation then
                lastMerchantRefresh = rotation
                remote:FireServer("Sync")
            end
        end
        if overlay.Visible and tab == "Plots" and state then
            for index, label in pairs(plotTimers) do
                local p = state.plots[index]
                if typeof(p) == "table" then
                    local sec = secondsLeft(p)
                    label.Text = if sec <= 0 then "✨ READY TO HARVEST!" else "Growing " .. math.floor(sec / 60) .. "m " .. (sec % 60) .. "s left"
                else
                    label.Text = "Tap PLANT to sow a seed"
                end
            end
        end
    end
end)
task.delay(1.9, function() remote:FireServer("Sync") end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="195">
        <Properties>
          <string name="Name">GardenerMotion</string>
          <string name="Source"><![CDATA[--!strict
-- Layer tool-free interactions over the Animator's current R15 pose. Remove
-- our previous offset before it evaluates the next idle/walk/run track.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local offsets: {[Motor6D]: CFrame} = {}
local actors: {[Model]: any} = {}

local function watch(player: Player)
    local function attach(character: Model)
        actors[character]={joints={},blend=0,carry=0,pet=0,nextScan=0}
    end
    player.CharacterAdded:Connect(attach)
    player.CharacterRemoving:Connect(function(character) actors[character]=nil end)
    if player.Character then attach(player.Character) end
end
Players.PlayerAdded:Connect(watch)
for _,player in ipairs(Players:GetPlayers()) do watch(player) end

RunService.PreAnimation:Connect(function()
    for motor,offset in pairs(offsets) do
        if motor.Parent then motor.Transform=motor.Transform*offset:Inverse() end
    end
    table.clear(offsets)
end)

RunService.PreSimulation:Connect(function(dt)
    local now=workspace:GetServerTimeNow()
    local camera=workspace.CurrentCamera
    if not camera then return end
    for character,actor in pairs(actors) do
        local root=character:FindFirstChild("HumanoidRootPart")
        if not root or not root:IsA("BasePart") or (root.Position-camera.CFrame.Position).Magnitude>100 then continue end
        local mode=character:GetAttribute("GardenCare")
        local t=now-(character:GetAttribute("GestureAt") or -10)
        local reach=if t>=0 and t<1.1 then math.sin(math.pi*t/1.1)^2 else 0
        local blend=1-math.exp(-dt*10)
        actor.carry+=((if mode=="Carry" then 1 else 0)-actor.carry)*blend
        actor.pet+=((if mode=="Pet" then 1 else 0)-actor.pet)*blend
        if reach+actor.carry+actor.pet<.001 then continue end
        if now>=actor.nextScan then
            table.clear(actor.joints)
            for _,j in ipairs(character:GetDescendants()) do
                if j:IsA("Motor6D") and j.Part1 then actor.joints[j.Name]=j end
            end
            actor.nextScan=now+2
        end
        local harvest=character:GetAttribute("GardenGesture")=="GardenHarvest"
        local stroke=(.76+.24*math.sin(now*5))*actor.pet
        local function pose(name: string,x: number,y: number,z: number)
            local j=actor.joints[name]
            if j and j.Parent then
                local delta=CFrame.Angles(x,y,z)
                j.Transform*=delta
                offsets[j]=delta
            end
        end
        pose("Waist",-.32*reach-.15*stroke,0,0)
        pose("Neck",-.15*reach+.08*actor.carry,0,.06*actor.pet)
        pose("RightShoulder",.92*reach+.76*actor.carry+.88*stroke,-.12*reach,.21*actor.carry)
        pose("LeftShoulder",(if harvest then .67 else .20)*reach+.76*actor.carry,0,-.21*actor.carry)
        pose("RightElbow",.67*actor.carry+.32*stroke+.32*reach,0,0)
        pose("LeftElbow",.67*actor.carry+.26*reach,0,0)
        pose("RightHip",.23*reach,0,0)
        pose("RightKnee",-.32*reach,0,0)
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="196">
        <Properties>
          <string name="Name">HUD</string>
          <string name="Source"><![CDATA[--!strict
-- Responsive, self-contained Roblox GUI. Playable with touch or keyboard 1–4.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local RescueRoute = require(ReplicatedStorage:WaitForChild("RescueRoute"))
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent
local gui = Instance.new("ScreenGui")
gui.Name = "MonsterHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local DARK = Color3.fromRGB(53, 46, 88)
local LAVENDER = Color3.fromRGB(108, 80, 171)
local CREAM = Color3.fromRGB(255, 252, 244)
local function round(parent: Instance, radius: number)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = parent
end

local function stroke(parent: Instance, color: Color3, thickness: number)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness
    s.Transparency = 0.16
    s.Parent = parent
end

local function label(parent: Instance, text: string, font: Enum.Font, size: number, color: Color3): TextLabel
    local t = Instance.new("TextLabel")
    t.Name = "Text"
    t.BackgroundTransparency = 1
    t.Font = font
    t.Text = text
    t.TextSize = size
    t.TextColor3 = color
    t.TextWrapped = true
    t.TextXAlignment = Enum.TextXAlignment.Center
    t.TextYAlignment = Enum.TextYAlignment.Center
    t.Parent = parent
    return t
end

local header = Instance.new("Frame")
header.Name = "StatusCard"
header.AnchorPoint = Vector2.new(0.5, 0)
header.Position = UDim2.new(0.5, 0, 0, 10)
header.Size = UDim2.new(0.94, 0, 0, 112)
header.BackgroundColor3 = CREAM
header.BorderSizePixel = 0
header.Parent = gui
round(header, 20)
stroke(header, Color3.fromRGB(238, 211, 255), 2)
local headerLimit = Instance.new("UISizeConstraint")
headerLimit.MaxSize = Vector2.new(650, 112)
headerLimit.Parent = header

local title = label(header, "😴 DON'T WAKE THE MONSTER!", Enum.Font.GothamBlack, 21, DARK)
title.Position = UDim2.new(0.03, 0, 0, 4)
title.Size = UDim2.new(0.94, 0, 0, 27)
local titleLimit = Instance.new("UITextSizeConstraint")
titleLimit.MinTextSize = 12
titleLimit.MaxTextSize = 22
titleLimit.Parent = title
title.TextScaled = true

local phaseText = label(header, "SHHH... GIGGLES IS SLEEPING", Enum.Font.GothamBold, 13, LAVENDER)
phaseText.Position = UDim2.new(0.04, 0, 0, 31)
phaseText.Size = UDim2.new(0.76, 0, 0, 20)
phaseText.TextXAlignment = Enum.TextXAlignment.Left
phaseText.TextScaled = true
local phaseLimit = Instance.new("UITextSizeConstraint")
phaseLimit.MinTextSize = 10
phaseLimit.MaxTextSize = 15
phaseLimit.Parent = phaseText

local timer = label(header, "01:50", Enum.Font.GothamBlack, 18, DARK)
timer.Position = UDim2.new(0.79, 0, 0, 31)
timer.Size = UDim2.new(0.17, 0, 0, 20)

local barBack = Instance.new("Frame")
barBack.Name = "NoiseTrack"
barBack.Position = UDim2.new(0.04, 0, 0, 60)
barBack.Size = UDim2.new(0.92, 0, 0, 23)
barBack.BackgroundColor3 = Color3.fromRGB(235, 229, 245)
barBack.BorderSizePixel = 0
barBack.ClipsDescendants = true
barBack.Parent = header
round(barBack, 12)

local barFill = Instance.new("Frame")
barFill.Name = "NoiseFill"
barFill.Size = UDim2.fromScale(0, 1)
barFill.BackgroundColor3 = Color3.fromRGB(255, 133, 176)
barFill.BorderSizePixel = 0
barFill.Parent = barBack
round(barFill, 12)
local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new(Color3.fromRGB(123, 218, 249), Color3.fromRGB(255, 91, 155))
gradient.Parent = barFill

local noiseCaption = label(header, "NOISE 0 / 100", Enum.Font.GothamBold, 11, DARK)
noiseCaption.Position = UDim2.new(0.04, 0, 0, 87)
noiseCaption.Size = UDim2.new(0.92, 0, 0, 18)

local stats = Instance.new("Frame")
stats.Name = "Stats"
stats.AnchorPoint = Vector2.new(0, 0)
stats.Position = UDim2.new(0, 12, 0, 132)
stats.Size = UDim2.new(0, 184, 0, 48)
stats.BackgroundColor3 = Color3.fromRGB(255, 249, 212)
stats.BorderSizePixel = 0
stats.Parent = gui
round(stats, 15)
stroke(stats, Color3.fromRGB(255, 222, 128), 2)
local statsLabel = label(stats, "🪙 0   •   PET: ???", Enum.Font.GothamBlack, 13, DARK)
statsLabel.Size = UDim2.fromScale(1, 1)

local health = Instance.new("Frame")
health.Name = "SurvivalHearts"
health.AnchorPoint = Vector2.new(1, 0)
health.Position = UDim2.new(1, -12, 0, 132)
health.Size = UDim2.fromOffset(122, 48)
health.BackgroundColor3 = Color3.fromRGB(255, 235, 238)
health.BorderSizePixel = 0
health.Visible = false
health.Parent = gui
round(health, 15)
stroke(health, Color3.fromRGB(255, 162, 182), 2)
local healthLabel = label(health, "❤️❤️❤️", Enum.Font.GothamBlack, 20, DARK)
healthLabel.Size = UDim2.fromScale(1, 1)

local banner = Instance.new("TextLabel")
banner.Name = "ChaosBanner"
banner.AnchorPoint = Vector2.new(0.5, 0)
banner.Position = UDim2.new(0.5, 0, 0, 294)
banner.Size = UDim2.new(0.94, 0, 0, 58)
banner.BackgroundColor3 = DARK
banner.BackgroundTransparency = 0.14
banner.TextColor3 = Color3.fromRGB(255, 247, 200)
banner.Font = Enum.Font.GothamBlack
banner.TextScaled = true
banner.TextWrapped = true
banner.TextStrokeTransparency = 0.5
banner.Text = ""
banner.Visible = false
banner.Parent = gui
round(banner, 18)
local bannerLimit = Instance.new("UISizeConstraint")
bannerLimit.MaxSize = Vector2.new(650, 58)
bannerLimit.Parent = banner
local bannerFont = Instance.new("UITextSizeConstraint")
bannerFont.MinTextSize = 13
bannerFont.MaxTextSize = 23
bannerFont.Parent = banner

local rescueCard = Instance.new("Frame")
rescueCard.Name = "CoopRescueChallenge"
rescueCard.AnchorPoint = Vector2.new(0.5, 1)
rescueCard.Position = UDim2.new(0.5, 0, 1, -193)
rescueCard.Size = UDim2.new(0.9, 0, 0, 75)
rescueCard.BackgroundColor3 = Color3.fromRGB(232, 250, 216)
rescueCard.BorderSizePixel = 0
rescueCard.Visible = false
rescueCard.Parent = gui
round(rescueCard, 15)
stroke(rescueCard, Color3.fromRGB(128, 212, 150), 2)
local rescueLimit = Instance.new("UISizeConstraint")
rescueLimit.MaxSize = Vector2.new(570, 75)
rescueLimit.Parent = rescueCard
local rescueLabel = label(rescueCard, "🐾 SAVE THE LOST PETS! 0/3", Enum.Font.GothamBlack, 18, DARK)
rescueLabel.Size = UDim2.new(1, -12, 0, 30)
rescueLabel.Position = UDim2.fromOffset(6, 2)
rescueLabel.TextScaled = true
local rescueTextLimit = Instance.new("UITextSizeConstraint")
rescueTextLimit.MinTextSize = 12
rescueTextLimit.MaxTextSize = 18
rescueTextLimit.Parent = rescueLabel

local routeLabel = label(rescueCard, "", Enum.Font.GothamBold, 14, DARK)
routeLabel.Position = UDim2.fromOffset(8, 34)
routeLabel.Size = UDim2.new(1,-119,0,38)
local signal = Instance.new("TextButton")
signal.Name = "SignalTeammates"
signal.AnchorPoint = Vector2.new(1,1)
signal.Position = UDim2.new(1,-5,1,-4)
signal.Size = UDim2.fromOffset(102,44)
signal.BackgroundColor3 = Color3.fromRGB(49,100,81)
signal.TextColor3 = CREAM
signal.Text = "I'll help"
signal.Font = Enum.Font.GothamBold
signal.TextSize = 15
signal.Parent = rescueCard
round(signal,10)

local foodPanel = Instance.new("Frame")
foodPanel.Name = "FeedControls"
foodPanel.AnchorPoint = Vector2.new(0.5, 1)
foodPanel.Position = UDim2.new(0.5, 0, 1, -14)
foodPanel.Size = UDim2.new(0.94, 0, 0, 168)
foodPanel.BackgroundColor3 = Color3.fromRGB(255, 251, 246)
foodPanel.BackgroundTransparency = 0.04
foodPanel.BorderSizePixel = 0
foodPanel.Parent = gui
round(foodPanel, 20)
stroke(foodPanel, Color3.fromRGB(229, 210, 255), 2)
local panelLimit = Instance.new("UISizeConstraint")
panelLimit.MaxSize = Vector2.new(590, 168)
panelLimit.Parent = foodPanel

local prompt = label(foodPanel, "FEED YOUR PET... IF YOU DARE 👀", Enum.Font.GothamBlack, 16, DARK)
prompt.Position = UDim2.new(0.02, 0, 0, 5)
prompt.Size = UDim2.new(0.96, 0, 0, 25)

local subtitle = label(foodPanel, "Tap food • discover surprises • 1–4 on keyboard", Enum.Font.GothamMedium, 11, LAVENDER)
subtitle.Position = UDim2.new(0.02, 0, 0, 28)
subtitle.Size = UDim2.new(0.96, 0, 0, 19)

local layout = Instance.new("Frame")
layout.Name = "Buttons"
layout.Position = UDim2.new(0.03, 0, 0, 53)
layout.Size = UDim2.new(0.94, 0, 0, 105)
layout.BackgroundTransparency = 1
layout.Parent = foodPanel
local grid = Instance.new("UIGridLayout")
grid.CellSize = UDim2.new(0.485, 0, 0, 47)
grid.CellPadding = UDim2.new(0.03, 0, 0, 7)
grid.SortOrder = Enum.SortOrder.LayoutOrder
grid.Parent = layout

local buttonOrder = {"Candy", "Pepper", "Bubble", "Star"}
local buttons: {[string]: TextButton} = {}
local pressedAt = 0
local function clickFood(food: string)
    local now = os.clock()
    if now - pressedAt < 0.12 then return end
    pressedAt = now
    remote:FireServer("Feed", food)
    local button = buttons[food]
    if button then
        TweenService:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Back), {Rotation = -3}):Play()
        task.delay(0.14, function()
            if button and button.Parent then TweenService:Create(button, TweenInfo.new(0.25, Enum.EasingStyle.Elastic), {Rotation = 0}):Play() end
        end)
    end
end

for index, food in ipairs(buttonOrder) do
    local data = Config.Foods[food]
    local b = Instance.new("TextButton")
    b.Name = food
    b.LayoutOrder = index
    b.Text = tostring(index) .. "   " .. data.label
    b.Font = Enum.Font.GothamBlack
    b.TextScaled = true
    b.TextColor3 = DARK
    b.BackgroundColor3 = data.color
    b.BorderSizePixel = 0
    b.AutoButtonColor = true
    b.Parent = layout
    round(b, 14)
    stroke(b, Color3.fromRGB(255, 255, 255), 2)
    local textLimit = Instance.new("UITextSizeConstraint")
    textLimit.MinTextSize = 11
    textLimit.MaxTextSize = 19
    textLimit.Parent = b
    b.MouseButton1Click:Connect(function() clickFood(food) end)
    buttons[food] = b
end

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
    if processed then return end
    local keyToFood = {
        [Enum.KeyCode.One] = "Candy",
        [Enum.KeyCode.Two] = "Pepper",
        [Enum.KeyCode.Three] = "Bubble",
        [Enum.KeyCode.Four] = "Star",
    }
    local food = keyToFood[input.KeyCode]
    if food then clickFood(food) end
end)

local noticeToken = 0
local function showNotice(message: string, color: Color3?)
    noticeToken += 1
    local token = noticeToken
    banner.Text = message
    banner.TextColor3 = color or Color3.fromRGB(255, 247, 200)
    banner.Visible = true
    banner.TextTransparency = 0
    banner.BackgroundTransparency = 0.14
    banner.Rotation = -2
    TweenService:Create(banner, TweenInfo.new(0.24, Enum.EasingStyle.Back), {Rotation = 0}):Play()
    task.delay(3, function()
        if token ~= noticeToken or not banner.Parent then return end
        local tween = TweenService:Create(banner, TweenInfo.new(0.5), {TextTransparency = 1, BackgroundTransparency = 1})
        tween:Play()
        tween.Completed:Wait()
        if token == noticeToken then banner.Visible = false end
    end)
end

local function countdown(seconds: number): string
    local value = math.max(0, math.floor(seconds))
    return string.format("%02d:%02d", math.floor(value / 60), value % 60)
end

local capture=Instance.new("TextButton")
capture.Name="RescueCapture"
capture.Text="📷 Save a rescue photo"
capture.Size=UDim2.fromOffset(174,38)
capture.Position=UDim2.new(.5,0,0,130)
capture.AnchorPoint=Vector2.new(.5,0)
capture.BackgroundColor3=CREAM
capture.TextColor3=DARK
capture.Font=Enum.Font.GothamBold
capture.Visible=false
capture.Parent=gui
round(capture,12)
local captureRound=0
local function offerPhoto(roundId: number)
    if roundId<=captureRound then return end
    captureRound=roundId
    capture.Visible=true
    task.delay(8,function()
        if captureRound==roundId then capture.Visible=false end
    end)
end
capture.Activated:Connect(function()
    capture.Visible=false
    local ok=pcall(function()
        local service=game:GetService("CaptureService")
        service:CaptureScreenshot(function(id)
            local prompted=pcall(function()
                service:PromptSaveCapturesToGallery({id},function() end)
            end)
            if not prompted then showNotice("Photo saving is unavailable on this device.",CREAM) end
        end)
    end)
    if not ok then showNotice("Photo capture is unavailable on this device.",CREAM) end
end)

local lureButton=Instance.new("TextButton")
lureButton.Name="RescueLure"
lureButton.Size=UDim2.fromOffset(188,40)
lureButton.AnchorPoint=Vector2.new(.5,1)
lureButton.Position=UDim2.new(.5,0,1,-107)
lureButton.BackgroundColor3=CREAM
lureButton.Font=Enum.Font.GothamBold
lureButton.TextColor3=DARK
lureButton.Visible=false
lureButton.Parent=gui
round(lureButton,12)
local lureId: string?=nil
local mayThrow=false
local out=false
local routeState: any = nil
local shown: RescueRoute.Target? = nil
local rescueOutline = Instance.new("Highlight")
rescueOutline.Name = "SelectedLostPet"
rescueOutline.Enabled = false
rescueOutline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
rescueOutline.OutlineColor = Color3.fromRGB(255, 220, 127)
rescueOutline.FillColor = Color3.fromRGB(255, 210, 130)
rescueOutline.FillTransparency = .91
rescueOutline.Parent = workspace
gui.Destroying:Connect(function() rescueOutline:Destroy() end)

local function refreshRoute()
    local root = if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
    local camera = workspace.CurrentCamera
    shown = if routeState and root and root:IsA("BasePart") and not out
        then RescueRoute.choose(routeState.targets, player.UserId, root.Position) else nil
    local target = shown
    local marked = if target and routeState then
        RescueRoute.modelFor(workspace:FindFirstChild("MonsterIsland"),routeState.round,target.id) else nil
    rescueOutline.Adornee = marked
    rescueOutline.Enabled = marked ~= nil
    signal.Visible = target ~= nil and target.helper == 0
    routeLabel.Size = UDim2.new(1, if signal.Visible then -119 else -16, 0, 38)
    if not target or not root or not root:IsA("BasePart") or not camera then
        routeLabel.Text = if out and routeState then "Your teammates are still rescuing" else ""
        return
    end
    local delta = target.position - root.Position
    local hint = if delta.Magnitude <= 13 then "Use SAVE ME!"
        elseif target.helper == player.UserId then "On my way"
        elseif target.helper ~= 0 then "Teammate en route" else "Lost pet"
    routeLabel.Text = string.format("%s %s · %d studs · %s",
        RescueRoute.arrow(delta,camera.CFrame.RightVector),target.name,math.round(delta.Magnitude),hint)
end
signal.Activated:Connect(function()
    if routeState and shown and shown.helper == 0 and not out then
        remote:FireServer("RescueSignal",{round = routeState.round, id = shown.id})
    end
end)
local routeElapsed = 0
game:GetService("RunService").Heartbeat:Connect(function(dt)
    if not routeState then return end
    routeElapsed += dt
    if routeElapsed >= .15 then
        routeElapsed = 0
        refreshRoute()
    end
end)
local function updateLure()
    lureButton.Visible=mayThrow and not out and lureId~=nil
end
lureButton.Activated:Connect(function()
    if lureId then remote:FireServer("GardenLure",lureId) end
end)

remote.OnClientEvent:Connect(function(event: any)
    if type(event) ~= "table" then return end
    if event.type == "state" then
        local fraction = math.clamp((event.noise or 0) / (event.maxNoise or 100), 0, 1)
        TweenService:Create(barFill, TweenInfo.new(0.32, Enum.EasingStyle.Sine), {Size = UDim2.fromScale(fraction, 1)}):Play()
        noiseCaption.Text = string.format("NOISE %d / %d", event.noise or 0, event.maxNoise or 100)
        timer.Text = countdown(event.wakeIn or event.time or 0)
        health.Visible = event.phase == "AWAKE"
        mayThrow=health.Visible and event.lureReady==true
        updateLure()
        -- Keep the playfield visible while dodging attacks: feeding is disabled
        -- by the server during a chase, so the giant food control panel hides.
        -- All four feed controls return automatically when the monster sleeps.
        foodPanel.Visible = event.phase == "SLEEP"
        rescueCard.Position = if event.phase == "AWAKE"
            then UDim2.new(0.5, 0, 1, -24)
            else UDim2.new(0.5, 0, 1, -193)
        local rescue = event.rescue
        rescueCard.Visible = event.phase == "AWAKE" and typeof(rescue) == "table" and rescue.active == true
        routeState = if rescueCard.Visible and not rescue.completed then rescue else nil
        refreshRoute()
        rescueLabel.Size = if routeState then UDim2.new(1,-12,0,30) else UDim2.new(1,-12,1,-4)
        if typeof(rescue) == "table" then
            if rescue.completed then
                rescueLabel.Text = "🎉 ALL SAVED! +30 COINS FOR SURVIVING HEROES"
                rescueCard.BackgroundColor3 = Color3.fromRGB(181, 245, 188)
            else
                local ribbon=if event.wakeMode=="Garden" then "Garden Keeper • help finish the rescue"
                    elseif event.wakeMode=="Listen" then "Quiet Steps • rescue without a bonk"
                    else "Trail Runner • draw Giggles away for 3 seconds"
                rescueLabel.Text = string.format("🐾 Rescue %d / %d   •   +%d team bonus\n%s",
                    rescue.rescued or 0,rescue.goal or 2,rescue.bonus or 30,ribbon)
                rescueCard.BackgroundColor3 = Color3.fromRGB(232, 250, 216)
            end
        end
        for _, foodButton in pairs(buttons) do
            foodButton.Active = event.phase == "SLEEP"
            foodButton.AutoButtonColor = event.phase == "SLEEP"
        end
        if event.phase == "AWAKE" then
            title.Text = "🚨 GIGGLES IS AWAKE! RUN!"
            phaseText.Text = if event.wakeMode=="Listen" then "LISTENING • LEAVE THE BLUE RING"
                elseif event.wakeMode=="Garden" then "JELLY SHOWER • DODGE THE GOLD RINGS"
                else "CHASE • RUN OUTSIDE THE STRIKE MARKS"
            title.TextColor3 = Color3.fromRGB(243, 70, 107)
            prompt.Text = "SAVE THE LOST PETS!"
        elseif event.warning then
            title.Text = "Giggles is stirring…"
            title.TextColor3 = Color3.fromRGB(139, 60, 40)
            phaseText.Text = if event.warning == "Noise" then "SOOTHE YOUR PET TO QUIET THE GARDEN" else "NAP ALMOST OVER • GET READY TO RESCUE"
            prompt.Text = if event.warning == "Noise" then "SHHH… HOLD THE SNACKS!" else "WATCH FOR THE LOST PETS"
        elseif event.phase == "COOLDOWN" then
            title.Text = "💤 PHEW... NAP TIME!"
            phaseText.Text = "YOUR COINS ARE ON THE WAY"
            title.TextColor3 = DARK
            prompt.Text = "REST A MOMENT..."
        else
            title.Text = "😴 DON'T WAKE THE MONSTER!"
            phaseText.Text = "SHHH... GIGGLES IS SLEEPING"
            title.TextColor3 = DARK
            prompt.Text = "FEED YOUR PET... IF YOU DARE 👀"
        end
    elseif event.type=="garden" then
        local stock=event.crafted or {}
        lureId=if (stock.SillyLure or 0)>0 then "SillyLure" elseif (stock.GlowLure or 0)>0 then "GlowLure" else nil
        lureButton.Text=if lureId=="GlowLure" then "Throw a Glow Lure" else "Throw a Silly Lure"
        updateLure()
    elseif event.type=="callWarning" then
        showNotice(event.text,CREAM)
    elseif event.type=="rescueMoment" then
        offerPhoto(event.round)
    elseif event.type == "stats" then
        statsLabel.Text = string.format("🪙 %d   •   PET: %s", event.coins or 0, event.pet or "???")
        out=event.knockedOut==true
        refreshRoute()
        updateLure()
        local count = math.clamp(event.hearts or 3, 0, 3)
        healthLabel.Text = if event.knockedOut then "💫 BONKED!" else string.rep("❤️", count) .. string.rep("🖤", 3 - count)
    elseif event.type == "petFeeling" then
        showNotice(tostring(event.text or ""), Color3.fromRGB(255, 209, 231))
    elseif event.type == "questToast" then
        showNotice(tostring(event.text or ""), Color3.fromRGB(175, 255, 205))
    elseif event.type == "notice" then
        showNotice(tostring(event.text or ""), event.color)
    elseif event.type == "shake" then
        -- Small HUD shake only, never override the camera on mobile.
        local original = foodPanel.Position
        foodPanel.Position = original + UDim2.fromOffset(5, 0)
        TweenService:Create(foodPanel, TweenInfo.new(0.18, Enum.EasingStyle.Back), {Position = original}):Play()
    end
end)

remote:FireServer("Sync")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="197">
        <Properties>
          <string name="Name">HowToPlay</string>
          <string name="Source"><![CDATA[--!strict
-- Short, readable onboarding: clarify the main loop in the first few seconds.
-- No modal is forced after pressing PLAY; use ? to reopen.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent

local gui = Instance.new("ScreenGui")
gui.Name = "HowToPlayGui"
gui.ResetOnSpawn = false
gui.DisplayOrder = 30
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local dark = Color3.fromRGB(60, 43, 89)
local light = Color3.fromRGB(255, 250, 240)
local soft = Color3.fromRGB(231, 219, 255)

local function corner(parent: Instance, radius: number)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = parent
end

local function line(parent: Instance, caption: string, at: UDim2, height: number, fontSize: number, bold: boolean): TextLabel
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Text = caption
    label.TextWrapped = true
    label.TextScaled = false
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Font = if bold then Enum.Font.GothamBlack else Enum.Font.GothamMedium
    label.TextSize = fontSize
    label.TextColor3 = dark
    label.Size = UDim2.new(1, -32, 0, height)
    label.Position = at
    label.Parent = parent
    return label
end

local help = Instance.new("TextButton")
help.Name = "ReopenTutorial"
help.AnchorPoint = Vector2.new(1, 1)
help.Position = UDim2.new(1, -13, 1, -243)
help.Size = UDim2.fromOffset(45, 43)
help.BackgroundColor3 = Color3.fromRGB(242, 228, 255)
help.TextColor3 = dark
help.Font = Enum.Font.GothamBlack
help.TextSize = 26
help.Text = "?"
help.Parent = gui
corner(help, 14)

local shade = Instance.new("Frame")
shade.Name = "TutorialShade"
shade.BackgroundColor3 = Color3.fromRGB(32, 23, 58)
shade.BackgroundTransparency = 0.25
shade.Size = UDim2.fromScale(1, 1)
shade.BorderSizePixel = 0
shade.Active = true
shade.Parent = gui

local panel = Instance.new("Frame")
panel.Name = "TutorialCard"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.new(0.92, 0, 0, 444)
panel.BackgroundColor3 = light
panel.BorderSizePixel = 0
panel.Parent = shade
corner(panel, 22)

local bounds = Instance.new("UISizeConstraint")
bounds.MaxSize = Vector2.new(500, 444)
bounds.Parent = panel

line(panel, "👾 DON'T WAKE THE MONSTER!", UDim2.fromOffset(16, 12), 36, 20, true)
line(panel, "A cute island. A sleepy giant. Terrible decisions.", UDim2.fromOffset(16, 49), 38, 14, false)

local steps = {
    {heading = "1  🧭  HUNT SEEDS", detail = "Open FIND SEEDS, track a glowing cache in the forest and hold its SEARCH prompt."},
    {heading = "2  🌱  GROW & EXPERIMENT", detail = "Walk to your garden beds and tap PLANT / HARVEST (E on PC). Use MY GARDEN to choose seeds, fertilize and mix recipes."},
    {heading = "3  🐱  FEED & CUDDLE", detail = "Feed wild snacks or hold PET to stroke your animal. Even a happy kitten's purr makes noise!"},
    {heading = "4  🚨  RESCUE & SURVIVE", detail = "When Giggles wakes, dodge attacks, save runaway pets and earn coins for your collection."},
}
for i, step in ipairs(steps) do
    local block = Instance.new("Frame")
    block.Name = "Step" .. i
    block.Size = UDim2.new(1, -30, 0, 68)
    block.Position = UDim2.new(0, 15, 0, 90 + (i - 1) * 72)
    block.BackgroundColor3 = if i % 2 == 1 then soft else Color3.fromRGB(227, 248, 227)
    block.BorderSizePixel = 0
    block.Parent = panel
    corner(block, 12)
    local title = line(block, step.heading, UDim2.fromOffset(8, 2), 25, 14, true)
    title.TextXAlignment = Enum.TextXAlignment.Left
    local detail = line(block, step.detail, UDim2.fromOffset(8, 27), 37, 12, false)
    detail.TextXAlignment = Enum.TextXAlignment.Left
end

local play = Instance.new("TextButton")
play.Name = "StartPlaying"
play.Size = UDim2.new(1, -30, 0, 48)
play.Position = UDim2.new(0, 15, 1, -56)
play.BackgroundColor3 = Color3.fromRGB(161, 235, 183)
play.BorderSizePixel = 0
play.Font = Enum.Font.GothamBlack
play.TextColor3 = dark
play.TextSize = 18
play.Text = "LET'S MAKE CHAOS! ✨"
play.Parent = panel
corner(play, 13)

local function setOpen(open: boolean)
    shade.Visible = open
    help.Visible = not open
end

local resolvedFirstJoin = false
local tutorialSeen = false

play.MouseButton1Click:Connect(function()
    setOpen(false)
    if not tutorialSeen then
        tutorialSeen = true
        remote:FireServer("TutorialDismiss")
    end
end)

remote.OnClientEvent:Connect(function(event: any)
    if type(event) ~= "table" or event.type ~= "collection" then return end
    tutorialSeen = event.tutorialSeen == true or tutorialSeen
    if not resolvedFirstJoin then
        resolvedFirstJoin = true
        -- The contextual objective teaches in the world. Help opens on demand.
    end
end)

-- On very fast joins the server may send the initial snapshot before this
-- LocalScript connects. Explicitly request one so the first-time guide
-- appears reliably while existing players are not interrupted.
task.delay(2.6, function()
    if not resolvedFirstJoin then remote:FireServer("Sync") end
end)
help.MouseButton1Click:Connect(function()
    setOpen(true)
end)
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
    if not processed and input.KeyCode == Enum.KeyCode.H then
        setOpen(not shade.Visible)
    end
end)
setOpen(false)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="198">
        <Properties>
          <string name="Name">NativeGardenWind</string>
          <string name="Source"><![CDATA[--!strict
-- Native crop breeze, cosmetic only. Moves a bounded subset of real Roblox
-- foliage in the playable .rbxlx when creator-owned GLBs are not installed.
-- Zero impact on growth timers, harvest prompts, collision or save data.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

type WindLeaf = {
    source: BasePart,
    base: CFrame,
    seed: number,
    weight: number,
    group: string,
}

local leaves: {[BasePart]: WindLeaf} = {}
local MAX_GARDEN = 88
local MAX_SCENERY = 48
local gardenCount = 0
local sceneryCount = 0
local elapsed = 0

local function category(part: BasePart): string?
    local name = part.Name
    if name == "PaintedLeaf" then return "garden" end
    if name == "PaintedTaperedLeaf" or name == "PaintedAngularLeaf" or
        name == "CanopyJaggedLeaf" or name == "PaintedOrchardLeaf" then
        return "scenery"
    end
    return nil
end

local function seedFor(part: BasePart): number
    local path = part:GetFullName()
    local seed = 91
    for i = 1, #path do
        seed = (seed * 31 + string.byte(path, i)) % 65521
    end
    -- Multiple leaves in the same bush share the same Roblox name. Include
    -- their original coordinates so they do not all sway in sync as a block.
    local p = part.Position
    seed = (seed + math.floor(p.X*523 + p.Y*887 + p.Z*631)) % 65521
    return seed
end

local function track(instance: Instance)
    if not instance:IsA("BasePart") then return end
    if leaves[instance] then return end
    local group = category(instance)
    if not group then return end
    local seed = seedFor(instance)
    if seed % 4 == 0 then return end -- no need to animate every single leaf
    if group == "garden" then
        if gardenCount >= MAX_GARDEN then return end
        gardenCount += 1
    else
        if sceneryCount >= MAX_SCENERY then return end
        sceneryCount += 1
    end
    leaves[instance] = {
        source = instance,
        base = instance.CFrame,
        seed = seed,
        weight = if group == "garden" then 0.045 else 0.028,
        group = group,
    }
end

local function untrack(instance: Instance)
    if not instance:IsA("BasePart") then return end
    local info = leaves[instance]
    if not info then return end
    if info.group == "garden" then gardenCount -= 1
    else sceneryCount -= 1 end
    leaves[instance] = nil
end

local island = Workspace:WaitForChild("MonsterIsland", 30)
if island then
    for _, part in ipairs(island:GetDescendants()) do track(part) end
    island.DescendantAdded:Connect(track)
    island.DescendantRemoving:Connect(untrack)
end

RunService.RenderStepped:Connect(function(dt: number)
    elapsed += dt
    if elapsed < 1 / 15 then return end
    elapsed = 0
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local at = camera.CFrame.Position
    local now = Workspace.DistributedGameTime
    for part, leaf in pairs(leaves) do
        if not part.Parent then
            untrack(part)
            continue
        end
        local distance = (part.Position - at).Magnitude
        if distance > 80 then continue end
        local wave = math.sin(now * 1.28 + leaf.seed * 0.04)
        local micro = math.sin(now * 2.21 + leaf.seed * 0.12) * .18
        local tilt = (wave+micro) * leaf.weight
        part.CFrame = leaf.base * CFrame.Angles(tilt, tilt*.26, tilt*.7)
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="199">
        <Properties>
          <string name="Name">NativePetIdle</string>
          <string name="Source"><![CDATA[--!strict
-- Client-only expressive idle animation for original native Roblox pets.
-- Works in the .rbxlx even if the owner has NOT imported GLB meshes.
-- Does not move the server-owned primary part or affect game mechanics.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

type Piece = {
    part: BasePart,
    offset: CFrame,
    side: number,
    rate: number,
    degree: number,
}
type Pet = {
    model: Model,
    root: BasePart,
    parts: {Piece},
    seed: number,
}

local pets: {[Model]: Pet} = {}
local tracked: {[Model]: boolean} = {}
local lastFrame = 0
local MAX_DISTANCE = 100
local MAX_PARTS_PER_PET = 7

-- Every species has movement different from its neighbors. The animation is
-- deliberately gentle and smooth, matching a slow, pastoral gardening game.
local motions: {[string]: {number}} = {
    FluffyRisingTail = {2.1, 12},
    LongCurvedTail = {2.5, 9},
    DinosaurThickTail = {1.7, 6},
    CottonTail = {1.9, 5},
    BunnyEarLining = {2.1, 8},
    FloppyMoonEar = {2.0, 10},
    SoftSpanielEar = {1.8, 8},
    CurvedWhisker = {2.4, 4},
    FeatheredWing = {3.3, 12},
    Wing = {3.8, 14},
    WaterGills = {2.6, 8},
    GillsFrill = {2.4, 7},
    CurvingOctopusArm = {1.8, 11},
    CrabPinkClaw = {2.1, 6},
    TurtleShell = {0.8, 2},
    RoundedEar = {1.7, 4},
    LittleAntler = {0.8, 2},
    SpriteFloatingFlare = {2.9, 9},
}

local function stableSeed(name: string): number
    local value = 0
    for i = 1, #name do
        value = (value * 17 + string.byte(name, i)) % 997
    end
    return value
end

local function build(model: Model)
    local root = model.PrimaryPart
    if not root or not root:IsA("BasePart") or
        model:GetAttribute("NativeSpeciesStyled") ~= true then
        return
    end
    local seed = stableSeed(model.Name)
    local pieces: {Piece} = {}
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("BasePart") and child ~= root then
            local motion = motions[child.Name]
            if motion then
                table.insert(pieces, {
                    part = child,
                    offset = root.CFrame:ToObjectSpace(child.CFrame),
                    side = if child.Position.X < root.Position.X then -1 else 1,
                    rate = motion[1],
                    degree = motion[2],
                })
                if #pieces >= MAX_PARTS_PER_PET then break end
            end
        end
    end
    if #pieces > 0 then
        pets[model] = {model = model, root = root, parts = pieces, seed = seed}
    end
end

local function watch(instance: Instance)
    if not instance:IsA("Model") then return end
    if tracked[instance] then return end
    -- Only actual owned pet models acquire this attribute. Farm Models,
    -- boss and player rigs will never be animated by this cosmetic pass.
    if instance:GetAttribute("NativeSpeciesStyled") == true then
        tracked[instance] = true
        build(instance)
    else
        instance:GetAttributeChangedSignal("NativeSpeciesStyled"):Connect(function()
            if instance:GetAttribute("NativeSpeciesStyled") == true then
                tracked[instance] = true
                build(instance)
            end
        end)
    end
end

local island = Workspace:WaitForChild("MonsterIsland", 30)
if island then
    for _, instance in ipairs(island:GetChildren()) do watch(instance) end
    island.ChildAdded:Connect(watch)
    island.ChildRemoved:Connect(function(instance)
        if instance:IsA("Model") then
            pets[instance] = nil
            tracked[instance] = nil
        end
    end)
end

RunService.RenderStepped:Connect(function(dt: number)
    lastFrame += dt
    if lastFrame < 1 / 20 then return end
    lastFrame = 0
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local time = Workspace.DistributedGameTime
    for model, entry in pairs(pets) do
        if not model.Parent or not entry.root.Parent then
            pets[model] = nil
            tracked[model] = nil
            continue
        end
        if (entry.root.Position - camera.CFrame.Position).Magnitude > MAX_DISTANCE then
            continue
        end
        local rootCF = entry.root.CFrame
        for index, piece in ipairs(entry.parts) do
            if not piece.part.Parent then continue end
            local wave = math.sin(time * piece.rate + entry.seed * .19 + index * .73)
            local swing = math.rad(piece.degree) * wave
            local sway = CFrame.Angles(swing * .18,
                swing * .36 * piece.side,
                swing * piece.side)
            piece.part.CFrame = rootCF * piece.offset * sway
        end
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="200">
        <Properties>
          <string name="Name">OrchardRigMotion</string>
          <string name="Source"><![CDATA[--!strict
-- Motor transforms are local to each bind pose. The server owns root movement
-- and interaction state. The artistic rig never drives collision or rewards.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local settings = UserSettings():GetService("UserGameSettings")
local rigs: {[BasePart]: any} = {}

local function track(root: Instance)
    if not root:IsA("BasePart") then return end
    local model = root.Parent
    if not model or not model:IsA("Model") then return end
    local joints = {}
    for _, child in ipairs(root:GetDescendants()) do
        if child:IsA("Motor6D") and child.Part1 then joints[child.Name] = child end
    end
    local seed=0
    for i=1,#model.Name do seed=(seed*31+string.byte(model.Name,i))%367 end
    local added=root.DescendantAdded:Connect(function(item)
        if item:IsA("Motor6D") then joints[item.Name]=item end
    end)
    local removed=root.DescendantRemoving:Connect(function(item)
        if joints[item.Name]==item then joints[item.Name]=nil end
    end)
    local species = model:GetAttribute("PetSpecies")
    local lamb = species=="Mochi" or species=="Tofu" or species=="Luma"
    local boss=model.Name=="GigglesTheGiant"
    rigs[root] = {boss=boss,model=model,joints=joints,added=added,removed=removed,prev=root.Position,phase=seed*.37,
        lamb=lamb,travel=0,rest=0,hold=0,stroke=0,wake=if boss and model:GetAttribute("Awake") then 1 else 0,stir=0,last=os.clock(),seed=seed}
end

CollectionService:GetInstanceAddedSignal("OrchardRig"):Connect(track)
CollectionService:GetInstanceRemovedSignal("OrchardRig"):Connect(function(root)
    local rig=rigs[root :: BasePart]
    if rig then rig.added:Disconnect() rig.removed:Disconnect() end
    rigs[root :: BasePart]=nil
end)
for _,root in ipairs(CollectionService:GetTagged("OrchardRig")) do track(root) end

-- One ear lifts, then settles a little past its resting position.
local function earFlick(age: number): number
    if age<=0 or age>=.72 then return 0 end
    local t=age/.72
    return math.sin(math.pi*t)^2*math.sin(2*math.pi*t)
end

RunService.PreSimulation:Connect(function()
    local camera=workspace.CurrentCamera
    if not camera then return end
    local quality=settings.SavedQualityLevel.Value
    local low=quality>0 and quality<=3
    local now=os.clock()
    for root,r in pairs(rigs) do
        local distance=(root.Position-camera.CFrame.Position).Magnitude
        local dt=now-r.last
        local distant=distance>(if low then 110 else 175)
        if distant and not r.boss then
            r.prev=root.Position
            r.last=now
            continue
        end
        if dt < (if distant then .25 elseif low or distance>70 then 1/20 else 1/45) then continue end
        local delta=root.Position-r.prev
        local speed=math.min(24,Vector2.new(delta.X,delta.Z).Magnitude/math.max(dt,.001))
        r.prev=root.Position
        r.last=now
        local postureBlend=1-math.exp(-dt*4.5)
        dt=math.min(dt,.12)
        local blend=1-math.exp(-dt*7)
        local model=r.model
        local mode=model:GetAttribute("MotionMode")
        local boss=r.boss
        local function fade(value: number, target: number): number
            return value+(target-value)*blend
        end
        r.travel=fade(r.travel,if mode=="Carry" or mode=="Nap" or boss then 0 else math.clamp(speed/8,0,1))
        r.rest=fade(r.rest,if mode=="Nap" then 1 else 0)
        r.hold=fade(r.hold,if mode=="Carry" then 1 else 0)
        r.stroke=fade(r.stroke,if mode=="Pet" then 1 else 0)
        local awake=if model:GetAttribute("Awake") then 1 else 0
        r.wake+=(awake-r.wake)*postureBlend
        if boss then r.stir=fade(r.stir,if model:GetAttribute("Stirring") and not model:GetAttribute("Awake") then 1 else 0) end
        r.phase+=dt*(2.2+math.min(speed,17)*.61)
        local beat=math.sin(r.phase)
        local breath=math.sin(now*(if boss then 1.13 else 1.92)+r.seed)
        local nibble=0
        local firstEar,secondEar=0,0
        local fedAt=model:GetAttribute("FedAt")
        if type(fedAt)=="number" then
            local age=workspace:GetServerTimeNow()-fedAt
            if age>=0 and age<1.2 then
                if r.lamb then
                    firstEar=earFlick(age)*(1-r.rest)
                    secondEar=earFlick(age-.14)*(1-r.rest)
                end
                nibble=math.sin(math.pi*age/1.2)^2 * (.60+.40*math.sin(age*16))
            end
        end
        local attack=0
        if boss then
            local stamp=model:GetAttribute("AttackAt")
            if type(stamp)=="number" then
                local t=workspace:GetServerTimeNow()-stamp
                if t>=0 and t<1.3 then attack=math.sin(math.pi*t/1.3)^2 end
            end
        end
        local prone=if boss then (1-r.wake)*(1-.44*r.stir) else 0
        local spine=r.joints.Spine
        local unit=if spine then spine:GetAttribute("PoseScale") or 1 else 1
        local pitch=-1.02*prone
        local height=(.02+.009*breath)*prone
        local up=if prone>0 then Vector3.new(0,math.cos(pitch),-math.sin(pitch)) else Vector3.yAxis
        for name,joint in pairs(r.joints) do
            if not joint.Part1 then continue end
            local side=if name:sub(-1)=="L" then -1 else 1
            local x,y,z=0,0,0
            local offset=Vector3.zero
            if name=="Spine" then
                x=pitch
                offset=Vector3.new(0,height,.77*prone)*unit
            elseif name=="Head" then
                x=.055*breath+.09*r.travel*math.cos(r.phase*2)+.45*r.rest-.17*r.stroke+.22*nibble
                y=.10*math.sin(now*.94+r.seed)*(1-r.travel)+.28*r.stroke
                z=.08*r.hold
                if r.lamb then z+=.20*r.stroke-.09*(firstEar-secondEar) end
                if boss then
                    x=.90*prone+.035*breath-.31*attack+.28*r.stir
                    offset=Vector3.new(0,-.10,-.27)*prone*unit
                    offset-=up*(.16*prone*unit)
                    z-=.13*prone
                    local scenario=model:GetAttribute("WakeMode")
                    if scenario=="Listen" then
                        y=.31*math.sin(now*1.45)*r.wake
                        z=.11*math.cos(now*1.45)*r.wake
                    elseif scenario=="Garden" then
                        x+=.12*math.sin(now*2.4)*r.wake
                    end
                    y+=.22*math.sin(now*1.9)*r.stir+.14*prone
                end
            elseif name:match("^Ear") then
                x=.035*breath+.09*math.cos(r.phase*2-.48)*r.travel+.38*r.rest-.16*r.stroke
                z=side*(.035*breath+.12*nibble+.09*r.hold)
                if r.lamb then
                    local flick=if side<0 then firstEar else secondEar
                    z+=side*(.46*flick+.15*r.stroke)
                    y+=side*(.13*flick+.12*r.stroke)
                end
            elseif name:match("^Fore") or name:match("^Hind") then
                local pair=if name:match("^Fore") then 1 else -1
                x=beat*side*pair*r.travel*.67+pair*(r.rest*.60+r.hold*.37)
                if pair==1 then x-=.17*nibble end
            elseif name=="Tail" then
                y=math.sin(now*(2.1+1.8*r.stroke)+r.seed)*(.17+.25*r.stroke)+.12*beat*r.travel+.24*nibble
                x=.13*r.hold-.25*r.rest+(if boss then 1.55*prone else 0)
            elseif name:match("^Wing") or name:match("^Gill") or name:match("^Claw") then
                z=side*(.13*breath+(.22+.38*r.travel)*beat*(1-r.rest)-.28*r.hold+.18*nibble)
            elseif name:match("^Tendril") then
                x=.15*math.sin(r.phase+(tonumber(name:sub(8)) or 0)*.82)
            elseif name:match("^Arm") then
                offset=up*(.35*prone*(1-.8*r.stir)*unit)
                x=1.34*prone+.065*breath-.30*r.wake-.87*attack+(if side<0 then 1.12 else .19)*r.stir
                z=side*(.08*breath+.10*r.wake+.18*attack-.32*r.stir+.12*prone)
            elseif name:match("^Leg") then
                -- Project the lower rings of the sculpted foot onto the
                -- dais. Both hind feet fold back as the torso tips forward.
                local legPitch=pitch-.55*prone
                local c,s=math.cos(legPitch),math.sin(legPitch)
                local sole=math.min(-.745*c+1.04*s,-.66*c+1.17*s,-.46*c+1.09*s)
                if spine and prone>0 then
                    local hip=spine:GetAttribute("FloorClearance")+height*unit+joint.C0.Position:Dot(up)
                    offset=up*(-hip-sole*unit)
                end
                x=-.55*prone+side*.15*attack
                if model:GetAttribute("Walking") then x+=side*.26*math.sin(now*3.4) end
            elseif name=="Blink" then
                local eyes=joint.Part1
                local openSize=eyes:GetAttribute("OpenEyeSize")
                if openSize then
                    local cycle=(now+r.seed*.013)%(3.7+(r.seed%7)*.19)
                    local sweep=if cycle<.24 then math.sin(math.pi*cycle/.24)^2 else 0
                    local height=openSize.Y*(1-.89*math.max(sweep,r.rest,.26*r.stroke))
                    if math.abs(height-eyes.Size.Y)>.0005 then
                        eyes.Size=Vector3.new(openSize.X,height,openSize.Z)
                    end
                end
            elseif name:match("^Eye") then
                joint.Part1.LocalTransparencyModifier=1-r.wake
            elseif name:match("^Lid") then
                joint.Part1.LocalTransparencyModifier=r.wake
            end
            joint.Transform=CFrame.new(offset)*CFrame.Angles(x,y,z)
        end
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="201">
        <Properties>
          <string name="Name">PetCare</string>
          <string name="Source"><![CDATA[--!strict
-- Pet care: tap to pick up and HOLD to stroke (touch, mouse, R key).
-- Holding input generates keepalive heartbeats; the server controls all noise and effects.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent

local INK = Color3.fromRGB(70, 48, 92)
local WHITE = Color3.fromRGB(255, 251, 241)
local PINK = Color3.fromRGB(255, 177, 202)
local GREEN = Color3.fromRGB(191, 243, 186)
local PURPLE = Color3.fromRGB(213, 186, 255)

local function corner(target: Instance, radius: number)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = target
end
local function border(target: Instance, color: Color3)
    local s = Instance.new("UIStroke")
    s.Thickness = 2
    s.Color = color
    s.Transparency = 0.25
    s.Parent = target
end
local function text(parent: Instance, caption: string, height: number, size: number, bold: boolean): TextLabel
    local label = Instance.new("TextLabel")
    label.Name = "CareLabel"
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -12, 0, height)
    label.Font = if bold then Enum.Font.GothamBlack else Enum.Font.GothamMedium
    label.Text = caption
    label.TextSize = size
    label.TextColor3 = INK
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.Parent = parent
    return label
end
local function button(parent: Instance, caption: string, tint: Color3): TextButton
    local b = Instance.new("TextButton")
    b.Text = caption
    b.TextScaled = true
    b.Font = Enum.Font.GothamBlack
    b.TextColor3 = INK
    b.AutoButtonColor = true
    b.BackgroundColor3 = tint
    b.BorderSizePixel = 0
    b.Parent = parent
    corner(b, 12)
    local limit = Instance.new("UITextSizeConstraint")
    limit.MaxTextSize = 16
    limit.MinTextSize = 11
    limit.Parent = b
    return b
end

local gui = Instance.new("ScreenGui")
gui.Name = "PetCareControls"
gui.ResetOnSpawn = false
gui.DisplayOrder = 8
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local card = Instance.new("Frame")
card.Name = "CarePanel"
card.AnchorPoint = Vector2.new(1, 1)
card.Position = UDim2.new(1, -12, 1, -244)
card.Size = UDim2.fromOffset(174, 154)
card.BackgroundColor3 = WHITE
card.BackgroundTransparency = 0.045
card.BorderSizePixel = 0
card.Parent = gui
corner(card, 18)
border(card, Color3.fromRGB(228, 196, 255))

local heading = text(card, "🐾 CUDDLE CORNER", 24, 13, true)
heading.Position = UDim2.fromOffset(6, 4)
local carry = button(card, "🤲 PICK UP", GREEN)
carry.Name = "Carry"
carry.Position = UDim2.fromOffset(8, 32)
carry.Size = UDim2.new(.5, -10, 0, 39)
local soothe = button(card,"SOOTHE",PURPLE)
soothe.Name = "Soothe"
soothe.Position = UDim2.new(.5,2,0,32)
soothe.Size = UDim2.new(.5,-10,0,39)
soothe.Activated:Connect(function() remote:FireServer("PetInteract","Comfort") end)
local stroke = button(card, "💗 HOLD TO PET", PINK)
stroke.Name = "PetHold"
stroke.Position = UDim2.fromOffset(8, 77)
stroke.Size = UDim2.new(1, -16, 0, 39)

local meter = Instance.new("Frame")
meter.Name = "PurrMeterBack"
meter.Position = UDim2.fromOffset(9, 126)
meter.Size = UDim2.new(1, -18, 0, 14)
meter.BackgroundColor3 = Color3.fromRGB(235, 229, 240)
meter.BorderSizePixel = 0
meter.Parent = card
corner(meter, 7)
local fill = Instance.new("Frame")
fill.Name = "PurrFill"
fill.Size = UDim2.fromScale(0, 1)
fill.BackgroundColor3 = PURPLE
fill.BorderSizePixel = 0
fill.Parent = meter
corner(fill, 7)

local meterText = text(card, "Hold longer • surprise inside!", 15, 10, false)
meterText.Position = UDim2.fromOffset(6, 139)
-- Locally pose both shoulders toward the carried creature. The pet itself
-- is positioned by the server, so everyone sees a real carried companion.
local shoulderDefaults: {[Motor6D]: CFrame} = {}
local poseActive = false
local function poseShoulders(enabled: boolean)
    if poseActive == enabled then return end
    poseActive = enabled
    local character = player.Character
    if not character then return end
    if enabled then
        for _, joint in ipairs(character:GetDescendants()) do
            if joint:IsA("Motor6D") and (joint.Name == "RightShoulder" or joint.Name == "LeftShoulder"
                or joint.Name == "Right Shoulder" or joint.Name == "Left Shoulder") then
                if not shoulderDefaults[joint] then shoulderDefaults[joint] = joint.C0 end
                local side = if string.find(joint.Name, "Right", 1, true) then -1 else 1
                local goal = shoulderDefaults[joint] * CFrame.Angles(math.rad(-49), math.rad(side * 8), math.rad(side * 13))
                TweenService:Create(joint, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {C0 = goal}):Play()
            end
        end
    else
        for joint, original in pairs(shoulderDefaults) do
            if joint.Parent then
                TweenService:Create(joint, TweenInfo.new(0.23, Enum.EasingStyle.Quad), {C0 = original}):Play()
            end
        end
    end
end
player.CharacterAdded:Connect(function()
    table.clear(shoulderDefaults)
    poseActive = false
end)

local state = {carrying = false, petting = false, purr = 0, cat = false}
local held = false
local activeTouch: InputObject? = nil

local function start()
    if held then return end
    held = true
    remote:FireServer("StartPetting")
    stroke.BackgroundColor3 = Color3.fromRGB(255, 117, 165)
    stroke.Text = "💞 STROKING... RELEASE"
end
local function stop()
    if not held then return end
    held = false
    activeTouch = nil
    remote:FireServer("StopPetting")
    stroke.BackgroundColor3 = PINK
    stroke.Text = "💗 HOLD TO PET"
end

stroke.InputBegan:Connect(function(input: InputObject)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        if input.UserInputType == Enum.UserInputType.Touch then activeTouch = input end
        start()
    end
end)
stroke.InputEnded:Connect(function(input: InputObject)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input == activeTouch then stop() end
end)
UserInputService.InputEnded:Connect(function(input: InputObject)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input == activeTouch or input.KeyCode == Enum.KeyCode.R then
        stop()
    end
end)
UserInputService.WindowFocusReleased:Connect(stop)
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
    if not processed and input.KeyCode == Enum.KeyCode.R then start() end
    if not processed and input.KeyCode == Enum.KeyCode.C then remote:FireServer("ToggleCarry") end
end)

carry.MouseButton1Click:Connect(function() remote:FireServer("ToggleCarry") end)

remote.OnClientEvent:Connect(function(payload: any)
    if typeof(payload) ~= "table" then return end
    if payload.type == "state" then
        local chasing = payload.phase == "AWAKE"
        if chasing and held then stop() end
        card.Visible = not chasing
        return
    end
    if payload.type ~= "petCare" then return end
    state = payload
    poseShoulders(state.carrying == true)
    carry.Text = if state.carrying then "👐 PUT DOWN" else "🤲 PICK UP"
    carry.BackgroundColor3 = if state.carrying then PURPLE else GREEN
    local purr = math.clamp(payload.purr or 0, 0, 1)
    TweenService:Create(fill, TweenInfo.new(0.32), {Size = UDim2.fromScale(purr, 1)}):Play()
    if state.cat and purr > 0.015 then
        meterText.Text = if purr > 0.74 then "🚨 TOO LOUD! SHHH!" else string.format("😻 PURRR...  %d%%", math.floor(purr * 100))
        fill.BackgroundColor3 = if purr > 0.74 then Color3.fromRGB(255, 113, 113) else PINK
    else
        meterText.Text = if state.cat then "💤 Stroking may wake Giggles!" else "💕 Your pet loves attention!"
        fill.BackgroundColor3 = PURPLE
    end
    if not state.petting and held then
        -- The server can cancel a hold on a sudden cat reaction or boss wake.
        -- Don't keep painting the hold UI as active.
        held = false
        activeTouch = nil
        stroke.BackgroundColor3 = PINK
        stroke.Text = "💗 HOLD TO PET"
    end
end)

-- Keepalives are deliberately slow and checked by the server. An abandoned
-- button press cannot generate infinite purr/noise on an unattended session.
task.spawn(function()
    while gui.Parent do
        task.wait(1.4)
        if held then remote:FireServer("PettingPulse") end
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="202">
        <Properties>
          <string name="Name">PetDiary</string>
          <string name="Source"><![CDATA[--!strict
-- Mobile-first pet diary. All values are reported by the server; no client stats can be edited.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local WHITE = Color3.fromRGB(255, 251, 245)
local DARK = Color3.fromRGB(67, 50, 94)
local PINK = Color3.fromRGB(255, 202, 222)
local LILAC = Color3.fromRGB(223, 204, 255)
local MINT = Color3.fromRGB(204, 241, 209)
local currentCollection: any = nil
local currentStats: any = nil

local function corner(target: Instance, radius: number)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = target
end
local function text(parent: Instance, title: string, size: number, position: UDim2, height: number, bold: boolean?): TextLabel
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position = position
    l.Size = UDim2.new(1, -28, 0, height)
    l.Text = title
    l.TextColor3 = DARK
    l.TextSize = size
    l.Font = if bold then Enum.Font.GothamBlack else Enum.Font.GothamMedium
    l.TextWrapped = true
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end
local function button(parent: Instance, name: string, caption: string, background: Color3): TextButton
    local b = Instance.new("TextButton")
    b.Name = name
    b.Text = caption
    b.Font = Enum.Font.GothamBlack
    b.TextColor3 = DARK
    b.TextScaled = true
    b.BackgroundColor3 = background
    b.BorderSizePixel = 0
    b.Parent = parent
    corner(b, 12)
    local limit = Instance.new("UITextSizeConstraint")
    limit.MinTextSize = 10
    limit.MaxTextSize = 17
    limit.Parent = b
    return b
end

local gui = Instance.new("ScreenGui")
gui.Name = "PetDiary"
gui.ResetOnSpawn = false
gui.DisplayOrder = 11
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
local open = button(gui, "OpenDiary", "💗 PET DIARY", PINK)
open.AnchorPoint = Vector2.new(1, 0)
open.Position = UDim2.new(1, -12, 0, 241)
open.Size = UDim2.fromOffset(152, 43)

local backdrop = Instance.new("Frame")
backdrop.Name = "DiaryBackdrop"
backdrop.Size = UDim2.fromScale(1, 1)
backdrop.BackgroundColor3 = Color3.fromRGB(32, 25, 52)
backdrop.BackgroundTransparency = 0.32
backdrop.BorderSizePixel = 0
backdrop.Active = true
backdrop.Visible = false
backdrop.Parent = gui

local panel = Instance.new("Frame")
panel.Name = "DiaryPanel"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.new(0.94, 0, 0.85, 0)
panel.BackgroundColor3 = WHITE
panel.BorderSizePixel = 0
panel.Parent = backdrop
corner(panel, 20)
local sizeLimit = Instance.new("UISizeConstraint")
sizeLimit.MaxSize = Vector2.new(510, 700)
sizeLimit.MinSize = Vector2.new(260, 300)
sizeLimit.Parent = panel

local title = text(panel, "💗 MY PET'S SECRET DIARY", 19, UDim2.fromOffset(14, 10), 35, true)
title.TextScaled = true
local sizeGuard = Instance.new("UITextSizeConstraint")
sizeGuard.MinTextSize = 12
sizeGuard.MaxTextSize = 19
sizeGuard.Parent = title

local close = button(panel, "Close", "✕", PINK)
close.AnchorPoint = Vector2.new(1, 0)
close.Position = UDim2.new(1, -12, 0, 10)
close.Size = UDim2.fromOffset(40, 37)
local hint = text(panel, "Every creature is a unique individual 💖", 12, UDim2.fromOffset(15, 50), 30)

local scroll = Instance.new("ScrollingFrame")
scroll.Name = "DiaryContents"
scroll.Position = UDim2.new(0, 12, 0, 87)
scroll.Size = UDim2.new(1, -24, 1, -176)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.CanvasSize = UDim2.fromScale(0, 0)
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.ScrollingDirection = Enum.ScrollingDirection.Y
scroll.ScrollBarThickness = 5
scroll.Parent = panel
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = scroll
local pad = Instance.new("UIPadding")
pad.PaddingBottom = UDim.new(0, 12)
pad.Parent = scroll

local actionBar = Instance.new("Frame")
actionBar.Name = "FriendshipActions"
actionBar.BackgroundTransparency = 1
actionBar.Position = UDim2.new(0, 12, 1, -78)
actionBar.Size = UDim2.new(1, -24, 0, 66)
actionBar.Parent = panel
local actions = {
    {key = "Pet", label = "🤲 PET", color = PINK},
    {key = "Play", label = "🎾 PLAY", color = MINT},
    {key = "Comfort", label = "🫂 SOOTHE", color = LILAC},
}
for index, item in ipairs(actions) do
    local b = button(actionBar, item.key, item.label, item.color)
    b.Size = UDim2.new(1 / 3, -7, 0, 44)
    b.Position = UDim2.new((index - 1) / 3, 5, 0, 0)
    b.MouseButton1Click:Connect(function()
        remote:FireServer("PetInteract", item.key)
    end)
end

local feedback = text(actionBar, "Get close to your pet before interacting!", 11, UDim2.new(0, 6, 0, 45), 20)
feedback.Size = UDim2.new(1, -12, 0, 20)
feedback.TextXAlignment = Enum.TextXAlignment.Center

local function panelRow(height: number, color: Color3): Frame
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = color
    frame.BorderSizePixel = 0
    frame.Size = UDim2.new(1, -6, 0, height)
    frame.Parent = scroll
    corner(frame, 13)
    return frame
end

local function indicator(parent: Instance, index: number, label: string, value: number, color: Color3)
    local base = text(parent, label .. "  " .. value .. "%", 12, UDim2.new(0, 9, 0, index * 33 + 3), 21, true)
    base.Size = UDim2.new(1, -18, 0, 20)
    local track = Instance.new("Frame")
    track.Position = UDim2.new(0, 9, 0, index * 33 + 24)
    track.Size = UDim2.new(1, -18, 0, 8)
    track.BackgroundColor3 = Color3.fromRGB(225, 221, 224)
    track.BorderSizePixel = 0
    track.Parent = parent
    corner(track, 5)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(math.clamp(value / 100, 0, 1), 1)
    fill.BackgroundColor3 = color
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 5)
end

local function addInfoRow(caption: string, detail: string, bg: Color3)
    local frame = panelRow(58, bg)
    local h = text(frame, caption, 15, UDim2.fromOffset(12, 3), 24, true)
    h.Size = UDim2.new(1, -24, 0, 24)
    local d = text(frame, detail, 12, UDim2.fromOffset(12, 28), 25)
    d.Size = UDim2.new(1, -24, 0, 25)
end

local function render()
    if not backdrop.Visible then return end
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    if not currentCollection or not currentCollection.petProfiles then
        addInfoRow("Waiting for your animal...", "Collect a pet and try again.", LILAC)
        return
    end
    local id = currentCollection.equipped
    local pet = Config.Pets[id]
    local profile = currentCollection.petProfiles[tostring(id)]
    if not pet or not profile then
        addInfoRow("No active pet", "Open MY PETS and equip your companion.", LILAC)
        return
    end
    hint.Text = "🐾 " .. pet.name .. "   •   " .. (pet.description or "a tiny chaos creature") .. "   •   " .. profile.mood
    addInfoRow("👑 " .. profile.temperament .. " CHARACTER", "Habit: " .. profile.habit .. "   •   Fear: " .. profile.fear, LILAC)
    addInfoRow("🍬 SECRET FOOD TASTES", "Loves " .. profile.favoriteFood .. "   •   Dislikes " .. profile.dislikedFood, PINK)
    addInfoRow("💞 " .. (profile.bondStage or "FRIENDSHIP"), "Loves: " .. profile.affection .. "   •   Mood: " .. profile.mood, MINT)
    addInfoRow("RESCUE MEMORIES",string.format("You and %s saved %d runaway pets together.",pet.name,profile.rescues or 0),MINT)
    local ribbons=profile.ribbons or {}
    local earned={}
    for _,entry in {{"QuietSteps","Quiet Steps"},{"TrailRunner","Trail Runner"},{"GardenKeeper","Garden Keeper"}} do
        if ribbons[entry[1]] then table.insert(earned,entry[2]) end
    end
    addInfoRow("RESCUE RIBBONS",if #earned>0 then table.concat(earned,"  •  ")
        else "Rescue without a bonk during Listening to learn Quiet Steps.",LILAC)
    local meter = panelRow(156, Color3.fromRGB(250, 237, 230))
    indicator(meter, 0, "💖 FRIENDSHIP", profile.bond, Color3.fromRGB(255, 110, 149))
    indicator(meter, 1, "😊 HAPPINESS", profile.happiness, Color3.fromRGB(244, 191, 88))
    indicator(meter, 2, "⚡ ENERGY", profile.energy, Color3.fromRGB(116, 207, 181))
    indicator(meter, 3, "🍎 HUNGER", profile.hunger, Color3.fromRGB(194, 148, 244))
    local genes = panelRow(195, Color3.fromRGB(239, 238, 253))
    local name = text(genes, "🌈 PERSONALITY TRAITS (PERMANENT)", 15, UDim2.fromOffset(12, 5), 27, true)
    name.Size = UDim2.new(1, -24, 0, 27)
    local keys = {
        {"kindness", "Kindness"}, {"curiosity", "Curiosity"}, {"courage", "Courage"},
        {"mischief", "Mischief"}, {"sociability", "Sociability"}, {"sensitivity", "Sensitivity"},
    }
    for i, pair in ipairs(keys) do
        local gene = text(genes, pair[2] .. ": " .. (profile.traits and profile.traits[pair[1]] or "?"), 13, UDim2.fromOffset(12, 27 + (i - 1) * 27), 25)
        gene.Size = UDim2.new(1, -24, 0, 25)
    end
end

local function setOpen(active: boolean)
    backdrop.Visible = active
    open.Visible = not active
    if active then
        remote:FireServer("Sync")
        render()
    end
end

open.MouseButton1Click:Connect(function() setOpen(true) end)
close.MouseButton1Click:Connect(function() setOpen(false) end)
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.B then setOpen(not backdrop.Visible) end
    if input.KeyCode == Enum.KeyCode.Escape and backdrop.Visible then setOpen(false) end
end)
remote.OnClientEvent:Connect(function(event: any)
    if typeof(event) ~= "table" then return end
    if event.type == "collection" then
        currentCollection = event
        render()
    elseif event.type == "stats" then
        currentStats = event
        if backdrop.Visible then render() end
    elseif event.type == "petFeeling" then
        feedback.Text = tostring(event.text or "")
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="203">
        <Properties>
          <string name="Name">SeedExplorer</string>
          <string name="Source"><![CDATA[--!strict
-- Mobile seed album + self-guided exploration. Actual pickup is ProximityPrompt
-- on a server-created world object; this UI never grants seeds by clicking.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent
local X = require(ReplicatedStorage:WaitForChild("ExpeditionConfig"))
local G = require(ReplicatedStorage:WaitForChild("GardenConfig"))

local WHITE = Color3.fromRGB(255, 250, 239)
local INK = Color3.fromRGB(61, 57, 90)
local BLUSH = Color3.fromRGB(252, 220, 205)
local LEAF = Color3.fromRGB(199, 238, 189)
local MUTED = Color3.fromRGB(107, 105, 120)
local state: any = nil
local tracked: any = nil
local marker: Highlight? = nil
local currentWeather = "Sunny"

local function round(target: Instance, px: number)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, px)
    c.Parent = target
end
local function label(parent: Instance, value: string, size: number, bold: boolean?): TextLabel
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundTransparency = 1
    t.Text = value
    t.TextWrapped = true
    t.Font = if bold then Enum.Font.GothamBlack else Enum.Font.GothamMedium
    t.TextColor3 = INK
    t.TextSize = size
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = parent
    return t
end
local function button(parent: Instance, value: string, color: Color3): TextButton
    local b = Instance.new("TextButton")
    b.Text = value
    b.TextScaled = true
    b.TextColor3 = INK
    b.Font = Enum.Font.GothamBlack
    b.BackgroundColor3 = color
    b.BorderSizePixel = 0
    b.Parent = parent
    round(b, 12)
    local max = Instance.new("UITextSizeConstraint")
    max.MinTextSize = 10
    max.MaxTextSize = 15
    max.Parent = b
    return b
end

local gui = Instance.new("ScreenGui")
gui.Name = "SeedExplorer"
gui.DisplayOrder = 12
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
local open = button(gui, "🧭 FIND SEEDS", LEAF)
open.Name = "OpenSeedExplorer"
open.Position = UDim2.fromOffset(12, 292)
open.Size = UDim2.fromOffset(152, 43)
local tracker = Instance.new("TextLabel")
tracker.Name = "TrackedSeed"
tracker.AnchorPoint = Vector2.new(0.5, 0)
tracker.Position = UDim2.new(0.5, 0, 0, 270)
tracker.Size = UDim2.new(0.8, 0, 0, 40)
tracker.BackgroundColor3 = Color3.fromRGB(241, 245, 214)
tracker.BackgroundTransparency = 0.14
tracker.TextColor3 = INK
tracker.Text = ""
tracker.TextScaled = true
tracker.Font = Enum.Font.GothamBlack
tracker.Visible = false
tracker.Parent = gui
round(tracker, 12)
local limit = Instance.new("UISizeConstraint")
limit.MaxSize = Vector2.new(460, 40)
limit.Parent = tracker

local overlay = Instance.new("Frame")
overlay.Name = "ExplorerOverlay"
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundColor3 = Color3.fromRGB(37, 34, 58)
overlay.BackgroundTransparency = 0.28
overlay.BorderSizePixel = 0
overlay.Active = true
overlay.Visible = false
overlay.Parent = gui
local panel = Instance.new("Frame")
panel.Name = "ExplorerPanel"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.new(0.94, 0, 0.87, 0)
panel.BackgroundColor3 = WHITE
panel.BorderSizePixel = 0
panel.Parent = overlay
round(panel, 22)
local cap = Instance.new("UISizeConstraint")
cap.MaxSize = Vector2.new(580, 690)
cap.MinSize = Vector2.new(255, 300)
cap.Parent = panel

local title = label(panel, "🌱 SEED HUNTER'S JOURNAL", 19, true)
title.Position = UDim2.new(0, 16, 0, 8)
title.Size = UDim2.new(1, -76, 0, 32)
title.TextScaled = true
local close = button(panel, "✕", BLUSH)
close.AnchorPoint = Vector2.new(1, 0)
close.Position = UDim2.new(1, -13, 0, 10)
close.Size = UDim2.fromOffset(42, 35)
local status = label(panel, "Explore and follow the glowing seed markers.", 12)
status.Position = UDim2.new(0, 14, 0, 48)
status.Size = UDim2.new(1, -28, 0, 48)

local scroll = Instance.new("ScrollingFrame")
scroll.Name = "ExplorerList"
scroll.Position = UDim2.new(0, 12, 0, 103)
scroll.Size = UDim2.new(1, -24, 1, -117)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.CanvasSize = UDim2.fromScale(0, 0)
scroll.ScrollBarThickness = 4
scroll.Parent = panel
local list = Instance.new("UIListLayout")
list.Padding = UDim.new(0, 8)
list.Parent = scroll
local inset = Instance.new("UIPadding")
inset.PaddingBottom = UDim.new(0, 11)
inset.Parent = scroll

local function row(height: number, bg: Color3): Frame
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -5, 0, height)
    card.BorderSizePixel = 0
    card.BackgroundColor3 = bg
    card.Parent = scroll
    round(card, 12)
    return card
end

local function clearHighlight()
    if marker then marker:Destroy() end
    marker = nil
end

local function track(node: any)
    tracked = node
    clearHighlight()
    overlay.Visible = false
    open.Visible = true
    tracker.Visible = true
    local island = workspace:FindFirstChild("MonsterIsland")
    if island then
        local match = island:FindFirstChild("SeedCache_" .. node.id, true)
        if match and match:IsA("BasePart") then
            marker = Instance.new("Highlight")
            marker.Adornee = match
            marker.FillColor = Color3.fromRGB(255, 232, 117)
            marker.OutlineColor = Color3.fromRGB(255, 255, 255)
            marker.FillTransparency = 0.4
            marker.OutlineTransparency = 0.1
            marker.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            marker.Parent = gui
        end
    end
end

local function draw()
    if not overlay.Visible then return end
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local foundCount = 0
    local mutationCount = 0
    if state then
        for _ in pairs(state.seedAlbum or {}) do foundCount += 1 end
        for _ in pairs(state.mutationAlbum or {}) do mutationCount += 1 end
    end
    local weather = X.Weather[currentWeather]
    status.Text = (if weather then weather.icon .. " " .. weather.name else "☀️ Sunshine") ..
        " • " .. foundCount .. "/28 SEEDS • " .. mutationCount .. "/4 MUTATIONS\n" ..
        "COMMUNITY FESTIVAL: " .. (if state then state.festivalFinds or 0 else 0) ..
        "/" .. X.FestivalGoal .. "  • DAILY: " ..
        (if state then state.forageToday or 0 else 0) .. "/5 (+45 coins)"

    local hint = row(70, Color3.fromRGB(232, 242, 219))
    local t = label(hint, "🧭 Follow a golden highlight to a seed cache, walk close and HOLD FIND SEEDS. Each cache regrows after 4 minutes. Rare odds: 7% before curiosity bonuses.", 12)
    t.Position = UDim2.fromOffset(9, 3)
    t.Size = UDim2.new(1, -18, 1, -6)

    for _, zoneId in ipairs(X.ZoneOrder) do
        local zone = X.Zones[zoneId]
        local header = row(60, Color3.fromRGB(242, 228, 239))
        local name = label(header, zone.icon .. " " .. zone.name .. "\n" .. zone.hint, 15, true)
        name.Position = UDim2.fromOffset(10, 4)
        name.Size = UDim2.new(1, -20, 1, -8)
        for _, node in ipairs(zone.nodes) do
            local card = row(54, Color3.fromRGB(245, 246, 229))
            local last = if state and state.hunt then state.hunt.visited[node.id] else nil
            local left = if type(last) == "number" then math.max(0, X.NodeCooldown - (os.time() - last)) else 0
            local desc = label(card, "🌱 " .. node.label .. (if left == 0 then "  •  READY" else "  •  REGROWS " .. left .. "s"), 12, true)
            desc.Position = UDim2.fromOffset(9, 4)
            desc.Size = UDim2.new(0.60, -12, 1, -8)
            local goto = button(card, if left > 0 then "TRACK AGAIN" else "TRACK", LEAF)
            goto.Position = UDim2.new(0.62, 0, 0, 8)
            goto.Size = UDim2.new(0.36, -7, 0, 38)
            goto.MouseButton1Click:Connect(function() track(node) end)
        end
    end
    local album = row(72, Color3.fromRGB(226, 240, 249))
    local labelAlbum = label(album, "📔 SEED ALBUM: " .. foundCount .. " unique wild seeds discovered\n✨ MUTATIONS: " .. mutationCount .. "/4 — Golden, Dewy, Moonlit, Giggly", 13, true)
    labelAlbum.Position = UDim2.fromOffset(10, 5)
    labelAlbum.Size = UDim2.new(1, -20, 1, -10)
    for _, key in ipairs(G.Order) do
        if G.Crops[key].kind == "ordinary" then
            local entry = row(34, Color3.fromRGB(244, 239, 228))
            local seen = state and state.seedAlbum and state.seedAlbum[key]
            local t = label(entry, (if seen then "✅ " .. G.Crops[key].icon .. " " .. G.Crops[key].name else "🔒 Undiscovered wild seed"), 12)
            t.Position = UDim2.fromOffset(9, 2)
            t.Size = UDim2.new(1, -18, 1, -4)
        end
    end
end

local function toggle(active: boolean)
    overlay.Visible = active
    open.Visible = not active
    if active then draw() end
end
open.MouseButton1Click:Connect(function() toggle(true) end)
close.MouseButton1Click:Connect(function() toggle(false) end)
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
    if not processed and input.KeyCode == Enum.KeyCode.J then toggle(not overlay.Visible) end
    if not processed and input.KeyCode == Enum.KeyCode.Escape and overlay.Visible then toggle(false) end
end)
remote.OnClientEvent:Connect(function(payload: any)
    if typeof(payload) ~= "table" then return end
    if payload.type == "garden" then
        state = payload
        currentWeather = payload.weather or currentWeather
        draw()
    elseif payload.type == "state" then
        currentWeather = payload.weather or currentWeather
    elseif payload.type == "seedFound" then
        if tracked and payload.seed then
            tracker.Text = if payload.discovered then "✨ NEW SEED! " .. payload.text else payload.text
        end
    end
end)
task.spawn(function()
    while gui.Parent do
        task.wait(1.5)
        if tracked then
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if root and root:IsA("BasePart") then
                local distance = (root.Position - Vector3.new(tracked.x, 10, tracked.z)).Magnitude
                tracker.Text = string.format("🧭 %s  •  %d studs away", tracked.label, math.floor(distance))
            end
        end
    end
end)
task.delay(1.6, function() remote:FireServer("Sync") end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="204">
        <Properties>
          <string name="Name">Soundscape</string>
          <string name="Source"><![CDATA[--!strict
-- Client-only cozy audio mix with an accessible mute button.
-- The offline Studio kit resolves the same originals from its local content directory.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Config = require(ReplicatedStorage:WaitForChild("AudioConfig"))
local remote = ReplicatedStorage:WaitForChild("MonsterRemote") :: RemoteEvent
local AudioSource = require(ReplicatedStorage.AudioSource)
local player = Players.LocalPlayer

local soundGroup = Instance.new("SoundGroup")
soundGroup.Name = "DWTMMusicMix"
soundGroup.Volume = 1
soundGroup.Parent = SoundService
local effectsGroup = Instance.new("SoundGroup")
effectsGroup.Name = "DWTMEffectsMix"
effectsGroup.Volume = 1
effectsGroup.Parent = SoundService

local music: Sound? = nil
local chase: Sound? = nil
local ambience: Sound? = nil
local musicEnabled = true
local effectsEnabled = true
local phase = "SLEEP"
local lastStirWake: number? = nil
local recent: {[string]: number} = {}

local gui = Instance.new("ScreenGui")
gui.Name = "AudioSettings"
gui.ResetOnSpawn = false
gui.DisplayOrder = 7
gui.Parent = player:WaitForChild("PlayerGui")

local musicButton = Instance.new("TextButton")
musicButton.Name = "MusicToggle"
musicButton.Position = UDim2.new(1, -164, 0, 290)
musicButton.Size = UDim2.fromOffset(152, 33)
musicButton.BackgroundColor3 = Color3.fromRGB(244, 239, 229)
musicButton.TextColor3 = Color3.fromRGB(72, 50, 92)
musicButton.TextScaled = true
musicButton.Font = Enum.Font.GothamBlack
musicButton.Text = "🎵 MUSIC ON"
musicButton.Parent = gui
local c = Instance.new("UICorner")
c.CornerRadius = UDim.new(0, 12)
c.Parent = musicButton

local fxButton = Instance.new("TextButton")
fxButton.Name = "EffectsToggle"
fxButton.Position = UDim2.new(1, -164, 0, 329)
fxButton.Size = UDim2.fromOffset(152, 33)
fxButton.BackgroundColor3 = Color3.fromRGB(244, 239, 229)
fxButton.TextColor3 = Color3.fromRGB(72, 50, 92)
fxButton.TextScaled = true
fxButton.Font = Enum.Font.GothamBlack
fxButton.Text = "🔊 EFFECTS ON"
fxButton.Parent = gui
local d = Instance.new("UICorner")
d.CornerRadius = UDim.new(0, 12)
d.Parent = fxButton

local function refreshButtons()
    musicButton.Text = if musicEnabled then "🎵 MUSIC ON" else "🔇 MUSIC OFF"
    fxButton.Text = if effectsEnabled then "🔊 EFFECTS ON" else "🔇 EFFECTS OFF"
    if not music and not chase then musicButton.Text = "🎵 AUDIO PENDING" end
end
local function loopTrack(assetId: number?, file: string, name: string, volume: number, group: SoundGroup): Sound?
    local uri=AudioSource.resolve(assetId,file)
    if not uri then return nil end
    local sound = Instance.new("Sound")
    sound.Name = name
    sound.SoundId = uri
    sound.Volume = volume
    sound.Looped = true
    sound.SoundGroup = group
    sound.Parent = SoundService
    sound:Play()
    return sound
end
music = loopTrack(Config.MusicAssetId,"calm-garden-theme","OriginalCozyGardenTheme",Config.MusicVolume,soundGroup)
chase = loopTrack(Config.ChaseMusicAssetId, "monster-chase-theme", "OriginalMonsterChaseTheme", 0, soundGroup)
ambience = loopTrack(Config.AmbienceAssetId, "sleepy-forest-ambience", "OriginalSleepyForestAmbience",
    if musicEnabled then Config.AmbienceVolume else 0, soundGroup)

local function crossfadeMusic()
    local calmVolume = if musicEnabled and phase ~= "AWAKE" then Config.MusicVolume else 0
    local chaseVolume = if musicEnabled and phase == "AWAKE" then Config.ChaseMusicVolume else 0
    local ambientVolume = if musicEnabled and phase == "SLEEP" then Config.AmbienceVolume else 0
    for _, item in ipairs({
        {sound = music, target = calmVolume},
        {sound = chase, target = chaseVolume},
        {sound = ambience, target = ambientVolume},
    }) do
        if item.sound then
            TweenService:Create(item.sound, TweenInfo.new(1.1, Enum.EasingStyle.Quad), {Volume = item.target}):Play()
        end
    end
end

musicButton.MouseButton1Click:Connect(function()
    musicEnabled = not musicEnabled
    crossfadeMusic()
    refreshButtons()
end)
fxButton.MouseButton1Click:Connect(function()
    effectsEnabled = not effectsEnabled
    refreshButtons()
end)

local cueFiles: {[string]: string} = {TinyViolin="tiny-violin-fail", SuspiciousMeow="suspicious-meow",
    RecordScratch="cartoon-record-scratch", ComedySting="comedy-drum-sting"}
local function playCue(id: string)
    if not effectsEnabled then return end
    local assetId = Config.Cues[id]
    if assetId==nil then return end
    local uri=AudioSource.resolve(assetId,cueFiles[id] or id)
    if not uri then return end
    local now = os.clock()
    if now - (recent[id] or -100) < 0.35 then return end
    recent[id] = now
    local effect = Instance.new("Sound")
    effect.Name = "Original_" .. id
    effect.SoundId = uri
    effect.Volume = Config.CueVolume
    effect.SoundGroup = effectsGroup
    effect.Parent = SoundService
    effect:Play()
    Debris:AddItem(effect, 12)
end

remote.OnClientEvent:Connect(function(event: any)
    if typeof(event) ~= "table" then return end
    if event.type == "soundCue" and type(event.cue) == "string" then
        playCue(event.cue)
    elseif event.type == "state" then
        local nextPhase = event.phase or phase
        if nextPhase == "SLEEP" and event.warning and lastStirWake ~= event.wakes then
            lastStirWake = event.wakes
            playCue("SleepyGrumble")
        end
        if nextPhase ~= phase then
            phase = nextPhase
            crossfadeMusic()
        end
    end
end)
refreshButtons()
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="205">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
      <int name="StreamingMinRadius">64</int>
      <int name="StreamingTargetRadius">128</int>
    </Properties>
  </Item>
</roblox>